tom interactive filter examples#Custom interactive filter example - Multiple reports#{1}":[233,234],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#About custom interactive filters on multiple tables":[235,245],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#About custom interactive filters on multiple tables#{1}":[237,238],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#About custom interactive filters on multiple tables#{2}":[239,239],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#About custom interactive filters on multiple tables#{3}":[240,240],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#About custom interactive filters on multiple tables#{4}":[241,241],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#About custom interactive filters on multiple tables#{5}":[242,243],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#About custom interactive filters on multiple tables#{6}":[244,245],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#How to apply Custom Interactive Filter to multiple tables":[246,281],"#Custom interactive filter examples#Custom interactive filter example - Multiple reports#How to apply Custom Interactive Filter to multiple tables#{1}":[248,281],"#Custom interactive filter examples#Related":[282,288],"#Custom interactive filter examples#Related#{1}":[284,284],"#Custom interactive filter examples#Related#{2}":[285,285],"#Custom interactive filter examples#Related#{3}":[286,286],"#Custom interactive filter examples#Related#{4}":[287,288]},"outlinks":[{"title":"widgets","target":"widgets","line":20},{"title":"Custom interactive filters","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/core-ui-interactive-filters/c_CustomPublishers.md","line":26},{"title":"UI scripts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_UIScripts.md","line":33},{"title":"Jelly tags","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/r_JellyTags.md","line":35},{"title":"DashboardMessageHandler","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/core-ui-interactive-filters/c_DashboardMessageHandler.md","line":37},{"title":"DashboardMessageHandler","target":"c_DashboardMessageHandler","line":86},{"title":"interactive filters","target":"c_HomepagePublishers","line":163},{"title":"Custom interactive filters","target":"c_CustomPublishers","line":239},{"title":"Widgets","target":"widgets","line":284},{"title":"DashboardMessageHandler","target":"c_DashboardMessageHandler","line":285},{"title":"Interactive Filters","target":"c_HomepagePublishers","line":286},{"title":"Custom interactive filters","target":"c_CustomPublishers","line":287}],"metadata":{"title":"Custom interactive filter examples","description":"As an administrator, you can create custom interactive filter widgets to provide advanced filtering options on dashboards.Create custom interactive filter widgets to provide advanced filtering options on dashboards.After you create the interactive filter, add the filtering logic.When the standard selection of date/time filter options doesn't meet your needs, you can create a custom option.You can use a custom interactive filter to filter multiple reports using different tables. There are two different APIs to publish an interactive filter for a single table or multiple tables. This example filters a report on the incident and problem tables by assignment group using a custom interactive filter.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/core-ui-interactive-filters/r\\_CustomPublisherExample.html","release":"australia","product":"Core UI Interactive Filters","classification":"core-ui-interactive-filters","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Custom interactive filters","Interactive Filters","Reporting","dashboards","and Performance Analytics in the Core UI","Platform Analytics"],"tags":["#now-intelligence","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[100,138],[169,171],[210,212],[252,280]],"key":"ServiceNowOfficialDocs/now-intelligence/core-ui-interactive-filters/r_CustomPublisherExample.md"},
