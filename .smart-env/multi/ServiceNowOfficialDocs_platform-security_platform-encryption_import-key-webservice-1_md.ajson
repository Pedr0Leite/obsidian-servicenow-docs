ort a wrapped key from a web service#Procedure#{1}":[99,100],"#Import a key from a web service#Import a wrapped key from a web service#Procedure#{2}":[101,104],"#Import a key from a web service#Import a wrapped key from a web service#Procedure#{3}":[105,106],"#Import a key from a web service#Import a wrapped key from a web service#Procedure#{4}":[107,108],"#Import a key from a web service#Import a wrapped key from a web service#Procedure#{5}":[109,113],"#Import a key from a web service#Import a wrapped key from a web service#Procedure#{6}":[114,115],"#Import a key from a web service#Import a wrapped key from a web service#Procedure#{7}":[116,117],"#Import a key from a web service#Import a wrapped key from a web service#Procedure#{8}":[118,170],"#Import a key from a web service#Import a wrapped key from a web service#Procedure#{9}":[171,172],"#Import a key from a web service#Related":[173,182],"#Import a key from a web service#Related#{1}":[175,175],"#Import a key from a web service#Related#{2}":[176,176],"#Import a key from a web service#Related#{3}":[177,177],"#Import a key from a web service#Related#{4}":[178,178],"#Import a key from a web service#Related#{5}":[179,179],"#Import a key from a web service#Related#{6}":[180,180],"#Import a key from a web service#Related#{7}":[181,182]},"outlinks":[{"title":"Key Management Framework","target":"encryption","line":32},{"title":"export","target":"export","line":56},{"title":"Cryptographic specification overview","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/platform-encryption/cryptographic-purpose.md","line":64},{"title":"basic authentication","target":"basic-authentication","line":89},{"title":"configuration","target":"sc-configuration","line":89},{"title":"certificates","target":"c_Certificates","line":95},{"title":"Create a cryptographic module","target":"create-cryptographic-module","line":105},{"title":"request","target":"c_requestAPI","line":116},{"title":"Key Management Framework","target":"encryption","line":175},{"title":"Export","target":"export","line":176},{"title":"Configuration","target":"sc-configuration","line":177},{"title":"Basic authentication","target":"basic-authentication","line":178},{"title":"Certificates","target":"c_Certificates","line":179},{"title":"Create a cryptographic module","target":"create-cryptographic-module","line":180},{"title":"request","target":"c_requestAPI","line":181}],"metadata":{"title":"Import a key from a web service","description":"Securely upload an external customer key onto your instance using import a key from a web service \\(for example the key REST API\\). Both symmetric and asymmetric public keys can be imported into a targeted KMF cryptographic module.Configure Key Management Framework import settings before importing a key.Upload your wrapped key into a cryptographic module using the import key from web service functionality. The example uses a symmetric key. Similar steps can be used to import an asymmetric key.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/platform-encryption/import-key-webservice-1.html","release":"australia","product":"Platform Encryption","classification":"platform-encryption","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Key Management Framework","Encryption"],"tags":["#platform-security","#encryption","#columns","#attachments","#security","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-security/platform-encryption/import-key-webservice-1.md"},
