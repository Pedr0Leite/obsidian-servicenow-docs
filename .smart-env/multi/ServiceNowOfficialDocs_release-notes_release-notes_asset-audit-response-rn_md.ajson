viceNow/ServiceNowDocs/australia/markdown/platform-administration/read-only-option.md","line":35},{"title":"KB2718122","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB2718122","line":35},{"title":"Automate the summarization of evidence requests","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/fulfill-evidence-requests-guided-experience.md","line":39},{"title":"Track impacted records that require remediation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/fulfill-evidence-requests-guided-experience.md","line":43},{"title":"View citations for your evidence requests","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/fulfill-evidence-requests-guided-experience.md","line":47},{"title":"Streamline the fulfillment of evidence requests by using financial regulatory context from the Digital Operational Resilience Act \\(DORA\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/audit-workspace.md","line":51},{"title":"ServiceNow product tiers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/ai-native-sku-overview.md","line":55},{"title":"ServiceNow Store","target":"https://store.servicenow.com/sn_appstore_store.do#!/store/home","line":67},{"title":"ServiceNow Store version history release notes","target":"https://www.servicenow.com/docs/bundle/store-release-notes/page/release-notes/store/sn-store-release-notes.html","line":67},{"title":"Software Asset Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/c_SoftwareAssetMgmt.md","line":71},{"title":"Hardware Asset Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/ham-landing-page.md","line":75},{"title":"Audit Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/c_GRCAudits.md","line":79},{"title":"IT Asset Management release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/it-asset-management-rn-landing.md","line":84}],"metadata":{"title":"Asset Audit Response release notes","description":"The ServiceNow Asset Audit Response application provides workspaces where asset managers can manage their regulatory audits, request evidence for these audits, respond to these requests through a guided experience, and access regulatory content data to help drive more efficient and accurate responses to these requests. Asset Audit Response was enhanced and updated in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":3,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/asset-audit-response-rn.md"},
