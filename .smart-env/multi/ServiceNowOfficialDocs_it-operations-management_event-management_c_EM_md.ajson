vicenow.com/support/contact-support.html","line":61},{"title":"Video: Getting started with Event Management","target":"https://players.brightcove.net/6274575390001/nUx4EKfUz_default/index.html?videoId=6331193497112","line":62},{"title":"Videos: Getting started with ITOM","target":"https://www.youtube.com/playlist?list=PLCOmiTb5WX3p7hJP68kQu3nXPCwwGtXK0","line":63},{"title":"Developer training","target":"https://developer.servicenow.com/app.do#!/training/landing","line":64},{"title":"Developer documentation","target":"https://developer.servicenow.com/app.do#!/documentation","line":65},{"title":"Alert grouping","target":"c_ServiceAnalyticsOverview","line":69},{"title":"View alert information","target":"t_EMViewAlert","line":70}],"metadata":{"title":"Event Management","description":"ServiceNow Event Management is a robust application that helps keep your IT systems healthy by spotting problems quickly and fixing them. It collects events from different sources, figures out what's causing the issues, and converts them into alerts. These alerts are then analyzed, grouped, and acted upon to resolve issues and maintain system health.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/event-management/c\\_EM.html","release":"australia","product":"Event Management","classification":"event-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["ITOM AIOps","IT Operations Management"],"tags":["#it-operations-management","#event-management","#alerts","#correlation","#aiops","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/event-management/c_EM.md"},
