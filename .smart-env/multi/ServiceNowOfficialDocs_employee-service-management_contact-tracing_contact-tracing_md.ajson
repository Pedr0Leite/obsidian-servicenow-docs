","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/contact-tracing/wifi-access-management.md","line":84},{"title":"Tracking employee contacts using daily logs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/contact-tracing/employee-daily-log.md","line":86},{"title":"Managing cases to follow up with potentially exposed contacts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/contact-tracing/exposure-case-management.md","line":88},{"title":"follow up with potentially exposed contacts","target":"contact-exposed-contacts","line":89},{"title":"Safe Workplace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/safe-workplace/safe-workplace.md","line":91},{"title":"Enhance search criteria","target":"enhance-case-search","line":95},{"title":"Safe Workplace","target":"safe-workplace","line":96},{"title":"Emergency Response Management","target":"emergency-response-management","line":97},{"title":"Emergency Outreach","target":"emergency-outreach","line":98},{"title":"Emergency Exposure Management","target":"emergency-exposure-management","line":99},{"title":"Identify potentially exposed users","target":"use-emergency-exposure-mgnt","line":100},{"title":"Safe Workplace Dashboard","target":"safe-workplace-dashboard","line":101},{"title":"Emergency Self Report","target":"emergency-self-report","line":102},{"title":"Employee Readiness Core","target":"employee-readiness-core","line":103},{"title":"Health and Safety","target":"health-safety-overview","line":104},{"title":"Vaccination Status","target":"vaccination-status","line":105},{"title":"Install Contact Tracing","target":"install-contact-tracing","line":106},{"title":"Follow up with potentially exposed contacts","target":"contact-exposed-contacts","line":107}],"metadata":{"title":"Contact Tracing","description":"The ServiceNow Contact Tracing application helps organizations reduce workplace transmission of infectious diseases, such as COVID-19, by identifying any on-site users who might have been in contact with an affected user. The user receives updates about the number of reported cases or symptoms in the location. A list of potentially exposed users is created from various data inputs, such as badge scans, Wi-Fi access logs, and daily contact logs.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/contact-tracing/contact-tracing.html","release":"australia","product":"Contact Tracing","classification":"contact-tracing","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Safe Workplace","Health and Safety","Employee Service Management"],"tags":["#employee-service-management","#contact-tracing","#health-safety","#covid","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/contact-tracing/contact-tracing.md"},
