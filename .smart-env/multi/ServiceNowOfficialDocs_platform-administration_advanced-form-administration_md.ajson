 for derived fields#About this task":[237,268],"#Advanced form configuration#Control the label type for derived fields#About this task#{1}":[239,240],"#Advanced form configuration#Control the label type for derived fields#About this task#{2}":[241,241],"#Advanced form configuration#Control the label type for derived fields#About this task#{3}":[242,243],"#Advanced form configuration#Control the label type for derived fields#About this task#{4}":[244,258],"#Advanced form configuration#Control the label type for derived fields#About this task#{5}":[259,260],"#Advanced form configuration#Control the label type for derived fields#About this task#{6}":[261,262],"#Advanced form configuration#Control the label type for derived fields#About this task#{7}":[263,264],"#Advanced form configuration#Control the label type for derived fields#About this task#{8}":[265,266],"#Advanced form configuration#Control the label type for derived fields#About this task#{9}":[267,268],"#Advanced form configuration#Related":[269,277],"#Advanced form configuration#Related#{1}":[271,271],"#Advanced form configuration#Related#{2}":[272,272],"#Advanced form configuration#Related#{3}":[273,273],"#Advanced form configuration#Related#{4}":[274,274],"#Advanced form configuration#Related#{5}":[275,275],"#Advanced form configuration#Related#{6}":[276,277]},"outlinks":[{"title":"Allow insert options on task records","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/advanced-form-administration.md","line":20},{"title":"Turn off focusing on the first writable field of a form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/advanced-form-administration.md","line":21},{"title":"Deactivate form submission with the Enter key","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/advanced-form-administration.md","line":22},{"title":"Enable multiple form splits","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/advanced-form-administration.md","line":23},{"title":"Define required fields","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/advanced-form-administration.md","line":24},{"title":"System Properties","target":"r_SetArchiveRuleProcessingBehavior","line":36},{"title":"template bar","target":"template-bar","line":66},{"title":"Add a system property","target":"t_AddAPropertyUsingSysPropsList","line":80},{"title":"User Administration","target":"c_UserAdministration","line":105},{"title":"configuring the form layout","target":"configure-form-layout","line":188},{"title":"reference","target":"reference-email-admin","line":239},{"title":"Add a system property","target":"t_AddAPropertyUsingSysPropsList","line":271},{"title":"System properties","target":"r_SetArchiveRuleProcessingBehavior","line":272},{"title":"Template bar","target":"template-bar","line":273},{"title":"User administration","target":"c_UserAdministration","line":274},{"title":"Configuring the form layout","target":"configure-form-layout","line":275},{"title":"Reference","target":"reference-email-admin","line":276}],"metadata":{"title":"Advanced form configuration","description":"Administrators can configure advanced form features, such as form focus, form splits, and derived fields.The Insert and Insert and Stay options are disabled by default for task records such as incidents and change requests. You can set a system property to show these options for task records.Switch the focus on a form to the first element on the page instead of the first writable field to make the form more accessible to users who use screen readers.Administrators can hide the template bar for a table by creating a system property.By default, when you press the Enter key in a simple one-line text field, a choice list, or a Boolean field, the form is submitted.Form splits enable you to organize fields on a form into columns. Administrators must add a property to enable form splits.You can specify which form fields are required in forms. This action prevents users with the personalize\\_form role from removing the field by configuring the form layout.You can configure the type of label that appears for derived fields.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/advanced-form-administration.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Administer","Form administration","Forms","fields","and lists","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/advanced-form-administration.md"},
