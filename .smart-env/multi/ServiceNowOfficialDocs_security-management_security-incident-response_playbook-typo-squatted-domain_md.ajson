ecurity-operations-landing-page","line":39},{"title":"Threat Intelligence","target":"threat-intel-landing-page","line":40},{"title":"Set up the Typo Squatted Domain playbook","target":"playbook-setup-typo-squatted-domain","line":41}],"metadata":{"title":"Playbook for Typo Squatted Domain","description":"This playbook provides systematic procedures for investigating misspelled domains and collaborating with the organization’s legal department for take-downs. Typo Squatted domains are intentionally misspelled domain names that closely resemble legitimate ones. Attackers take advantage of spelling errors to lead them to an ill-intended website for financial exploitation or other malicious activities.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/playbook-typo-squatted-domain.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Flow-based Playbooks","Security Incident Response playbooks","Playbook Resources","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/security-management/security-incident-response/playbook-typo-squatted-domain.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"xtnjjm","at":1784561352378},"key":"ServiceNowOfficialDocs/security-management/security-incident-response/playbook-typo-squatted-domain.md#---frontmatter---","lines":[1,20],"size":1074,"outlinks":[],"class_name":"SmartBlock"},
