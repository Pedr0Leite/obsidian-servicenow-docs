cated\\)#MLPredictor - recordFinalValuesInPredictionResults\\(GlideRecord now\\_GR, String reason\\)":[436,458],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - recordFinalValuesInPredictionResults\\(GlideRecord now\\_GR, String reason\\)#{1}":[438,458],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getCapability\\(\\)":[459,470],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getCapability\\(\\)#{1}":[461,470],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getName\\(\\)":[471,482],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getName\\(\\)#{1}":[473,482],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getPredictedField\\(\\)":[483,512],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getPredictedField\\(\\)#{1}":[485,512],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getThreshold\\(String className\\)":[513,526],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getThreshold\\(String className\\)#{1}":[515,526],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getVersion\\(\\)":[527,538],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.getVersion\\(\\)#{1}":[529,538],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.isActive\\(\\)":[539,550],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.isActive\\(\\)#{1}":[541,550],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.predict\\(GlideRecord now\\_GR, Object threshold\\)":[551,576],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.predict\\(GlideRecord now\\_GR, Object threshold\\)#{1}":[553,576],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.predictTopN\\(GlideRecord now\\_GR, Object topN\\)":[577,608],"#MLPredictor- Global \\(deprecated\\)#MLPredictor - solution.predictTopN\\(GlideRecord now\\_GR, Object topN\\)#{1}":[579,608],"#MLPredictor- Global \\(deprecated\\)#Related":[609,612],"#MLPredictor- Global \\(deprecated\\)#Related#{1}":[611,612]},"outlinks":[{"title":"Using ML APIs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/using-ml-apis.md","line":26},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":32},{"title":"update","target":"r_Update","line":208},{"title":"update","target":"r_Update","line":611}],"metadata":{"title":"MLPredictor - Global \\(deprecated\\)","description":"The MLPredictor API provides utility methods for Predictive Intelligence predictions.Instantiates a new MLPredictor object.Sets predicted values from an array of specified solutions to a specified record.Applies a predicted value from a specified classification solution to the specified GlideRecord.Gets the solution object.Gets active solutions for a table in a specified GlideRecord.Gets the predicted value for a specified solution based on the specified prediction outcome.Gets predictions for a specified solution.Identifies if a solution object is a classification type.Identifies if a solution object is a similarity type.Gets the confidence of the predicted value.Gets the predicted value from the MLPredictor outcome object.Gets the sys\\_id of the predicted value.Sets final prediction result values to a specified GlideRecord with an optionally specified reason.Gets the capability information of a trained solution.Gets the name of the solution used for prediction.Gets the predicted value of a solution.Gets the solution threshold.Gets the version of the active solution.Determines if the specified solution is active.Gets solution prediction results as an Outcome object.Returns a list of outcome objects up to the expected number of predictions. Maximum number 1000 predictions.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_MLPredictorAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[44,50],[67,76],[95,141],[159,173],[177,181],[197,213],[217,221],[225,229],[305,326],[340,357],[383,391],[405,413],[427,434],[451,457],[495,511],[564,575],[590,607]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_MLPredictorAPI.md"},
