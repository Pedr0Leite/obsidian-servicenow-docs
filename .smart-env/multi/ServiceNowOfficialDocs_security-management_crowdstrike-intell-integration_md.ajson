n overview#Related#{2}":[112,112],"#CrowdStrike Falcon Intelligence integration overview#Related#{3}":[113,113],"#CrowdStrike Falcon Intelligence integration overview#Related#{4}":[114,114],"#CrowdStrike Falcon Intelligence integration overview#Related#{5}":[115,115],"#CrowdStrike Falcon Intelligence integration overview#Related#{6}":[116,116],"#CrowdStrike Falcon Intelligence integration overview#Related#{7}":[117,117],"#CrowdStrike Falcon Intelligence integration overview#Related#{8}":[118,118],"#CrowdStrike Falcon Intelligence integration overview#Related#{9}":[119,119],"#CrowdStrike Falcon Intelligence integration overview#Related#{10}":[120,120],"#CrowdStrike Falcon Intelligence integration overview#Related#{11}":[121,121],"#CrowdStrike Falcon Intelligence integration overview#Related#{12}":[122,123]},"outlinks":[{"title":"Security Operations","target":"security-operations-landing-page","line":18},{"title":"CrowdStrike Falcon Intelligence integration","target":"crowdstrike-intell-landing-page","line":20},{"title":"Threat Intelligence","target":"threat-intel-landing-page","line":20},{"title":"Submit an IoC Lookup request from the Security Incident Catalog","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/t_SubmitThrtScnReqFromCat.md","line":25},{"title":"observables","target":"c_Observables","line":29},{"title":"malware","target":"threat-intelligence-malware","line":29},{"title":"Threat Lookup","target":"tisc-threat-lookup","line":29},{"title":"Security Operations Integration - Threat Lookup capability","target":"sec-ops-threat-lookups-capability","line":31},{"title":"Common Security Operations integration flows and orchestration activities","target":"common-wf-activities","line":37},{"title":"Indicators of Compromise","target":"c_IoCs","line":50},{"title":"Indicators","target":"indicator","line":50},{"title":"Download the integration from the ServiceNow Store","target":"download-app-first-time","line":54},{"title":"Perform lookups on observables","target":"perform-lookups-on-observables","line":107},{"title":"Security Operations Integration - Threat Lookup capability","target":"sec-ops-threat-lookups-capability","line":111},{"title":"Common Security Operations integration flows and orchestration activities","target":"common-wf-activities","line":112},{"title":"Download an application from the ServiceNow Store for the first time","target":"download-app-first-time","line":113},{"title":"Perform lookups on observables","target":"perform-lookups-on-observables","line":114},{"title":"Security Operations","target":"security-operations-landing-page","line":115},{"title":"Threat Intelligence","target":"threat-intel-landing-page","line":116},{"title":"CrowdStrike Falcon Intelligence integration","target":"crowdstrike-intell-landing-page","line":117},{"title":"Threat Lookup","target":"tisc-threat-lookup","line":118},{"title":"Observables","target":"c_Observables","line":119},{"title":"Malware","target":"threat-intelligence-malware","line":120},{"title":"Indicators","target":"indicator","line":121},{"title":"Indicators of compromise","target":"c_IoCs","line":122}],"metadata":{"title":"CrowdStrike Falcon Intelligence integration overview","description":"CrowdStrike Falcon Intelligence provides cyber security intelligence that easily integrating with Security Operations.The Threat Lookup - CrowdStrike Falcon Intelligence flow designer performs a lookup on selected observables. If the observables are of a type recognized by CrowdStrike Falcon Intelligence, the observables are scanned for malware, and the results are returned.The Integration Configuration feature allows you to quickly activate and set up third-party security integrations, including the CrowdStrike Falcon Intelligence integration. Before you can use the CrowdStrike Falcon Intelligence, you must download it from the ServiceNow Store and add the appropriate API key and ID.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/crowdstrike-intell-integration.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["CrowdStrike Falcon Intelligence integration","Threat Intelligence integrations","Threat Intelligence","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/crowdstrike-intell-integration.md"},
