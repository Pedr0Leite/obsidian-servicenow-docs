line#Related#{2}":[167,167],"#Create a custom pipeline#Related#{3}":[168,168],"#Create a custom pipeline#Related#{4}":[169,169],"#Create a custom pipeline#Related#{5}":[170,171]},"outlinks":[{"title":"ReleaseOps","target":"releaseops-landing","line":25},{"title":"Exploring Playbook","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/process-automation-designer.md","line":31},{"title":"deployment","target":"get-started-deployment","line":35},{"title":"Runbook tasks in ReleaseOps","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/releaseops/runbook-tasks.md","line":35},{"title":"Duplicate a playbook","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/duplicate-process.md","line":47},{"title":"tests","target":"tests-module","line":51},{"title":"Add and configure a stage in a playbook","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/add-configure-stage.md","line":53},{"title":"Decision activities","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/create-a-decision-activity.md","line":57},{"title":"Automated Test Framework \\(ATF\\)","target":"atf-landing-page","line":82},{"title":"Add a decision","target":"add-decision","line":112},{"title":"Decision activities","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/create-a-decision-activity.md","line":114},{"title":"ReleaseOps","target":"releaseops-landing","line":166},{"title":"Deployment","target":"get-started-deployment","line":167},{"title":"Tests","target":"tests-module","line":168},{"title":"Automated Test Framework \\(ATF\\)","target":"atf-landing-page","line":169},{"title":"Add a decision","target":"add-decision","line":170}],"metadata":{"title":"Create a custom pipeline","description":"Create a custom pipeline to move changes from your development environment to production \\(or your target instance\\) by duplicating one of the ReleaseOps sample playbooks.Create a custom pipeline to move changes through your non-production environment by duplicating the Deployment Request Assessment playbook. Add the deployment analyzer to detect if there are code changes in the deployment and skip Automated Test Framework \\(ATF\\) tests during assessment.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/releaseops/create-release-ops-pipeline.html","release":"australia","product":"ReleaseOps","classification":"releaseops","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":5,"keywords":["ReleaseOps","deploy changes","update sets","pipeline","ATF","schedule a release","deployment request","deployment analyzer"],"breadcrumb":["Configure","ReleaseOps","Deploying applications","Building applications"],"tags":["#application-development","#release-management","#pipeline","#ci-cd","#devops","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/application-development/releaseops/create-release-ops-pipeline.md"},
