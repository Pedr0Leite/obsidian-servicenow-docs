criptions#{4}":[353,354],"#Integrating with Microsoft Dynamics 365 and Power Apps#Optimizing Microsoft Dynamics 365 subscriptions#{5}":[355,366],"#Integrating with Microsoft Dynamics 365 and Power Apps#Related":[367,374],"#Integrating with Microsoft Dynamics 365 and Power Apps#Related#{1}":[369,369],"#Integrating with Microsoft Dynamics 365 and Power Apps#Related#{2}":[370,370],"#Integrating with Microsoft Dynamics 365 and Power Apps#Related#{3}":[371,371],"#Integrating with Microsoft Dynamics 365 and Power Apps#Related#{4}":[372,372],"#Integrating with Microsoft Dynamics 365 and Power Apps#Related#{5}":[373,374]},"outlinks":[{"title":"models","target":"c_Models","line":28},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":28},{"title":"Microsoft 365 frequently asked questions","target":"https://www.microsoft.com/en-in/microsoft-365/microsoft-365-for-home-and-school-faq","line":37},{"title":"https://admin.powerplatform.microsoft.com/","target":"https://admin.powerplatform.microsoft.com/","line":168},{"title":"Request SaaS License Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/request-saas-license-management.md","line":206},{"title":"Application Manager","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/application-manager.md","line":206},{"title":"using Software Asset Workspace","target":"using-sam-workspace","line":210},{"title":"Software Asset Workspace","target":"sam-workspace","line":237},{"title":"Set up Microsoft Azure Active Directory","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/integrating-with-microsoft365.md","line":260},{"title":"Software Asset Management publisher pack for Microsoft","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/microsoft-publisher-pack.md","line":286},{"title":"software models","target":"c_CreatingSoftwareModels","line":314},{"title":"Subscription exclusions for SaaS and SSO applications","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/subscription-exclusions.md","line":326},{"title":"Create a child alias to set up multiple integration profiles","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/create-child-alias-saas.md","line":328},{"title":"Review a software reclamation rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/add-reclamation-rule-sub.md","line":330},{"title":"Create entitlements in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/track-software-rights.md","line":334},{"title":"Create entitlements in workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/create-entitlements-workspace.md","line":335},{"title":"Create entitlements using the guided walk-through","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/guidedwalk-workspace.md","line":336},{"title":"License Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-license-workbench.md","line":338},{"title":"License usage view","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-workspace-workbench.md","line":338},{"title":"Run software reconciliation in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/t_RunReconciliation.md","line":340},{"title":"Run software reconciliation in the workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/run-recon-workspace.md","line":341},{"title":"Dynamics 365 pricing overview page","target":"https://www.microsoft.com/en-us/dynamics-365/pricing-overview","line":357},{"title":"Integrating with Microsoft Dynamics 365 and Power Apps","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/integrating-with-microsoft365.md","line":360},{"title":"Reclamation rules for SaaS and SSO applications","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/reclamation-rules.md","line":365},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":369},{"title":"Models","target":"c_Models","line":370},{"title":"Using Software Asset Workspace","target":"using-sam-workspace","line":371},{"title":"Software Asset Workspace","target":"sam-workspace","line":372},{"title":"Software models","target":"c_CreatingSoftwareModels","line":373}],"metadata":{"title":"Integrating with Microsoft Dynamics 365 and Power Apps","description":"Integrating your ServiceNow instance with the Microsoft Dynamics 365 and Power Apps service enables you to track your software subscriptions and to reclaim unused licenses.Set up Microsoft Azure Active Directory \\(AD\\).Set the system-level settings for Microsoft Dynamics 365 and Power Apps.Set up ServiceNow instance for Microsoft Dynamics 365 and Power Apps to track your software subscriptions and to reclaim unused licenses.Evaluating the software usage activity of Microsoft Dynamics 365 subscriptions helps you monitor license usage, optimize license allocation, and potentially reduce costs for the assigned licenses. Software usage activity refers to how software products are being used.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/saas-license-management/integrating-with-microsoft365.html","release":"australia","product":"SaaS License Management","classification":"saas-license-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["Integrate with SaaS applications","SaaS License Management","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#saas","#license-management","#discovery","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/saas-license-management/integrating-with-microsoft365.md"},
