les","line":25},{"title":"Platform Analytics","target":"c_performanceAnalyticsAndReporting","line":29},{"title":"Certify a Platform Analytics dashboard","target":"certify-db-ac","line":43},{"title":"Add a dashboard to a Dashboards page","target":"add-dashboard-to-workspace","line":47},{"title":"Platform Analytics experience dashboard categories","target":"db-categories","line":51},{"title":"Platform Analytics dashboard roles","target":"pa-dashboard-roles","line":73},{"title":"Certify a Platform Analytics dashboard","target":"certify-db-ac","line":74},{"title":"Add a dashboard to a Dashboards page","target":"add-dashboard-to-workspace","line":75},{"title":"Platform Analytics experience dashboard categories","target":"db-categories","line":76},{"title":"Platform Analytics","target":"c_performanceAnalyticsAndReporting","line":77}],"metadata":{"title":"Configure Platform Analytics dashboard details","description":"You can change a dashboard name, add a description, certify it, configure visibility, and specify the requester, the owner, the owner group.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/config-db-in-ac.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"keywords":["How to change dashboard visibility","How to add dashboard description","How to certify a dashboard","How to set dashboard owner","How to see dashboard creator","How to see whom the dashboard has been shared with","How to make a dashboard available on a workspace"],"breadcrumb":["Configure","Dashboards","Platform Analytics experience","Platform Analytics"],"tags":["#now-intelligence","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/config-db-in-ac.md"},
