:18},{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":18},{"title":"Vulnerability Response","target":"vuln-landing-page","line":18},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":23},{"title":"infrastructure","target":"threat-intelligence-infrastructure","line":29},{"title":"Unified Security Exposure Management \\(USEM\\)","target":"unified-security-exposure-management-landing-page","line":35},{"title":"Vulnerability Response","target":"vuln-landing-page","line":36},{"title":"Application Vulnerability Response","target":"avr-landing","line":37},{"title":"Container Vulnerability Response","target":"cvr-landing","line":38},{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":39},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":40},{"title":"Infrastructure","target":"threat-intelligence-infrastructure","line":41}],"metadata":{"title":"Security Exposure Management workflow","description":"Unified Security Exposure Management \\(USEM\\) is ServiceNow’s next-generation platform that consolidates multiple security exposure applications—Vulnerability Response \\(VR\\), Application Vulnerability Response \\(AVR\\), Container Vulnerability Response \\(CVR\\), and Configuration Compliance \\(CC\\)—into a unified architecture. It provides a single source of truth for security exposure, enabling real-time visibility, streamlined workflows, and automated remediation.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/sem-workflow.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Explore","Unified Security Exposure Management","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/sem-workflow.md"},
