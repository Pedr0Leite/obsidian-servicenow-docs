rget":"#mcetoc_1glp1cerl1vv","line":12},{"title":"Querying and using if and .next() instead","target":"#mcetoc_1glp1cerl200","line":13},{"title":"Lessons learned:","target":"#mcetoc_1glp1cerl201","line":14},{"title":"Looping through records, using addEncodedQuery and while loop","target":"#mcetoc_1glp1cerl202","line":15},{"title":"Bad example:","target":"#mcetoc_1glp1cerl203","line":16},{"title":"Better example:","target":"#mcetoc_1glp1cerl204","line":17},{"title":"deleteRecord() and updateMultiple()/deleteMultiple(), and Cascade Delete","target":"#mcetoc_1glp1cerl205","line":18},{"title":"setWorkflow() and autoSysFields()","target":"#mcetoc_1glp1cerl206","line":19},{"title":"setWorkflow(false);","target":"#mcetoc_1glp1cerl207","line":20},{"title":"autoSysFields(false);","target":"#mcetoc_1glp1cerl208","line":21},{"title":"'false' means true","target":"#mcetoc_1glp1cerl209","line":22},{"title":"gs.log() and the Source parameter","target":"#mcetoc_1glp1cerl20a","line":23},{"title":"Thread dump and exact Timestamps","target":"#mcetoc_1glp1cerl20b","line":24},{"title":"Example use case:","target":"#mcetoc_1glp1cerl20c","line":25},{"title":"GlideLog.getStackTrace(new Packages.java.lang.Throwable())","target":"#mcetoc_1glp1cerl20d","line":26},{"title":"Run in the Correct Scope","target":"#mcetoc_1glp1cerl20e","line":27},{"title":"Run as a scheduled script, splitting the data sets, and limit()","target":"#mcetoc_1glp1cerl20f","line":28},{"title":"Use .limit(n) to restrict the query to n records at a time, and then run the script several times.","target":"#mcetoc_1glp1cerl20g","line":29},{"title":"Speed the job up by running multiple threads at once.","target":"#mcetoc_1glp1cerl20h","line":30},{"title":"Example of running a UI Action or Business Rule as a standalone script","target":"#mcetoc_1glp1cerl20i","line":31}],"class_name":"SmartBlock"},
