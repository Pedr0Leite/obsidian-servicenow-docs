":24},{"title":"Setup indicator for configuration phase","target":"../image/ProgressBarConfig.png","line":32,"embedded":true},{"title":"increase the amount of memory","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/t_MIDServerOptionalConfiguration.md","line":49},{"title":"MID Server Connection parameters","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/mid-server-parameters.md","line":52},{"title":"Configuring MID Servers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/c_MIDServerConfiguration.md","line":73},{"title":"MID Server","target":"mid-server-landing","line":77}],"metadata":{"title":"Set MID Server thread use","description":"Change the number of threads used by the MID Server according to performance requirements. MID Servers which compete with other programs for CPU time can use fewer threads than the default. MID Servers which need more speed, and have a host computer powerful enough, can use more threads.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/mid-server/t\\_SetMIDServerThreadUse.html","release":"australia","product":"MID Server","classification":"mid-server","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Configuring MID Servers","Configuring MID Server","MID Server","Manage instance data sources","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#mid-server","#on-premise","#proxy","#connectivity","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[60,62]],"key":"ServiceNowOfficialDocs/servicenow-platform/mid-server/t_SetMIDServerThreadUse.md"},
