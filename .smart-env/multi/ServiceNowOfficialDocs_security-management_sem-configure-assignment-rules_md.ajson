ediation tasks#Result":[273,284],"#Configuring assignment rules#Remove assignments from findings and remediation tasks#Result#{1}":[275,276],"#Configuring assignment rules#Remove assignments from findings and remediation tasks#Result#{2}":[277,278],"#Configuring assignment rules#Remove assignments from findings and remediation tasks#Result#{3}":[279,280],"#Configuring assignment rules#Remove assignments from findings and remediation tasks#Result#{4}":[281,282],"#Configuring assignment rules#Remove assignments from findings and remediation tasks#Result#{5}":[283,284],"#Configuring assignment rules#Remove assignments from findings and remediation tasks#What to do next":[285,288],"#Configuring assignment rules#Remove assignments from findings and remediation tasks#What to do next#{1}":[287,288],"#Configuring assignment rules#Related":[289,301],"#Configuring assignment rules#Related#{1}":[291,291],"#Configuring assignment rules#Related#{2}":[292,292],"#Configuring assignment rules#Related#{3}":[293,293],"#Configuring assignment rules#Related#{4}":[294,294],"#Configuring assignment rules#Related#{5}":[295,295],"#Configuring assignment rules#Related#{6}":[296,296],"#Configuring assignment rules#Related#{7}":[297,297],"#Configuring assignment rules#Related#{8}":[298,298],"#Configuring assignment rules#Related#{9}":[299,299],"#Configuring assignment rules#Related#{10}":[300,301]},"outlinks":[{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":23},{"title":"vulnerabilities","target":"vulnerabilities","line":23},{"title":"Configure rules to manage findings","target":"sem-configure-rules-manage-findings","line":27},{"title":"Assigning findings to remediation teams using assignment rules","target":"sem-assigning-findings-to-remediation-teams","line":32},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"sem-acls-for-admin-rules","line":40},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/sem-acls-for-admin-rules.md","line":154},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/sem-acls-for-admin-rules.md","line":199},{"title":"Application Vulnerability Response","target":"avr-landing","line":228},{"title":"Container Vulnerability Response","target":"cvr-landing","line":228},{"title":"Vulnerability Response","target":"vuln-landing-page","line":228},{"title":"Using bulk edit in the Vulnerability Manager Workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/vulnerability-manager-workspace/vmws-using-bulk-edit.md","line":247},{"title":"Vulnerability Manager Workspace","target":"vulnerability-manager-workspace-landing-page","line":247},{"title":"IT Remediation workspace","target":"it-remediation-workspace-landing-page","line":255},{"title":"Remove assignments from findings and remediation tasks","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/sem-configure-assignment-rules.md","line":279},{"title":"Configure rules to manage findings","target":"sem-configure-rules-manage-findings","line":291},{"title":"Assigning findings to remediation teams using assignment rules","target":"sem-assigning-findings-to-remediation-teams","line":292},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"sem-acls-for-admin-rules","line":293},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":294},{"title":"Vulnerabilities","target":"vulnerabilities","line":295},{"title":"Vulnerability Response","target":"vuln-landing-page","line":296},{"title":"Application Vulnerability Response","target":"avr-landing","line":297},{"title":"Container Vulnerability Response","target":"cvr-landing","line":298},{"title":"Vulnerability Manager Workspace","target":"vulnerability-manager-workspace-landing-page","line":299},{"title":"IT Remediation Workspace","target":"it-remediation-workspace-landing-page","line":300}],"metadata":{"title":"Configuring assignment rules","description":"By configuring assignment rules, you can automate the process of routing findings to the appropriate teams or individuals. By defining assignment criteria based on vulnerability attributes or affected assets, you can ensure timely and accurate ownership for remediation efforts.Create rules to assign findings automatically based on specific filter conditions. These rules apply to items as they’re imported or manually created.Reapply assignment rules to rerun assignment logic on existing findings or groups after they’ve already been created.Delete assignment rules after careful consideration of potential impacts on the assignment logic and operational workflows.Clear the Assigned to and Assignment group fields on vulnerable item records in the Vulnerability Response, Application Vulnerability Response, and Container Vulnerability Response applications.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/sem-configure-assignment-rules.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"keywords":["assign findings to remediation teams automatically","assign vulnerable items to remediation teams automatically","assign application vulnerable items to remediation teams automatically","assign container vulnerable items to remediation teams automatically","configuring assignment rules"],"breadcrumb":["Configure rules to manage findings","Implement","Unified Security Exposure Management","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/sem-configure-assignment-rules.md"},
