/markdown/api-reference/rest-apis/Clotho-Time-Series-API.md","line":2361},{"title":"Supported transforms","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/Clotho-Time-Series-API.md","line":2369},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2409},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2463},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":3768},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":3781},{"title":"insert","target":"r_Insert","line":3844},{"title":"update","target":"r_Update","line":3845}],"metadata":{"title":"MetricBase Time Series API","description":"The MetricBase Time Series API provides endpoints to insert data into, retrieve information from, and to run transforms against a MetricBase database.Retrieves specified time series data from the MetricBase database.Transforms the specified data based on the specified parameters.Accumulates metric values at specified timestamp and saves the result to the database rather than overwriting the value.Retrieves and optionally groups time series data for one or more metrics after applying a specified list of transforms that form a linear pipeline.Returns a stream of transformed time series data for one or more metrics after applying the specified list of transforms.Adds time series data to the MetricBase database.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/Clotho-Time-Series-API.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":56,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[187,195],[229,236],[259,267],[269,302],[502,510],[544,551],[574,583],[587,666],[747,755],[791,798],[856,891],[895,901],[993,1002],[1042,1049],[1153,1161],[1171,1178],[1196,1204],[1230,1238],[1256,1262],[1298,1305],[1339,1347],[1365,1371],[1407,1414],[1453,1460],[1488,1495],[1513,1541],[1551,1559],[1635,1642],[1654,1668],[1725,1732],[1734,1748],[1786,1795],[1935,1942],[1986,1993],[2086,2133],[2137,2202],[2304,2312],[2340,2347],[2812,2819],[2847,2854],[2872,2900],[2910,2918],[2994,3001],[3013,3027],[3084,3091],[3093,3107],[3145,3154],[3294,3301],[3345,3352],[3447,3495],[3499,3549],[3553,3569],[3573,3625],[3692,3700],[3736,3743],[3797,3832],[3834,3840]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/Clotho-Time-Series-API.md"},
