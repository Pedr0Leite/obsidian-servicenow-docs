{1}":[80,80],"#Pre-authorization#Related#{2}":[81,81],"#Pre-authorization#Related#{3}":[82,82],"#Pre-authorization#Related#{4}":[83,83],"#Pre-authorization#Related#{5}":[84,85]},"outlinks":[{"title":"pre-authorization requests","target":"mco-agents-pre-auth-requests","line":21},{"title":"pre-authorization request","target":"mco-pre-auth-request-use","line":21},{"title":"submit a pre-authorization request","target":"mco-submit-pre-auth-request","line":27},{"title":"Dealer Portal","target":"mco-dealer-portal","line":40},{"title":"repair claim","target":"mco-use-repair-claim","line":61},{"title":"Pre-authorization request","target":"mco-pre-auth-request-use","line":80},{"title":"Pre-authorization requests","target":"mco-agents-pre-auth-requests","line":81},{"title":"Submit a pre-authorization request","target":"mco-submit-pre-auth-request","line":82},{"title":"Dealer portal","target":"mco-dealer-portal","line":83},{"title":"Repair claim","target":"mco-use-repair-claim","line":84}],"metadata":{"title":"Pre-authorization","description":"A pre-authorization request is a process to confirm the approval before initiating activities, such as repairs, material procurement, or labor costs that are included under warranty or service agreements. This procedure confirms that all required inspections and criteria are satisfied and duly authorized by the Warranty Specialist. When a claim is created, approved pre-authorization requests can be used to generate claim jobs, avoiding re-entering of claim details. This process promotes quality assurance and operational efficiency in the process.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/manufacturing/mco-pre-auth-request.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["MCO core","Explore","Manufacturing Commercial Operations"],"tags":["#manufacturing","#industry","#solutions","#ot","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/manufacturing/mco-pre-auth-request.md"},
