ttps://www.servicenow.com/docs/r/api-reference/rest-apis/policies-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":18,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[166,171],[194,199],[203,205],[345,350],[354,361],[506,511],[539,544],[604,609],[645,650],[750,755],[759,790],[845,852],[962,967],[1018,1023],[1094,1099],[1103,1123],[1274,1279],[1330,1335],[1406,1411],[1415,1435]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/policies-api.md"},
