eFromGR\\(Object hashMap, GlideRecord now\\_GR, Object ignore\\)":[162,292],"#GlideRecordUtil- Global#GlideRecordUtil - populateFromGR\\(Object hashMap, GlideRecord now\\_GR, Object ignore\\)#{1}":[164,292],"#GlideRecordUtil- Global#Related":[293,296],"#GlideRecordUtil- Global#Related#{1}":[295,296]},"outlinks":[{"title":"Using discovery script includes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_ScriptIncludes.md","line":26},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28},{"title":"GlideRecord","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordAPI.md","line":42},{"title":"GlideRecord","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordAPI.md","line":58},{"title":"GlideRecord","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordAPI.md","line":104},{"title":"GlideRecord","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordAPI.md","line":145},{"title":"update","target":"r_Update","line":152},{"title":"GlideRecord","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordAPI.md","line":196},{"title":"update","target":"r_Update","line":295}],"metadata":{"title":"GlideRecordUtil - Global","description":"The GlideRecordUtil script include is a utility class for working with GlideRecords.Returns the GlideRecord object for the specified configuration item \\(CI\\) using just the sys\\_id of the CI.Returns an array of all the fields in the specified GlideRecord.Returns a GlideRecord instance for the given table, positioned to the given sys\\_id, and of the right class \\(table\\).Returns a list of the ancestors of a specified table.Sets the fields in the specified GlideRecord with the field values contained in the specified hashmap, unless that field name is in the ignore hashmap.Populates a given hashmap from a GlideRecord. Each field in the GlideRecord becomes a property in the hashmap.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_GlideRecordUtilAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[46,48],[64,74],[78,89],[106,108],[126,129],[133,136],[154,160],[214,216],[225,233],[237,291]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_GlideRecordUtilAPI.md"},
