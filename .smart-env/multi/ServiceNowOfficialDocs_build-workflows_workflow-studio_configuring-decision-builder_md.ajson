,"#Configuring decision tables#Decision tables personas and roles#Personas and roles#{9}":[50,88],"#Configuring decision tables#Decision tables personas and roles#Personas and roles#{10}":[89,89],"#Configuring decision tables#Decision tables personas and roles#Personas and roles#{11}":[90,90],"#Configuring decision tables#Decision tables personas and roles#Personas and roles#{12}":[91,91],"#Configuring decision tables#Decision tables personas and roles#Personas and roles#{13}":[92,93],"#Configuring decision tables#Decision tables personas and roles#Personas and roles#{14}":[94,106],"#Configuring decision tables#Related":[107,111],"#Configuring decision tables#Related#{1}":[109,109],"#Configuring decision tables#Related#{2}":[110,111]},"outlinks":[{"title":"Workflow Studio","target":"workflow-studio","line":24},{"title":"Update to the latest version of Workflow Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/workflow-studio/update-to-the-latest-version-of-workflow-studio.md","line":26},{"title":"use decision tables","target":"use-decision-tables","line":30},{"title":"Workflow Studio","target":"workflow-studio","line":109},{"title":"Use decision tables","target":"use-decision-tables","line":110}],"metadata":{"title":"Configuring decision tables","description":"Workflow Studio is installed automatically with each family upgrade. By updating to the latest version of Workflow Studio, you have the latest updates to decision tables. Configure Workflow Studio and assign roles to your staff based on the permission level they require.The responsibilities of your staff are controlled by roles assigned to each member. Personas aren’t explicitly part of decision tables in Workflow Studio, but administrators assign roles to give team members permission to configure or use decision tables.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/workflow-studio/configuring-decision-builder.html","release":"australia","product":"Workflow Studio","classification":"workflow-studio","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Decision tables","Workflow Studio","Build workflows"],"tags":["#build-workflows","#workflow-studio","#visual","#process-design","#flow-designer","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/build-workflows/workflow-studio/configuring-decision-builder.md"},
