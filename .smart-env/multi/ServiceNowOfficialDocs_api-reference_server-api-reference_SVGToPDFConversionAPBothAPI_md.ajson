6,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[42,44],[227,272],[283,287],[289,376],[419,432],[436,438],[549,592],[605,609]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/SVGToPDFConversionAPBothAPI.md"},
