ork on workflows#Copy a workflow between two application scopes#Procedure#{9}":[200,201],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{10}":[202,203],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{11}":[204,205],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{12}":[206,207],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{13}":[208,209],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{14}":[210,211],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{15}":[212,213],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{16}":[214,215],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{17}":[216,217],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{18}":[218,227],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{19}":[228,229],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{20}":[230,231],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{21}":[232,233],"#Work on workflows#Copy a workflow between two application scopes#Procedure#{22}":[234,236],"#Work on workflows#Copy a workflow between two application scopes#Result":[237,240],"#Work on workflows#Copy a workflow between two application scopes#Result#{1}":[239,240],"#Work on workflows#Related":[241,249],"#Work on workflows#Related#{1}":[243,243],"#Work on workflows#Related#{2}":[244,244],"#Work on workflows#Related#{3}":[245,245],"#Work on workflows#Related#{4}":[246,246],"#Work on workflows#Related#{5}":[247,247],"#Work on workflows#Related#{6}":[248,249]},"outlinks":[{"title":"workflow activities","target":"c_WorkflowActivities","line":23},{"title":"Workflow management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/managing-workflows.md","line":29},{"title":"Workflow activities","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/workflow-activities/c_WorkflowActivities.md","line":43},{"title":"Drag a workflow activity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/workflow-activities/t_AddAnActivityToAWorkflow.md","line":51},{"title":"workflow validation","target":"c_WorkflowValidation","line":58},{"title":"Workflow Editor","target":"workflow-editor","line":58},{"title":"workflow validator","target":"r_WorkflowValidator","line":72},{"title":"Workflow Versions","target":"c_WorkflowVersions","line":82},{"title":"Workflow validation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowValidation.md","line":93},{"title":"workflow contexts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/r_AdministeringWorkflowContexts.md","line":112},{"title":"version of the workflow","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowVersions.md","line":165},{"title":"created in your domain","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowsAndDomainSeparation.md","line":167},{"title":"Create a workflow","target":"t_CreateAWorkflow","line":192},{"title":"Create a workflow","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/t_CreateAWorkflow.md","line":194},{"title":"Workflow activities","target":"c_WorkflowActivities","line":243},{"title":"Workflow editor","target":"workflow-editor","line":244},{"title":"Workflow validation","target":"c_WorkflowValidation","line":245},{"title":"Workflow validator","target":"r_WorkflowValidator","line":246},{"title":"Workflow versions","target":"c_WorkflowVersions","line":247},{"title":"Create a workflow","target":"t_CreateAWorkflow","line":248}],"metadata":{"title":"Work on workflows","description":"To complete a workflow, you add workflow activities, validate the workflow, and publish it.Activities determine the functionality of the workflow.You can manually validate a workflow from the Workflow Editor. You can generate a workflow validation report from the Workflow Version form.When a workflow is complete, publish the workflow so that it is available to all users.A workflow can run only if a checked out version is available to the user who has it checked out, and a valid, published version is available for all users with permission to run it.You can edit a published workflow after you check it out.Application scoping protects applications by identifying and restricting access to application files and data. You can copy a workflow created in one application scope \\(for example, Test\\) to another \\(Production\\) as needed.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/legacy-workflow/work-on-workflows.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Workflow management","Classic Workflow","Build workflows"],"tags":["#build-workflows","#legacy-workflow","#classic","#deprecated","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/build-workflows/legacy-workflow/work-on-workflows.md"},
