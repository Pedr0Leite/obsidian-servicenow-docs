:"external credential storage","target":"c_ExternalCredentialStorage","line":102},{"title":"CyberArk","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/c_CyberArkCredStorageIntegrate.md","line":102},{"title":"External credential storage","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/c_ExternalCredentialStorage.md","line":102},{"title":"users","target":"users","line":126},{"title":"Authentication","target":"c_Authentication","line":201},{"title":"encryption","target":"encryption-landing","line":226},{"title":"External Credential Storage plugin","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/t_ActivateExtrnlCredStoragePlugIn.md","line":270},{"title":"External credential storage","target":"c_ExternalCredentialStorage","line":301},{"title":"Users","target":"users","line":302},{"title":"Authentication","target":"c_Authentication","line":303},{"title":"Encryption","target":"encryption-landing","line":304}],"metadata":{"title":"SNMP credentials","description":"Discovery explores many kinds of devices \\(switches, routers, printers, and so on\\) using the SNMP protocol. Credentials for SNMP don’t include a user name, just a password, called the community string.The SNMP Community credential type manages access to discover many kinds of devices \\(switches, routers, printers, etc.\\) using the SNMP protocol. This credential type is available for Discovery, Service Mapping, and Orchestration.SNMPv3 credentials accept a privacy protocol and an additional privacy key and are available for Discovery and Orchestration. For external storage in CyberArk, you can select a privacy account key.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/connections-and-credentials/c\\_SNMPCredentials.html","release":"australia","product":"Connections and Credentials","classification":"connections-and-credentials","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Create and test your credentials","Get started with credentials","Connections and Credentials","Access Management"],"tags":["#platform-security","#credentials","#connections","#aliases","#integration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-security/connections-and-credentials/c_SNMPCredentials.md"},
