meline categories for major security incidents":[118,155],"#Major Security Incident Management administration#Configure timeline categories for major security incidents#{1}":[120,121],"#Major Security Incident Management administration#Configure timeline categories for major security incidents#Before you begin":[122,125],"#Major Security Incident Management administration#Configure timeline categories for major security incidents#Before you begin#{1}":[124,125],"#Major Security Incident Management administration#Configure timeline categories for major security incidents#Procedure":[126,155],"#Major Security Incident Management administration#Configure timeline categories for major security incidents#Procedure#{1}":[128,129],"#Major Security Incident Management administration#Configure timeline categories for major security incidents#Procedure#{2}":[130,134],"#Major Security Incident Management administration#Configure timeline categories for major security incidents#Procedure#{3}":[135,144],"#Major Security Incident Management administration#Configure timeline categories for major security incidents#Procedure#{4}":[145,155],"#Major Security Incident Management administration#Set notification preferences for MSIM":[156,187],"#Major Security Incident Management administration#Set notification preferences for MSIM#{1}":[158,167],"#Major Security Incident Management administration#Set notification preferences for MSIM#{2}":[168,168],"#Major Security Incident Management administration#Set notification preferences for MSIM#{3}":[169,170],"#Major Security Incident Management administration#Set notification preferences for MSIM#{4}":[171,180],"#Major Security Incident Management administration#Set notification preferences for MSIM#{5}":[181,181],"#Major Security Incident Management administration#Set notification preferences for MSIM#{6}":[182,183],"#Major Security Incident Management administration#Set notification preferences for MSIM#{7}":[184,187],"#Major Security Incident Management administration#Configure MSI closure activities":[188,205],"#Major Security Incident Management administration#Configure MSI closure activities#{1}":[190,191],"#Major Security Incident Management administration#Configure MSI closure activities#Before you begin":[192,195],"#Major Security Incident Management administration#Configure MSI closure activities#Before you begin#{1}":[194,195],"#Major Security Incident Management administration#Configure MSI closure activities#Procedure":[196,205],"#Major Security Incident Management administration#Configure MSI closure activities#Procedure#{1}":[198,199],"#Major Security Incident Management administration#Configure MSI closure activities#Procedure#{2}":[200,201],"#Major Security Incident Management administration#Configure MSI closure activities#Procedure#{3}":[202,203],"#Major Security Incident Management administration#Configure MSI closure activities#Procedure#{4}":[204,205],"#Major Security Incident Management administration#Related":[206,212],"#Major Security Incident Management administration#Related#{1}":[208,208],"#Major Security Incident Management administration#Related#{2}":[209,209],"#Major Security Incident Management administration#Related#{3}":[210,210],"#Major Security Incident Management administration#Related#{4}":[211,212]},"outlinks":[{"title":"Major Security Incident Management","target":"major-security-incident-management-landing-page","line":24},{"title":"Major Security Incident Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/major-security-incident-management-landing-page.md","line":28},{"title":"Promote to Major Security Incident","target":"promote-to-major-security-incident","line":44},{"title":"Link to Major Security Incident","target":"link-si-msi","line":46},{"title":"Overview tab","target":"vr-va-ws-overview-tab","line":120},{"title":"Major Security Incident Management","target":"major-security-incident-management-landing-page","line":208},{"title":"Promote to Major Security Incident","target":"promote-to-major-security-incident","line":209},{"title":"Link to Major Security Incident","target":"link-si-msi","line":210},{"title":"Overview tab","target":"vr-va-ws-overview-tab","line":211}],"metadata":{"title":"Major Security Incident Management administration","description":"Plan and configure your Major Security Incident Management implementation.Enable users to decide to propose or promote incidents as major security incidents. Easily track all incidents related to a major security incident by enabling security incidents to be linked to the parent or child incident.Tag or label the security incidents or vulnerable records to a major security incident when the incident is proposed or promoted. If a security incident is proposed then the incident record is referred as major security incident candidate. When a security is promoted then the incident record is referred as Major Security Incident with state as Accepted.Configure labels in major security incident management to create custom labels and filter the external collaboration activities and tasks in the activity stream. The different types of implemented labels are State labels and timeline labels.Configure different types of labels to better filter and also indicate the incident states. Major security incident labels provide the flexibility to label the collaboration activities and tasks of the incident records.Configure and assign Timeline categories such as Threat, Response, or Custom to your major security incidents using the Timeline section on the Overview tab.Automate the email notification process and notify the users when a security incident is either proposed or promoted to a major security incident candidate.Establish actions that will occur automatically when a major security incident is closed. Increase security by automatically archiving and removing access to folders containing resolution information.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/configuring-msi-administration-settings.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Major Security Incident Management","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/security-incident-response/configuring-msi-administration-settings.md"},
