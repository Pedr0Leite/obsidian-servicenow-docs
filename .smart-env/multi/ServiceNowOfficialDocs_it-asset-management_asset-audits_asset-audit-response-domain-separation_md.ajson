onse#Related#{3}":[61,61],"#Domain separation and Asset Audit Response#Related#{4}":[62,62],"#Domain separation and Asset Audit Response#Related#{5}":[63,64]},"outlinks":[{"title":"Asset Audit Response","target":"asset-audit-response","line":24},{"title":"Application support for domain separation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-separated-apps.md","line":36},{"title":"Asset Governance Workspace","target":"asset-governance-workspace","line":46},{"title":"Audit Workspace","target":"audit-workspace","line":46},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":46},{"title":"Hardware Asset Management","target":"ham-landing-page","line":46},{"title":"Asset Audit Response reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/asset-audits/asset-audit-response-references.md","line":50},{"title":"Domain separation for service providers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-sep-landing-page.md","line":55},{"title":"Asset Audit Response","target":"asset-audit-response","line":59},{"title":"Audit Workspace","target":"audit-workspace","line":60},{"title":"Asset Governance Workspace","target":"asset-governance-workspace","line":61},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":62},{"title":"Hardware Asset Management","target":"ham-landing-page","line":63}],"metadata":{"title":"Domain separation and Asset Audit Response","description":"If any conkeyrefs are broken, re-add them from the doc/source/reuse/domain-separation/domain-separation-overview.dita file.In the short description, edit the first sentence to state whether domain separation is supported or not and add the application name. Keep the conkeyref at the end that describes domain separation.Domain separation is supported for Asset Audit Response. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/asset-audits/asset-audit-response-domain-separation.html","release":"australia","product":"Asset Audits","classification":"asset-audits","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Reference","Asset Audit Response","IT Asset Management"],"tags":["#it-asset-management","#asset-audit","#reconciliation","#hardware","#itam","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/asset-audits/asset-audit-response-domain-separation.md"},
