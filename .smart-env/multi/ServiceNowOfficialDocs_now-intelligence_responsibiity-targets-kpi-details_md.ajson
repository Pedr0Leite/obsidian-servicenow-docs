6}],"metadata":{"title":"Responsibility for indicator targets","description":"A user can be responsible for targets on one or more Performance Analytics indicator/breakdown combinations \\(KPIs\\). Responsible users are expected to track progress towards the targets and can change the targets on their KPIs.After an admin creates a target, assign responsibility for reviewing and editing the target to a subject matter expert \\(SME\\) in the business area.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/responsibiity-targets-kpi-details.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Targets and thresholds","KPI Details","Platform Analytics experience","Platform Analytics"],"tags":["#now-intelligence","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/responsibiity-targets-kpi-details.md"},
