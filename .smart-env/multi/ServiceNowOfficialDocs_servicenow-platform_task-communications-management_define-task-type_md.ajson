{"title":"Define a communication task","target":"create-comm-task-definition","line":58}],"metadata":{"title":"Create a task type","description":"Create the communication task type and specify whether the task is applicable to a particular table or is globally applicable. The communication task type helps you to filter a task by its type, generate a report of a particular task type, or create SLAs for any communication task.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/task-communications-management/define-task-type.html","release":"australia","product":"Task Communications Management","classification":"task-communications-management","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Working with Task Communications Management","Task Communications Management","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#task-comms","#email","#templates","#bulk","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/task-communications-management/define-task-type.md"},
