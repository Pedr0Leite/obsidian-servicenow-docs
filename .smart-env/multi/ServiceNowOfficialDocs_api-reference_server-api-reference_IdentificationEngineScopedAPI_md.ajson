rviceNow/ServiceNowDocs/australia/markdown/servicenow-platform/create-ire-data-source-rule.md","line":5347},{"title":"Enhanced IRE features","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/ire.md","line":5347},{"title":"Reconciliation Rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/create-reconciliation-rule.md","line":5781},{"title":"insert","target":"r_Insert","line":6515},{"title":"update","target":"r_Update","line":6516}],"metadata":{"title":"IdentificationEngine - Scoped","description":"The IdentificationEngine API uses the Identification and Reconciliation framework to minimize the creation of duplicate configuration items \\(CIs\\) and to reconcile CI attributes by only accepting information from authorized data sources when updating the Configuration Management Database \\(CMDB\\).Inserts or updates configuration items \\(CI\\) and non-Configuration Management Database \\(CMDB\\) CIs \\(classes not extending from cmdb\\_ci\\) in the CMDB based on identification and reconciliation rules. Use this API instead of updating the CMDB directly.Inserts or updates configuration items \\(CI\\) and non-Configuration Management Database \\(CMDB\\) CIs \\(classes not extending from cmdb\\_ci\\) in the CMDB based on identification and reconciliation rules. Use this API instead of updating the CMDB directly.Determines the operation \\(insert/update\\) to perform with the specified payload without committing the operation in the database.Determines the Configuration Management Database \\(CMDB\\) operation \\(insert/update\\) to perform with the specified payload \\(request body\\), without committing the operations in the database.Runs an identification audit against the specified configuration item \\(CI\\) to detect duplicates.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/IdentificationEngineScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":70,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[64,89],[115,120],[146,155],[198,260],[268,282],[291,334],[396,404],[423,510],[572,580],[600,652],[661,665],[674,737],[742,833],[850,862],[871,889],[896,968],[975,1001],[1011,1038],[1043,1087],[1095,1151],[1162,1180],[1187,1205],[1212,1270],[1280,1333],[1350,1354],[1419,1423],[1510,1514],[1708,1712],[1729,1733],[1844,1848],[1862,1866],[1972,2017],[2042,2068],[2073,2099],[2108,2151],[2213,2221],[2235,2244],[2287,2349],[2357,2376],[2463,2525],[2533,2553],[2605,2614],[2618,2627],[2690,2695],[2745,2754],[2887,2897],[2907,2920],[2946,2953],[2979,2989],[3016,3021],[3033,3038],[3072,3078],[3088,3090],[3100,3104],[3142,3149],[3175,3185],[3213,3220],[3246,3250],[3260,3262],[3272,3276],[3318,3339],[3349,3359],[3441,3448],[3474,3484],[3511,3516],[3528,3533],[3577,3585],[3667,3683],[3701,3708],[3750,3757],[3834,3841],[3883,3896],[3924,3931],[4013,4025],[4102,4195],[4199,4330],[4417,4434],[4438,4503],[4547,4572],[4598,4603],[4629,4638],[4681,4743],[4751,4765],[4774,4817],[4879,4887],[4906,4993],[5055,5063],[5083,5135],[5144,5148],[5157,5220],[5225,5275],[5284,5417],[5427,5437],[5450,5460],[5470,5496],[5514,5524],[5534,5616],[5623,5649],[5659,5686],[5691,5727],[5735,5809],[5823,5849],[5856,5882],[5889,5958],[5965,5991],[6002,6030],[6037,6087],[6099,6279],[6283,6488],[6506,6511]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/IdentificationEngineScopedAPI.md"},
