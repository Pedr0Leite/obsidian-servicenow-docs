)#{15}":[283,284],"#BusinessServiceManager- Global#BusinessServiceManager - isReadingPermitted\\(Object gr, String userSysID\\)#{16}":[285,302],"#BusinessServiceManager- Global#BusinessServiceManager - migrateManualToApplicationService\\(String service\\_id\\)":[303,319],"#BusinessServiceManager- Global#BusinessServiceManager - migrateManualToApplicationService\\(String service\\_id\\)#{1}":[305,319],"#BusinessServiceManager- Global#BusinessServiceManager - populateApplicationService\\(String service\\_id, Number levels, String black\\_listed\\_relation\\_types\\)":[320,338],"#BusinessServiceManager- Global#BusinessServiceManager - populateApplicationService\\(String service\\_id, Number levels, String black\\_listed\\_relation\\_types\\)#{1}":[322,338],"#BusinessServiceManager- Global#BusinessServiceManager - removeCI\\(String service\\_id, String target\\_id\\)":[339,392],"#BusinessServiceManager- Global#BusinessServiceManager - removeCI\\(String service\\_id, String target\\_id\\)#{1}":[341,392],"#BusinessServiceManager- Global#BusinessServiceManager - removeEntryPoint\\(serviceId, endpointSysId\\)":[393,439],"#BusinessServiceManager- Global#BusinessServiceManager - removeEntryPoint\\(serviceId, endpointSysId\\)#{1}":[395,419],"#BusinessServiceManager- Global#BusinessServiceManager - removeEntryPoint\\(serviceId, endpointSysId\\)#{2}":[420,420],"#BusinessServiceManager- Global#BusinessServiceManager - removeEntryPoint\\(serviceId, endpointSysId\\)#{3}":[421,422],"#BusinessServiceManager- Global#BusinessServiceManager - removeEntryPoint\\(serviceId, endpointSysId\\)#{4}":[423,439],"#BusinessServiceManager- Global#BusinessServiceManager - removeManualConnection\\(String source\\_id, String endpoint\\_id, String service\\_id\\)":[440,458],"#BusinessServiceManager- Global#BusinessServiceManager - removeManualConnection\\(String source\\_id, String endpoint\\_id, String service\\_id\\)#{1}":[442,458],"#BusinessServiceManager- Global#BusinessServiceManager - updateEntryPoint\\(serviceId, endpointGr\\)":[459,507],"#BusinessServiceManager- Global#BusinessServiceManager - updateEntryPoint\\(serviceId, endpointGr\\)#{1}":[461,485],"#BusinessServiceManager- Global#BusinessServiceManager - updateEntryPoint\\(serviceId, endpointGr\\)#{2}":[486,486],"#BusinessServiceManager- Global#BusinessServiceManager - updateEntryPoint\\(serviceId, endpointGr\\)#{3}":[487,488],"#BusinessServiceManager- Global#BusinessServiceManager - updateEntryPoint\\(serviceId, endpointGr\\)#{4}":[489,507],"#BusinessServiceManager- Global#Related":[508,512],"#BusinessServiceManager- Global#Related#{1}":[510,510],"#BusinessServiceManager- Global#Related#{2}":[511,512]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28},{"title":"insert","target":"r_Insert","line":122},{"title":"Assign a role to a service group","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/t_EMAssignRoleSvcGroup.md","line":216},{"title":"Assign a role to a service group","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/t_EMAssignRoleSvcGroup.md","line":222},{"title":"update","target":"r_Update","line":420},{"title":"insert","target":"r_Insert","line":510},{"title":"update","target":"r_Update","line":511}],"metadata":{"title":"BusinessServiceManager - Global","description":"The BusinessServiceManager API provides methods that unify service management by converting manually-created services to application services, populating application services, and adding/removing configuration items and connections.Instantiates a BusinessServiceManager object.Adds a CI to a manually-created application service.Adds an entry point to the application service and starts discovery on the entry point.Adds a new entry point without starting discovery.Adds a manually created connection to an application service.Checks the roles of a specified user and the permissions data configured for a specified service/service group and returns a Boolean value that indicates whether the user can view the service/service group.Converts a manual service to an application service.Populates an application service with relations and CIs from the designated entry point.Removes a manually created CI from an application service.Removes an existing entry point from the application service.Removes a manually created connection and the connected CI from an application service.Updates an existing entry point in the application service.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/BusinessServiceManagerAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[38,40],[56,63],[75,82],[117,127],[131,133],[168,178],[182,184],[200,208],[288,301],[315,318],[334,337],[388,391],[426,432],[436,438],[454,457],[492,500],[504,506]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/BusinessServiceManagerAPI.md"},
