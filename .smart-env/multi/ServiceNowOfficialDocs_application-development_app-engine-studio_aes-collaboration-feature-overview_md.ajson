er developers#Related":[370,380],"#Collaborate with other developers#Related#{1}":[372,372],"#Collaborate with other developers#Related#{2}":[373,373],"#Collaborate with other developers#Related#{3}":[374,374],"#Collaborate with other developers#Related#{4}":[375,375],"#Collaborate with other developers#Related#{5}":[376,376],"#Collaborate with other developers#Related#{6}":[377,377],"#Collaborate with other developers#Related#{7}":[378,378],"#Collaborate with other developers#Related#{8}":[379,380]},"outlinks":[{"title":"delegated development","target":"delegated-development-landing","line":38},{"title":"Elevated privilege roles","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_ElevatedPrivilege.md","line":95},{"title":"global scope","target":"c_GlobalScope","line":108},{"title":"Building apps in App Engine Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/app-engine-studio/aes-app-creation.md","line":121},{"title":"collaboration permissions","target":"collaboration-permissions","line":149},{"title":"Delegated development and collaboration permissions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/app-engine-studio/aes-collaboration-feature-overview.md","line":149},{"title":"Configure your controller instance","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/app-engine-management-center/config-controller-instance.md","line":159},{"title":"Delegated development and collaboration permissions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/app-engine-studio/aes-collaboration-feature-overview.md","line":188},{"title":"Delegate development and deployment permissions to personnel","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/delegated-development-and-deployment/t_AddADeveloper.md","line":190},{"title":"UI Builder","target":"ui-builder-overview","line":245},{"title":"Flow Designer","target":"flow-designer","line":297},{"title":"Decision Tables","target":"decision-table","line":301},{"title":"Notifications","target":"notifications","line":309},{"title":"deployment","target":"get-started-deployment","line":337},{"title":"Delegated Development","target":"delegated-development-landing","line":372},{"title":"Global scope","target":"c_GlobalScope","line":373},{"title":"Collaboration permissions","target":"collaboration-permissions","line":374},{"title":"UI Builder","target":"ui-builder-overview","line":375},{"title":"Flow Designer","target":"flow-designer","line":376},{"title":"Decision Tables","target":"decision-table","line":377},{"title":"Notifications","target":"notifications","line":378},{"title":"Deployment","target":"get-started-deployment","line":379}],"metadata":{"title":"Collaborate with other developers","description":"In App Engine Studio \\(AES\\), you can add or remove users and groups to be collaborators on an application.Give users or groups permission to collaborate with other developers in App Engine Studio \\(AES\\) using the Collaboration feature.Change the permissions that are assigned to a collaborator or create a custom collaboration permission to enable what people can do in App Engine Studio \\(AES\\).Collaboration permissions define what users can do in App Engine Studio \\(AES\\).Remove users and groups from collaboration to restrict them from owning or editing an app.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/app-engine-studio/aes-collaboration-feature-overview.html","release":"australia","product":"App Engine Studio","classification":"app-engine-studio","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Build","App Engine Studio","Building low-code applications","Developing your application","Building applications"],"tags":["#application-development","#aes","#low-code","#app-builder","#drag-and-drop","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/application-development/app-engine-studio/aes-collaboration-feature-overview.md"},
