e for indexing and searching#Related#{3}":[240,240],"#Configure a table for indexing and searching#Related#{4}":[241,241],"#Configure a table for indexing and searching#Related#{5}":[242,242],"#Configure a table for indexing and searching#Related#{6}":[243,244]},"outlinks":[{"title":"stop words","target":"stop-words-ais","line":24},{"title":"Remove the text index for a child table","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/remove-index-child-table.md","line":42},{"title":"results","target":"hs-results","line":46},{"title":"view historical text indexing statistics","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/r_ViewTextIndexingStatsAndStatus.md","line":46},{"title":"Configurations","target":"clone-configurations-tab","line":56},{"title":"5","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/configure-single-table-for-indexing.md","line":64},{"title":"Zing index and search attributes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/index-attributes.md","line":91},{"title":"Zing index and search attributes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/index-attributes.md","line":109},{"title":"parameters","target":"r_DirectJDBCProbeParameters","line":115},{"title":"synonyms","target":"synonyms-ais","line":131},{"title":"Create synonym dictionaries","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/create-synonym-dictionaries.md","line":139},{"title":"List search finds records from the current table","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/c_TextSearchesInRecordLists.md","line":148},{"title":"Querying tables in script","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_UsingGlideRecordToQueryTables.md","line":150},{"title":"Zing indexes words","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/zing-indexes-words.md","line":152},{"title":"Field types reference","target":"r_FieldTypes","line":215},{"title":"Remove an index for a specific field","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/search-administration/t_RemoveAnIndexForASpecificField.md","line":223},{"title":"Encrypt fields using encryption configurations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_ConfigureCloudEdge.md","line":231},{"title":"Field types reference","target":"r_FieldTypes","line":238},{"title":"Stop words","target":"stop-words-ais","line":239},{"title":"Results","target":"hs-results","line":240},{"title":"Configurations","target":"clone-configurations-tab","line":241},{"title":"Parameters","target":"r_DirectJDBCProbeParameters","line":242},{"title":"Synonyms","target":"synonyms-ais","line":243}],"metadata":{"title":"Configure a table for indexing and searching","description":"Enable Zing text indexing for a table to allow users to search its records for string values. Configure the table's text indexing attributes, stop words, and synonym dictionaries to control search behavior.Text indexing excludes fields that meet certain name, type, attribute, or encryption conditions. User searches don't match or return values from excluded fields.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/search-administration/configure-single-table-for-indexing.html","release":"australia","product":"Search Administration","classification":"search-administration","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Zing indexes words","Zing text indexing and search engine","Search administration","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#search","#index","#administration","#solr","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/search-administration/configure-single-table-for-indexing.md"},
