sercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/proactive-analytics/proactive-analytics.md","line":36},{"title":"Create a target in KPI Details","target":"create-kpi-details-targets","line":58},{"title":"Create a target in KPI Details","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/create-kpi-details-targets.md","line":62},{"title":"Edit multiple targets in KPI Details","target":"edit-multiple-targets","line":64},{"title":"Subscribe users to Data snapshots indicator target","target":"subscribe-users-to-ds-target","line":66},{"title":"Create, modify, or delete a threshold in KPI Details","target":"add-mod-pers-tar-thresh-kpi-details","line":68},{"title":"Add a target to multiple breakdown elements in KPI Details","target":"add-multiple-targets","line":70},{"title":"Responsibility for indicator targets","target":"responsibiity-targets-kpi-details","line":72},{"title":"KPI Details","target":"kpi-details","line":75},{"title":"Performance Analytics \\(Indicator data sources\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown","line":86},{"title":"Performance Analytics targets and thresholds","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/pa-targets-thresholds.md","line":88},{"title":"Create a target in KPI Details","target":"create-kpi-details-targets","line":92},{"title":"Edit multiple targets in KPI Details","target":"edit-multiple-targets","line":93},{"title":"Subscribe users to Data snapshots indicator target","target":"subscribe-users-to-ds-target","line":94},{"title":"Create, modify, or delete a threshold in KPI Details","target":"add-mod-pers-tar-thresh-kpi-details","line":95},{"title":"Add a target to multiple breakdown elements in KPI Details","target":"add-multiple-targets","line":96},{"title":"Responsibility for indicator targets","target":"responsibiity-targets-kpi-details","line":97},{"title":"KPI Details","target":"kpi-details","line":98}],"metadata":{"title":"Indicator targets and thresholds in KPI Details","description":"Targets are goals your organization wants to achieve. They show the difference between the desired and actual scores of an indicator on a certain date. Thresholds define a normal range of scores for an indicator and alert you when certain events occurs, like when a score reaches an all-time high.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/kpi-details-targets.html","release":"australia","topic_type":"concept","last_updated":"2023-08-03","reading_time_minutes":6,"breadcrumb":["KPI Details","Platform Analytics experience","Platform Analytics"],"tags":["#now-intelligence","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/kpi-details-targets.md"},
