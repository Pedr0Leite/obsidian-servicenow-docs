product offerings","target":"som-create-product-offering","line":94},{"title":"Create multiple configurations","target":"create-multiple-child-configs","line":95},{"title":"Using product catalogs","target":"using-product-catalog","line":96},{"title":"Product Catalog Management","target":"product-catalog-managment","line":97},{"title":"Configurable products","target":"configurable-products-explore","line":98},{"title":"Rules","target":"rules_101","line":99},{"title":"Modify","target":"Modify","line":100}],"metadata":{"title":"Multiple configurations","description":"As a product catalog manager, when you define a configurable product offering, you can enable agents to add multiple configurations of a child product offering. When agents add multiple configurations, they can change the quantity for each configuration of the offering, define each configuration as a separate line item, and select the appropriate options and characteristics for each configuration.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/order-management/multiple-child-offering-configurations.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Create product offerings","Configuring product offerings and catalogs","Lead-to-cash foundation apps","Configure","Sales Customer Relationship Management"],"tags":["#order-management","#fulfillment","#catalog","#orchestration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/order-management/multiple-child-offering-configurations.md"},
