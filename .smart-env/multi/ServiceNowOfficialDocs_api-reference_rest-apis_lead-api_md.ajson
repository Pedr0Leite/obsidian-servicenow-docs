plorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":2838},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":3465},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":3478},{"title":"Scripted REST Service form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":4805},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":4805},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":5436},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":5448},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":6730},{"title":"Script includes","target":"c_ScriptIncludes","line":6731},{"title":"REST APIs","target":"c_RESTAPI","line":6732},{"title":"insert","target":"r_Insert","line":6733},{"title":"update","target":"r_Update","line":6734}],"metadata":{"title":"lead API","description":"The lead API provides endpoints that enable you to create, update, and query/retrieve marketing leads and their associated lead line items from an instance.Retrieves all leads and associated lead line items based on the filter criteria passed in the query parameters.Returns the lead record and all associated lead line items for the specified sys\\_id.Updates the specified lead record and its associated lead line items. You can also use this endpoint to associate new lead line items to the specified lead.Creates a lead record and its associated lead line items using the specified parameters.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/lead-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":64,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[284,289],[335,340],[378,383],[413,418],[555,560],[588,610],[636,641],[675,681],[739,744],[826,831],[863,868],[898,906],[1018,1023],[1073,1078],[1150,1155],[1239,1244],[1292,1300],[1339,1344],[1348,1551],[1648,1653],[1699,1704],[1742,1747],[1777,1782],[1919,1924],[1952,1974],[2000,2005],[2039,2045],[2103,2108],[2190,2195],[2227,2232],[2262,2270],[2382,2387],[2437,2442],[2514,2519],[2603,2608],[2656,2664],[2703,2708],[2712,2810],[2889,2893],[2939,2943],[2965,2969],[3098,3102],[3124,3135],[3163,3167],[3201,3205],[3227,3232],[3320,3324],[3366,3370],[3436,3442],[3551,3556],[3602,3607],[3645,3650],[3680,3685],[3822,3827],[3855,3877],[3903,3908],[3942,3948],[4006,4011],[4093,4098],[4130,4135],[4165,4173],[4285,4290],[4340,4345],[4417,4422],[4506,4511],[4559,4567],[4606,4637],[4641,4779],[4846,4850],[4896,4900],[4922,4926],[5061,5065],[5087,5098],[5126,5130],[5166,5170],[5192,5197],[5287,5291],[5333,5337],[5405,5411],[5512,5517],[5563,5568],[5606,5611],[5641,5646],[5783,5788],[5816,5838],[5864,5869],[5903,5909],[5967,5972],[6054,6059],[6091,6096],[6126,6134],[6246,6251],[6301,6306],[6378,6383],[6467,6472],[6520,6528],[6567,6616],[6620,6726]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/lead-api.md"},
