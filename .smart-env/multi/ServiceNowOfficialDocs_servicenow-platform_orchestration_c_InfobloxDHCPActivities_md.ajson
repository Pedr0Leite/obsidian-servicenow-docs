tivities#DHCP Delete IP Reservation activity#Input variables#{1}":[126,173],"#Infoblox DHCP activities#DHCP Delete IP Reservation activity#Conditions":[174,180],"#Infoblox DHCP activities#DHCP Delete IP Reservation activity#Conditions#{1}":[176,180],"#Infoblox DHCP activities#DHCP List IP Reservations activity":[181,246],"#Infoblox DHCP activities#DHCP List IP Reservations activity#{1}":[183,188],"#Infoblox DHCP activities#DHCP List IP Reservations activity#Input variables":[189,239],"#Infoblox DHCP activities#DHCP List IP Reservations activity#Input variables#{1}":[191,239],"#Infoblox DHCP activities#DHCP List IP Reservations activity#Conditions":[240,246],"#Infoblox DHCP activities#DHCP List IP Reservations activity#Conditions#{1}":[242,246],"#Infoblox DHCP activities#Related":[247,253],"#Infoblox DHCP activities#Related#{1}":[249,249],"#Infoblox DHCP activities#Related#{2}":[250,250],"#Infoblox DHCP activities#Related#{3}":[251,251],"#Infoblox DHCP activities#Related#{4}":[252,253]},"outlinks":[{"title":"Infoblox DDI activity pack","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_InfobloxDDIActivityPack.md","line":28},{"title":"IP address","target":"ip-address","line":32},{"title":"DHCP Reserve IP v4 Address Range activity","target":"r_DHCPReserveIPv4AddrRangeActivity-1","line":32},{"title":"REST web service activity template","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateARESTWebServiceActivity.md","line":34},{"title":"MID Server","target":"mid-server-landing","line":34},{"title":"Workflow Editor","target":"workflow-editor","line":36},{"title":"DHCP List IP Reservations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_InfobloxDHCPActivities.md","line":117},{"title":"DHCP Reserve IPv4 Address Range","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_InfobloxDHCPActivities.md","line":118},{"title":"REST web service activity template","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateARESTWebServiceActivity.md","line":120},{"title":"REST web service activity template","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateARESTWebServiceActivity.md","line":185},{"title":"DHCP Reserve IP v4 Address Range activity","target":"r_DHCPReserveIPv4AddrRangeActivity-1","line":249},{"title":"IP Address","target":"ip-address","line":250},{"title":"MID Server","target":"mid-server-landing","line":251},{"title":"Workflow editor","target":"workflow-editor","line":252}],"metadata":{"title":"Infoblox DHCP activities","description":"The Infoblox DHCP activities manage the IP addresses reserved for DHCP in your network.The DHCP Reserve IP v4 Address Range activity reserves an IP address range for DHCP use.The DHCP Delete IP Reservation activity deletes IP reservations in DHCP using either an IPv4 or IPv6 address range.The DHCP List IP Reservations activity generates a list of all the DHCP range reservations on a specific InfoBlox server.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/orchestration/c\\_InfobloxDHCPActivities.html","release":"australia","product":"Orchestration","classification":"orchestration","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Infoblox DDI activity pack","Orchestration activity packs","Classic Orchestration","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#orchestration","#itpa","#automation","#runbooks","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/orchestration/c_InfobloxDHCPActivities.md"},
