ervable enrichment in MISP#Add comments to MISP attribute":[425,451],"#Observable enrichment in MISP#Add comments to MISP attribute#{1}":[427,428],"#Observable enrichment in MISP#Add comments to MISP attribute#Before you begin":[429,434],"#Observable enrichment in MISP#Add comments to MISP attribute#Before you begin#{1}":[431,431],"#Observable enrichment in MISP#Add comments to MISP attribute#Before you begin#{2}":[432,432],"#Observable enrichment in MISP#Add comments to MISP attribute#Before you begin#{3}":[433,434],"#Observable enrichment in MISP#Add comments to MISP attribute#Procedure":[435,447],"#Observable enrichment in MISP#Add comments to MISP attribute#Procedure#{1}":[437,438],"#Observable enrichment in MISP#Add comments to MISP attribute#Procedure#{2}":[439,440],"#Observable enrichment in MISP#Add comments to MISP attribute#Procedure#{3}":[441,442],"#Observable enrichment in MISP#Add comments to MISP attribute#Procedure#{4}":[443,444],"#Observable enrichment in MISP#Add comments to MISP attribute#Procedure#{5}":[445,447],"#Observable enrichment in MISP#Add comments to MISP attribute#Result":[448,451],"#Observable enrichment in MISP#Add comments to MISP attribute#Result#{1}":[450,451],"#Observable enrichment in MISP#Related":[452,462],"#Observable enrichment in MISP#Related#{1}":[454,454],"#Observable enrichment in MISP#Related#{2}":[455,455],"#Observable enrichment in MISP#Related#{3}":[456,456],"#Observable enrichment in MISP#Related#{4}":[457,457],"#Observable enrichment in MISP#Related#{5}":[458,458],"#Observable enrichment in MISP#Related#{6}":[459,459],"#Observable enrichment in MISP#Related#{7}":[460,460],"#Observable enrichment in MISP#Related#{8}":[461,462]},"outlinks":[{"title":"observables","target":"c_Observables","line":18},{"title":"Using MISP to investigate and analyze threats","target":"using-misp-to-detect-and-analyze-threats","line":20},{"title":"observable enrichment","target":"tisc-observable-enrichment","line":24},{"title":"Security Incident Response","target":"sir-landing-page","line":28},{"title":"Security Operations Integration - Enrich Observable flow","target":"secops-integration-enrich-observ-wf","line":39},{"title":"related list configuration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/sir-new-ui-setup-form-uiaction.md","line":47},{"title":"MISP documentation","target":"https://www.circl.lu/doc/misp/categories-and-types/#categories","line":93},{"title":"MISP documentation","target":"https://www.circl.lu/doc/misp/categories-and-types/#types","line":101},{"title":"Review the MISP user role and permissions","target":"misp-user-roles-and-permissions","line":175},{"title":"Run Observable Enrichment","target":"tisc-run-observable-enrichment","line":186},{"title":"Security Operations Integration - Enrich Observable workflow","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/secops-integration-enrich-observ-wf.md","line":196},{"title":"Review the MISP user role and permissions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/misp-user-roles-and-permissions.md","line":211},{"title":"MISP Event Data","target":"misp-event-data","line":254},{"title":"Review the MISP user role and permissions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/misp-user-roles-and-permissions.md","line":394},{"title":"Review the MISP user role and permissions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/misp-user-roles-and-permissions.md","line":431},{"title":"Using MISP to investigate and analyze threats","target":"using-misp-to-detect-and-analyze-threats","line":454},{"title":"Security Operations Integration - Enrich Observable flow","target":"secops-integration-enrich-observ-wf","line":455},{"title":"MISP user roles and permissions","target":"misp-user-roles-and-permissions","line":456},{"title":"Observables","target":"c_Observables","line":457},{"title":"Observable Enrichment","target":"tisc-observable-enrichment","line":458},{"title":"Security Incident Response","target":"sir-landing-page","line":459},{"title":"Run Observable Enrichment","target":"tisc-run-observable-enrichment","line":460},{"title":"MISP event data","target":"misp-event-data","line":461}],"metadata":{"title":"Observable enrichment in MISP","description":"By enriching observables with additional information from various MISP sources during incident response investigations, you can contain identified threats.Enable automatic observable enrichment in the ServiceNow AI Platform MISP when new observables are associated with the security incident.Select individual or multiple observables and perform a manual observable enrichment so that you can enrich observables with additional information from various MISP sources.Add or remove tags in MISP to classify events or attributes. You can use tagging globally to enable your classification or use tags locally when you don't want MISP events to be modified during your classification.Add or remove galaxies in MISP so that you can classify these objects as a cluster in MISP and attach them to MISP events or attributes.Add comments for the MISP attributes. The comments that you add are for informational purposes only and are not used for correlation of MISP data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/observable-enrichment-in-misp.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["Using MISP to investigate and analyze threats","MISP integration for Security Operations","Threat Intelligence integrations","Threat Intelligence","Enterprise security case management applications","Security Operations"],"tags":["#security-management"