dar weeks#Before you begin":[186,189],"#Modifying and adding calendar report system properties#Customize calendar weeks#Before you begin#{1}":[188,189],"#Modifying and adding calendar report system properties#Customize calendar weeks#Procedure":[190,235],"#Modifying and adding calendar report system properties#Customize calendar weeks#Procedure#{1}":[192,193],"#Modifying and adding calendar report system properties#Customize calendar weeks#Procedure#{2}":[194,195],"#Modifying and adding calendar report system properties#Customize calendar weeks#Procedure#{3}":[196,197],"#Modifying and adding calendar report system properties#Customize calendar weeks#Procedure#{4}":[198,199],"#Modifying and adding calendar report system properties#Customize calendar weeks#Procedure#{5}":[200,235],"#Modifying and adding calendar report system properties#Set calendar record limit":[236,290],"#Modifying and adding calendar report system properties#Set calendar record limit#{1}":[238,239],"#Modifying and adding calendar report system properties#Set calendar record limit#Before you begin":[240,243],"#Modifying and adding calendar report system properties#Set calendar record limit#Before you begin#{1}":[242,243],"#Modifying and adding calendar report system properties#Set calendar record limit#Procedure":[244,290],"#Modifying and adding calendar report system properties#Set calendar record limit#Procedure#{1}":[246,247],"#Modifying and adding calendar report system properties#Set calendar record limit#Procedure#{2}":[248,249],"#Modifying and adding calendar report system properties#Set calendar record limit#Procedure#{3}":[250,290],"#Modifying and adding calendar report system properties#Related":[291,296],"#Modifying and adding calendar report system properties#Related#{1}":[293,293],"#Modifying and adding calendar report system properties#Related#{2}":[294,294],"#Modifying and adding calendar report system properties#Related#{3}":[295,296]},"outlinks":[{"title":"calendar reports","target":"c_CalendarReport","line":28},{"title":"report sources","target":"c_ReportSources","line":28},{"title":"Platform Analytics experience","target":"par-workspace","line":38},{"title":"collect scores","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/c_ClctData.md","line":101},{"title":"Customize calendar weeks","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/reporting/modify-add-calendar-sys-props.md","line":173},{"title":"Calendar reports","target":"c_CalendarReport","line":293},{"title":"Report sources","target":"c_ReportSources","line":294},{"title":"Platform Analytics experience","target":"par-workspace","line":295}],"metadata":{"title":"Modifying and adding calendar report system properties","description":"Specify system property values to override Task table highlighting in calendar events, limit the number of events in a calendar cell, or change the day the calendar week starts.Highlighting for calendar report events is configured with field styles, which are defined for a particular table. You can configure whether calendar reports use field styles from the tables or report sources that they are based on.In calendar reports, you can configure the maximum number of events that appear in some calendar views.By default, weeks for calendar reports start on Sunday. You can add a system property to start weeks on Sunday or another day instead.Configure a system property to specify how calendar week numbers are determined.By default, calendar reports save up to 10,000 records. Change this limit by setting the glide.ui.max\\_calendar\\_records system property. If the number of records fetched exceeds this limit, you are prompted to filter the data and run the report again.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/reporting/modify-add-calendar-sys-props.html","release":"australia","product":"Reporting","classification":"reporting","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Customize calendar reports","Administering reports","Reporting","Reporting","dashboards","and Performance Analytics in the Core UI","Platform Analytics"],"tags":["#now-intelligence","#reports","#builder","#scheduling","#analytics","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/reporting/modify-add-calendar-sys-props.md"},
