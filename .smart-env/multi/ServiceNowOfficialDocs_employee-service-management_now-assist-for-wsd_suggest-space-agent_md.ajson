et":"reservation-portal","line":67}],"metadata":{"title":"Using the workplace collaboration Agent for space suggestions","description":"The Workplace Collaboration Agent provides insights on your team members in-office attendance. Based on this information, the reservation agent finds and reserves a space for reservation and collaboration. The collaboration agent considers your colleague's in-office days, location, and suggests a space for collaboration when you are in office.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/now-assist-for-wsd/suggest-space-agent.html","release":"australia","product":"Now Assist for WSD","classification":"now-assist-for-wsd","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Using Now Assist in Virtual Agent","Now Assist for Workplace Service Delivery \\(WSD\\)","Workplace Service Delivery","Employee Service Management"],"tags":["#employee-service-management","#now-assist","#ai","#workplace","#generative","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/now-assist-for-wsd/suggest-space-agent.md"},
