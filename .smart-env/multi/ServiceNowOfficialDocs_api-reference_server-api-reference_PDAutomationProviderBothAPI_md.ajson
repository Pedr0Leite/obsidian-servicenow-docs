r_Insert","line":780}],"metadata":{"title":"PDAutomationProvider - Scoped, Global","description":"The PDAutomationProvider API enables inserting an optional activity into a process while it's executing.Activates a playbook.Adds a specified optional activity to a process to be run relative to another activity during process execution.Assigns an optional activity to a lane to run during that lane's execution context.Deactivates a playbook.Duplicates a playbook.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/PDAutomationProviderBothAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[95,113],[120,143],[151,198],[201,205],[218,330],[339,343],[346,457],[466,470],[473,524],[542,549],[620,622],[626,628],[727,767],[769,773]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/PDAutomationProviderBothAPI.md"},
