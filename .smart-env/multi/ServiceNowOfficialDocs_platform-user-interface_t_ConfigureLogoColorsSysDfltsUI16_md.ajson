":185},{"title":"Customizing instance appearance","target":"customizing-instance-appearance","line":315},{"title":"Working with themes in Next Experience","target":"next-experience-theming","line":508},{"title":"Customizing instance appearance","target":"customizing-instance-appearance","line":509},{"title":"Core UI","target":"c_UI16","line":510},{"title":"Configure","target":"configure-onboarding-modals","line":511},{"title":"User preferences","target":"c_UserPreferences","line":512},{"title":"Lists","target":"lists-configurable-workspace","line":513},{"title":"Core UI application navigator","target":"c_UI16ApplicationNavigator","line":514}],"metadata":{"title":"Configure logo, colors, and system defaults for Core UI","description":"You can use the Basic Configuration Core UI module to brand your instance with your company logo and colors and set basic system defaults. This place is the best starting point if you are setting up your instance for the first time or if you have recently enabled Core UI.The La Jolla theme is the new brand theme for ServiceNow. When you upgrade to Madrid, your theme is automatically upgraded to the La Jolla theme. Any customizations you have made to the system theme will not be upgraded. Use the styles in the list below to upgrade or revert any styles to the new or old theme.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-user-interface/t\\_ConfigureLogoColorsSysDfltsUI16.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Customizing instance appearance","User interface configuration","Working in Core UI","Configure UIs and portals","Configure user experiences"],"tags":["#platform-user-interface","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-user-interface/t_ConfigureLogoColorsSysDfltsUI16.md"},
