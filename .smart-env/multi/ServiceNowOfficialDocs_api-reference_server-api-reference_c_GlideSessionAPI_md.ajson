ame\\(\\)":[144,171],"#GlideSession- Global#GlideSession - getTimeZoneName\\(\\)#{1}":[146,167],"#GlideSession- Global#GlideSession - getTimeZoneName\\(\\)#Scoped equivalent":[168,171],"#GlideSession- Global#GlideSession - getTimeZoneName\\(\\)#Scoped equivalent#{1}":[170,171],"#GlideSession- Global#GlideSession - isInteractive\\(\\)":[172,202],"#GlideSession- Global#GlideSession - isInteractive\\(\\)#{1}":[174,198],"#GlideSession- Global#GlideSession - isInteractive\\(\\)#Scoped equivalent":[199,202],"#GlideSession- Global#GlideSession - isInteractive\\(\\)#Scoped equivalent#{1}":[201,202],"#GlideSession- Global#GlideSession - isLoggedIn\\(\\)":[203,230],"#GlideSession- Global#GlideSession - isLoggedIn\\(\\)#{1}":[205,226],"#GlideSession- Global#GlideSession - isLoggedIn\\(\\)#Scoped equivalent":[227,230],"#GlideSession- Global#GlideSession - isLoggedIn\\(\\)#Scoped equivalent#{1}":[229,230],"#GlideSession- Global#GlideSession - putClientData\\(String paramName, String paramValue\\)":[231,261],"#GlideSession- Global#GlideSession - putClientData\\(String paramName, String paramValue\\)#{1}":[233,256],"#GlideSession- Global#GlideSession - putClientData\\(String paramName, String paramValue\\)#Scoped equivalent":[257,261],"#GlideSession- Global#GlideSession - putClientData\\(String paramName, String paramValue\\)#Scoped equivalent#{1}":[259,261]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":26},{"title":"getClientData\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideSessionScopedAPI.md","line":90},{"title":"getLanguage\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideSessionScopedAPI.md","line":118},{"title":"getTimeZoneName\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideSessionScopedAPI.md","line":170},{"title":"isInteractive\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideSessionScopedAPI.md","line":201},{"title":"isLoggedIn\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideSessionScopedAPI.md","line":229},{"title":"putClientData\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideSessionScopedAPI.md","line":259}],"metadata":{"title":"GlideSession - Global","description":"The GlideSession API provides methods to find information about the current session.Clears a session client value previously set with putClientData\\(\\).Returns a session client value previously set with putClientData\\(\\).Gets the session's language code.Gets a list of roles for the current user.Gets the name of the session's time zone.Determines if the current session is interactive.Determines if the current user is currently logged in.Sets a session client value that can be retrieved with getClientData\\(\\). This method is used in a server side script that runs when a form is created.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_GlideSessionAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[42,51],[55,59],[75,80],[84,86],[104,108],[112,114],[134,136],[140,142],[156,160]