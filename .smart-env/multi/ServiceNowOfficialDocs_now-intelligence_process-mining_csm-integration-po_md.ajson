ence/performance-analytics/performance-analytics-glossary.md","line":59},{"title":"Integration with Performance Analytics","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/process-mining/integrate-pa.md","line":59},{"title":"Activate content packs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/process-mining/activate-po-content-pack.md","line":61},{"title":"Example of Process Mining for CSM","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/process-mining/csm-integration-po.md","line":66},{"title":"Analyzing and getting process insights","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/process-mining/analyze-get-process-insights.md","line":100},{"title":"Content pack for Customer Service Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/process-mining/csm-integration-po.md","line":102},{"title":"Process Mining Content Pack for CSM","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/process-mining/csm-integration-po.md","line":182},{"title":"Process Mining Workspace","target":"analyst-workbench-overview","line":186},{"title":"Analyst Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/process-mining/analyst-workbench-dashboard.md","line":194},{"title":"Analyst Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/process-mining/analyst-workbench-dashboard.md","line":204},{"title":"Process Mining","target":"process-mining","line":208},{"title":"Process Mining workspace","target":"analyst-workbench-overview","line":209}],"metadata":{"title":"Content pack for Customer Service Management","descripti