 and automated test results#View automated test suite results#Procedure#{3}":[106,119],"#View test results and automated test results#Related":[120,126],"#View test results and automated test results#Related#{1}":[122,122],"#View test results and automated test results#Related#{2}":[123,123],"#View test results and automated test results#Related#{3}":[124,124],"#View test results and automated test results#Related#{4}":[125,126]},"outlinks":[{"title":"test results","target":"atf-test-results-module","line":24},{"title":"suite results","target":"suite-results-module","line":32},{"title":"suites","target":"suites-module","line":32},{"title":"Test results record","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/atf-test-results-record.md","line":42},{"title":"Step results record","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/atf-step-result-record.md","line":50},{"title":"Test logs record","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/atf-test-log-record.md","line":58},{"title":"Building and running automated tests with the Automated Test Framework","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/atf-build-overview.md","line":61},{"title":"Allowed Client Errors","target":"whitelisted-client-errors","line":65},{"title":"Test suite results record","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/atf-test-suite-results-record.md","line":106},{"title":"Identify and resolve client errors","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/identify-and-resolve-client-errors.md","line":112},{"title":"Allow client errors from test results","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/whitelist-errors-from-test-results.md","line":114},{"title":"Allow client errors from step results","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/whitelist-errors-from-step-results-related-list.md","line":116},{"title":"Allow client errors from the test logs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/whitelist-errors-from-test-log-related-list.md","line":118},{"title":"Test results","target":"atf-test-results-module","line":122},{"title":"Suite results","target":"suite-results-module","line":123},{"title":"Suites","target":"suites-module","line":124},{"title":"Allowed client errors","target":"whitelisted-client-errors","line":125}],"metadata":{"title":"View test results and automated test results","description":"View test results from completed test and test suite runs. Carefully consider the results of automated test runs and perform any corrective actions required to resolve any revealed issues.When viewing test results, step results or test logs, you can allow client errors as ignored or warning entries in the Allowed Client Errors table. This allows test executions to continue past client errors in future test runs.If the test has a UI component, the system takes screenshots of the UI. View these screenshots to gain further insight into the test results.View results from an automated test suite.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/automated-test-framework-atf/atf-view-results-consolidated.html","release":"australia","product":"Automated Test Framework \\(ATF\\)","classification":"automated-test-framework-atf","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Building and running automated tests with the Automated Test Framework","Automated Test Framework \\(ATF\\) test building and execution","Automated Test Framework \\(ATF\\)","Testing and debugging applications","Building applications"],"tags":["#application-development","#atf","#testing","#automated-tests","#test-suites","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/application-development/automated-test-framework-atf/atf-view-results-consolidated.md"},
