nsion and workflow#{2}":[55,55],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{3}":[56,70],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{4}":[58,70],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{5}":[71,72],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{6}":[73,85],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{7}":[86,86],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{8}":[87,101],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{9}":[89,101],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{10}":[102,103],"#ConsolidationService- Scoped, Global#ConsolidationService API extension and workflow#{11}":[104,105],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateEntity\\(String contextType\\)":[106,173],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateEntity\\(String contextType\\)#{1}":[108,129],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateEntity\\(String contextType\\)#{2}":[130,130],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateEntity\\(String contextType\\)#{3}":[131,132],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateEntity\\(String contextType\\)#{4}":[133,173],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateJSONs\\(Object json1, Object json2\\)":[174,274],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateJSONs\\(Object json1, Object json2\\)#{1}":[176,198],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateJSONs\\(Object json1, Object json2\\)#{2}":[199,199],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateJSONs\\(Object json1, Object json2\\)#{3}":[200,201],"#ConsolidationService- Scoped, Global#ConsolidationService - canConsolidateJSONs\\(Object json1, Object json2\\)#{4}":[202,274],"#ConsolidationService- Scoped, Global#ConsolidationService - canMergeEntity\\(String contextType\\)":[275,339],"#ConsolidationService- Scoped, Global#ConsolidationService - canMergeEntity\\(String contextType\\)#{1}":[277,298],"#ConsolidationService- Scoped, Global#ConsolidationService - canMergeEntity\\(String contextType\\)#{2}":[299,299],"#ConsolidationService- Scoped, Global#ConsolidationService - canMergeEntity\\(String contextType\\)#{3}":[300,301],"#ConsolidationService- Scoped, Global#ConsolidationService - canMergeEntity\\(String contextType\\)#{4}":[302,339],"#ConsolidationService- Scoped, Global#ConsolidationService - consolidate\\(Object sourceJSON, Object targetJSON, Object additionalParams\\)":[340,1688],"#ConsolidationService- Scoped, Global#ConsolidationService - consolidate\\(Object sourceJSON, Object targetJSON, Object additionalParams\\)#{1}":[342,1688]},"outlinks":[{"title":"script includes","target":"c_ScriptIncludes","line":43},{"title":"LeadtoCashCore - Scoped","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/LeadToCashCoreAPI.md","line":44},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":104},{"title":"LeadtoCashCore - Scoped","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/LeadToCashCoreAPI.md","line":368},{"title":"LeadtoCashCore - Scoped","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/LeadToCashCoreAPI.md","line":1656},{"title":"Script includes","target":"c_ScriptIncludes","line":1687}],"metadata":{"title":"ConsolidationService - Scoped, Global","description":"The ConsolidationService API is a script include with methods for merging and de-duplicating complex, hierarchical business data \\(such as contracts, quotes, line items, and entitlements\\) using custom logic.Overridable method for specifying which child entity types can be consolidated within a JSON. The base implementation returns false for all entity types if not overridden.Overridable method that adds conditions for determining whether two entity JSONs with the same hash can be consolidated. The base implementation returns false if not overridden.Overridable method for specifying which child entity types can be merged from source JSONs into the target JSON. The base implementation returns false for all entity types if not overridden.Merges source entity JSON\\(s\\) into a target entity JSON and consolidates child entities within the merged result based on hash-based grouping and pairwise consolidation logic.Overridable method that controls whether consolidation is enabled for this service instance. The base implementation returns false if not overridden. Implementing classes must override this method to return true to enable consolidation.Overridable method that returns the hash configuration for grouping entities before consolidation. The configuration specifies which attributes and child context types generate an MD5 hash for each entity. Entities with the same hash are grouped for pairwise consolidation. The base implementation returns an empty object when not overridden.Overridable method to determine the primary JSON when two JSONs are being consolidated. For non-overridden attributes, the primary JSON's attribute values are used on the consolidated result. The base implementation returns json1 if not overridden.Overridable method, called after two JSONs are consolidated, for updating attributes on the consolidated JSON. The base implementation is a no-op if not overridden.Overridable method that applies final modifications to the consolidated JSON after hierarchy consolidation is complete. The base implementation is a no-op if not overridden.Overridable method called before merge and consolidation for performing custom pre-processing tasks such as bulk map creation or caching lookup data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/ConsolidationServiceAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-04-01","reading_time_minutes":22,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[58,69],[89,100],[138,165],[169,172],[207,266],[270,273],[307,331],[335,338],[370,374],[398,417],[487,504],[520,536],[580,596],[631,647],[663,679],[695,711],[727,743],[759,781],[798,816],[836,904],[923,944],[961,977],[991,1079],[1162,1166],[1211,1215],[1262,1266],[1292,1328],[1345,1349],[1351,1387],[1439,1443],[1456,1473],[1515,1519],[1532,1552],[1599,1617],[1646,1666]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/ConsolidationServiceAPI.md"},
