t assignment#Agent auto-assignment using multiple selection criteria#{10}":[170,170],"#Assigning security analysts#Automatic security analyst assignment#Agent auto-assignment using multiple selection criteria#{11}":[171,171],"#Assigning security analysts#Automatic security analyst assignment#Agent auto-assignment using multiple selection criteria#{12}":[172,173],"#Assigning security analysts#Automatic security analyst assignment#Agent auto-assignment using multiple selection criteria#{13}":[174,175],"#Assigning security analysts#Automatic security analyst assignment#Agent auto-assignment using multiple selection criteria#{14}":[176,176],"#Assigning security analysts#Automatic security analyst assignment#Agent auto-assignment using multiple selection criteria#{15}":[177,178],"#Assigning security analysts#Automatic security analyst assignment#Agent auto-assignment using multiple selection criteria#{16}":[179,180],"#Assigning security analysts#Automatic security analyst assignment#Agent assignment using Advanced Work Assignment \\(AWA\\)":[181,184],"#Assigning security analysts#Automatic security analyst assignment#Agent assignment using Advanced Work Assignment \\(AWA\\)#{1}":[183,184],"#Assigning security analysts#Related":[185,191],"#Assigning security analysts#Related#{1}":[187,187],"#Assigning security analysts#Related#{2}":[188,188],"#Assigning security analysts#Related#{3}":[189,189],"#Assigning security analysts#Related#{4}":[190,191]},"outlinks":[{"title":"Security Incident Response","target":"sir-landing-page","line":28},{"title":"location","target":"location","line":50},{"title":"configuration settings","target":"qradar-ibm-intg-settings","line":50},{"title":"Agent auto-assignment using multiple selection criteria","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/r_AgentAssignment.md","line":58},{"title":"On-Call Scheduling","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/c_OnCallScheduling.md","line":62},{"title":"locations","target":"threat-intelligence-locations","line":72},{"title":"Agent auto-assignment using multiple selection criteria","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/r_AgentAssignment.md","line":86},{"title":"Agent auto-assignment using multiple selection criteria","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/r_AgentAssignment.md","line":110},{"title":"Agent auto-assignment using multiple selection criteria","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/r_AgentAssignment.md","line":144},{"title":"Agent auto assignment using location","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/r_AgentAssignment.md","line":154},{"title":"Agent auto-assignment using skills","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/r_AgentAssignment.md","line":155},{"title":"Agent auto-assignment using time zones","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/r_AgentAssignment.md","line":156},{"title":"Advanced Work Assignment","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/awa-application-landing-page.md","line":183},{"title":"Security Incident Response","target":"sir-landing-page","line":187},{"title":"Location","target":"location","line":188},{"title":"Configuration settings","target":"qradar-ibm-intg-settings","line":189},{"title":"Locations","target":"threat-intelligence-locations","line":190}],"metadata":{"title":"Assigning security analysts","description":"Depending on your settings in the SIR Administration Configuration screen, you can assign security analysts to security incidents manually; automatically by using a workflow; or automatically by using auto-assignment.You can configure the Security Incident Response Administration Configuration screen to require that security analysts be assigned manually whenever someone or the SIR application creates a security incident or generates a security response task.You can configure the Security Incident Response Administration Configuration screen to use a selected workflow to assign the security analyst whenever someone or the SIR application creates a security incident or security response task.You can configure the Security Incident Response Administration Configuration screen to auto-assign the security analyst whenever someone or the SIR application creates a security incident or security response task. Auto-assignment allows you to define, based on the needs of your organization, the criteria by which analysts are assigned automatically to security incidents.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/r\\_AgentAssignment.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/security-incident-response/r_AgentAssignment.md"},
