sure#Related#{1}":[47,47],"#Using the Legal Invention Disclosure#Related#{2}":[48,49]},"outlinks":[{"title":"Legal Invention Disclosure","target":"legal-invention-disclosure-landing","line":24},{"title":"Create a Legal Invention Disclosure request","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/submit-legal-invention-disclosure.md","line":26},{"title":"Create a Legal Invention Disclosure request","target":"submit-legal-invention-disclosure","line":27},{"title":"Review the Legal Invention Disclosure request","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/request-for-clarification.md","line":28},{"title":"Respond to a request for clarification for a Legal Invention Disclosure request","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/submit-request-for-review.md","line":30},{"title":"Create a matter or add a Legal Invention Disclosure request to an existing matter","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/create-matter.md","line":32},{"title":"Associate an existing Outside Counsel to a legal matter","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/add-outside-counsel-to-existing-matter.md","line":34},{"title":"Proceed with a Legal Invention Disclosure request","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/idf-proceed-application.md","line":36},{"title":"Provide Legal Invention Disclosure request information to an outside counsel","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/idf-provide-info-outside-counsel.md","line":38},{"title":"Facilitate the patent review process","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/facilitate-patent-review-process.md","line":40},{"title":"Legal Invention Disclosure","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-invention-disclosure/legal-invention-disclosure-landing.md","line":43},{"title":"Legal Invention Disclosure","target":"legal-invention-disclosure-landing","line":47},{"title":"Create a Legal Invention Disclosure request","target":"submit-legal-invention-disclosure","line":48}],"metadata":{"title":"Using the Legal Invention Disclosure","description":"Legal Invention Disclosure provides a streamlined process for inventors to request an application for a patent and for that request to be reviewed both internally and externally by outside counsels. The application is then submitted to patent authorities. You can choose to reward inventors at selected stages of the application process.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/legal-invention-disclosure/use-legal-invention-disclosure.html","release":"australia","product":"Legal Invention Disclosure","classification":"legal-invention-disclosure","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Legal Invention Disclosure","Legal Service Delivery Practice Applications","Legal Service Delivery","Legal and Contract Operations","Employee Service Management"],"tags":["#employee-service-management","#legal","#invention","#ip","#disclosure","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/legal-invention-disclosure/use-legal-invention-disclosu