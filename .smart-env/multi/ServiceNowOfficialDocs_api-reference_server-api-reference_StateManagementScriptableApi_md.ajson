tableApi - isLeaseExpired\\(String requestorId, String ciSysId, String ciActionName\\)#{1}":[220,242],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isLeaseExpired\\(String requestorId, String ciSysId, String ciActionName\\)#{2}":[243,244],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isLeaseExpired\\(String requestorId, String ciSysId, String ciActionName\\)#{3}":[245,259],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isNotAllowedOpsTransition\\(String ciType, String opsLabel, String transitionOpsLabel\\)":[260,273],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isNotAllowedOpsTransition\\(String ciType, String opsLabel, String transitionOpsLabel\\)#{1}":[262,273],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isValidRequestor\\(String requestorId\\)":[274,319],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isValidRequestor\\(String requestorId\\)#{1}":[276,297],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isValidRequestor\\(String requestorId\\)#{2}":[298,298],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isValidRequestor\\(String requestorId\\)#{3}":[299,300],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - isValidRequestor\\(String requestorId\\)#{4}":[301,319],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - registerOperator\\(\\)":[320,427],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - registerOperator\\(\\)#{1}":[322,342],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - registerOperator\\(\\)#{2}":[343,343],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - registerOperator\\(\\)#{3}":[344,345],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - registerOperator\\(\\)#{4}":[346,427],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - unregisterOperator\\( String requestorId\\)":[428,473],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - unregisterOperator\\( String requestorId\\)#{1}":[430,451],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - unregisterOperator\\( String requestorId\\)#{2}":[452,452],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - unregisterOperator\\( String requestorId\\)#{3}":[453,454],"#StateManagementScriptableApi- Global#StateManagementScriptableApi - unregisterOperator\\( String requestorId\\)#{4}":[455,473],"#StateManagementScriptableApi- Global#Related":[474,477],"#StateManagementScriptableApi- Global#Related#{1}":[476,477]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":30},{"title":"update","target":"r_Update","line":419},{"title":"update","target":"r_Update","line":476}],"metadata":{"title":"StateManagementScriptableApi - Global","description":"The StateManagementScriptableApi provides a set of methods for manipulating configuration item \\(CI\\) operational states and applying CI actions.Add a CI action to a list of CIs.Extend the CI-action-lease time for the registered user. If the previous lease has expired, the new lease time starts now.Returns a list of active CI actions for the specified CI.Returns the operational state of the CI.Determines if the two specified actions are compatible.Determines if the lease has expired for the requestor of a specified CI Action.For a type of CI, determine if a CI action is not allowed for an operational state.For a type of CI, determine if an operational state transition is not allowed.Determines if the specified requestor is a valid active workflow user or a registered user.Registers an operator for a non-workflow user.Removes a CI action for a list of CIs.Set the operational state for list of CIs.Unregisters an operator for non-workflow users.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/StateManagementScriptableApi.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[121,136],[140,146],[178,192],[196,203],[304,312],[316,318],[354,426],[458,466],[470,472]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/StateManagementScriptableApi.md"},
