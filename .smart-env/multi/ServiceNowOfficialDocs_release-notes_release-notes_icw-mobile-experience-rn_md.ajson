iceNowDocs/australia/markdown/industrial-connected-workforce/use-ai-enhanced-ra-icw-mobile.md","line":46},{"title":"Generate an action plan using AI Enhanced recommended actions for ICW Mobile","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/generate-action-plan-ai-enhanced-ra-icw-mobile.md","line":50},{"title":"Mobile Task Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/using-icw-mobile-experience.md","line":55},{"title":"Mobile Standards Hub","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/standards-hub-mobile.md","line":61},{"title":"Intuitive and minimal input actions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/create-action-mobile.md","line":67},{"title":"Guided Task Execution","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/execute-igt-icw-mobile.md","line":73},{"title":"Performance &amp; Reliability Enhancements","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/configure-now-mobile-agent-application-icw-mobile.md","line":79},{"title":"Report any safety related incident","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/icw-mobile-report-safety-incident.md","line":85},{"title":"ServiceNow Store","target":"https://store.servicenow.com/sn_appstore_store.do#!/store/home","line":94},{"title":"ServiceNow Store version history release notes","target":"https://www.servicenow.com/docs/bundle/store-release-notes/page/release-notes/store/sn-store-release-notes.html","line":94},{"title":"Industrial Connected Workforce Core","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/industrial-connected-workforce-core-landing-page.md","line":107},{"title":"Industrial Standards","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/industrial-standards-landing-page.md","line":111},{"title":"Industrial Guided Tasks","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/exploring-industrial-guided-tasks.md","line":115},{"title":"Industrial Connected Workforce release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/industrial-connected-workforce-rn-landing.md","line":120}],"metadata":{"title":"Industrial Connected Workforce Mobile Experience release notes","description":"The ServiceNow Industrial Connected Workforce Mobile Experience \\(ICW Mobile\\) application provides a mobile‑first experience for frontline industrial workers. This application enables them to perform tasks, report deviations, escalate issues, and access standards and knowledge content directly from handheld devices. Designed for reliability in high‑activity environments, ICW Mobile enables operators to stay productive whether online or offline. ICW Mobile is a new application in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":4,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/icw-mobile-experience-rn.md"},
