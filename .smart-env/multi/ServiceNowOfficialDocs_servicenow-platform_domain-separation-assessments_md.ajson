.md","line":29},{"title":"Assessments reference","target":"assessment-reference","line":31},{"title":"Domain separation for service providers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-sep-landing-page.md","line":36},{"title":"Assessments reference","target":"assessment-reference","line":40},{"title":"Domain separation","target":"domain-separation-relationship-formatter-editor","line":41},{"title":"Assessments","target":"r_Assessments","line":42}],"metadata":{"title":"Domain separation and Assessments","description":"Domain separation is supported for Assessments. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/domain-separation-assessments.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Assessments reference","Assessments","Assessments and Surveys","Exploring Service Administration","Service Administration","Manage service capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/domain-separation-assessments.md"},
