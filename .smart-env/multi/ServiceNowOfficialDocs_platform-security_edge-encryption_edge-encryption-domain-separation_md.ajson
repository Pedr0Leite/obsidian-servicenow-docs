
"smart_sources:ServiceNowOfficialDocs/platform-security/edge-encryption/edge-encryption-domain-separation.md": {"path":"ServiceNowOfficialDocs/platform-security/edge-encryption/edge-encryption-domain-separation.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"wbh3ko","at":1784561346202},"class_name":"SmartSource","last_import":{"mtime":1782933197819,"size":2648,"at":1784561346203,"hash":"wbh3ko"},"blocks":{"#---frontmatter---":[1,20],"#Domain separation and Edge Encryption":[22,50],"#Domain separation and Edge Encryption#{1}":[24,25],"#Domain separation and Edge Encryption#Support level: No support":[26,32],"#Domain separation and Edge Encryption#Support level: No support#{1}":[28,28],"#Domain separation and Edge Encryption#Support level: No support#{2}":[29,30],"#Domain separation and Edge Encryption#Support level: No support#{3}":[31,32],"#Domain separation and Edge Encryption#How domain separation works in Edge Encryption":[33,43],"#Domain separation and Edge Encryption#How domain separation works in Edge Encryption#{1}":[35,43],"#Domain separation and Edge Encryption#Related":[44,50],"#Domain separation and Edge Encryption#Related#{1}":[46,46],"#Domain separation and Edge Encryption#Related#{2}":[47,47],"#Domain separation and Edge Encryption#Related#{3}":[48,48],"#Domain separation and Edge Encryption#Related#{4}":[49,50]},"outlinks":[{"title":"Edge Encryption","target":"edge-encryption","line":24},{"title":"users","target":"users","line":24},{"title":"business logic","target":"sc-business-logic","line":28},{"title":"Application support for domain separation","target":"domain-separated-apps","line":31},{"title":"Configuring Edge Encryption","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/edge-encryption/edge-config.md","line":37},{"title":"Application support for domain separation","target":"domain-separated-apps","line":46},{"title":"Edge Encryption","target":"edge-encryption","line":47},{"title":"Users","target":"users","line":48},{"title":"Business Logic","target":"sc-business-logic","line":49}],"metadata":{"title":"Domain separation and Edge Encryption","description":"Domain separation is supported in limited circumstances with Edge Encryption. Edge Encryption provides the ability to encrypt data from within the customer's environment through the use of specific configurations, rules, and keys defined on the Edge Encryption proxy. The Edge Encryption proxy is not domain aware and cannot support domain-specific settings. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/edge-encryption/edge-encryption-domain-separation.html","release":"australia","product":"Edge Encryption","classification":"edge-encryption","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Configuring Edge Encryption","Edge Encryption","Encryption"],"tags":["#platform-security","#edge-encryption","#field-level","#proxy","#security","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/platform-security/edge-encryption/edge-encryption-domain-separation.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"jgyu27","at":1784561346202},"key":"ServiceNowOfficialDocs/platform-security/edge-encryption/edge-encryption-domain-separation.md#---frontmatter---","lines":[1,20],"size":1104,"outlinks":[],"class_name":"SmartBlock"},
