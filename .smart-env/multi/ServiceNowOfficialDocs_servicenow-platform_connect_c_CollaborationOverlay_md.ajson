ustralia/markdown/servicenow-platform/connect/t_DisableTheCollaborationOverlay.md","line":27},{"title":"Connect actions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/connect/t_AdministerConnectActions.md","line":70},{"title":"work notes","target":"c_WorkNotes","line":71},{"title":"attachment","target":"attachment","line":72},{"title":"Connect","target":"c_Connect","line":76},{"title":"Connect Chat","target":"c_Collaboration","line":77},{"title":"Connect Support","target":"c_ConnectSupport","line":78},{"title":"Connect workspace","target":"c_CollaborationWorkspace","line":79},{"title":"Work notes","target":"c_WorkNotes","line":80},{"title":"Attachment","target":"attachment","line":81}],"metadata":{"title":"Connect overlay","description":"The Connect overlay appears over the standard user interface. It consists of the Connect sidebar, which is the primary interface for Connect Chat and Connect Support, and any Connect mini windows that are open. Each mini window contains a header, a conversation area, and a message field.The Connect sidebar is the primary interface for Connect Chat and Connect Support. It lists your conversations and provides access to create conversations.When you open a Connect Chat or Connect Support conversation in the Connect overlay, it opens in a Connect mini window. Each mini window contains a header, a conversation area, and a message field.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/connect/c\\_CollaborationOverlay.html","release":"australia","product":"Connect","classification":"connect","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Connect interface","Connect","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#connect","#messaging","#collaboration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":