-alert.html","release":"australia","product":"Event Management","classification":"event-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Event rules","Processing Events","Configuring Event Management","Event Management","ITOM AIOps","IT Operations Management"],"tags":["#it-operations-management","#event-management","#alerts","#correlation","#aiops","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/event-management/ci-binding-alert.md"},
