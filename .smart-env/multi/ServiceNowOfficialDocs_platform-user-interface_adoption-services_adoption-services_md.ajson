terface/adoption-services/inproduct-help.md","line":44},{"title":"Onboarding modals","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/adoption-services/next-experience-onboarding.md","line":48},{"title":"Create onboarding modals to introduce users to new experiences, products, and applications.","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/adoption-services/next-experience-onboarding.md","line":52},{"title":"Guided setup","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/adoption-services/guided-setup.md","line":56},{"title":"Use guided setup to go through the initial configuration of any product or application that provides a Guided Setup module.","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/adoption-services/guided-setup.md","line":60},{"title":"Guided tours","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/adoption-services/guided-tours.md","line":64},{"title":"Use guided tours to provide step-by-step walkthroughs of applications within your instance.","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/adoption-services/guided-tours.md","line":68}],"metadata":{"title":"Adoption services","description":"Adoption Services is a suite of solutions, both products and features, that provide user support and critical information at the anticipated time of need. Such services include in-product help, modals, tours, and guides that teach users how to interact with the UI pages that they’re looking at in their instance.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-user-interface/adoption-services/adoption-services.html","release":"australia","product":"Adoption Services","classification":"adoption-services","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Configure user experiences"],"tags":["#platform-user-interface","#adoption","#onboarding","#guided-setup","#ui","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-user-interface/adoption-services/adoption-services.md"},
