},{"title":"System for Cross-domain Identity Management \\(SCIM\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/scim.md","line":36},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":38},{"title":"SCIM","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/scim-api.md","line":107},{"title":"https://datatracker.ietf.org/doc/html/rfc7644\\#section-3.4.2.2","target":"https://datatracker.ietf.org/doc/html/rfc7644#section-3.4.2.2","line":207},{"title":"https://datatracker.ietf.org/doc/html/rfc7644\\#section-3.4.2.4","target":"https://datatracker.ietf.org/doc/html/rfc7644#section-3.4.2.4","line":208},{"title":"https://datatracker.ietf.org/doc/html/rfc7644\\#section-3.4.2.3","target":"https://datatracker.ietf.org/doc/html/rfc7644#section-3.4.2.3","line":209},{"title":"https://datatracker.ietf.org/doc/html/rfc7644\\#section-3.4.2.5","target":"https://datatracker.ietf.org/doc/html/rfc7644#section-3.4.2.5","line":210},{"title":"SCIM","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/scim-api.md","line":227},{"title":"https://datatracker.ietf.org/doc/html/rfc7644\\#section-3.4.2.2","target":"https://datatracker.ietf.org/doc/html/rfc7644#section-3.4.2.2","line":411},{"title":"https://datatracker.ietf.org/doc/html/rfc7644\\#section-3.4.2.4","target":"https://datatracker.ietf.org/doc/html/rfc7644#section-3.4.2.4","line":412},{"title":"https://datatracker.ietf.org/doc/html/rfc7644\\#section-3.4.2.3","target":"https://datatracker.ietf.org/doc/html/rfc7644#section-3.4.2.3","line":413},{"title":"https://datatracker.ietf.org/doc/html/rfc7644\\#section-3.4.2.5","target":"https://datatracker.ietf.org/doc/html/rfc7644#section-3.4.2.5","line":414},{"title":"SCIM","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/scim-api.md","line":431},{"title":"Create a SCIM Provider Resource Mapping","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/scim-provider-resource-mapping.md","line":530},{"title":"SCIM","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/scim-api.md","line":595},{"title":"Create a SCIM Provider Resource Mapping","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/scim-provider-resource-mapping.md","line":690},{"title":"SCIM","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/scim-api.md","line":755},{"title":"update","target":"r_Update","line":846}],"metadata":{"title":"SCIM2Client - Scoped","description":"The SCIM2Client API provides methods that call the System for Cross-domain Identity Management \\(SCIM\\) Provider \\(server role\\) to create, update, or delete data in a service provider \\(SP\\).Deletes a specified resource from an external service provider system.Returns all resources from a specified external provider system that match the passed criteria.Returns a resource from the external provider system with the specified unique resource ID.Creates or updates a resource in an external service provider system for a specified sys\\_id.Creates a new resource in an external service provider system for a specified sys\\_id.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/SCIM2ClientAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[125,129],[133,151],[245,251],[255,355],[449,454],[458,522],[613,617],[621,682],[773,777],[781,842]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/SCIM2ClientAPI.md"},
