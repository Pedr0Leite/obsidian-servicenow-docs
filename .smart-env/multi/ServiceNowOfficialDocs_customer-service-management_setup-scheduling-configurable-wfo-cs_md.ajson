281,281],"#Setting up Scheduling in Workforce Optimization for Customer Service#Related#{2}":[282,282],"#Setting up Scheduling in Workforce Optimization for Customer Service#Related#{3}":[283,283],"#Setting up Scheduling in Workforce Optimization for Customer Service#Related#{4}":[284,284],"#Setting up Scheduling in Workforce Optimization for Customer Service#Related#{5}":[285,285],"#Setting up Scheduling in Workforce Optimization for Customer Service#Related#{6}":[286,287]},"outlinks":[{"title":"points","target":"gamification-components-points","line":18},{"title":"Optimize workforce operations","target":"setup-configurable-wfo-cs","line":20},{"title":"Workforce Optimization for Customer Service","target":"configurable-wfo-cs","line":40},{"title":"Optimization","target":"optimization","line":213},{"title":"Monitor schedule adherence of your agents","target":"view-schedule-adherence-configurable-wfo","line":215},{"title":"Analyze adherence and conformance from the time worked summary","target":"analyze-time-worked-summary-configurable-wfo-cs","line":217},{"title":"Using extension points to extend application functionality","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/extension-points.md","line":277},{"title":"Optimize workforce operations","target":"setup-configurable-wfo-cs","line":281},{"title":"Monitor schedule adherence of your agents","target":"view-schedule-adherence-configurable-wfo","line":282},{"title":"Analyze adherence and conformance from the time worked summary","target":"analyze-time-worked-summary-configurable-wfo-cs","line":283},{"title":"Points","target":"gamification-components-points","line":284},{"title":"Workforce Optimization for Customer Service","target":"configurable-wfo-cs","line":285},{"title":"Optimization","target":"optimization","line":286}],"metadata":{"title":"Setting up Scheduling in Workforce Optimization for Customer Service","description":"Manage events using the team calendar. Create different types of event categories. Use scripted extension points to customize event types.Add an event category. Create or update field configurations for events. You can also specify if an event category must be excluded when the shift coverage for agents are calculated.Create multiple events from the same category and add them to the team calendar.Configure schedule adherence properties to calculate the adherence and conformance of your agents so that you can improve the operational efficiency of your organization.Configure and tweak the schedule adherence and conformance formulas using scripted extension points so that you can customize them for your organization.Use extension points to call scripts for event categories such as meeting, time off, or work time.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/customer-service-management/setup-scheduling-configurable-wfo-cs.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Optimize workforce operations","Extend capabilities","Configure","Customer Service Management"],"tags":["#customer-service-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[52,105]],"key":"ServiceNowOfficialDocs/customer-service-management/setup-scheduling-configurable-wfo-cs.md"},
