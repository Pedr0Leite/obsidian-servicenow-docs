"title":"Product Catalog","target":"c_ProductCatalog","line":60}],"metadata":{"title":"Domain separation and Product Catalog","description":"Domain separation is supported in the Product Catalog. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-service-management/product-catalog/domain-separation-product-catalog.html","release":"australia","product":"Product Catalog","classification":"product-catalog","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Product Catalog","Asset Management","IT Service Management"],"tags":["#it-service-management","#catalog","#products","#itsm","#models","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/it-service-management/product-catalog/domain-separation-product-catalog.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1dw5mte","at":1784561344390},"key":"ServiceNowOfficialDocs/it-service-management/product-catalog/domain-separation-product-catalog.md#---frontmatter---","lines":[1,20],"size":794,"outlinks":[],"class_name":"SmartBlock"},
