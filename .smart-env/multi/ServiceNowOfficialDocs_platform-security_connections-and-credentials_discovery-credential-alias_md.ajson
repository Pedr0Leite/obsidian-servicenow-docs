68,71],"#Credential aliases for Discovery#Create a Discovery credential alias#Procedure#{3}":[72,79],"#Credential aliases for Discovery#Create a Discovery credential alias#Procedure#{4}":[80,83],"#Credential aliases for Discovery#Create a Discovery credential alias#Procedure#{5}":[84,85],"#Credential aliases for Discovery#Create a Discovery credential alias#Procedure#{6}":[86,89],"#Credential aliases for Discovery#Create a Discovery credential alias#Procedure#{7}":[90,91],"#Credential aliases for Discovery#Create a Discovery credential alias#Procedure#{8}":[92,93],"#Credential aliases for Discovery#Create a Discovery credential alias#Procedure#{9}":[94,97]},"outlinks":[{"title":"affinity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/c_CredentialAffinity.md","line":34}],"metadata":{"title":"Credential aliases for Discovery","description":"Credential aliases for Discovery allow an administrator to use specific credentials on Discovery schedules. You can configure behaviors for your aliases that determine how strictly the system enforces their use.Create the alias and then add that alias to a credential in the credential record. You can add a credential to multiple aliases and add multiple credentials to a single alias.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/connections-and-credentials/discovery-credential-alias.html","release":"australia","product":"Connections and Credentials","classification":"connections-and-credentials","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Get started with credentials","Connections and Credentials","Access Management"],"tags":["#platform-security","#credentials","#connections","#aliases","#integration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-security/connections-and-credentials/discovery-creden