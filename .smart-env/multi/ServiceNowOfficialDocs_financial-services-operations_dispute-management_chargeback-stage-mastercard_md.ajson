NowDocs/australia/markdown/financial-services-operations/dispute-management/workspace-for-agent.md","line":43},{"title":"Mastercard document requirements","target":"mastercard-image-and-document-requirements","line":50},{"title":"Initiate chargeback","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/initiate-chargeback-mastercard.md","line":52},{"title":"Review and respond to collaboration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/review-respond-collaboration.md","line":54},{"title":"Review chargeback response and decide on pre-arbitration or arbitration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/review-and-decide-prearbitration.md","line":56},{"title":"Review pre-arbitration response and escalate to arbitration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/review-prearbitration-response-escalate-arbitration.md","line":58},{"title":"Review arbitration response","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/review-arbitration-response-mc.md","line":60},{"title":"Reverse provisional credit","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/reverse-provisional-credit-mc.md","line":62},{"title":"Provide final credit to customer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/provide-final-credit-mc.md","line":64},{"title":"Convert provisional credit to final credit","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/convert-provisional-credit-to-final-credit_mc.md","line":66},{"title":"Processing a Mastercard dispute","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/financial-services-operations/dispute-management/processing-mastercard-dispute-case.md","line":69},{"title":"Mastercard document requirements","target":"mastercard-image-and-document-requirements","line":73},{"title":"chargeback stage","target":"chargeback-stage","line":74}],"metadata":{"title":"Chargeback in Mastercard transaction disputes","description":"After a chargeback is initiated, the chargeback request is sent to Mastercard, which alerts the merchant. Mastercard requests collaboration from merchants, who either provide a voucher, refund, or First-Party Trust evidence as response. If the merchant doesn’t respond, the process escalates to formal chargeback procedures.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/financial-services-operations/dispute-management/chargeback-stage-mastercard.html","release":"australia","product":"Dispute Management","classification":"dispute-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Processing a Mastercard dispute","Resolving disputes with Mastercard","Processing","Use","Dispute Management","Banking applications","Financial Services Operations \\(FSO\\)"],"tags":["#financial-services-operations","#disputes","#fso","#investigation","#resolution","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/financial-services-operations/dispute-management/chargeback-stage-mastercard.md"},
