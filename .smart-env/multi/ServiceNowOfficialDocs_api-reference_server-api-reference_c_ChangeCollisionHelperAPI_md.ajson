ing ci, GlideDateTime startDate, GlideDateTime endDate\\)#{1}":[70,81],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - getChangesWithCi\\(String ci, GlideDateTime startDate, GlideDateTime endDate\\)":[82,95],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - getChangesWithCi\\(String ci, GlideDateTime startDate, GlideDateTime endDate\\)#{1}":[84,95],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - getCiMaintenanceSchedule\\(String ci\\)":[96,107],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - getCiMaintenanceSchedule\\(String ci\\)#{1}":[98,107],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - getDependants\\(String ci\\)":[108,119],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - getDependants\\(String ci\\)#{1}":[110,119],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - getDependencies\\(String ci\\)":[120,131],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - getDependencies\\(String ci\\)#{1}":[122,131],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - isCiInAffectedCis\\(String ci, String changeId\\)":[132,144],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - isCiInAffectedCis\\(String ci, String changeId\\)#{1}":[134,144],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - isDateInCiMaintenanceWindows\\( GlideDateTime startDate, GlideDateTime endDate, String maintenanceWindow\\)":[145,159],"#ChangeCollisionHelper- Global#ChangeCollisionHelper - isDateInCiMaintenanceWindows\\( GlideDateTime startDate, GlideDateTime endDate, String maintenanceWindow\\)#{1}":[147,159]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28}],"metadata":{"title":"ChangeCollisionHelper - Global","description":"The ChangeCollisionHelper script include provides helper methods found in the Change Management - Collision Detector \\(com.snc.change.collision\\) plugin.Adds the CI to the change's affected CI list.Returns the Affected CI sys\\_ids for the given change.Returns any blackout that overlap the period defined by startDate and endDate.Returns changes scheduled in the timespan \\(defined by startDate and endDate\\) that have the given CI in their Affected CIs list.Returns the changes that are in the timespan \\(startDate, endDate\\) and that are linked to the given CI.Returns the Maintenance Schedule for a CI.Returns all the CIs that depend on the given CI.Returns all the CIs that the given CI depends on.Check if an CI is already in the change's affected CIs list.Checks if the time span defined by startDate and endDate falls in the CI's maintenance window.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_ChangeCollisionHelperAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_ChangeCollisionHelperAPI.md"},
