agement","target":"r_PolicyComplianceMgmt","line":26},{"title":"Install the SOX Content Pack","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/grc-common-functions/install-grc-sox-content-pack.md","line":28},{"title":"Install the SOX Content Pack","target":"install-grc-sox-content-pack","line":29},{"title":"Verify the SOX Content Pack in Policy and Compliance Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/grc-common-functions/verify-SOX-content-policy-and-compliance.md","line":30},{"title":"Verify the SOX Content Pack in Risk Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/grc-common-functions/verify-SOX-content-risk-management.md","line":32},{"title":"entity types","target":"entity-type-in-risk-ws","line":33},{"title":"Verify the SOX Content Pack in Audit Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/grc-common-functions/verify-SOX-content-audit-management.md","line":34},{"title":"SOX Content Pack dashboard and reports","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/grc-common-functions/grc-SOX-compliance-content-pack.md","line":36},{"title":"Governance, Risk, and Compliance content packs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/grc-common-functions/grc-content-packs.md","line":39},{"title":"Policy and Compliance Management","target":"r_PolicyComplianceMgmt","line":43},{"title":"Audit Management","target":"c_GRCAudits","line":44},{"title":"Install the SOX Content Pack","target":"install-grc-sox-content-pack","line":45},{"title":"Entity types","target":"entity-type-in-risk-ws","line":46}],"metadata":{"title":"Sarbanes-Oxley \\(SOX\\) Content Pack","description":"The Sarbanes-Oxley \\(SOX\\) Content Pack provides basic SOX content for an organization to commence and manage activities towards attaining operational SOX compliance using the ServiceNow GRC application. A content pack may include pre-defined scope, specific policies, controls, risks, audit, test plans, dashboards, and reports providing users of ServiceNow GRC a head-start in using the applications towards SOX compliance-related activities.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/grc-common-functions/sn-store-SOX-governance-risk-compliance.html","release":"australia","product":"GRC Common Functions","classification":"grc-common-functions","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["GRC content packs","Common GRC features","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#grc","#attestation","#evidence","#scoping","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/grc-common-functions/sn-store-SOX-governance-risk-compliance.md"},
