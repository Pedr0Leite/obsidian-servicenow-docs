ess data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/domain-sep-pa-dashboards.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Configure","Dashboards","Platform Analytics experience","Platform Analytics"],"tags":["#now-intelligence","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/domain-sep-pa-dashboards.md"},
