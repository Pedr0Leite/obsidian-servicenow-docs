covery Quick Start#Related#{2}":[226,227]},"outlinks":[{"title":"Discovery","target":"r-discovery","line":24},{"title":"MID Server installation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server-installation.md","line":26},{"title":"using Discovery","target":"using-discovery","line":26},{"title":"Using guided setup","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/guided-setup.md","line":52},{"title":"Configure and schedule subnet discovery","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/discovery-quick-start.md","line":144},{"title":"applicative credentials","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/applicative-creds.md","line":152},{"title":"Data collected by ITOM Visibility","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/itom-visibility/data-collected-by-itom-visibility.md","line":154},{"title":"Discovery","target":"r-discovery","line":225},{"title":"Using Discovery","target":"using-discovery","line":226}],"metadata":{"title":"Discovery Quick Start","description":"Discovery Quick Start is a wizard that helps you get up and running with Discovery quickly. Use Discovery Quick Start tasks to discover IP ranges, or subnets, in your environment and then to identify the configuration items \\(CI\\) in those subnets.Subnet discovery finds all the subnets in your environment to determine available IP ranges and to verify that there are MID Servers available to access these ranges.Using the credentials you provide, the Quick Start wizard finds all the configuration items \\(CI\\) for the IP ranges identified during subnet discovery.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/discovery/discovery-quick-start.html","release":"australia","product":"Discovery","classification":"discovery","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Discovery setup","Configuring Discovery","Discovery","ITOM Visibility","IT Operations Management"],"tags":["#it-operations-management","#discovery","#cmdb","#patterns","#ci","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/discovery/discovery-quick-start.md"},
