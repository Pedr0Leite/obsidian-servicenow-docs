separation works in Password Reset#{3}":[41,41],"#Domain separation and the Password Reset application#How domain separation works in Password Reset#{4}":[42,42],"#Domain separation and the Password Reset application#How domain separation works in Password Reset#{5}":[43,43],"#Domain separation and the Password Reset application#How domain separation works in Password Reset#{6}":[44,44],"#Domain separation and the Password Reset application#How domain separation works in Password Reset#{7}":[45,45],"#Domain separation and the Password Reset application#How domain separation works in Password Reset#{8}":[46,47],"#Domain separation and the Password Reset application#Password Change process":[48,60],"#Domain separation and the Password Reset application#Password Change process#{1}":[50,60],"#Domain separation and the Password Reset application#Related":[61,66],"#Domain separation and the Password Reset application#Related#{1}":[63,63],"#Domain separation and the Password Reset application#Related#{2}":[64,64],"#Domain separation and the Password Reset application#Related#{3}":[65,66]},"outlinks":[{"title":"Domain separation","target":"domain-separation-relationship-formatter-editor","line":23},{"title":"Password Reset","target":"password-reset-landing-page","line":23},{"title":"Application support for domain separation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-separated-apps.md","line":34},{"title":"self-service","target":"self-service-landing","line":50},{"title":"Domain separation for service providers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-sep-landing-page.md","line":59},{"title":"Domain separation","target":"domain-separation-relationship-formatter-editor","line":63},{"title":"Password Reset","target":"password-reset-landing-page","line":64},{"title":"Self-service","target":"self-service-landing","line":65}],"metadata":{"title":"Domain separation and the Password Reset application","description":"Domain separation is supported in the Password Reset application. A password reset process that you define in any domain is isolated from a process that you create in any other domain. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/password-reset/domain-separation-pwd-reset.html","release":"australia","product":"Password Reset","classification":"password-reset","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Password Reset reference","Password Reset","Manage service capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#password-reset","#self-service","#enrollment","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/password-reset/domain-separation-pwd-reset.md"},
