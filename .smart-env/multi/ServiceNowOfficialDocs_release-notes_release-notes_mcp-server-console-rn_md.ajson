eNowDocs/australia/markdown/intelligent-experiences/ai-control-tower-landing.md","line":61},{"title":"Model Context Protocol Client","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/mcp-client.md","line":65},{"title":"Machine Identity Console","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/machine-identity-console.md","line":69},{"title":"AI Experiences release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/intelligent-experiences-rn-landing.md","line":74}],"metadata":{"title":"MCP Server Console release notes","description":"The ServiceNow MCP Server Console application enables secure and governed access to functionality on a ServiceNow instance for AI applications with Model Context Protocol \\(MCP\\) servers. MCP servers extend ServiceNow AI Platform functionality into any external MCP client and employee experience over the Model Context Protocol. MCP Server Console is a new application in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2025-11-04","reading_time_minutes":2,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/mcp-server-console-rn.md"},
