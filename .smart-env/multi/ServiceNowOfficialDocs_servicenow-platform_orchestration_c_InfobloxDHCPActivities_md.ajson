Now/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateARESTWebServiceActivity.md","line":185},{"title":"DHCP Reserve IP v4 Address Range activity","target":"r_DHCPReserveIPv4AddrRangeActivity-1","line":249},{"title":"IP Address","target":"ip-address","line":250},{"title":"MID Server","target":"mid-server-landing","line":251},{"title":"Workflow editor","target":"workflow-editor","line":252}],"metadata":{"title":"Infoblox DHCP activities","description":"The Infoblox DHCP activities manage the IP addresses reserved for DHCP in your network.The DHCP Reserve IP v4 Address Range activity reserves an IP address range for DHCP use.The DHCP Delete IP Reservation activity deletes IP reservations in DHCP using either an IPv4 or IPv6 address range.The DHCP List IP Reservations activity generates a list of all the DHCP range reservations on a specific InfoBlox server.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/orchestration/c\\_InfobloxDHCPActivities.html","release":"australia","product":"Orchestration","classification":"orchestration","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Infoblox DDI activity pack","Orchestration activity packs","Classic Orchestration","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#orchestration","#itpa","#automation","#runbooks","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/servicenow-platform/orchestration/c_InfobloxDHCPActivities.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"d7voab","at":1784561353500},"key":"ServiceNowOfficialDocs/servicenow-platform/orchestration/c_InfobloxDHCPActivities.md#---frontmatter---","lines":[1,20],"size":1023,"outlinks":[],"class_name":"SmartBlock"},
