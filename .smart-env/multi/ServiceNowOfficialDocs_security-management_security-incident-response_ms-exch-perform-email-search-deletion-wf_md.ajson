ew Action Status":[64,96],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Preview Action Status#{1}":[66,67],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Preview Action Status#Input variables":[68,76],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Preview Action Status#Input variables#{1}":[70,76],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Preview Action Status#Output variables":[77,84],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Preview Action Status#Output variables#{1}":[79,84],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Preview Action Status#Exit Conditions":[85,96],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Preview Action Status#Exit Conditions#{1}":[87,96],"#Microsoft Exchange - Perform Email Search and Deletion flow#Create Compliance Search Delete Action":[97,119],"#Microsoft Exchange - Perform Email Search and Deletion flow#Create Compliance Search Delete Action#{1}":[99,100],"#Microsoft Exchange - Perform Email Search and Deletion flow#Create Compliance Search Delete Action#Input variables":[101,109],"#Microsoft Exchange - Perform Email Search and Deletion flow#Create Compliance Search Delete Action#Input variables#{1}":[103,109],"#Microsoft Exchange - Perform Email Search and Deletion flow#Create Compliance Search Delete Action#Exit Conditions":[110,119],"#Microsoft Exchange - Perform Email Search and Deletion flow#Create Compliance Search Delete Action#Exit Conditions#{1}":[112,119],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Delete Action Status":[120,152],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Delete Action Status#{1}":[122,123],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Delete Action Status#Input variables":[124,132],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Delete Action Status#Input variables#{1}":[126,132],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Delete Action Status#Output variables":[133,140],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Delete Action Status#Output variables#{1}":[135,140],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Delete Action Status#Exit Conditions":[141,152],"#Microsoft Exchange - Perform Email Search and Deletion flow#Check Delete Action Status#Exit Conditions#{1}":[143,152],"#Microsoft Exchange - Perform Email Search and Deletion flow#Remove Compliance Search Action":[153,165],"#Microsoft Exchange - Perform Email Search and Deletion flow#Remove Compliance Search Action#{1}":[155,156],"#Microsoft Exchange - Perform Email Search and Deletion flow#Remove Compliance Search Action#Input variables":[157,165],"#Microsoft Exchange - Perform Email Search and Deletion flow#Remove Compliance Search Action#Input variables#{1}":[159,165],"#Microsoft Exchange - Perform Email Search and Deletion flow#Related":[166,171],"#Microsoft Exchange - Perform Email Search and Deletion flow#Related#{1}":[168,168],"#Microsoft Exchange - Perform Email Search and Deletion flow#Related#{2}":[169,169],"#Microsoft Exchange - Perform Email Search and Deletion flow#Related#{3}":[170,171]},"outlinks":[{"title":"Common Security Operations integration flows and orchestration activities","target":"common-wf-activities","line":34},{"title":"Create Compliance Search Action","target":"get-email-details-from-exch-server","line":38},{"title":"Check Compliance Search Status Action","target":"search-delete-email-threat-exchange","line":39},{"title":"Common Security Operations integration flows and orchestration activities","target":"common-wf-activities","line":168},{"title":"Create Compliance Search Action","target":"get-email-details-from-exch-server","line":169},{"title":"Check Compliance Search Status Action","target":"search-delete-email-threat-exchange","line":170}],"metadata":{"title":"Microsoft Exchange - Perform Email Search and Deletion flow","description":"When the Microsoft Exchange - Perform Email Search and Deletion flow is executed, it searches the Exchange server using the search query provided, and returns the details to the on-premises instance.The Create Compliance Search Preview Action creates a new compliance search action of type preview on the exchange server for the created compliance search.The Preview Action Status checks the status of compliance search action of type preview and returns the preview information of the emails found like recipient, sender, subject, email date received.The Create Compliance Search Delete Action creates a new compliance search action of type purge on the exchange server for the created compliance search.The Check Delete Action Status checks the status of compliance search action of type purge and performs soft delete operation on the exchange server for the emails found as a part of compliance search.The Remove Compliance Search action removes the created compliance search from exchange server.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/ms-exch-perform-email-search-deletion-wf.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Microsoft Exchange On-Premises integration","Security Incident Response integrations","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/security-management/security-incident-response/ms-exch-perform-email-search-deletion-wf.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"