omain separation#Related":[107,111],"#MID Server domain separation#Related#{1}":[109,109],"#MID Server domain separation#Related#{2}":[110,111]},"outlinks":[{"title":"MID Server","target":"mid-server-landing","line":24},{"title":"Setup indicator for configuration phase","target":"../image/ProgressBarConfig.png","line":28,"embedded":true},{"title":"Configuring MID Servers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/c_MIDServerConfiguration.md","line":41},{"title":"domain separation","target":"domain-separation-relationship-formatter-editor","line":45},{"title":"Configure a MID Server user","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/t_SetupMIDServerRole.md","line":53},{"title":"MID Server user credentials","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/mid-server-install-prereqs.md","line":57},{"title":"domain separated","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_DomainSeparation.md","line":87},{"title":"MID Server","target":"mid-server-landing","line":109},{"title":"Domain separation","target":"domain-separation-relationship-formatter-editor","line":110}],"metadata":{"title":"MID Server domain separation","description":"Use the MID Server user role to configure MID Servers to access separate domains. The credentials in the config.xml file of a MID Server determine which domains it can access. Specific MID Server policy records can be restricted for use only by MID Server from the same domain.Set up domain separation through the MID server user role and the MID Server configuration file.You can create a MID Server in the global domain that can explore targets in other domains.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/mid-server/c\\_MIDServerDomainSeparation.html","release":"australia","product":"MID Server","classification":"mid-server","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Configuring MID Servers","Configuring MID Server","MID Server","Manage instance data sources","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#mid-server","#on-premise","#proxy","#connectivity","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/mid-server/c_MIDServerDomainSeparation.md"},
