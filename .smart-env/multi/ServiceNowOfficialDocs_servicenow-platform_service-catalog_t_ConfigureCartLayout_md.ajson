thubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/service-catalog-cart-widgets.md","line":35},{"title":"Preview screens","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/service-catalog-screens.md","line":36},{"title":"Order status screens","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/service-catalog-status-screens.md","line":37},{"title":"label","target":"label","line":53},{"title":"Cart layout","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/c_ConfigureCartLayout.md","line":62},{"title":"service catalog properties","target":"r_ServiceCatalogProperties","line":66},{"title":"check box","target":"check-box","line":84},{"title":"reference","target":"reference","line":153},{"title":"Requested for","target":"requested-for","line":191},{"title":"Catalog Item form","target":"catalog-item-form","line":214},{"title":"cart layout settings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/t_ConfigureCartLayout.md","line":222},{"title":"migrating to cart layouts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/c_MigrateCartLayouts.md","line":255},{"title":"Cart layout","target":"c_ConfigureCartLayout","line":259},{"title":"Service Catalog","target":"service-catalog","line":260},{"title":"Label","target":"label","line":261},{"title":"Service Catalog properties","target":"r_ServiceCatalogProperties","line":262},{"title":"Check box","target":"check-box","line":263},{"title":"Reference","target":"reference","line":264},{"title":"Requested for","target":"requested-for","line":265},{"title":"Catalog Item form","target":"catalog-item-form","line":266}],"metadata":{"title":"Configure the cart layout","description":"Configure cart layout records to define functionality for widgets or screens in the shopping cart.When you enable cart layouts, service catalog properties are impacted. Consider the possible outcomes and alter the settings or properties to achieve the cart layout and functionality you require.Configure macros that define functionality for elements within each widget or screen.Create macros for cart layout records using Jelly scripts to define customized behavior and display within a widget or screen.Set fields in the Catalog Item form to configure the cart layout for specific items.Service catalog enables you to use additional methods to configure cart behavior or layouts, which override cart layout record settings.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/service-catalog/t\\_ConfigureCartLayout.html","release":"australia","product":"Service Catalog","classification":"service-catalog","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Cart layout","Service Catalog customization","Types of catalog items","Explore","Service Catalog","Manage service capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#service-catalog","#request-items","#variables","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[193,210]],"key":"ServiceNowOfficialDocs/servicenow-platform/service-catalog/t_ConfigureCartLayout.md"},
