:"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/exploring-subflows.md","line":27},{"title":"ServiceNow Fluent API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/servicenow-fluent-api-reference.md","line":29},{"title":"ServiceNow Fluent","target":"servicenow-fluent","line":34},{"title":"properties","target":"atf-admin-properties","line":44},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":84},{"title":"Flow roles","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/flow-roles.md","line":136},{"title":"wfa.trigger function","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-flow-api.md","line":208},{"title":"wfa.action function","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-flow-api.md","line":222},{"title":"wfa.flow\\_logic function","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-flow-api.md","line":223},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":521},{"title":"wfa.action function","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-flow-api.md","line":689},{"title":"wfa.flow\\_logic function","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-flow-api.md","line":690},{"title":"Workflow Studio flow trigger types","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/flow-triggers.md","line":915},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":963},{"title":"Workflow Studio actions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/flow-actions.md","line":1124},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":1172},{"title":"Workflow Studio flow logic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/flow-logic.md","line":1340},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":1376},{"title":"wfa.action function","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-flow-api.md","line":1488},{"title":"wfa.flow\\_logic function","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-flow-api.md","line":1489},{"title":"Field types reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/r_FieldTypes.md","line":1723},{"title":"Subflow object","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-flow-api.md","line":1876},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":1926},{"title":"ServiceNow Fluent","target":"servicenow-fluent","line":2063},{"title":"Create a flow","target":"app-tutorial-create-a-flow","line":2064},{"title":"Properties","target":"atf-admin-properties","line":2065}],"metadata":{"title":"Flow API - ServiceNow Fluent","description":"The Flow API defines flows and subflows \\[sys\\_hub\\_flow\\], which automate business processes with reusable multiple-step components.Create a flow \\[sys\\_hub\\_flow\\] to run a sequence of actions and flow logic when a set of trigger conditions occur.Create a subflow \\[sys\\_hub\\_flow\\] to run a reusable sequence of actions and flow logic when called by a flow or API.Run a flow when the start conditions of a specific trigger type are met. Triggers determine when a flow runs and what data is available from the flow start conditions.Run a specific action instance from a flow or subflow. Actions determine what data is generated, updated, or retrieved.Run a specific flow logic instance from a flow or subflow. Flow logic determines how and when data is used.Reference a specific runtime data pill value from an action or flow logic input.Run a specific subflow from a parent flow or subflow.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":29,"keywords":["servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api"],"tags":["#application-development","#scoped-apps","#architecture","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[247,404],[408,469],[714,889],[980,998],[1002,1014],[1018,1040],[1044,1090],[1189,1250],[1254,1321],[1431,1474],[1494,1532],[1536,1593],