","target":"exploring-learning-exp","line":22},{"title":"Azure Form Recognizer documentation","target":"https://docs.microsoft.com/en-us/azure/applied-ai-services/form-recognizer/","line":24},{"title":"Form Recognizer 2021-09-30-preview","target":"https://westus.dev.cognitive.microsoft.com/docs/services/form-recognizer-api-v3-0-preview-1/operations/CopyDocumentModelTo","line":25},{"title":"Automate reviews of vaccine responses","target":"enable-automated-vaccine-response-reviews","line":36},{"title":"Set up Vaccination Status properties","target":"config-vaccination-properties","line":37},{"title":"Configure Azure Form Recognizer integration for automatic vaccine response reviews","target":"config-azure-form-recognizer-integration","line":50},{"title":"Automate reviews of vaccine responses","target":"enable-automated-vaccine-response-reviews","line":54},{"title":"Set up Vaccination Status properties","target":"config-vaccination-properties","line":55},{"title":"Configure Azure Form Recognizer integration for automatic vaccine response reviews","target":"config-azure-form-recognizer-integration","line":56},{"title":"Vaccination Status","target":"vaccination-status","line":57},{"title":"Learning","target":"exploring-learning-exp","line":58}],"metadata":{"title":"Automating vaccine response reviews with the Azure Form Recognizer service","description":"Your organization can automatically review and validate vaccine responses with Vaccination Status by integrating with the Azure Form Recognizer service.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/automate-vaccine-validation-with-azure-form-recognizer.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Automating vaccine response reviews","Vaccination Status","Safe Workplace","Health and Safety","Employee Service Management"],"tags":["#employee-service-management","#type-concept"]},"task_lines":[],"task