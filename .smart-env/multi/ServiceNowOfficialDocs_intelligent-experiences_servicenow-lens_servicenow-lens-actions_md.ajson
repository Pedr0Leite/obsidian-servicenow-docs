intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":169},{"title":"Field types supported","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/field-types-supported.md","line":223},{"title":"Now Assist","target":"platform-now-assist-landing","line":313},{"title":"using ServiceNow AI Lens","target":"servicenow-lens-use","line":415},{"title":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":502},{"title":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":513},{"title":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":524},{"title":"Define a Lens action","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":790},{"title":"ServiceNow AI Lens","target":"servicenow-lens-landing-page","line":893},{"title":"Cases","target":"cases","line":894},{"title":"Trigger ServiceNow AI Lens from the desktop app","target":"preview-desktop-others-lens","line":895},{"title":"Now Assist","target":"platform-now-assist-landing","line":896},{"title":"Using ServiceNow AI Lens","target":"servicenow-lens-use","line":897}],"metadata":{"title":"Define ServiceNow AI Lens behavior with Lens actions","description":"As a Lens admin, you can create Lens actions in ServiceNow AI Lens to customize Lens behavior by providing default instructions, configuring context, and more.Create a Lens action to define custom context, trigger options, and default instructions for the ServiceNow AI Lens execution.Enable customers to scan documents related to car accident on their desktop to auto-fill the Insurance Request form on the ServiceNow instance.Enable compliance analysts to digitize and review several vendor agreements. Instead of manually entering details, they can launch ServiceNow AI Lens directly from the desktop, scan agreements, and adjust extracted values in the preview window before saving.Enable service agents to create user records by extracting specific information from identity documents using ServiceNow AI Lens, directly from the ServiceNow instance.Use ServiceNow AI Lens to map the column headers of an Excel sheet that you specify with ServiceNow table columns and then insert the Excel sheet data into the table.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/intelligent-experiences/servicenow-lens/servicenow-lens-actions.html","release":"australia","product":"ServiceNow Lens","classification":"servicenow-lens","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":22,"breadcrumb":["Configure","ServiceNow AI Lens","Enable AI experiences"],"tags":["#intelligent-experiences","#lens","#visualization","#ar","#digital-twin","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[235,257],[266,305],[333,344],[353,359],[377,384],[571,594],[643,690]]},"smart_blocks:ServiceNowOfficialDocs/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md#---frontmatter---": {"path":null,"