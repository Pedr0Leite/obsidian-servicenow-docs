owDocs/australia/markdown/platform-security/r_JDBCCredentialsForm.md","line":168},{"title":"IP address","target":"ip-address","line":276},{"title":"JDBC credentials","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/r_JDBCCredentialsForm.md","line":371},{"title":"MID Server properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/r_MIDServerProperties.md","line":427},{"title":"Create input variables","target":"CreateInputVariables","line":501},{"title":"auto-mapping option","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateAJDBCActivity.md","line":534},{"title":"Reference","target":"reference","line":540},{"title":"Check box","target":"check-box","line":541},{"title":"MID Server","target":"mid-server-landing","line":542},{"title":"MID Server capabilities","target":"mid-server-capabilities","line":543},{"title":"Connect","target":"c_Connect","line":544},{"title":"IP Address","target":"ip-address","line":545},{"title":"Create input variables","target":"CreateInputVariables","line":546}],"metadata":{"title":"Create a JDBC activity","description":"Create a custom JDBC activity to automate SQL commands and stored procedure calls to relational databases from workflow.The JDBC Connection \\[jdbc\\_connection\\] table provides the information custom JDBC Orchestration activities use to connect to various target databases.The ServiceNow activity designer allows you to map parameter values in a JDBC test payload to variables in the Outputs tab automatically.You can use Orchestration to run a stored procedure on MySQL, Oracle DB, and MS-SQL databases.You can test the input parameters of a custom JDBC activity during its development without having to run the activity in a workflow context.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/orchestration/t\\_CreateAJDBCActivity.html","release":"australia","product":"Orchestration","classification":"orchestration","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":11,"breadcrumb":["Orchestration custom activity templates","Orchestration activity designer","Classic Orchestration","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#orchestration","#itpa","#automation","#runbooks","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/orchestration/t_CreateAJDBCActivity.md"},
