ttps://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/c_MIDServerConfiguration.md","line":56},{"title":"connect","target":"c_Connect","line":74},{"title":"capabilities","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown","line":78},{"title":"Shazzam probe","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/t_ConfigureTheShazzamProbe.md","line":88},{"title":"email","target":"email","line":93},{"title":"notify","target":"notify-landing-page","line":93},{"title":"MID Server distributed clusters for Operational Intelligence","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/ops-intelligence-mid-server.md","line":111},{"title":"MID Server selection","target":"c_MIDServerSelector","line":115},{"title":"MID Server","target":"mid-server-landing","line":121},{"title":"Connect","target":"c_Connect","line":122},{"title":"Email","target":"email","line":123},{"title":"Notify","target":"notify-landing-page","line":124},{"title":"MID Server selection","target":"c_MIDServerSelector","line":125}],"metadata":{"title":"Configure a MID Server cluster","description":"Group multiple MID Servers to form clusters, then configure clusters for fail-over protection or load balancing. Load-balancing clusters automatically balance work between each MID Server to improve stability and performance, as well as handle fail-over. Fail-over clusters have a configured order used to determine which MID Server to use next if a failure occurs.MID Server clusters enable multiple MID Servers with the appropriate capabilities to be grouped together for load balancing and fail-over protection.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/mid-server/t\\_ConfigureAMIDServerCluster.html","release":"australia","product":"MID Server","classification":"mi