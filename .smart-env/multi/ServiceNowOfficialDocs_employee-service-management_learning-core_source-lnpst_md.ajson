ervicenow.com/docs/r/employee-service-management/learning-core/source-lnpst.html","release":"australia","product":"Learning Core","classification":"learning-core","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Integrating Learning Core with third-party learning management systems","Configuring Learning Core","Learning Core","HR Service Delivery","Employee Service Management"],"tags":["#employee-service-management","#learning","#lms","#courses","#training","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/learning-core/source-lnpst.md"},
