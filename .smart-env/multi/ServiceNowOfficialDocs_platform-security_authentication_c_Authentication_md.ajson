p-integration/c_LDAPIntegration.md","line":80},{"title":"Use external user self-registration to on-board a large volume of external users to your instance.","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/authentication/external-user-self-registration.md","line":86},{"title":"users","target":"users","line":89},{"title":"Access control","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/instance-security-hardening-settings/sc-access-control.md","line":94},{"title":"Security Hardening","target":"sc-hardening","line":94},{"title":"SAML","target":"c_SAML2.0WebBrowserSSOProfile","line":95},{"title":"Identity","target":"identity-landing","line":99},{"title":"OAuth Inbound","target":"oauth-inbound","line":100},{"title":"Multi-factor authentication","target":"mfa-landing","line":101},{"title":"Users","target":"users","line":102},{"title":"Security hardening","target":"sc-hardening","line":103},{"title":"SAML","target":"c_SAML2.0WebBrowserSSOProfile","line":104}],"metadata":{"title":"Authentication","description":"ServiceNow's authentication validates the identity of a user who accesses an instance, and then authorizes the user to features that match the user's role or job function.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/authentication/c\\_Authentication.html","release":"australia","product":"Authentication","classification":"authentication","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Access Management"],"tags":["#platform-security","#sso","#oauth","#saml","#mfa","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/platform-security/authentication/c_Authentication.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"n8j81c","at":1784561346029},"key"