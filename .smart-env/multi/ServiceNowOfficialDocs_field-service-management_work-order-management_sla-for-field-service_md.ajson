outlinks":[{"title":"setting up work orders and tasks","target":"setting-up-work-orders-and-tasks","line":28},{"title":"Manage a work order SLA","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/t_ManageAWorkOrderSLA.md","line":30},{"title":"View a task with an SLA","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/t_ViewATaskWithASLA.md","line":34},{"title":"Suspend and resume SLA timing from a work order","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/t_SpndRsmSLATimingWO.md","line":38},{"title":"Suspend and resume SLA timing from a work order task","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/t_SpndRsmSLATimingWOTsk.md","line":42},{"title":"Delete an SLA from a work order","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/t_DeleteAnSLAFromAWorkOrder.md","line":46},{"title":"Setting up work orders and tasks","target":"setting-up-work-orders-and-tasks","line":52}],"metadata":{"title":"SLAs for Field Service Management","description":"SLAs determine when work on a work order or work order task should be complete. SLAs are important because they keep work orders on schedule. For example, you may have a contractual obligation to complete any break/ fix work orders tasks within a certain time. You can use SLA to make sure the contractual obligation is met.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/field-service-management/work-order-management/sla-for-field-service.html","release":"australia","product":"Work Order Management","classification":"work-order-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Templates","Work orders","Set up work orders and tasks","Configure","Field Service Management"],"tags":["#field-service-management","#work-orders","#fsm","#tasks","#management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/field-service-management/work-order-management/sla-for-field-service.md"},
