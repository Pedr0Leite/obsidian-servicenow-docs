specified lead record and its associated line item records. This method returns all fields within the associated records.Processes the request body and updates the specified lead and all its associated line items, based on the passed parameters.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/LeadAPIProcessUtilOOBAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[84,89],[116,130],[165,171],[202,210],[244,248],[273,286],[338,343],[370,384],[448,453],[480,494]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/LeadAPIProcessUtilOOBAPI.md"},
