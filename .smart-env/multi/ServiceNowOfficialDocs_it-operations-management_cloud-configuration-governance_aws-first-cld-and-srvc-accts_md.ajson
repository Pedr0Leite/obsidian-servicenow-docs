arget":"aws-create-user-policy-cloud-mgt","line":142},{"title":"Set up an additional cloud account","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/cloud-configuration-governance/add-cloud-account-cloud-mgt.md","line":181},{"title":"Add an AWS service account to the cloud account","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/cloud-configuration-governance/aws-add-service-account-cloud-mgt.md","line":183},{"title":"Configure access to the AWS accounts using permanent AWS credentials","target":"aws-create-creds-cloud-mgt","line":187},{"title":"Control AWS access and permissions using policies","target":"aws-create-user-policy-cloud-mgt","line":188},{"title":"Discovery","target":"r-discovery","line":189},{"title":"Cloud Provisioning and Governance","target":"cloud-management-v2-landing-page","line":190},{"title":"Cloud Admin Portal","target":"cloud-admin-portal","line":191},{"title":"Cloud accounts","target":"cloud-accounts","line":192},{"title":"Create a service account","target":"create-service-account","line":193},{"title":"Discovery status","target":"c_DiscoveryStatus","line":194}],"metadata":{"title":"Set up a cloud account and service account for AWS","description":"A service account is a secure record on your instance that stores the credential and access information for your provider account. Discovery uses the information to access your provider account to get data on each resource in each specified datacenter. A cloud account is the logical representation in Cloud Provisioning and Governance of all or part of your managed cloud infrastructure. A cloud account can include multiple service accounts — even service accounts from different providers. For each service account, you specify which datacenters to include in the cloud account.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/c