d reviewing the records#Related":[44,48],"#Creating and reviewing the records#Related#{1}":[46,46],"#Creating and reviewing the records#Related#{2}":[47,48]},"outlinks":[{"title":"Operational Resilience","target":"grc-opres-landing-page","line":18},{"title":"Configuring Digital resilience third-party registers","target":"conf-dg-resi-party-regi","line":42},{"title":"Configuring Digital resilience third-party registers","target":"conf-dg-resi-party-regi","line":46},{"title":"Operational Resilience","target":"grc-opres-landing-page","line":47}],"metadata":{"title":"Creating and reviewing the records","description":"The Operational Resilience administrators and managers can access the Digital Resilience Choices records in an instance. For best results, it is important to create or update the records such as legal entities, branches, functions, contracts, and so on in a specific order into the Digital resilience third-party registers application. Those specifics are outlined in this section.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/order-for-creating-records.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Configuring Digital resilience third-party registers","Maintaining Digital resilience third-party registers","Manage","Operational Resilience","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/order-for-creating-records.md"},
