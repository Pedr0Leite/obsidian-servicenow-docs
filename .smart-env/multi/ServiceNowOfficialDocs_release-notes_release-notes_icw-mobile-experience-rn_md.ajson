own/industrial-connected-workforce/exploring-industrial-guided-tasks.md","line":115},{"title":"Industrial Connected Workforce release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/industrial-connected-workforce-rn-landing.md","line":120}],"metadata":{"title":"Industrial Connected Workforce Mobile Experience release notes","description":"The ServiceNow Industrial Connected Workforce Mobile Experience \\(ICW Mobile\\) application provides a mobile‑first experience for frontline industrial workers. This application enables them to perform tasks, report deviations, escalate issues, and access standards and knowledge content directly from handheld devices. Designed for reliability in high‑activity environments, ICW Mobile enables operators to stay productive whether online or offline. ICW Mobile is a new application in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":4,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/release-notes/release-notes/icw-mobile-experience-rn.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"ibu6rk","at":1784561346951},"key":"ServiceNowOfficialDocs/release-notes/release-notes/icw-mobile-experience-rn.md#---frontmatter---","lines":[1,15],"size":786,"outlinks":[],"class_name":"SmartBlock"},
