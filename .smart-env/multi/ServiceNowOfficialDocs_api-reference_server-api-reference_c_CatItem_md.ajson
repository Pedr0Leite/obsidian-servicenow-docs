,"#CatItem- Scoped#CatItem - isVisibleServicePortal\\(\\)":[512,555],"#CatItem- Scoped#CatItem - isVisibleServicePortal\\(\\)#{1}":[514,537],"#CatItem- Scoped#CatItem - isVisibleServicePortal\\(\\)#{2}":[538,538],"#CatItem- Scoped#CatItem - isVisibleServicePortal\\(\\)#{3}":[539,540],"#CatItem- Scoped#CatItem - isVisibleServicePortal\\(\\)#{4}":[541,555],"#CatItem- Scoped#CatItem - notAvailableForUserCriteria\\(String action, Array criteriaIDs\\)":[556,596],"#CatItem- Scoped#CatItem - notAvailableForUserCriteria\\(String action, Array criteriaIDs\\)#{1}":[558,582],"#CatItem- Scoped#CatItem - notAvailableForUserCriteria\\(String action, Array criteriaIDs\\)#{2}":[583,584],"#CatItem- Scoped#CatItem - notAvailableForUserCriteria\\(String action, Array criteriaIDs\\)#{3}":[585,596],"#CatItem- Scoped#CatItem - read\\(Object columns, Boolean standardUpdate\\)":[597,660],"#CatItem- Scoped#CatItem - read\\(Object columns, Boolean standardUpdate\\)#{1}":[599,636],"#CatItem- Scoped#CatItem - read\\(Object columns, Boolean standardUpdate\\)#{2}":[637,637],"#CatItem- Scoped#CatItem - read\\(Object columns, Boolean standardUpdate\\)#{3}":[638,639],"#CatItem- Scoped#CatItem - read\\(Object columns, Boolean standardUpdate\\)#{4}":[640,660],"#CatItem- Scoped#CatItem - setAttributes\\(Object attributes\\)":[661,701],"#CatItem- Scoped#CatItem - setAttributes\\(Object attributes\\)#{1}":[663,701],"#CatItem- Scoped#CatItem - setCatalogs\\(String catalogs\\)":[702,734],"#CatItem- Scoped#CatItem - setCatalogs\\(String catalogs\\)#{1}":[704,734],"#CatItem- Scoped#CatItem - setCategories\\(String categories\\)":[735,753],"#CatItem- Scoped#CatItem - setCategories\\(String categories\\)#{1}":[737,753],"#CatItem- Scoped#CatItem - setImage\\(String dbImageSysId, String type\\)":[754,816],"#CatItem- Scoped#CatItem - setImage\\(String dbImageSysId, String type\\)#{1}":[756,793],"#CatItem- Scoped#CatItem - setImage\\(String dbImageSysId, String type\\)#{2}":[794,794],"#CatItem- Scoped#CatItem - setImage\\(String dbImageSysId, String type\\)#{3}":[795,796],"#CatItem- Scoped#CatItem - setImage\\(String dbImageSysId, String type\\)#{4}":[797,816],"#CatItem- Scoped#CatItem - setTableName\\(String tableName\\)":[817,835],"#CatItem- Scoped#CatItem - setTableName\\(String tableName\\)#{1}":[819,835],"#CatItem- Scoped#CatItem - submitProducer\\(Object values\\)":[836,1120],"#CatItem- Scoped#CatItem - submitProducer\\(Object values\\)#{1}":[838,1120]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28},{"title":"deleteRecord","target":"r_DeleteRecord","line":336},{"title":"update","target":"r_Update","line":805},{"title":"deleteRecord","target":"r_DeleteRecord","line":1118},{"title":"update","target":"r_Update","line":1119}],"metadata":{"title":"CatItem - Scoped","description":"The CatItem API provides methods that enable you to create and modify service catalog items using scripts.Adds the Available For user criteria to the current catalog item.Verifies whether the current catalog item is viewable in the selected domain \\(domain selected in the domain picker\\).Determines if the user has access to view the catalog item on global search.Inserts the defined catalog item.Deletes a catalog item.Returns the first category that the user can view in a catalog.Returns an array of users for whom the associated item cannot be delegated \\(requested on behalf of\\).Returns the class name for the current catalog item record.Verifies whether the specified delegated user has acquisition rights to the current service catalog item.Determines if the current catalog item is available in service portal.Adds the Not Available For user criteria to a catalog item.Returns a mapping of catalog item attribute values.Sets attributes for a catalog item.Defines the catalogs that this catalog item is associated with.Defines the categories that this catalog item is associated with.Adds an image to a catalog item.Defines the table name for this catalog item.Creates a record using a specified Service Catalog record producer.Updates the values for specified fields of a catalog item.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_CatItem.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":12,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[78,81],[115,118],[178,182],[186,188],[228,276],[280,284],[324,343],[359,362],[366,368],[407,413],[417,424],[440,443],[447,449],[502,508],[544,548],[552,554],[592,595],[647,652],[656,659],[675,694],[698,700],[716,727],[731,733],[749,752],[804,815],[831,834],[867,884],[925,1002],[1010,1014],[1026,1078],[1103,1107]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_CatItem.md"},
