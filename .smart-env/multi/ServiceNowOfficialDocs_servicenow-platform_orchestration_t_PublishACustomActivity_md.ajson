enow.com/docs/r/servicenow-platform/orchestration/t\\_PublishACustomActivity.html","release":"australia","product":"Orchestration","classification":"orchestration","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Orchestration activity designer","Classic Orchestration","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#orchestration","#itpa","#automation","#runbooks","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/orchestration/t_PublishACustomActivity.md"},
