 reservation.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/wsd\\_reservation\\_invitees-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":11,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[135,144],[154,179],[219,224],[320,325],[473,480],[484,554],[684,689],[717,727],[731,741],[794,813],[1039,1044],[1072,1101],[1105,1112]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/wsd_reservation_invitees-api.md"},
