raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":156},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":169},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":290}],"metadata":{"title":"Workplace Connector Webhook API","description":"The Workplace Connector Webhook API is a generic interface that enables data from different kinds of workplace hardware or sensors \\(such as badging systems or occupancy sensors\\) to be stored in Workplace Service Delivery tables.Creates a record in the Connector Events \\[sn\\_wsd\\_wc\\_connector\\_events\\] table and then stores the hardware/sensor-based event data passed in the endpoint's payload into the Payload field of that record.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/workplace\\_connector\\_webhook-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[132,145],[197,203],[239,268],[272,286]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/workplace_connector_webhook-api.md"},
