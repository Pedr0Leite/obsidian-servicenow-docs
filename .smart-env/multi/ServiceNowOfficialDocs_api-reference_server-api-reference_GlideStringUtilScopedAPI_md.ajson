tringUtil - escapeNonPrintable\\(String sourceString\\)#{1}":[130,151],"#GlideStringUtil - Scoped, Global#GlideStringUtil - escapeQueryTermSeparator\\(String sourceString\\)":[152,175],"#GlideStringUtil - Scoped, Global#GlideStringUtil - escapeQueryTermSeparator\\(String sourceString\\)#{1}":[154,175],"#GlideStringUtil - Scoped, Global#GlideStringUtil - escapeTicks\\(String sourceString\\)":[176,199],"#GlideStringUtil - Scoped, Global#GlideStringUtil - escapeTicks\\(String sourceString\\)#{1}":[178,199],"#GlideStringUtil - Scoped, Global#GlideStringUtil - getHTMLValue\\(String sourceString\\)":[200,225],"#GlideStringUtil - Scoped, Global#GlideStringUtil - getHTMLValue\\(String sourceString\\)#{1}":[202,225],"#GlideStringUtil - Scoped, Global#GlideStringUtil - getNumeric\\(String sourceString\\)":[226,249],"#GlideStringUtil - Scoped, Global#GlideStringUtil - getNumeric\\(String sourceString\\)#{1}":[228,249],"#GlideStringUtil - Scoped, Global#GlideStringUtil - isBase64\\(String sourceString\\)":[250,332],"#GlideStringUtil - Scoped, Global#GlideStringUtil - isBase64\\(String sourceString\\)#{1}":[252,273],"#GlideStringUtil - Scoped, Global#GlideStringUtil - isBase64\\(String sourceString\\)#{2}":[274,274],"#GlideStringUtil - Scoped, Global#GlideStringUtil - isBase64\\(String sourceString\\)#{3}":[275,276],"#GlideStringUtil - Scoped, Global#GlideStringUtil - isBase64\\(String sourceString\\)#{4}":[277,332],"#GlideStringUtil - Scoped, Global#GlideStringUtil - newLinesToBreaks\\(String sourceString\\)":[333,356],"#GlideStringUtil - Scoped, Global#GlideStringUtil - newLinesToBreaks\\(String sourceString\\)#{1}":[335,356],"#GlideStringUtil - Scoped, Global#GlideStringUtil - normalizeWhitespace\\(String sourceString\\)":[357,380],"#GlideStringUtil - Scoped, Global#GlideStringUtil - normalizeWhitespace\\(String sourceString\\)#{1}":[359,380],"#GlideStringUtil - Scoped, Global#GlideStringUtil - unEscapeHTML\\(String htmlString\\)":[381,424],"#GlideStringUtil - Scoped, Global#GlideStringUtil - unEscapeHTML\\(String htmlString\\)#{1}":[383,424],"#GlideStringUtil - Scoped, Global#GlideStringUtil - urlEncode\\(String url\\)":[425,451],"#GlideStringUtil - Scoped, Global#GlideStringUtil - urlEncode\\(String url\\)#{1}":[427,451]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28}],"metadata":{"title":"GlideStringUtil - Scoped, Global","description":"The GlideStringUtil API provides string handling methods.Replaces periods with underscore characters.Removes quotes from a string.Replaces problem characters with escape characters.Replaces illegal characters with their escape codes.Replaces non-printable characters with their printable notation.Replaces query term separators \"^\" with their escape sequence \"^^\".Replaces quotes with escape characters by adding a backslash before each quote.Replaces illegal HTML characters into HTML notation.Extracts numeric characters from a string.Validates whether the specified string is a valid base64 string.Validates whether the specified string is in valid sys\\_id format.Replaces the new line character, /n, with a break code, &lt;br/&gt;.Replaces carriage returns, line feeds, and tabs with spaces, and then removes leading, trailing, and duplicate spaces.Replaces escape characters with their respective character.Encodes non-ASCII characters, unsafe ASCII characters, and spaces so you can use the returned string on the Internet. Uses UTF-8 encoding. Uses percent \\(%\\) encoding.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/GlideStringUtilScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[42,46],[50,52],[66,70],[74,76],[90,94],[98,100],[116,120],[124,126],[140,144],[148,150],[164,168],[172,174],[188,192],[196,198],[214,218],[222,224],[238,242],[246,248],[283,287],[289,325],[329,331],[345,349],[353,355],[369,373],[377,379],[399,403],[407,409],[413,417],[421,423],[439,443],[447,449]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GlideStringUtilScopedAPI.md"},
