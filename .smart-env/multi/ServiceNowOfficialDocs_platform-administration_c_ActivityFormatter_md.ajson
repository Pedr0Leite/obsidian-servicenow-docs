261],"#Activity formatter#Configure activity formatter colors#Procedure":[262,309],"#Activity formatter#Configure activity formatter colors#Procedure#{1}":[264,265],"#Activity formatter#Configure activity formatter colors#Procedure#{2}":[266,271],"#Activity formatter#Configure activity formatter colors#Procedure#{3}":[272,278],"#Activity formatter#Configure activity formatter colors#Procedure#{4}":[279,284],"#Activity formatter#Configure activity formatter colors#Procedure#{5}":[285,288],"#Activity formatter#Configure activity formatter colors#Procedure#{6}":[289,294],"#Activity formatter#Configure activity formatter colors#Procedure#{7}":[295,299],"#Activity formatter#Configure activity formatter colors#Procedure#{8}":[300,305],"#Activity formatter#Configure activity formatter colors#Procedure#{9}":[306,309],"#Activity formatter#Related":[310,318],"#Activity formatter#Related#{1}":[312,312],"#Activity formatter#Related#{2}":[313,313],"#Activity formatter#Related#{3}":[314,314],"#Activity formatter#Related#{4}":[315,315],"#Activity formatter#Related#{5}":[316,316],"#Activity formatter#Related#{6}":[317,318]},"outlinks":[{"title":"journal fields","target":"r_JournalFields","line":18},{"title":"Using formatters","target":"c_Formatters","line":30},{"title":"User presence","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_UserPresence.md","line":35},{"title":"system properties","target":"r_SetArchiveRuleProcessingBehavior","line":86},{"title":"email properties","target":"c_EmailProperties","line":161},{"title":"System Mailboxes","target":"c_SystemMailboxes","line":161},{"title":"Add a system property","target":"t_AddAPropertyUsingSysPropsList","line":242},{"title":"Using formatters","target":"c_Formatters","line":312},{"title":"Add a system property","target":"t_AddAPropertyUsingSysPropsList","line":313},{"title":"Journal fields","target":"r_JournalFields","line":314},{"title":"System properties","target":"r_SetArchiveRuleProcessingBehavior","line":315},{"title":"Email properties","target":"c_EmailProperties","line":316},{"title":"System mailboxes","target":"c_SystemMailboxes","line":317}],"metadata":{"title":"Activity formatter","description":"The activity formatter provides an easy way to track items not saved with a field in the record, for example, journal fields like comments and work notes.You can create an activity formatter for any audited table.Add an activity formatter to any form to track journal fields on the form.Enable the Live Feed-Activity toggle, which allows users to switch between the activity feed and the document feed for a record.You can customize which fields appear in the activity formatter. You can add or remove fields from the list of activities that users can select when they open the activity filter.The system property glide.ui.activity.email\\_roles enables you to control which roles can see emails in the activity formatter.Use the glide.max\\_activity\\_size property to increase the amount of content that can be visible in the Activity Formatter.The glide.ui16.emailStreamResponseActions system property determines whether a user can reply to email using the email reply button in the activity stream in Core UI.Use the glide.ui.activity\\_stream.style.comments and glide.ui.activity\\_stream.style.work\\_notes properties to change the color-coding in the Activity Formatter.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/c\\_ActivityFormatter.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Formatters","Administer","Form administration","Forms","fields","and lists","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/c_ActivityFormatter.md"},
