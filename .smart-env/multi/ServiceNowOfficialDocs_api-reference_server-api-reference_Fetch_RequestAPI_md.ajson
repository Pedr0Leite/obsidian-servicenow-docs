lobal#Fetch Request - json\\(\\)":[742,768],"#Fetch Request- Scoped, Global#Fetch Request - json\\(\\)#{1}":[744,768],"#Fetch Request- Scoped, Global#Fetch Request - text\\(\\)":[769,795],"#Fetch Request- Scoped, Global#Fetch Request - text\\(\\)#{1}":[771,795],"#Fetch Request- Scoped, Global#Related":[796,799],"#Fetch Request- Scoped, Global#Related#{1}":[798,799]},"outlinks":[{"title":"Fetch - fetch\\(String resource, Object options\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/FetchAPI.md","line":28},{"title":"Fetch Headers - Scoped, Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/Fetch.HeadersAPI.md","line":29},{"title":"Fetch Request - Scoped, Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/Fetch.RequestAPI.md","line":30},{"title":"Fetch RequestInit - Scoped, Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/Fetch.RequestInitAPI.md","line":31},{"title":"Fetch Response - Scoped,Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/Fetch.ResponseAPI.md","line":32},{"title":"Available system properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/r_AvailableSystemProperties.md","line":34},{"title":"https://developer.mozilla.org/en-US/docs/Web/API/Request","target":"https://developer.mozilla.org/en-US/docs/Web/API/Request","line":38},{"title":"update","target":"r_Update","line":117},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":523},{"title":"Fetch RequestInit - Scoped, Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/Fetch.RequestInitAPI.md","line":571},{"title":"arrayBuffer","target":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/ArrayBuffer","line":618},{"title":"Blob","target":"https://developer.mozilla.org/en-US/docs/Web/API/Blob","line":645},{"title":"Uint8Array","target":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Uint8Array","line":675},{"title":"Fetch Request - Request\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/Fetch.RequestAPI.md","line":702},{"title":"FormData","target":"https://developer.mozilla.org/en-US/docs/Web/API/FormData","line":721},{"title":"update","target":"r_Update","line":798}],"metadata":{"title":"Fetch Request - Scoped, Global","description":"The Fetch Request API contains methods for creating or retrieving a Request object to allow applications to asynchronously request resources, such as JSON, text, or binary data, from a server, and handle the response. This API supports various HTTP methods like GET, POST, PUT, DELETE, and so on.Creates a new Request object. Optionally create the Request object from a URL or object resource.Reads the request body and returns it as a promise that resolves with an arrayBuffer.Reads the request body and returns it as a promise that resolves with a Blob.Reads the request body and returns it as a promise that resolves with an Uint8Array.Creates a copy of the current Request object.Reads the request body and returns it as a promise that resolves with a FormData object.Reads the request body, parses the content as JSON, and returns a promise that resolves with the parsed result.Reads the request body and returns it as a promise that resolves with a String decoded using UTF-8.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/Fetch.RequestAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":16,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[62,69],[86,97],[130,209],[227,230],[266,275],[287,290],[302,307],[324,350],[367,374],[386,389],[410,413],[433,436],[448,451],[463,466],[478,505],[517,520],[576,579],[583,593],[597,606],[622,633],[649,663],[679,690],[706,709],[725,740],[756,767],[783,794]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/Fetch.RequestAPI.md"},
