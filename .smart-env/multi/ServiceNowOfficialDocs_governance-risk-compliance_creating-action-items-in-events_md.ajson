#{2}":[207,207],"#Creating action items in events#Related#{3}":[208,209]},"outlinks":[{"title":"event assets","target":"event-assets","line":18},{"title":"Create task and assessment-type action items in events","target":"create-action-items-in-events","line":199},{"title":"Structured workflows for Exercises","target":"performing-tasks-to-manage-exercise-events","line":202},{"title":"Create task and assessment-type action items in events","target":"create-action-items-in-events","line":206},{"title":"Structured workflows for Exercises","target":"performing-tasks-to-manage-exercise-events","line":207},{"title":"Event assets","target":"event-assets","line":208}],"metadata":{"title":"Creating action items in events","description":"Starting with BCM release 9.0.x, crisis managers can create action tasks for recovery members or teams anytime during a crisis event or exercise, as long as the event remains open. Crisis managers can create these tasks on the fly without mapping them to event assets or recovery plans. These action tasks are also not included in the event recovery timeline.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/creating-action-items-in-events.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Structured workflows for Exercises","Manage","Business Continuity Management","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/creating-action-items-in-events.md"},
