t it will be deprecated in a future release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":1,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/wfo-hr-rn.md"},
