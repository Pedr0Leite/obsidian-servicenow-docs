ing classification rules#Deactivate or delete a classification rule#Procedure":[296,313],"#Configuring classification rules#Deactivate or delete a classification rule#Procedure#{1}":[298,299],"#Configuring classification rules#Deactivate or delete a classification rule#Procedure#{2}":[300,301],"#Configuring classification rules#Deactivate or delete a classification rule#Procedure#{3}":[302,303],"#Configuring classification rules#Deactivate or delete a classification rule#Procedure#{4}":[304,305],"#Configuring classification rules#Deactivate or delete a classification rule#Procedure#{5}":[306,307],"#Configuring classification rules#Deactivate or delete a classification rule#Procedure#{6}":[308,309],"#Configuring classification rules#Deactivate or delete a classification rule#Procedure#{7}":[310,311],"#Configuring classification rules#Deactivate or delete a classification rule#Procedure#{8}":[312,313],"#Configuring classification rules#Related":[314,324],"#Configuring classification rules#Related#{1}":[316,316],"#Configuring classification rules#Related#{2}":[317,317],"#Configuring classification rules#Related#{3}":[318,318],"#Configuring classification rules#Related#{4}":[319,319],"#Configuring classification rules#Related#{5}":[320,320],"#Configuring classification rules#Related#{6}":[321,321],"#Configuring classification rules#Related#{7}":[322,322],"#Configuring classification rules#Related#{8}":[323,324]},"outlinks":[{"title":"discovered items","target":"cj-discovered-items","line":19},{"title":"vulnerabilities","target":"vulnerabilities","line":19},{"title":"Configure rules to manage findings","target":"sem-configure-rules-manage-findings","line":23},{"title":"Categorizing findings and discovered items using classification rules","target":"sem-categorizing-findings-discovered-items","line":28},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"sem-acls-for-admin-rules","line":36},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":40},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/sem-acls-for-admin-rules.md","line":104},{"title":"Create and define filter groups in Security Operations","target":"create-filter-group","line":193},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/sem-acls-for-admin-rules.md","line":263},{"title":"Deactivate or delete a classification rule","target":"delete-vulnerability-classification-rule","line":282},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/sem-acls-for-admin-rules.md","line":286},{"title":"Configure rules to manage findings","target":"sem-configure-rules-manage-findings","line":316},{"title":"Categorizing findings and discovered items using classification rules","target":"sem-categorizing-findings-discovered-items","line":317},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"sem-acls-for-admin-rules","line":318},{"title":"Create and define filter groups in Security Operations","target":"create-filter-group","line":319},{"title":"Vulnerabilities","target":"vulnerabilities","line":320},{"title":"Discovered Items","target":"cj-discovered-items","line":321},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":322},{"title":"Deactivate or delete a classification rule","target":"delete-vulnerability-classification-rule","line":323}],"metadata":{"title":"Configuring classification rules","description":"By configuring classification rules, you can ensure consistent categorization and processing of vulnerabilities, discovered items and other finding related entities based on key attributes. This helps the system route findings to the correct tables, apply the appropriate grouping, assignment, and remediation rules, enhance reporting accuracy, and determine which business logic to use \\(such as prioritization and remediation targets\\).Create groups so that the underlying rules of this group can classify the entities or records in a specified table based on the conditions. The rules can be used to select any field in the corresponding table.Create rules to classify entities or records in the specified table into choice of classifications for use in downstream process or rules.Rerun all active rules on all the findings when you modify a classification rule. You can also update existing vulnerabilities by applying the new classification rules.Deactivate or delete a classification rule if it is no longer needed or relevant.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/sem-configure-classification-rules.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"keywords":["configure classification rules"],"breadcrumb":["Configure rules to manage findings","Implement","Unified Security Exposure Management","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/sem-configure-classification-rules.md"},
