.servicenow.com/docs/r/source-to-pay-operations/accounts-payable-operations/recommend-invoice-owner-ai-agent.html","release":"australia","product":"Accounts Payable Operations","classification":"accounts-payable-operations","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"keywords":["AI agent","Now Assist","APO","Accounts Payable Operations","invoice exception","Non-PO matching","purchase order","Non-PO","AI automation"],"breadcrumb":["Using AI agents in Now Assist for Accounts Payable Operations","Now Assist for APO","Accounts Payable Operations","Finance and Supply Chain"],"tags":["#source-to-pay-operations","#ap","#invoices","#payables","#fsc","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/source-to-pay-operations/accounts-payable-operations/recommend-invoice-owner-ai-agent.md"},
