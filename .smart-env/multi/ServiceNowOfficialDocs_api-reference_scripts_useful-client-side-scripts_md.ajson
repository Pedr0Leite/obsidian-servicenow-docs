e script use cases#Create a UI routing action#Procedure#{1}":[219,220],"#Client-side script use cases#Create a UI routing action#Procedure#{2}":[221,222],"#Client-side script use cases#Create a UI routing action#Procedure#{3}":[223,224],"#Client-side script use cases#Create a UI routing action#Procedure#{4}":[225,230],"#Client-side script use cases#Create a UI routing action#Procedure#{5}":[231,232],"#Client-side script use cases#Create a UI routing action#Procedure#{6}":[233,234],"#Client-side script use cases#Create a UI routing action#Procedure#{7}":[235,236],"#Client-side script use cases#Create a UI routing action#Procedure#{8}":[237,268],"#Client-side script use cases#Create a UI routing action#Procedure#{9}":[269,270],"#Client-side script use cases#Create a UI routing action#Procedure#{10}":[271,291],"#Client-side script use cases#Display field messages":[292,365],"#Client-side script use cases#Display field messages#{1}":[294,321],"#Client-side script use cases#Display field messages#{2}":[322,322],"#Client-side script use cases#Display field messages#{3}":[323,323],"#Client-side script use cases#Display field messages#{4}":[324,324],"#Client-side script use cases#Display field messages#{5}":[325,326],"#Client-side script use cases#Display field messages#{6}":[327,365],"#Client-side script use cases#Using client and server code in a UI action":[366,461],"#Client-side script use cases#Using client and server code in a UI action#{1}":[368,397],"#Client-side script use cases#Using client and server code in a UI action#gsftSubmit\\(String control, Object form, String action\\_name\\)":[398,461],"#Client-side script use cases#Using client and server code in a UI action#gsftSubmit\\(String control, Object form, String action\\_name\\)#{1}":[400,461],"#Client-side script use cases#Related":[462,471],"#Client-side script use cases#Related#{1}":[464,464],"#Client-side script use cases#Related#{2}":[465,465],"#Client-side script use cases#Related#{3}":[466,466],"#Client-side script use cases#Related#{4}":[467,467],"#Client-side script use cases#Related#{5}":[468,468],"#Client-side script use cases#Related#{6}":[469,469],"#Client-side script use cases#Related#{7}":[470,471]},"outlinks":[{"title":"Useful scripts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/usefulScripts.md","line":26},{"title":"Service Catalog checkout models","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/c_EnableATwoStepCheckout.md","line":42},{"title":"Personalize a form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/t_PersonalizeAForm.md","line":43},{"title":"UI Macros","target":"c_UIMacros","line":47},{"title":"UI macros","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_UIMacros.md","line":107},{"title":"UI Pages","target":"r_UIPages","line":109},{"title":"update","target":"r_Update","line":122},{"title":"forum","target":"http://community.service-now.com/","line":187},{"title":"insert","target":"r_Insert","line":250},{"title":"client scripts","target":"client-scripts","line":298},{"title":"GlideForm - getFormElement\\(\\)","target":"c_GlideFormAPI","line":454},{"title":"Scoped GlideSystem - eventQueue\\(String name, Object instance, String parm1, String parm2, String queue\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideSystemScopedAPI.md","line":456},{"title":"GlideUser - Client","target":"c_GlideUserAPI","line":458},{"title":"Defining UI actions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/c_UIActions.md","line":460},{"title":"GlideForm \\(g\\_form\\) - Client","target":"c_GlideFormAPI","line":464},{"title":"GlideUser - Client","target":"c_GlideUserAPI","line":465},{"title":"Client scripts","target":"client-scripts","line":466},{"title":"UI macros","target":"c_UIMacros","line":467},{"title":"UI pages","target":"r_UIPages","line":468},{"title":"insert","target":"r_Insert","line":469},{"title":"update","target":"r_Update","line":470}],"metadata":{"title":"Client-side script use cases","description":"Use cases for client-side scripts include displaying field messages, changing form colors, adding fields, and creating UI routing actions.This is an example of adding a Company field to the checkout below the Requested for field using non-cart layout macros, that is, glide.sc.use\\_cart\\_layouts is false.Add autofill functionality is also called incident template, auto assignments, quick calls, call script, or auto populate.Changes color of a form field of the form on state change. The script can easily be changed to adjust any property of any object on the page accessible via the HTML DOM.This solution enables you to create a record with the service desk without knowing whether it is an incident or request item; the service desk can then route the record to the appropriate table.Rather than use JavaScript alert\\(\\), for a cleaner look, you can display an error on the form itself. The methods showFieldMsg\\(\\) and hideFieldMsg\\(\\) can be used to display a message just below the field itself.You can use a script to validate input upon a UI Action click on the client side before updating the record on the server side. The user will not have to click the button twice to validate the required fields and update the record.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/scripts/useful-client-side-scripts.html","release":"australia","product":"Scripts","classification":"scripts","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["Useful scripts","Scripting","API implementation","API implementation and reference"],"tags":["#api-reference","#script-includes","#server-side","#glideajax","#library","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[51,53],[57,86],[90,105],[113,125],[144,165],[197,207],[239,267],[273,289],[331,337],[341,359],[372,396]],"key":"ServiceNowOfficialDocs/api-reference/scripts/useful-client-side-scripts.md"},
