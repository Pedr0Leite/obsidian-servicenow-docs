ices Core","target":"install-public-sector-digital-services-core","line":20},{"title":"Install License and Permit Playbook for Public Sector Digital Services","target":"install-psds-license-permit-request-playbook","line":24},{"title":"Services Offered and Services Received Migration Guidance","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB1559449","line":25},{"title":"Configure service definition catalog items for License and Permit Playbook application","target":"psds-create-service-definition-catalog-item","line":25},{"title":"publish","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/publish-virtual-agent-topic.md","line":26},{"title":"Enable public sector end users to create a License or Permit request using Virtual Agent","target":"psds-configuring-va","line":26},{"title":"Configure Virtual Agent for License and Permit Playbook","target":"psds-lpr-configure-va","line":26},{"title":"Automatically route license and permit requests using Advanced Work Assignment","target":"awa-psds-overview","line":27},{"title":"Configure License and Permit Eligibility Framework in License and Permit Playbook","target":"psds-configure-eligibility-lpr","line":28},{"title":"Configure decision tables for License and Permit Playbook","target":"psds-configure-decision-tables","line":29},{"title":"Create Document Templates for License and Permit Playbook","target":"psds-lpr-configure-doc-template","line":30},{"title":"Install Public Sector Digital Services Core","target":"install-public-sector-digital-services-core","line":34},{"title":"Install License and Permit Playbook for Public Sector Digital Services","target":"install-psds-license-permit-request-playbook","line":35},{"title":"Configure service definition catalog items for License and Permit Playbook application","target":"psds-create-service-definition-catalog-item","line":36},{"title":"Configure Virtual Agent for Public Sector Digital Services","target":"psds-configuring-va","line":37},{"title":"Configure Virtual Agent for License and Permit Playbook","target":"psds-lpr-configure-va","line":38},{"title":"Configure Advanced Work Assignment for Public Sector Digital Services","target":"awa-psds-overview","line":39},{"title":"Configure License and Permit Eligibility Framework in License and Permit Playbook","target":"psds-configure-eligibility-lpr","line":40},{"title":"Configure decision tables for License and Permit Playbook","target":"psds-configure-decision-tables","line":41},{"title":"Create Document Templates for License and Permit Playbook","target":"psds-lpr-configure-doc-template","line":42}],"metadata":{"title":"Install and configure the License and Permit Playbook application","description":"Install the License and Permit Playbook application, which enables public sector end users to submit and track license and permit requests and provides government agents with a pre-defined process for handling and resolving these requests. You can then configure the features available for submitting requests and routing requests to agents.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/government-industry/configuring-license-permit-playbook.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Playbooks and Solutions","Configure agent workspaces","Configure","Public Sector Digital Services \\(PSDS\\)"],"tags":["#government-industry","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/government-industry/configuring-license-permit-playbook.md"},
