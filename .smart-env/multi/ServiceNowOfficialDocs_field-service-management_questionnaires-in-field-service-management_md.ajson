line":18},{"title":"Survey-based questionnaires","target":"survey-based-questionnaires","line":47},{"title":"Smart Assessment Questionnaires","target":"smart-assessment-questionnaire","line":49},{"title":"Survey-based questionnaires","target":"survey-based-questionnaires","line":53},{"title":"Smart Assessment Questionnaires","target":"smart-assessment-questionnaire","line":54},{"title":"Field Service Management","target":"fsm-application-landing-page","line":55}],"metadata":{"title":"Questionnaires in Field Service Management","description":"Field Service Management supports questionnaires as a structured mechanism for collecting information from field service agents during the execution of work orders and work order tasks. Questionnaires can be used at any stage of a task—before work begins, while work is in progress, or as a condition for closing a task—and can be made mandatory to enforce compliance and completeness.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/field-service-management/questionnaires-in-field-service-management.html","release":"australia","topic_type":"concept","last_updated":"2026-06-04","reading_time_minutes":2,"breadcrumb":["Explore","Field Service Management"],"tags":["#field-service-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/field-service-management/questionnaires-in-field-service-management.md"},
