wn/servicenow-platform/knowledge-management/config-search-results-filter-facets.md","line":764},{"title":"Translate a knowledge article from a translation task","target":"translate-knowledge-article","line":798},{"title":"Knowledge Management properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":866},{"title":"Knowledge portal properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":868},{"title":"Knowledge search properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":870},{"title":"Knowledge article view properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":872},{"title":"Knowledge homepage properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":874},{"title":"Article quality index properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":876},{"title":"Knowledge subscription properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":878},{"title":"External Content Integration Properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":880},{"title":"Other knowledge properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/r_KnowledgeProperties.md","line":882},{"title":"Activate the Knowledge Management Advanced plugin","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/activate-knowledge-advanced-plugin.md","line":888},{"title":"Article versioning","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/article-versioning.md","line":888},{"title":"ownership groups","target":"enable-ownership-group","line":1128},{"title":"Knowledge Management","target":"knowledge-management","line":1175},{"title":"Check box","target":"check-box","line":1176},{"title":"Label","target":"label","line":1177},{"title":"Article versioning","target":"article-versioning","line":1178},{"title":"Attachment","target":"attachment","line":1179},{"title":"Knowledge blocks","target":"knowledge-blocks","line":1180},{"title":"Yes/No","target":"yes-no","line":1181},{"title":"Work notes","target":"c_WorkNotes","line":1182},{"title":"Reference","target":"reference","line":1183},{"title":"HTML","target":"html","line":1184},{"title":"Email","target":"email","line":1185},{"title":"UI page","target":"ui-page","line":1186},{"title":"Translate a knowledge article from a translation task","target":"translate-knowledge-article","line":1187},{"title":"Ownership groups","target":"enable-ownership-group","line":1188}],"metadata":{"title":"Knowledge Management properties","description":"As an administrator, you can configure the look and functionality of many knowledge base features with Knowledge Management properties.Knowledge portal properties control the look and functionality of the legacy portal page. This portal page lists recent knowledge articles and their publishing dates, organized by topic.Knowledge search properties give you control over the search options available to users and the presentation of search results.Article view properties give you control over the meta data and rating options that appear with articles. They also enable you to grant access to individual feedback options based on user role.Knowledge homepage properties control the featured content on the knowledge homepage.Other knowledge properties let you control general knowledge management features.The knowledge administrator can set knowledge properties that enable users to edit specific fields on published articles without creating new versions.The knowledge administrator can set configuration properties that enable users to subscribe to knowledge bases and knowledge articles.The knowledge administrator can set the pass score for AQI reviews using the knowledge properties page.Administrators can configure the properties to add allowed content types and change the UI label for the external content integration feature.The Knowledge administrator can set configuration properties that would create actionable feedback tasks.The knowledge administrator can set group ownership properties that enable the use of ownership groups for knowledge articles and decide who can edit and approve a published knowledge article.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/knowledge-management/r\\_KnowledgeProperties.html","release":"australia","product":"Knowledge Management","classification":"knowledge-management","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":33,"breadcrumb":["Knowledge Management reference","Knowledge Management","Manage content capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#knowledge-management","#kb","#articles","#search","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/servicenow-platform/knowledge-management/r_KnowledgeProperties.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1xlcnp3","at":1784561353370},"key":"ServiceNowOfficialDocs/servicenow-platform/knowledge-management/r_KnowledgeProperties.md#---frontmatter---","lines":[1,20],"size":2231,"outlinks":[],"class_name":"SmartBlock"},
