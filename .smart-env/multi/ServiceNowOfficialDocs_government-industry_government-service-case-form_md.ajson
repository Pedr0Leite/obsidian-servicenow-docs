e form#{24}":[200,200],"#Government Service Case form#{25}":[201,201],"#Government Service Case form#{26}":[202,203],"#Government Service Case form#{27}":[204,278],"#Government Service Case form#{28}":[279,280],"#Government Service Case form#{29}":[281,413],"#Government Service Case form#Government Service Case form related lists":[414,534],"#Government Service Case form#Government Service Case form related lists#{1}":[416,534],"#Government Service Case form#Related":[535,538],"#Government Service Case form#Related#{1}":[537,538]},"outlinks":[{"title":"Public Sector Digital Services Core Case Forms","target":"psds-case-forms","line":412},{"title":"Public Sector Digital Services Core Case Forms","target":"psds-case-forms","line":537}],"metadata":{"title":"Government Service Case form","description":"A government service agent creates a case to identify a constituent's request, and to track the activities related to resolving the issue. The Case form captures and displays detailed information about a constituent's issue or request.The Case form includes related lists that store case information and that agents can use to perform case-related tasks. Government agents are able to access a service request case, information request case, or license and permit case and view the following related lists.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/government-industry/government-service-case-form.html","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Public Service Case Forms","Forms","Reference","Public Sector Digital Services \\(PSDS\\)"],"tags":["#government-industry","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/government-industry/government-service-case-form.md"},
