erviceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":625},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":625},{"title":"Encoded query","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_EncodedQueryStrings.md","line":670},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":679},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":691},{"title":"Scripted REST Service form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":891},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":891},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":940},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":952},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":1151},{"title":"Help Request API","target":"help-request-api","line":1152},{"title":"REST APIs","target":"c_RESTAPI","line":1153},{"title":"insert","target":"r_Insert","line":1154},{"title":"update","target":"r_Update","line":1155}],"metadata":{"title":"Remote help request API","description":"The Remote help request API provides endpoints to create, view, and fetch lists of IT service requests and their details from an electronic medical record \\(EMR\\) system. An IT service request is associated with a task type such as an incident in the ServiceNow instance.Inserts electronic medical record \\(EMR\\) system data into the corresponding ServiceNow tables.Updates a record in the specified remote request data table for the task.Fetches a list of tasks that match the specified ID and query filter.Fetches a single task as specified in the task\\_id.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/remote\\_help\\_request-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":16,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[97,110],[124,126],[138,145],[193,204],[284,311],[315,336],[409,414],[428,430],[442,447],[495,504],[568,585],[589,608],[717,727],[799,807],[811,870],[978,988],[1060,1065],[1069,1147]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/remote_help_request-api.md"},
