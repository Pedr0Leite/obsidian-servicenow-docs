emaAPI - getCopyName\\(Object recordData\\)#{5}":[332,348],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - getCopyName\\(Object recordData\\)#{6}":[349,349],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - getCopyName\\(Object recordData\\)#{7}":[350,351],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - getCopyName\\(Object recordData\\)#{8}":[352,408],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)":[409,507],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)#{1}":[411,437],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)#{2}":[438,438],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)#{3}":[439,439],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)#{4}":[440,441],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)#{5}":[442,460],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)#{6}":[461,461],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)#{7}":[462,463],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)#{8}":[464,507],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - verifyCopyOperation\\(String transactionId\\)":[508,566],"#CopyDynamicSchemaAPI- Scoped, Global#CopyDynamicSchemaAPI - verifyCopyOperation\\(String transactionId\\)#{1}":[510,566],"#CopyDynamicSchemaAPI- Scoped, Global#Related":[567,570],"#CopyDynamicSchemaAPI- Scoped, Global#Related#{1}":[569,570]},"outlinks":[{"title":"CopyDynamicSchemaAPI - verifyCopyOperation\\(String transactionId\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":48},{"title":"CopyDynamicSchemaAPI - shouldCopy\\(Object recordData\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":49},{"title":"CopyDynamicSchemaAPI - getCopyName\\(Object recordData\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":50},{"title":"CopyDynamicSchemaAPI - getCopyApi\\(String categoryToCopy, String verificationKey\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":58},{"title":"CopyDynamicSchemaAPI - skipAttributes\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":59},{"title":"CopyDynamicSchemaAPI - skipChoiceSets\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":59},{"title":"CopyDynamicSchemaAPI - skipChoiceOverrides\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":59},{"title":"CopyDynamicSchemaAPI - getTransactionId\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":60},{"title":"CopyDynamicSchemaAPI - runAsync\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":61},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":66},{"title":"CopyDynamicSchemaAPI - getTransactionId\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CopyDynamicSchemaAPI.md","line":110},{"title":"insert","target":"r_Insert","line":247},{"title":"insert","target":"r_Insert","line":569}],"metadata":{"title":"CopyDynamicSchemaAPI - Scoped, Global","description":"The CopyDynamicSchemaAPI class provides methods and extension points for duplicating dynamic schema metadata.Creates and returns a CopyDynamicSchemaAPI object used to execute the copy operation. This method is provided in the DynamicSchemaCopyController class.Preset enabling users to skip the copying of attributes during the copy operation.Preset enabling users to skip the copying of all choice overrides during the copy operation.Preset enabling users to skip the copying of all choice sets and choices during the copy operation. All copied elements that would’ve linked to the copied choice set or choice will link to the original choice set or choice instead.Generates and returns a unique transaction ID for each copy operation you start. This ID is used to track the operation and is passed to extension points for validation and custom logic. This method is provided in the DynamicSchemaCopyController class.Starts the copy process for dynamic schema components and returns a transaction ID for identifying the copy operation. This method is provided in the DynamicSchemaCopyController class.Extension point method allowing custom names for a copy or an auto-generated name if empty or null. This extension point method is provided in the DynamicSchemaCopyController JavaScript class.Extension point method for creating custom copy operations by allowing users to specify whether a particular record should be copied. The method returns true if the record is to be copied and false if it should be skipped.Extension point method used to verify the transaction ID of the copy operation before returning the matching verification key from getCopyApi\\(\\), ensuring relevance to the extension point implementation. This extension point method is provided in the DynamicSchemaCopyController class.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/CopyDynamicSchemaAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":13,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[119,123],[127,129],[147,151],[155,157],[173,177],[181,183],[199,203],[207,209],[240,250],[254,256],[289,293],[297,299],[363,401],[405,407],[467,504],[522,559],[563,565]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/CopyDynamicSchemaAPI.md"},
