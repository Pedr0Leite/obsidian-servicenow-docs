sibility search methods#{5}":[118,119],"#Using accessibility features#View card details in a Visual Task Board":[120,145],"#Using accessibility features#View card details in a Visual Task Board#{1}":[122,123],"#Using accessibility features#View card details in a Visual Task Board#Before you begin":[124,129],"#Using accessibility features#View card details in a Visual Task Board#Before you begin#{1}":[126,129],"#Using accessibility features#View card details in a Visual Task Board#Procedure":[130,145],"#Using accessibility features#View card details in a Visual Task Board#Procedure#{1}":[132,133],"#Using accessibility features#View card details in a Visual Task Board#Procedure#{2}":[134,135],"#Using accessibility features#View card details in a Visual Task Board#Procedure#{3}":[136,137],"#Using accessibility features#View card details in a Visual Task Board#Procedure#{4}":[138,139],"#Using accessibility features#View card details in a Visual Task Board#Procedure#{5}":[140,141],"#Using accessibility features#View card details in a Visual Task Board#Procedure#{6}":[142,143],"#Using accessibility features#View card details in a Visual Task Board#Procedure#{7}":[144,145],"#Using accessibility features#Related":[146,157],"#Using accessibility features#Related#{1}":[148,148],"#Using accessibility features#Related#{2}":[149,149],"#Using accessibility features#Related#{3}":[150,150],"#Using accessibility features#Related#{4}":[151,151],"#Using accessibility features#Related#{5}":[152,152],"#Using accessibility features#Related#{6}":[153,153],"#Using accessibility features#Related#{7}":[154,154],"#Using accessibility features#Related#{8}":[155,155],"#Using accessibility features#Related#{9}":[156,157]},"outlinks":[{"title":"reference","target":"onboarding-modals-reference","line":22},{"title":"forms","target":"form-configurable-workspace","line":27},{"title":"Turn off first field focus","target":"c_SetUpSect508ComplianceFeature","line":28},{"title":"use the list editor","target":"t_UseTheListEditor","line":32},{"title":"User interface configuration","target":"p_NavigationAndUIConfiguration","line":42},{"title":"Service Portal","target":"c_ServicePortal","line":80},{"title":"User Profile widget","target":"user-profile-widget","line":80},{"title":"filters","target":"c_Filters","line":116},{"title":"Available search options","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/c_IntroductionToSearching.md","line":118},{"title":"Visual Task Boards","target":"c_VisualTaskBoards","line":132},{"title":"Enabling accessibility features","target":"c_SetUpSect508ComplianceFeature","line":148},{"title":"User interface configuration","target":"p_NavigationAndUIConfiguration","line":149},{"title":"Reference","target":"onboarding-modals-reference","line":150},{"title":"Forms","target":"form-configurable-workspace","line":151},{"title":"Use the list editor","target":"t_UseTheListEditor","line":152},{"title":"Service Portal","target":"c_ServicePortal","line":153},{"title":"User Profile widget","target":"user-profile-widget","line":154},{"title":"Filters","target":"c_Filters","line":155},{"title":"Visual Task Boards","target":"c_VisualTaskBoards","line":156}],"metadata":{"title":"Using accessibility features","description":"Accessibility features include keyboard navigation, color and style settings, using a screen reader, and search methods.Skip links allow users to quickly navigate to the main content on a page, list, or form, bypassing icons, banner text, navigation links, and other elements. Skip links are not visible until you tab to them.There are several color and style changes that make the platform more accessible.Screen elements in the platform have enhancements that make them accessible to screen readers.There are several ways to search for information in the user interface.With accessibility mode enabled, tab through cards in a task board. Use the card details button to view task card details.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-user-interface/keyboard-accessibility.html","release":"australia","topic_type":"concept","last_updated":"2026-06-25","reading_time_minutes":6,"breadcrumb":["User interface configuration","Working in Core UI","Configure UIs and portals","Configure user experiences"],"tags":["#platform-user-interface","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-user-interface/keyboard-accessibility.md"},
