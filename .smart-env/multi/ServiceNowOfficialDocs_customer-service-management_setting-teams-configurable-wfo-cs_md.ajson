ssignment group#Procedure#{2}":[83,84],"#Setting up Teams Workforce Optimization for Customer Service#Add managers to a KPI assignment group#Procedure#{3}":[85,86],"#Setting up Teams Workforce Optimization for Customer Service#Add managers to a KPI assignment group#Procedure#{4}":[87,88],"#Setting up Teams Workforce Optimization for Customer Service#Add managers to a KPI assignment group#Procedure#{5}":[89,91],"#Setting up Teams Workforce Optimization for Customer Service#Add managers to a KPI assignment group#What to do next":[92,95],"#Setting up Teams Workforce Optimization for Customer Service#Add managers to a KPI assignment group#What to do next#{1}":[94,95],"#Setting up Teams Workforce Optimization for Customer Service#Related":[96,101],"#Setting up Teams Workforce Optimization for Customer Service#Related#{1}":[98,98],"#Setting up Teams Workforce Optimization for Customer Service#Related#{2}":[99,99],"#Setting up Teams Workforce Optimization for Customer Service#Related#{3}":[100,101]},"outlinks":[{"title":"Optimize workforce operations","target":"setup-configurable-wfo-cs","line":22},{"title":"Workforce Optimization for Customer Service","target":"configurable-wfo-cs","line":43},{"title":"user","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_CreateAUser.md","line":77},{"title":"Analyze the performance trends for your teams","target":"teams-configurable-wfo-cs","line":94},{"title":"Optimize workforce operations","target":"setup-configurable-wfo-cs","line":98},{"title":"Using Teams in Workforce Optimization for Customer Service","target":"teams-configurable-wfo-cs","line":99},{"title":"Workforce Optimization for Customer Service","target":"configurable-wfo-cs","line":100}],"metadata":{"title":"Setting up Teams Workforce Optimization for Customer Service","description":"Organize your teams into assignment groups and create reports for those groups so that you can gain visibility into the team's performance.Create key performance indicator \\(KPI\\) groups with the KPIs that matter most to your teams. When you associate your KPI groups with assignment groups, you can monitor your team's performance.Assign one or more managers to each KPI assignment group so that they can gain visibility into the group and monitor the team's performance.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/customer-service-management/setting-teams-configurable-wfo-cs.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Optimize workforce operations","Extend capabilities","Configure","Customer Service Management"],"tags":["#customer-service-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/customer-service-management/setting-teams-configurable-wfo-cs.md"},
