ession- Scoped#Scoped GlideSession - getLanguage\\(\\)":[151,174],"#GlideSession- Scoped#Scoped GlideSession - getLanguage\\(\\)#{1}":[153,174],"#GlideSession- Scoped#Scoped GlideSession - getSessionToken\\(\\)":[175,198],"#GlideSession- Scoped#Scoped GlideSession - getSessionToken\\(\\)#{1}":[177,198],"#GlideSession- Scoped#Scoped GlideSession - getTimeZoneName\\(\\)":[199,222],"#GlideSession- Scoped#Scoped GlideSession - getTimeZoneName\\(\\)#{1}":[201,222],"#GlideSession- Scoped#Scoped GlideSession - getUrlOnStack\\(\\)":[223,247],"#GlideSession- Scoped#Scoped GlideSession - getUrlOnStack\\(\\)#{1}":[225,247],"#GlideSession- Scoped#Scoped GlideSession - isImpersonating\\(\\)":[248,315],"#GlideSession- Scoped#Scoped GlideSession - isImpersonating\\(\\)#{1}":[250,271],"#GlideSession- Scoped#Scoped GlideSession - isImpersonating\\(\\)#{2}":[272,272],"#GlideSession- Scoped#Scoped GlideSession - isImpersonating\\(\\)#{3}":[273,274],"#GlideSession- Scoped#Scoped GlideSession - isImpersonating\\(\\)#{4}":[275,315],"#GlideSession- Scoped#Scoped GlideSession - isLoggedIn\\(\\)":[316,382],"#GlideSession- Scoped#Scoped GlideSession - isLoggedIn\\(\\)#{1}":[318,339],"#GlideSession- Scoped#Scoped GlideSession - isLoggedIn\\(\\)#{2}":[340,340],"#GlideSession- Scoped#Scoped GlideSession - isLoggedIn\\(\\)#{3}":[341,342],"#GlideSession- Scoped#Scoped GlideSession - isLoggedIn\\(\\)#{4}":[343,382]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28}],"metadata":{"title":"GlideSession - Scoped","description":"The scoped GlideSession API provides methods to find information about the current session.Retrieves a session client value previously set with putClientData\\(\\).Returns the client IP address.Returns the application currently selected in the application picker.Returns the sys\\_id of the current domain for the logged-in user session.Returns the session's language code.Returns the session token.Returns the name of the session's time zone.Returns the URL on the stack. Returns null if the stack is empty.Returns true if the user is impersonating another user.Returns true if the session is interactive.Returns true if the user is logged in.Sets a session client value that can be retrieved with getClientData\\(\\). This method is used in a server side script that runs when a form is created.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_GlideSessionScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[44,49],[53,55],[69,73],[77,79],[95,99],[103,105],[127,149],[163,167],[171,173],[187,191],[195,197],[211,215],[219,221],[235,239],[243,246],[279,314],[348,352],[354,369],[374,378]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_GlideSessionScopedAPI.md"},
