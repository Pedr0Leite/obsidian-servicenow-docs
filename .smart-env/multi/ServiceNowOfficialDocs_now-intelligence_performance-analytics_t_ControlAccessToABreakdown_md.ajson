ments#Define an elements security list#{1}":[58,59],"#Control ability to view breakdown elements#Define an elements security list#Before you begin":[60,63],"#Control ability to view breakdown elements#Define an elements security list#Before you begin#{1}":[62,63],"#Control ability to view breakdown elements#Define an elements security list#Procedure":[64,173],"#Control ability to view breakdown elements#Define an elements security list#Procedure#{1}":[66,67],"#Control ability to view breakdown elements#Define an elements security list#Procedure#{2}":[68,69],"#Control ability to view breakdown elements#Define an elements security list#Procedure#{3}":[70,71],"#Control ability to view breakdown elements#Define an elements security list#Procedure#{4}":[72,73],"#Control ability to view breakdown elements#Define an elements security list#Procedure#{5}":[74,173],"#Control ability to view breakdown elements#Role restrictions with deny lists":[174,183],"#Control ability to view breakdown elements#Role restrictions with deny lists#{1}":[176,183],"#Control ability to view breakdown elements#Role restrictions with allow lists":[184,193],"#Control ability to view breakdown elements#Role restrictions with allow lists#{1}":[186,193],"#Control ability to view breakdown elements#Related":[194,201],"#Control ability to view breakdown elements#Related#{1}":[196,196],"#Control ability to view breakdown elements#Related#{2}":[197,197],"#Control ability to view breakdown elements#Related#{3}":[198,198],"#Control ability to view breakdown elements#Related#{4}":[199,199],"#Control ability to view breakdown elements#Related#{5}":[200,201]},"outlinks":[{"title":"Analytics Hub","target":"c_UsePerformanceAnalyticsScorecards","line":24},{"title":"widgets","target":"widgets","line":24},{"title":"breakdown sources","target":"breakdown-sources","line":32},{"title":"Platform Analytics","target":"c_performanceAnalyticsAndReporting","line":36},{"title":"Indicator breakdowns","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/c_CreatingBreakdowns.md","line":54},{"title":"dashboard elements","target":"dashboard-elements","line":160},{"title":"Widgets","target":"widgets","line":196},{"title":"Analytics Hub","target":"c_UsePerformanceAnalyticsScorecards","line":197},{"title":"Breakdown sources","target":"breakdown-sources","line":198},{"title":"Platform Analytics","target":"c_performanceAnalyticsAndReporting","line":199},{"title":"Dashboard elements","target":"dashboard-elements","line":200}],"metadata":{"title":"Control ability to view breakdown elements","description":"To limit which breakdown elements a subset of users can view on indicators, implement element security. Element security applies to widgets, workspaces, and the Analytics Hub .An elements security list prevents unauthorized access to breakdown elements.If deny list security is specified for a breakdown source, and any of the roles of a user are on an element security list for that breakdown source, that user cannot see the elements which that security list applies to.If allow list security is specified for a breakdown source, and any of the roles of a user are on an element security list for that breakdown source, that user can see the elements which that security list applies to.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/performance-analytics/t\\_ControlAccessToABreakdown.html","release":"australia","product":"Performance Analytics","classification":"performance-analytics","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Indicator breakdowns","Configure fundamentals","Performance Analytics \\(Indicator data sources\\)","Platform Analytics"],"tags":["#now-intelligence","#pa","#scorecards","#indicators","#analytics","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/performance-analytics/t_ControlAccessToABreakdown.md"},
