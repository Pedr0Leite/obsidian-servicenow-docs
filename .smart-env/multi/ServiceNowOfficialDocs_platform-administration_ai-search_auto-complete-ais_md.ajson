a":{"title":"Auto-complete suggestions in AI Search applications","description":"Automatically display intelligent suggestions in your search application's input field, helping users formulate their searches or jump directly to relevant results. Suggestions can include relevant search results, popular queries, recent queries from the user's personal history, and popular search results.AI Search provides multiple types of auto-complete suggestions that you can configure for display to users in the search field.Modify default settings for display of auto-complete suggestions of a selected type in your search application's input field.Disable the display of auto-complete suggestions of a selected type in your search application's input field.Re-enable the display of auto-complete suggestions of a selected type in your search application's input field.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/ai-search/auto-complete-ais.html","release":"australia","product":"AI Search","classification":"ai-search","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Search application configurations","Configuring AI Search","AI Search","Search administration","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#ai-search","#indexing","#relevancy","#search","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/platform-administration/ai-search/auto-complete-ais.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1i5ovsx","at":1784561347337},"key":"ServiceNowOfficialDocs/platform-administration/ai-search/auto-complete-ais.md#---frontmatter---","lines":[1,20],"size":1386,"outlinks":[],"class_name":"SmartBlock"},
