/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/edit-already-published-catalog-items-using-now-assist.md","line":74},{"title":"Now Assist in Catalog Builder","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/now-assist-for-catalog-generation.md","line":77},{"title":"Service Catalog","target":"service-catalog","line":81},{"title":"Catalog Builder","target":"catalog-builder","line":82},{"title":"Reference","target":"reference","line":83}],"metadata":{"title":"Using Now Assist conversation to create and edit catalog items","description":"Now Assist provides a conversational interface that enables you to create catalog items, making these items available in the Service Catalog for users to request.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/service-catalog/use-now-assist-conversation-to-create-and-edit-catalog-items.html","release":"australia","product":"Service Catalog","classification":"service-catalog","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Now Assist in Catalog Builder","Service Catalog","Manage service capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#service-catalog","#request-items","#variables","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/service-catalog/use-now-assist-conversation-to-create-and-edit-catalog-items.md"},
