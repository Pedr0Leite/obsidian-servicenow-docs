ification versions#Batch specification version update#{4}":[56,56],"#Updating specification versions#Batch specification version update#{5}":[57,57],"#Updating specification versions#Batch specification version update#{6}":[58,58],"#Updating specification versions#Batch specification version update#{7}":[59,62],"#Updating specification versions#Related":[63,72],"#Updating specification versions#Related#{1}":[65,65],"#Updating specification versions#Related#{2}":[66,66],"#Updating specification versions#Related#{3}":[67,67],"#Updating specification versions#Related#{4}":[68,68],"#Updating specification versions#Related#{5}":[69,69],"#Updating specification versions#Related#{6}":[70,70],"#Updating specification versions#Related#{7}":[71,72]},"outlinks":[{"title":"Modify","target":"Modify","line":21},{"title":"rules","target":"rules_101","line":29},{"title":"Sales Customer Relationship Management","target":"order-mgt-overview","line":48},{"title":"Configure update specification versions","target":"som-configure-specification-version-update","line":52},{"title":"Configure update specification versions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/order-management/som-configure-specification-version-update.md","line":54},{"title":"Batch update for product specification versions","target":"som-configure-specification-version-update-silent-batch-utility","line":56},{"title":"View upgrade inventory job status","target":"som-view-upgrade-inventory-job-status","line":58},{"title":"Setting up specifications and product offerings","target":"order-mgt-product-catalog","line":61},{"title":"Configure update specification versions","target":"som-configure-specification-version-update","line":65},{"title":"Batch update for product specification versions","target":"som-configure-specification-version-update-silent-batch-utility","line":66},{"title":"View upgrade inventory job status","target":"som-view-upgrade-inventory-job-status","line":67},{"title":"Setting up specifications and product offerings","target":"order-mgt-product-catalog","line":68},{"title":"Modify","target":"Modify","line":69},{"title":"Rules","target":"rules_101","line":70},{"title":"Sales Customer Relationship Management","target":"order-mgt-overview","line":71}],"metadata":{"title":"Updating specification versions","description":"Enterprises frequently create and update new versions of product and service specifications. When these changes occur, it's important to update the existing product specification in ServiceNow. Failure to update the product specifications can lead to difficulties with MACD \\(Modify, Add, Change, Delete\\) operation when orders enter fulfillment.OM content revamp - Check with Judy if this and sub-topics are covered in configuring product catalog.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/order-management/som-specification-version-update.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Specifications and product offerings","Configuring product offerings and catalogs","Lead-to-cash foundation apps","Configure","Sales Customer Relationship Management"],"tags":["#order-management","#fulfillment","#catalog","#orchestration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/order-management/som-specification-version-update.md"},
