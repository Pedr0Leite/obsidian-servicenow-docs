own/api-reference/rest-api-explorer/c_RESTAPI.md","line":1791},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2174},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2207},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":2293},{"title":"REST APIs","target":"c_RESTAPI","line":2294}],"metadata":{"title":"Attachment API","description":"The Attachment API provides endpoints that allow you to upload and query file attachments.Deletes a specified attachment.Deletes all attributes for an attachment.Deletes a specified attribute from an attachment.Returns the metadata for multiple attachments.Returns the metadata for the attachment file with a specific sys\\_id value.Retrieves all attributes for an attachment.Retrieves a specified attribute from an attachment.Returns the binary file attachment with a specific sys\\_id value.Renames an attachment.Adds an attribute to a specified attachment.Uploads a specified binary file as an attachment to a specified record.Uploads a multipart file attachment.Updates the value of an existing attribute for an attachment.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/c\\_AttachmentAPI.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":31,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[114,119],[121,123],[206,210],[214,216],[311,315],[319,321],[432,438],[440,465],[537,542],[544,567],[671,678],[709,714],[718,731],[847,852],[883,888],[892,899],[971,976],[9