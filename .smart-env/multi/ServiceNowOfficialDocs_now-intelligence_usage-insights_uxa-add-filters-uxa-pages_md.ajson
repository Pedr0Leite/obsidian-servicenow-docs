et":"c_performanceAnalyticsAndReporting","line":66}],"metadata":{"title":"Add user properties as filters to Usage Insights","description":"In addition to the default filters on the pages of the Usage Insights application, you can add filters based on user properties. This allows you to effectively segment your Usage Insights data to develop a deeper understanding of your users and their usage patterns. User properties-based filters are supported as global filters for all pages and objects in the Usage Insights application.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/usage-insights/uxa-add-filters-uxa-pages.html","release":"australia","product":"Usage Insights","classification":"usage-insights","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Configuring Usage Insights","Usage Insights","Platform Analytics"],"tags":["#now-intelligence","#usage","#adoption","#insights","#analytics","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/now-intelligence/usage-insights/uxa-add-filters-uxa-pages.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1toqcqm","at":1784561345868},"key":"ServiceNowOfficialDocs/now-intelligence/usage-insights/uxa-add-filters-uxa-pages.md#---frontmatter---","lines":[1,20],"size":902,"outlinks":[],"class_name":"SmartBlock"},
