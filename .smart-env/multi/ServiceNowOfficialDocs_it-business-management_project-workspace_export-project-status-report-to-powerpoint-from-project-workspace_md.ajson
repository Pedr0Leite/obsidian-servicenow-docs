oject-management/t_CreateAProjectStatusReport.md","line":64},{"title":"Managing projects with Project Workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-business-management/project-workspace/use-projects-pw.md","line":81},{"title":"Project Workspace","target":"project-workspace-landing-page","line":85},{"title":"Export to PowerPoint for Strategic Portfolio Management","target":"export-ppt-landing-page","line":86},{"title":"Status report form","target":"status-report-form-project-management","line":87}],"metadata":{"title":"Export a project status report to Microsoft PowerPoint from Project Workspace","description":"Generate a status report of your project and export it as a Microsoft PowerPoint file from Project Workspace. You can use this file to present the project status to stakeholders or to collaborate with them over risks and next steps. Save time by generating a Microsoft PowerPoint file with the latest information and avoid copying information into slides.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-business-management/project-workspace/export-project-status-report-to-powerpoint-from-project-workspace.html","release":"australia","product":"Project Workspace","classification":"project-workspace","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Managing projects with Project Workspace","Project Workspace","Project Portfolio Management","Strategic Portfolio Management"],"tags":["#it-business-management","#project-workspace","#coordination","#pm","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-business-management/project-workspace/export-project-status-report-to-powerpoint-from-project-workspace.md"},
