wn/application-development/servicenow-sdk/record-api-now-ts.md","line":480},{"title":"global scope","target":"c_GlobalScope","line":484},{"title":"Record API - ServiceNow Fluent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/record-api-now-ts.md","line":496},{"title":"Watermarks on notification emails","target":"https://www.servicenow.com/docs/r/7LhbZn3yz3Q58qhjZoU9iQ/kTwHRtaHawJF_Sz_AA_tnA","line":559},{"title":"Record API - ServiceNow Fluent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/record-api-now-ts.md","line":607},{"title":"Email digests","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/email-digests.md","line":689},{"title":"Record API - ServiceNow Fluent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/record-api-now-ts.md","line":752},{"title":"Record API - ServiceNow Fluent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/record-api-now-ts.md","line":800},{"title":"Record API - ServiceNow Fluent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/record-api-now-ts.md","line":898},{"title":"Record API - ServiceNow Fluent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/record-api-now-ts.md","line":922},{"title":"Subscription-based notifications","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/c_SubscriptionBasedNotifications.md","line":946},{"title":"ServiceNow Fluent","target":"servicenow-fluent","line":998},{"title":"Notifications","target":"notifications","line":999},{"title":"Email category","target":"test-steps-email-category","line":1000},{"title":"Properties","target":"atf-admin-properties","line":1001},{"title":"Global scope","target":"c_GlobalScope","line":1002}],"metadata":{"title":"Email Notification API - ServiceNow Fluent","description":"The Email Notification API defines notifications \\[sysevent\\_email\\_action\\] that send automated emails based on database operations, custom events, or manual triggers.Create an email notification \\[sysevent\\_email\\_action\\] specifying when to send it, who receives it, what it contains, and if it can be delivered in an email digest.Configure the conditions that must be met for the notification to be sent.Configure the contents of an email notification.Configure the contents of an email digest that summarizes the activity for a selected notification and its target records during a specified time interval.Configure who receives an email notification.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/servicenow-sdk/fluent-email-notification-api.html","release":"australia","product":"ServiceNow SDK","classification":"servicenow-sdk","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":15,"keywords":["servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api","servicenow fluent","fluent api"],"breadcrumb":["ServiceNow Fluent API reference","Reference","ServiceNow SDK","Building applications in source code","Building pro-code applications","Developing your application","Building applications"],"tags":["#application-development","#sdk","#local-dev","#developer-tools","#typescript","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[217,221],[253,434],[683,868]],"key":"ServiceNowOfficialDocs/application-development/servicenow-sdk/fluent-email-notification-api.md"},
