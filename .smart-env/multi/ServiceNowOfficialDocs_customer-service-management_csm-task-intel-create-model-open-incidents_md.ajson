eate a model to predict similar open incidents#Procedure#{7}":[50,65],"#Create a model to predict similar open incidents#Procedure#{8}":[66,75],"#Create a model to predict similar open incidents#Procedure#{9}":[76,86],"#Create a model to predict similar open incidents#Procedure#{10}":[87,88],"#Create a model to predict similar open incidents#Procedure#{11}":[89,92],"#Create a model to predict similar open incidents#Procedure#{12}":[93,98],"#Create a model to predict similar open incidents#Related":[99,105],"#Create a model to predict similar open incidents#Related#{1}":[101,101],"#Create a model to predict similar open incidents#Related#{2}":[102,102],"#Create a model to predict similar open incidents#Related#{3}":[103,103],"#Create a model to predict similar open incidents#Related#{4}":[104,105]},"outlinks":[{"title":"Intelligence","target":"intelligence-csm","line":18},{"title":"Task Intelligence for Customer Service","target":"csm-task-intelligence","line":22},{"title":"Task Intelligence Admin Console","target":"csm-task-intel-admin-center","line":32},{"title":"Recommended Actions","target":"configure-nba","line":97},{"title":"Intelligence","target":"intelligence-csm","line":101},{"title":"Task Intelligence for Customer Service","target":"csm-task-intelligence","line":102},{"title":"Task Intelligence Admin Console","target":"csm-task-intel-admin-center","line":103},{"title":"Recommended Actions","target":"configure-nba","line":104}],"metadata":{"title":"Create a model to predict similar open incidents","description":"Use the Task Intelligence for CSM to create and train a machine learning model that identifies similar open incidents. The model analyzes similar open incidents data to suggest relevant incident records when working on a current open incident, helping agents resolve issues faster. The plugin includes a ready-to-train model for predicting similar cases and also lets you create custom models tailored to your specific use cases.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/customer-service-management/csm-task-intel-create-model-open-incidents.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Configure","Task Intelligence for Customer Service","Machine learning solutions","Implement Intelligence","Configure","Customer Service Management"],"tags":["#customer-service-management","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/customer-service-management/csm-task-intel-create-model-open-incidents.md"},
