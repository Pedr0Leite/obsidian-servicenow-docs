yberArk","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/configure-oauth-2-0-credentials-on-cyberark.md","line":344},{"title":"Create a Connection &amp; Credential alias","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/connection-alias.md","line":361},{"title":"authentication","target":"c_Authentication","line":417},{"title":"Configure the CyberArk vault and install the AIM API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/t_InstallCyberArkAIMAPI.md","line":458},{"title":"Configure the CyberArk vault and install the AIM API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/t_InstallCyberArkAIMAPI.md","line":468},{"title":"OAuth 2.0 authentication via MID Server using external credential storage","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/connections-and-credentials/oauth-2-0-support-in-external-credential.md","line":512},{"title":"OAuth 2.0","target":"c_OAuthApplications","line":516},{"title":"OAuth 2.0 credentials","target":"oauth-2-credentials","line":517},{"title":"OAuth","target":"oauth-inbound-and-outbound","line":518},{"title":"request","target":"c_requestAPI","line":519},{"title":"Configuration","target":"sc-configuration","line":520},{"title":"Client credentials grant","target":"client-credential-grant","line":521},{"title":"Create a configuration template","target":"create-template","line":522},{"title":"External credential storage","target":"c_ExternalCredentialStorage","line":523},{"title":"Client Credentials","target":"client-credentials","line":524},{"title":"Authentication","target":"c_Authentication","line":525}],"metadata":{"title":"Configure a