Now/ServiceNowDocs/australia/markdown/platform-administration/t_CreateAUser.md","line":44},{"title":"Create a user group","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_CreateAGroup.md","line":45},{"title":"Add a user to a group","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_CreateAGroup.md","line":46},{"title":"Assign a role to a user","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_AssignARoleToAUser.md","line":54},{"title":"Assign a role to a group","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_AssignRoleToGroup.md","line":55},{"title":"Roles installed with Public Sector Digital Services","target":"roles-installed-with-public-sector-digital-services","line":62}],"metadata":{"title":"Configure user roles and groups in Public Sector Digital Services","description":"The Public Sector Digital Services application uses roles to provide access to information, identify internal and external users, and establish different types of relationships between users and public sector entities. These roles control access to public sector data through UI-based features such as forms and lists.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/government-industry/psds-assigning-roles.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["User management","Set up your environment","Configure","Public Sector Digital Services \\(PSDS\\)"],"tags":["#government-industry","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/government-industry/psds-assigning-roles.md"},
