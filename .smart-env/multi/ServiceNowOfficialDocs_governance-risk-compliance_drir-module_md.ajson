le=KB0597477","line":48},{"title":"Contact Customer Service and Support","target":"https://support.servicenow.com/now?draw=case","line":49},{"title":"Developer training","target":"https://developer.servicenow.com/app.do#!/training/landing","line":50},{"title":"Developer documentation","target":"https://developer.servicenow.com/app.do#!/documentation","line":51},{"title":"Operational Resilience","target":"grc-opres-landing-page","line":55}],"metadata":{"title":"Using Digital resilience incident reporting","description":"Beginning with the Yokohama release, users of the Operational Resilience Workspace can report Information and Communication Technology \\(ICT\\) related incidents to regulators using the Digital resilience incident reporting module. This module, integrated with Incident Management and Security Incident Response, creates or updates incident case task records whenever a major incident is created or updated in these applications. The report is generated in the specified format and shared with regulators.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/drir-module.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Manage","Operational Resilience","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/drir-module.md"},
