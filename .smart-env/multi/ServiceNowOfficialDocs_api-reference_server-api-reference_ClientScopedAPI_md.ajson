ata.Get all series from a specific dimension.Saves metric data to the MetricBase database.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/ClientScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[38,40],[95,116],[135,140],[157,165],[183,191],[227,238]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/ClientScopedAPI.md"},
