341]},"outlinks":[{"title":"ATF Test Generator and Cloud Runner","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/atf-tg-cr-intro.md","line":32},{"title":"Cloud Runner TestRunnerApi – Scoped, Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/cloudrnr-TestRunnerAPI-scoped.md","line":36},{"title":"Cloud Runner TestUserApi – Scoped, Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/cloudrnr-TestUserAPI-scoped.md","line":37},{"title":"Cloud Runner Test Generation REST API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/cloudrunner-testgeneration-api.md","line":38},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":40},{"title":"update","target":"r_Update","line":44},{"title":"Encoded query strings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_EncodedQueryStrings.md","line":300},{"title":"update","target":"r_Update","line":340}],"metadata":{"title":"Cloud Runner TestGenerationApi – Scoped, Global","description":"Manages test job generation to be executed in a cloud runner for Automated Test Framework \\(ATF\\). This API is part of the CloudRunnerApi script include.Sets the test generation job and its associated update set record to complete status. Cancels the root trackers of any generated tests that are running. If any test jobs are in progress on cancellation, this method sets any of the in-progress test records generated to skipped.Provides the status of each generated test for a provided Browser Orchestration Queue \\(BOQ\\) record.Inserts a record into the Browser Orchestration Queue \\(BOQ\\) \\[sn\\_atf\\_tg\\_sn\\_boq\\] table to start a test job.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/cloudrnr-TestGenerationAPI-scoped.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[56,64],[96,141],[151,155],[163,321],[330,334]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/cloudrnr-TestGenerationAPI-scoped.md"},
