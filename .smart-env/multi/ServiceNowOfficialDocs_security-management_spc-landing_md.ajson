community","target":"https://www.servicenow.com/community/secops/ct-p/security-operations","line":50},{"title":"Search the Known Error Portal for known error articles","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB0597477","line":51},{"title":"Contact Customer Service and Support","target":"https://support.servicenow.com/now?draw=case","line":52},{"title":"Tools","target":"tools","line":56},{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":57},{"title":"Explore","target":"threat-intelligence-security-center-overview","line":58},{"title":"Integrate","target":"integrating-threat-intelligence-security-center","line":59}],"metadata":{"title":"Security Posture Control","description":"Gain visibility into your enterprise asset inventory and security tool coverage. Use policies provided with the product or create your own to identify assets missing key security tools, such as endpoint protection, configuration management, and vulnerability scanning. Monitor assets for security tool configurations specific to your environment and automate the remediation workflow for security gaps in the Configuration Compliance application.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/spc-landing.html","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Security Operations"],"tags":["#security-management","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/spc-landing.md"},
