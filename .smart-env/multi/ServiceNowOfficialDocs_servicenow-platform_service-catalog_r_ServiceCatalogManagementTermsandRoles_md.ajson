uilder editor \\[catalog\\_builder\\_editor\\]":[154,173],"#Service Catalog terms and roles#Catalog builder editor \\[catalog\\_builder\\_editor\\]#{1}":[156,157],"#Service Catalog terms and roles#Catalog builder editor \\[catalog\\_builder\\_editor\\]#Contains Roles":[158,163],"#Service Catalog terms and roles#Catalog builder editor \\[catalog\\_builder\\_editor\\]#Contains Roles#{1}":[160,163],"#Service Catalog terms and roles#Catalog builder editor \\[catalog\\_builder\\_editor\\]#Groups":[164,169],"#Service Catalog terms and roles#Catalog builder editor \\[catalog\\_builder\\_editor\\]#Groups#{1}":[166,169],"#Service Catalog terms and roles#Catalog builder editor \\[catalog\\_builder\\_editor\\]#Special considerations":[170,173],"#Service Catalog terms and roles#Catalog builder editor \\[catalog\\_builder\\_editor\\]#Special considerations#{1}":[172,173],"#Service Catalog terms and roles#Related":[174,181],"#Service Catalog terms and roles#Related#{1}":[176,176],"#Service Catalog terms and roles#Related#{2}":[177,177],"#Service Catalog terms and roles#Related#{3}":[178,178],"#Service Catalog terms and roles#Related#{4}":[179,179],"#Service Catalog terms and roles#Related#{5}":[180,181]},"outlinks":[{"title":"Service Catalog","target":"service-catalog","line":23},{"title":"Execution Plans","target":"c_ExecutionPlans","line":27},{"title":"Execution Plan Tasks","target":"c_ExecutionPlanTasks","line":31},{"title":"Service Catalog Reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/service-catalog-reference.md","line":44},{"title":"Catalog Builder","target":"catalog-builder","line":128},{"title":"reference","target":"reference","line":146},{"title":"Service Catalog","target":"service-catalog","line":176},{"title":"Execution Plans","target":"c_ExecutionPlans","line":177},{"title":"Execution plan tasks","target":"c_ExecutionPlanTasks","line":178},{"title":"Catalog Builder","target":"catalog-builder","line":179},{"title":"Reference","target":"reference","line":180}],"metadata":{"title":"Service Catalog terms and roles","description":"The Service Catalog application uses these roles to manage different aspects of the application.Can manage all aspects of the Service Catalog application, including scripting functions such as creating UI macros or business rules.Can manage the Service Catalog application, including catalogs, categories, and items, but not including scripting functions available to administrators.Can edit and update a service catalog, as well as the categories and catalog items within the catalog. The manager can assign editors and also a different manager for the service catalog. You can perform these actions only on catalogs for which you are assigned as the manager.Can edit and update a service catalog, as well as categories and catalog items within the catalog. The editor can assign other editors, but cannot change the catalog manager. You can perform these actions only on catalogs for which you are assigned as the editor.Can create and maintain advanced catalog items in Catalog Builder such that they can create, edit, or delete client scripts in Catalog Builder.Can create and maintain items in the catalog builder using the templates that the user has access to.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/service-catalog/r\\_ServiceCatalogManagementTermsandRoles.html","release":"australia","product":"Service Catalog","classification":"service-catalog","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Service Catalog Reference","Service Catalog","Manage service capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#service-catalog","#request-items","#variables","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/servicenow-platform/service-catalog/r_ServiceCatalogManagementTermsandRoles.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"rna4br","at":1784561353802},"key":"ServiceNowOfficialDocs/servicenow-platform/service-catalog/r_ServiceCatalogManagementTermsandRoles.md#---frontmatter---","lines":[1,19],"size":1752,"outlinks":[],"class_name":"SmartBlock"},
