\)":[203,235],"#XMLNode - Scoped, Global#Scoped XMLNode - getNodeValue\\(\\)#{1}":[205,235],"#XMLNode - Scoped, Global#Scoped XMLNode - getTextContent\\(\\)":[236,268],"#XMLNode - Scoped, Global#Scoped XMLNode - getTextContent\\(\\)#{1}":[238,268],"#XMLNode - Scoped, Global#Scoped XMLNode - hasAttribute\\(String attribute\\)":[269,301],"#XMLNode - Scoped, Global#Scoped XMLNode - hasAttribute\\(String attribute\\)#{1}":[271,301],"#XMLNode - Scoped, Global#Scoped XMLNode - isCDATANode\\(\\)":[302,355],"#XMLNode - Scoped, Global#Scoped XMLNode - isCDATANode\\(\\)#{1}":[304,327],"#XMLNode - Scoped, Global#Scoped XMLNode - isCDATANode\\(\\)#{2}":[328,328],"#XMLNode - Scoped, Global#Scoped XMLNode - isCDATANode\\(\\)#{3}":[329,330],"#XMLNode - Scoped, Global#Scoped XMLNode - isCDATANode\\(\\)#{4}":[331,355],"#XMLNode - Scoped, Global#Scoped XMLNode - toString\\(\\)":[356,393],"#XMLNode - Scoped, Global#Scoped XMLNode - toString\\(\\)#{1}":[358,393]},"outlinks":[{"title":"XMLDocument2","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_XMLDocument2ScopedAPI.md","line":26},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28},{"title":"Scoped XMLDocument2 - setEnableCDATAReporting\\(Boolean enable\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_XMLDocument2ScopedAPI.md","line":306},{"title":"Scoped XMLDocument2 - setEnableCDATAReporting\\(Boolean enable\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_XMLDocument2ScopedAPI.md","line":332}],"metadata":{"title":"XMLNode - Scoped, Global","description":"The XMLNode API provides methods to query values from XML nodes. XMLNodes are extracted from XMLDocument2 objects, which contain XML strings.Gets the value of the attribute.Returns an object containing the node's attributes as properties with values.Gets a XMLNodeIterator object that can be used to walk through the list of child nodes.Gets the node's first child node.Gets the node's last child node.Gets the node's name. A node's name is determined by the node type. A document-element node's name is \\#document. A text node's name is \\#text. An element node's name is the element's name.Gets the node's value. A node's value is determined by the node type. Element and document-element nodes return null.Gets the text content of the current node. The text content of a node consists of all the node's child text nodesDetermines if the node has the specified attribute.Indicates whether the CDATA node is preserved as a separate node.Returns the string value of the current node.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_XMLNodeScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[42,55],[59,61],[87,101],[115,128],[132,134],[148,162],[166,168],[182,195],[199,201],[215,228],[232,234],[248,261],[265,267],[281,294],[298,300],[334,348],[352,354],[368,381],[385,391]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_XMLNodeScopedAPI.md"},
