rtification","line":49},{"title":"Data certification task notifications","target":"eaw-data-cert-notification","line":51},{"title":"Track progress of a certification policy","target":"eaw-data-cert-track-progress","line":53},{"title":"Review and certify data certification tasks","target":"eaw-approve-data-cert-tasks","line":55},{"title":"Activate a certification policy","target":"eaw-data-cert-activate","line":57},{"title":"Deactivate a certification policy","target":"eaw-data-cert-deactivate","line":59},{"title":"Delete a certification policy","target":"eaw-delete-data-cert","line":61},{"title":"Managing Enterprise Architecture Workspace","target":"eaw-managing-ea-workspace","line":64},{"title":"Create a certification policy","target":"eaw-create-policy","line":68},{"title":"Edit a certification policy","target":"eaw-data-cert-edit-policy","line":69},{"title":"View certification policy","target":"eaw-data-cert-view-policy","line":70},{"title":"Publish a certification policy","target":"eaw-data-cert-publish-policy","line":71},{"title":"Run certification for a policy","target":"eaw-data-cert-run-certification","line":72},{"title":"Data certification task notifications","target":"eaw-data-cert-notification","line":73},{"title":"Track progress of a certification policy","target":"eaw-data-cert-track-progress","line":74},{"title":"Review and certify data certification tasks","target":"eaw-approve-data-cert-tasks","line":75},{"title":"Activate a certification policy","target":"eaw-data-cert-activate","line":76},{"title":"Deactivate a certification policy","target":"eaw-data-cert-deactivate","line":77},{"title":"Delete a certification policy","target":"eaw-delete-data-cert","line":78},{"title":"Managing Enterprise Architecture Workspace","target":"eaw-managing-ea-workspace","line":79},{"title":"Enterprise Architecture Workspace","target":"ea-workspace","line":80},{"title":"Enterprise Architecture","target":"application-portfolio-management-landing-page","line":81}],"metadata":{"title":"Working with data certification","description":"In the Enterprise Architecture Workspace, enterprise architects can manage certifications alongside requests, assessments, and portfolio health insights without switching to separate modules. You can define rules for validating data \\(for example, application lifecycle, technology standards\\), automate recurring checks \\(daily, monthly, quarterly\\), assign certifiers to review and approve data. You can highlight overdue certifications and compliance gaps.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-portfolio-management/eaw-work-with-data-cert.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Managing Enterprise Architecture Workspace","Enterprise Architecture Workspace","Enterprise Architecture"],"tags":["#application-portfolio-management","#apm","#portfolio","#rationalization","#lifecycle","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/application-portfolio-management/eaw-work-with-data-cert.md"},
