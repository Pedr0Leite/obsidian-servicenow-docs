bout this task#{1}":[170,171],"#Workflow stage sets#Add a stage set to a workflow#Procedure":[172,188],"#Workflow stage sets#Add a stage set to a workflow#Procedure#{1}":[174,175],"#Workflow stage sets#Add a stage set to a workflow#Procedure#{2}":[176,177],"#Workflow stage sets#Add a stage set to a workflow#Procedure#{3}":[178,179],"#Workflow stage sets#Add a stage set to a workflow#Procedure#{4}":[180,181],"#Workflow stage sets#Add a stage set to a workflow#Procedure#{5}":[182,183],"#Workflow stage sets#Add a stage set to a workflow#Procedure#{6}":[184,185],"#Workflow stage sets#Add a stage set to a workflow#Procedure#{7}":[186,188],"#Workflow stage sets#Add a stage set to a workflow#What to do next":[189,192],"#Workflow stage sets#Add a stage set to a workflow#What to do next#{1}":[191,192],"#Workflow stage sets#Related":[193,199],"#Workflow stage sets#Related#{1}":[195,195],"#Workflow stage sets#Related#{2}":[196,196],"#Workflow stage sets#Related#{3}":[197,197],"#Workflow stage sets#Related#{4}":[198,199]},"outlinks":[{"title":"workflow stages","target":"c_WorkflowStages","line":23},{"title":"workflow properties","target":"r_WorkflowProperties","line":27},{"title":"Workflow stages","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowStages.md","line":38},{"title":"Create a workflow stage field","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/t_CreateAWorkflowStageField.md","line":116},{"title":"Workflow Editor","target":"workflow-editor","line":120},{"title":"workflow activities","target":"c_WorkflowActivities","line":191},{"title":"Add a stage to a workflow activity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/add-translate-stages.md","line":191},{"title":"Workflow stages","target":"c_WorkflowStages","line":195},{"title":"Workflow properties","target":"r_WorkflowProperties","line":196},{"title":"Workflow editor","target":"workflow-editor","line":197},{"title":"Workflow activities","target":"c_WorkflowActivities","line":198}],"metadata":{"title":"Workflow stage sets","description":"Stage sets are named groups of workflow stages commonly used together. Create a stage set and assign it as a default set to any number of tables. You can import the choice list values of a workflow field as stages for a workflow, and export a stage set to create a new one.You can create a new stage set by creating a stage set record and adding stage set entries manually.You can assign a stage set as a default set to any number of tables.You can import the choice list values of a workflow field as stages for a workflow.You can create a new stage set by exporting the stages from an existing workflow as a set, instead of manually adding stage set entries to a stage set record.You can add any number of stage sets to an existing workflow.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/legacy-workflow/c\\_WorkflowStageSets.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Workflow stages","Workflow management","Classic Workflow","Build workflows"],"tags":["#build-workflows","#legacy-workflow","#classic","#deprecated","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/build-workflows/legacy-workflow/c_WorkflowStageSets.md"},
