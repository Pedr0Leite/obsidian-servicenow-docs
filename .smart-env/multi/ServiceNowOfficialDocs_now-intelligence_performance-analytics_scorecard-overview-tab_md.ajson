the Analytics Hub#{1}":[210,213],"#View scores and statistics#User preferences on the Analytics Hub":[214,227],"#View scores and statistics#User preferences on the Analytics Hub#{1}":[216,219],"#View scores and statistics#User preferences on the Analytics Hub#{2}":[220,220],"#View scores and statistics#User preferences on the Analytics Hub#{3}":[221,221],"#View scores and statistics#User preferences on the Analytics Hub#{4}":[222,223],"#View scores and statistics#User preferences on the Analytics Hub#{5}":[224,227],"#View scores and statistics#Domain separation on the Analytics Hub":[228,235],"#View scores and statistics#Domain separation on the Analytics Hub#{1}":[230,235],"#View scores and statistics#Related":[236,243],"#View scores and statistics#Related#{1}":[238,238],"#View scores and statistics#Related#{2}":[239,239],"#View scores and statistics#Related#{3}":[240,240],"#View scores and statistics#Related#{4}":[241,241],"#View scores and statistics#Related#{5}":[242,243]},"outlinks":[{"title":"Analytics Hub","target":"c_UsePerformanceAnalyticsScorecards","line":24},{"title":"Create a target color scheme","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/pa-targets.md","line":44},{"title":"real-time scores","target":"real-time-scores","line":52},{"title":"automated indicator","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/glossary/now-platform-glossary.md","line":56},{"title":"database view","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/glossary/now-platform-glossary.md","line":59},{"title":"Access Control","target":"access-control","line":64},{"title":"Real-time scores","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/real-time-scores.md","line":71},{"title":"widgets","target":"widgets","line":71},{"title":"Applying time series aggregations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/applying-time-series-aggregations.md","line":81},{"title":"Leveraging Time Series with Performance Analytics","target":"https://youtu.be/aM6JtUndRYk","line":81},{"title":"Create an automated indicator","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/t_CreateAnAutomatedIndicator.md","line":105},{"title":"Element filters","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/c_BreakdownElementFilters.md","line":128},{"title":"Navigating breakdown elements with breakdown relations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/breakdown-relations.md","line":132},{"title":"Showing multiple elements separately or aggregated","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/multi-element-select-indicator-views.md","line":150},{"title":"automated indicators","target":"automated-indicators","line":170},{"title":"KB0748969","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB0748969","line":173},{"title":"Analytics Hub for a specific indicator","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/view-scorecard.md","line":197},{"title":"Associate a domain configuration with a dashboard","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/associate-domain-config-dashboard.md","line":234},{"title":"Analytics Hub","target":"c_UsePerformanceAnalyticsScorecards","line":238},{"title":"Real-time scores","target":"real-time-scores","line":239},{"title":"Access control","target":"access-control","line":240},{"title":"Widgets","target":"widgets","line":241},{"title":"Automated indicators","target":"automated-indicators","line":242}],"metadata":{"title":"View scores and statistics","description":"The Analytics Hub Overview tab shows the score for a time period, statistics, and a time series. You can set the time period for the statistics and time series. You can also filter scores by breakdown and element.The top of the View tab summarizes information about the indicator being viewed.You can select real-time scores to view instead of the last score.On the Analytics Hub, you can aggregate changes in indicators into discrete time intervals.You can set the time period of scores that the Analytics Hub describes.In the View tab of the Analytics Hub, you can set various statistics to apply to the indicator score.On the Analytics Hub, you have several options for viewing breakdowns and breakdown elements.If you click a value on a chart in a widget on a dashboard, you open the Analytics Hub on that indicator. If you are on a breakdown dashboard and have multiple elements selected, and the widget shows the aggregate of those elements, the Analytics Hub also shows the aggregate of those elements.You can toggle between showing a time series of indicator scores and a list of the records used to calculate those scores.You can change what the chart displays in the View tab of the Analytics Hub.To change the visualization used for the graph, select a visualization from the list menu. Area, column, line, and spline visualizations are available.You can set display preferences per indicator and have them persist for each time you view that indicator.The Analytics Hub follows whichever domain you have selected in the System Settings. You see only the scores that are collected in that domain.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/performance-analytics/scorecard-overview-tab.html","release":"australia","product":"Performance Analytics","classification":"performance-analytics","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":13,"breadcrumb":["Analytics Hub for a specific indicator","Analytics Hub","Reporting","dashboards","and Performance Analytics in the Core UI","Platform Analytics"],"tags":["#now-intelligence","#pa","#scorecards","#indicators","#analytics","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/performance-analytics/scorecard-overview-tab.md"},
