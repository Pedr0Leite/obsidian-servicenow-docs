ocedure#{3}":[350,351],"#Configuring lookup rules#Reapply lookup rules on selected discovered items#Procedure#{4}":[352,355],"#Configuring lookup rules#Reapply lookup rules on selected discovered items#Procedure#{5}":[356,357],"#Configuring lookup rules#Reapply lookup rules on selected discovered items#Procedure#{6}":[358,361],"#Configuring lookup rules#Reapply lookup rules on selected discovered items#Procedure#{7}":[362,363],"#Configuring lookup rules#Reapply lookup rules on selected discovered items#Procedure#{8}":[364,372],"#Configuring lookup rules#Related":[373,385],"#Configuring lookup rules#Related#{1}":[375,375],"#Configuring lookup rules#Related#{2}":[376,376],"#Configuring lookup rules#Related#{3}":[377,377],"#Configuring lookup rules#Related#{4}":[378,378],"#Configuring lookup rules#Related#{5}":[379,379],"#Configuring lookup rules#Related#{6}":[380,380],"#Configuring lookup rules#Related#{7}":[381,381],"#Configuring lookup rules#Related#{8}":[382,382],"#Configuring lookup rules#Related#{9}":[383,383],"#Configuring lookup rules#Related#{10}":[384,385]},"outlinks":[{"title":"mapping","target":"mapping-logrhythm","line":18},{"title":"Configure rules to manage findings","target":"sem-configure-rules-manage-findings","line":20},{"title":"Associating finding with a configuration item using lookup rules","target":"sem-associate-finding-configuration-item-using-lookup-rules","line":25},{"title":"Unified Security Exposure Management \\(USEM\\)","target":"unified-security-exposure-management-landing-page","line":37},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":43},{"title":"Application Vulnerability Response","target":"avr-landing","line":151},{"title":"Vulnerability Response","target":"vuln-landing-page","line":151},{"title":"Discovered Items","target":"cj-discovered-items","line":169},{"title":"Steps to help prevent duplicate or orphaned records after running Vulnerability Response CI lookup rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/vulnerability-response/ci-identifier-rules-impl-test.md","line":238},{"title":"Vulnerability Response vulnerable item form fields","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/vulnerability-response/vulnerable-item-fields.md","line":244},{"title":"KB0788209","target":"https://support.servicenow.com/kb_view.do?sysparm_article=KB0788209","line":258},{"title":"Security Operations","target":"security-operations-landing-page","line":258},{"title":"data mapping","target":"cc-prisma-import-data","line":277},{"title":"creating lookup rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/sem-configure-lookup-rules.md","line":297},{"title":"CI changes for discovered items","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/vulnerability-response/reapply-discovered-items-ci-changes.md","line":340},{"title":"Configure rules to manage findings","target":"sem-configure-rules-manage-findings","line":375},{"title":"Associating finding with a configuration item using lookup rules","target":"sem-associate-finding-configuration-item-using-lookup-rules","line":376},{"title":"Mapping","target":"mapping-logrhythm","line":377},{"title":"Unified Security Exposure Management \\(USEM\\)","target":"unified-security-exposure-management-landing-page","line":378},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":379},{"title":"Application Vulnerability Response","target":"avr-landing","line":380},{"title":"Vulnerability Response","target":"vuln-landing-page","line":381},{"title":"Discovered Items","target":"cj-discovered-items","line":382},{"title":"Security Operations","target":"security-operations-landing-page","line":383},{"title":"Data mapping","target":"cc-prisma-import-data","line":384}],"metadata":{"title":"Configuring lookup rules","description":"By configuring lookup rules, you can map security exposure data to the correct configuration items \\(CIs\\) in the CMDB. This mapping is a critical function because associating exposure findings with the right assets is essential for proper risk assessment, assignment, and remediation workflows.Create lookup rules to automatically and accurately associate incoming exposure findings data with the correct configuration items \\(CIs\\) in the Configuration Management Database \\(CMDB\\) This is essential for enabling the rest of the vulnerability management process to function correctly.To ignore some configuration item \\(CI\\) classes, for example Load Balancer \\[cmdb\\_ci\\_lb\\], when running lookup rules, set the ignoreCIClass \\[sn\\_sec\\_cmn.ignoreCIClass\\] system property.Reapply lookup rules to ensure updated or existing rules are applied to relevant items. This helps maintain accurate data mapping and consistency after rule changes or additions.Reapply the lookup rules on selected discovered items from the discovered item list view select actions. If the configuration item \\(CI\\) changes after you reapply the rules, the discovered items are updated with the new CI and impacted detections. Vulnerable items are also updated.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/sem-configure-lookup-rules.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Configure rules to manage findings","Implement","Unified Security Exposure Management","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/sem-configure-lookup-rules.md"},
