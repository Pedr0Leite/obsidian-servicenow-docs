ces/ctwm-track-care-team-task-plans.md","line":67},{"title":"Fulfilling care team task plans","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/healthcare-life-sciences/ctwm-fulfilling.md","line":68},{"title":"Care Team Work Management reference","target":"ctwm-reference","line":69},{"title":"Create a care team task plan using the Operational rounding playbook","target":"ctwm-operational-rounding-playbook","line":73},{"title":"Track care team task plans","target":"ctwm-track-care-team-task-plans","line":74},{"title":"Fulfilling care team task plans","target":"ctwm-fulfilling","line":75},{"title":"Configuring Care Team Work Management","target":"ctwm-configuring","line":76},{"title":"Care Team Work Management reference","target":"ctwm-reference","line":77},{"title":"Care Team Work Management","target":"ctwm-landing","line":78},{"title":"Care team cases and tasks","target":"ctwm-care-team-case","line":79}],"metadata":{"title":"Exploring Care Team Work Management","description":"Care Team Work Management provides a structured way for hospitals to design, coordinate, and execute operational work across care teams. By standardizing how work is defined, assigned, and completed, it reduces administrative overhead, gives clinicians more time for patient care, and improves operational reliability and regulatory readiness.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/healthcare-life-sciences/ctwm-exploring.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Care Team Work Management","Healthcare Operations","Healthcare and Life Sciences"],"tags":["#healthcare-life-sciences","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/healthcare-life-sciences/ctwm-exploring.md"},
