],"#SOAPMessageV2 - Scoped, Global#SOAPMessageV2 - execute\\(\\)#{5}":[80,92],"#SOAPMessageV2 - Scoped, Global#SOAPMessageV2 - executeAsync\\(\\)":[93,614],"#SOAPMessageV2 - Scoped, Global#SOAPMessageV2 - executeAsync\\(\\)#{1}":[95,614]},"outlinks":[{"title":"SOAP message","target":"c_SOAPMessage","line":24},{"title":"Direct SOAPMessageV2 example","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/r_DirectSOAPMessageV2Example.md","line":32},{"title":"Recordless SOAPMessageV2 example","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/r_RecordlessSOAPMessageV2Example.md","line":33},{"title":"Asynchronous SOAPMessageV2 example","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/r_AsyncronousSOAPMessageV2Example.md","line":34},{"title":"SOAPMessageV2 MID server example","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/r_SOAPMessageV2MIDServerExample.md","line":35},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":37},{"title":"SOAPResponseV2","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_SOAPResponseV2API.md","line":86},{"title":"update","target":"r_Update","line":99},{"title":"SOAPResponseV2 - Scoped, Global","target":"c_SOAPResponseV2API","line":115},{"title":"SOAP web service","target":"c_SOAPWebService","line":137},{"title":"execute\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_SOAPMessageV2API.md","line":148},{"title":"UriMatcher - Scoped","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/UriMatcherScopedAPI.md","line":206},{"title":"SOAPMessageV2\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_SOAPMessageV2API.md","line":299},{"title":"Redirections in HTTP","target":"https://developer.mozilla.org/en-US/docs/Web/HTTP/Redirections","line":318},{"title":"insert","target":"r_Insert","line":359},{"title":"SOAPMessageV2\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_SOAPMessageV2API.md","line":528},{"title":"SOAPResponseV2 - Scoped, Global","target":"c_SOAPResponseV2API","line":609},{"title":"SOAP web service","target":"c_SOAPWebService","line":610},{"title":"SOAP message","target":"c_SOAPMessage","line":611},{"title":"insert","target":"r_Insert","line":612},{"title":"update","target":"r_Update","line":613}],"metadata":{"title":"SOAPMessageV2 - Scoped, Global","description":"The SOAPMessageV2 API provides methods to send an outbound SOAP message using JavaScript.Instantiates an empty SOAPMessageV2 object.Instantiates a SOAPMessageV2 object from a SOAP message record and a function associated with that record.Sends the SOAP message to the endpoint.Sends the SOAP message to the External Communication Channel \\(ECC\\) queue.Gets the endpoint for the SOAP message.Returns the content of the SOAP message body.Gets the value for an HTTP header specified by the SOAP client.Gets HTTP headers that were set by the SOAP client and the associated values.Sets one or more URIs allowed to be redirected to. Controlling the allowed outbound URIs reduces security concerns and helps prevent URL redirect attacks that send users to malicious sites.Sets basic authentication headers for the SOAP message.Associates outbound requests and the resulting response record in the ECC queue.Overrides a value from the database by writing to the SOAP message payload.Sets the endpoint for the SOAP message.Sets the parameter in the API that controls automatic HTTP redirects. By default, automatic redirects are turned off.Sets the amount of time the SOAP message waits for a response from the web service provider before the request times out.Sets the log level for this message and the corresponding response.Configures the SOAP message to be sent through a MID Server.Sets the mutual authentication protocol profile for the SOAP message.Sets the body content to send to the web service provider.Sets an HTTP header in the SOAP message to the specified value.Defines the SOAP action this SOAP message performs.Sets a variable with the specified name from the SOAP message record to the specified value.Sets a variable with the specified name from the SOAP message record to the specified value.Sets web service security values for the SOAP message.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_SOAPMessageV2API.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":12,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[49,51],[64,66],[88,91],[125,139],[142,158],[162,178],[181,197],[200,218],[229,246],[249,265],[268,290],[293,309],[312,354],[364,368],[370,374],[384,388],[390,404],[407,448],[451,481],[484,500],[504,519],[522,538],[543,560],[563,580],[583,602]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_SOAPMessageV2API.md"},
