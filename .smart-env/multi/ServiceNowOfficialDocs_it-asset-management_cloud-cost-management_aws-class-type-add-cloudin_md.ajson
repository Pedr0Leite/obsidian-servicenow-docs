WS CI class type to ensure accurate billing data#Related#{2}":[102,103]},"outlinks":[{"title":"Cloud Cost Management","target":"cloud-insights-landing-page","line":32},{"title":"Cloud Cost Management Infra Stack","target":"ccm-infra-stack","line":34},{"title":"Schedule and manage the jobs that download AWS billing data","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/cloud-cost-management/aws-bill-dwnld-job-cloudin.md","line":95},{"title":"Supported CI class types for Amazon AWS Cloud services","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/cloud-cost-management/aws-supported-ci-class-types.md","line":97},{"title":"Cloud Cost Management","target":"cloud-insights-landing-page","line":101},{"title":"Cloud Cost Management Infra Stack","target":"ccm-infra-stack","line":102}],"metadata":{"title":"Add an AWS CI class type to ensure accurate billing data","description":"Specify the details of a new CI or CI type to enable the CI placement process to assign cost and usage data correctly. The process is a part of Billing Download job execution. The CI placement process associates downloaded cost and usage data with the appropriate CIs.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/cloud-cost-management/aws-class-type-add-cloudin.html","release":"australia","product":"Cloud Cost Management","classification":"cloud-cost-management","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Set up access to AWS billing and usage data","Configure Cloud Cost Management for AWS","Configuring Cloud Cost Management","Cloud Cost Management","IT Asset Management"],"tags":["#it-asset-management","#cloud-cost","#finops","#optimization","#itam","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/cloud-cost-management/aws-class-type-add