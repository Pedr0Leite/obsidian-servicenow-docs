/itr-ws-create-remediation-task.md","line":65},{"title":"IT Remediation Workspace","target":"it-remediation-workspace-landing-page","line":65},{"title":"Automating prioritization and triaging","target":"sem-automating-prioritization-triaging","line":76},{"title":"Configuring remediation task rules","target":"sem-configure-remediation-task-rules","line":81},{"title":"Automating prioritization and triaging","target":"sem-automating-prioritization-triaging","line":85},{"title":"Configuring remediation task rules","target":"sem-configure-remediation-task-rules","line":86},{"title":"IT Remediation Workspace","target":"it-remediation-workspace-landing-page","line":87}],"metadata":{"title":"Grouping multiple findings as remediation tasks for easy processing using remediation task rules","description":"Remediation tasks help vulnerability analysts and remediation teams manage findings in bulk. By configuring remediation task rules, you can automatically group findings into remediation tasks, eliminating the need for manual task creation and streamlining remediation efforts.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/sem-grouping-multiple-findings-remediation-tasks-processing.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Automating prioritization and triaging","Security Exposure Management workflow","Explore","Unified Security Exposure Management","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/sem-grouping-multiple-findings-remediation-tasks-processing.md"},
