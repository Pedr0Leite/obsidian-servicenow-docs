er \\(AjaxSchedueItem scheduleItem , Object rotaSpanItems, Object definitionItems, Array repeatRotaSpanIdArr\\)#{1}":[167,179],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - invalidateRotaRespCache \\(GlideRecord rotaRespCacheGR\\)":[180,191],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - invalidateRotaRespCache \\(GlideRecord rotaRespCacheGR\\)#{1}":[182,191],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - matchRotaSpanRule\\(ScheduleTimeSpan timeSpan, Array rotaSpanItems, Array repeatRotaSpanIdArr, Object seriesStartTimes\\)":[192,206],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - matchRotaSpanRule\\(ScheduleTimeSpan timeSpan, Array rotaSpanItems, Array repeatRotaSpanIdArr, Object seriesStartTimes\\)#{1}":[194,206],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - populateCalendarSubscriptionSettings \\(\\)":[207,218],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - populateCalendarSubscriptionSettings \\(\\)#{1}":[209,218],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - processSeriesEvent \\(List scheduleItems, Array repeatRotaSpanIdArr , String userId\\)":[219,232],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - processSeriesEvent \\(List scheduleItems, Array repeatRotaSpanIdArr , String userId\\)#{1}":[221,232],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - saveCalendarEvents \\(String groupId, String rotaId, String userId, Object dateRangeObj, String result\\)":[233,248],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - saveCalendarEvents \\(String groupId, String rotaId, String userId, Object dateRangeObj, String result\\)#{1}":[235,248],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - sendCalendarURL \\(GlideRecord rotaGR\\)":[249,260],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - sendCalendarURL \\(GlideRecord rotaGR\\)#{1}":[251,260],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - updateExceptionList \\(AJAXScheduleItem scheduleItem, ScheduleTimeSpan timeSpan, Array rotaSpanItems\\)":[261,274],"#OCRotaICalendarSNC- Global#OCRotaICalendarSNC - updateExceptionList \\(AJAXScheduleItem scheduleItem, ScheduleTimeSpan timeSpan, Array rotaSpanItems\\)#{1}":[263,274],"#OCRotaICalendarSNC- Global#Related":[275,278],"#OCRotaICalendarSNC- Global#Related#{1}":[277,278]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":26},{"title":"update","target":"r_Update","line":182},{"title":"update","target":"r_Update","line":277}],"metadata":{"title":"OCRotaICalendarSNC - Global","description":"The OCRotaICalendarSNC script include provides iCal formatted events for the a specific user's rotation.Records in the cmn\\_rota\\_resp\\_cache table that have a From date prior to today.Returns list of AJAXScheduleItems for the user's on-call.Creates a VEVENT based on the scheduleItemSpan provided.Creates a formatted iCalendar if the user has no upcoming on-call.Returns the formatted iCalendar for the user's rotation.Returns the formatted iCalendar for the user's rotation if found in the cmn\\_rota\\_resp\\_cache table.Checks whether the provided timeSpan intersects with one of the rota span items.Creates the subscribable URL for the user's iCalendar.Returns a URL to the on-call calendar based on the rota record.Returns an array of the user's overrides \\(extra coverage\\).Returns an object containing the user's override \\(extra coverage\\) and excluded spans.Used by business rules on the cmn\\_rota\\_member, cmn\\_schedule\\_span, and roster\\_schedule\\_span tables to update the cmn\\_rota\\_resp\\_cache table.Checks whether the provided timeSpan matches one of the rotaSpanItems.Used by fixed job to populate the calendar subscription fields on the cmn\\_rota formReturns an object containing the user's rotations.Inserts the user's iCalendar into the cmn\\_rota\\_resp\\_cache table.Queues events to send an email to all members of the rotation.Returns an object that contains all of the timeSpans that need to be excluded from the user's iCalendar.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_OCRotaICalendarSNCAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_OCRotaICalendarSNCAPI.md"},
