ed discovery#Procedure#{17}":[197,198],"#Calibrate fingerprint-based discovery#Adjust regular expression used for fingerprint-based discovery#Procedure#{18}":[199,200],"#Calibrate fingerprint-based discovery#Adjust regular expression used for fingerprint-based discovery#Procedure#{19}":[201,202],"#Calibrate fingerprint-based discovery#Adjust regular expression used for fingerprint-based discovery#Procedure#{20}":[203,205],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery":[206,229],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery#{1}":[208,209],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery#Before you begin":[210,213],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery#Before you begin#{1}":[212,213],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery#Procedure":[214,229],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery#Procedure#{1}":[216,217],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery#Procedure#{2}":[218,219],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery#Procedure#{3}":[220,222],"#Calibrate fingerprint-based discovery#Disable fingerprint-based discovery#Procedure#{4}":[223,229],"#Calibrate fingerprint-based discovery#Related":[230,233],"#Calibrate fingerprint-based discovery#Related#{1}":[232,233]},"outlinks":[{"title":"discovery","target":"r-discovery","line":24},{"title":"Configuration tips for Predictive Intelligence","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/troubleshooting-predictive-intelligence.md","line":92},{"title":"disable the fingerprint-based discovery","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/calibrate-process-based-discovery.md","line":102},{"title":"View and kill active transaction","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_ViewAndKillAnActiveTransaction.md","line":104},{"title":"Adjust regular expression used for fingerprint-based discovery","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/calibrate-process-based-discovery.md","line":148},{"title":"Add a system property","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_AddAPropertyUsingSysPropsList.md","line":216},{"title":"KB0826261: Advanced configuration and troubleshooting of fingerprint-based discovery","target":"https://support.servicenow.com/nav_to.do?uri=%2Fkb_view.do%3Fsysparm_article%3DKB0826261%26sysparm_stack%3D%26sysparm_view%3D","line":226},{"title":"Troubleshooting Guide for ML Connection Suggestions","target":"https://support.servicenow.com/nav_to.do?uri=%2Fkb%3Fid%3Dkb_article_view%26sysparm_article%3DKB0963421","line":228},{"title":"Discovery","target":"r-discovery","line":232}],"metadata":{"title":"Calibrate fingerprint-based discovery","description":"Fine-tune discovering applications based on processes, if the discovery results are not satisfactory.Fingerprint-based discovery relies on Predictive Intelligence for generating suggestions for discovery. If the Application Fingerprints dashboard does not display any suggestions, ensure that the Predictive Intelligence is configured correctly.Adjust definitions of process-based suggestions before starting discovery. Typically, you need to fine-tune automatically generated suggestions if the accuracy is less than 100%. Predictive Intelligence creates suggestions and provides the accuracy estimate for each suggestion. The lack of accuracy may result in the failure to discover required applications or the discovery of wrong applications in addition to the correctly discovered applications.Fine-tune the regular expression in the classifier rule to make discovery results more precise. Predictive Intelligence extracts regular expressions from processes and assigns them to classifier rules as part of creating suggestions. If you are not satisfied with the discovery results or the suggestion accuracy is lower than 100%, modify the regular expression.By default, the fingerprint-based discovery is enabled. Disable application discovery based on processes, if Predictive Intelligence does not generate enough processes.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/discovery/calibrate-process-based-discovery.html","release":"australia","product":"Discovery","classification":"discovery","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Discover applications based on fingerprints","Running discoveries in your network","Using Discovery","Discovery","ITOM Visibility","IT Operations Management"],"tags":["#it-operations-management","#discovery","#cmdb","#patterns","#ci","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/discovery/calibrate-process-based-discovery.md"},"smart_blocks:ServiceNowOfficialDocs/it-operations-management/discovery/calibrate-process-based-discovery.md#---frontmatter---": {"path":null,"last_embed":{"hash":"12of2bo","at":1784578497231},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.07322831,-0.01348963,0.01397905,-0.07440381,-0.01782535,-0.01753764,-0.00079642,0.01316473,0.04196623,-0.00189302,0.04083121,-0.00201096,0.0426268,0.00193245,-0.0389611,-0.01492869,0.02739904,0.03159926,0.05105649,-0.01808927,0.11593144,0.05324988,-0.02047682,-0.00466682,0.03828825,0.07074358,-0.01595169,-0.05213217,-0.04020036,-0.22794242,0.01727789,0.02298156,0.02017786,0.00386211,0.01427461,-0.03286166,-0.02109419,0.06915382,-0.06624074,0.02708383,0.02001999,0.05869697,-0.04140093,-0.01533171,-0.03601219,-0.05676882,-0.03701935,-0.000