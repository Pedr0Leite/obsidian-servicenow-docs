deRecord":[352,361],"#Script includes#Discovery script includes#Getting All the Fields In a GlideRecord#{1}":[354,361],"#Script includes#Discovery script includes#Populating GlideRecord Object Fields":[362,383],"#Script includes#Discovery script includes#Populating GlideRecord Object Fields#{1}":[364,383],"#Script includes#Discovery script includes#Getting Table Hierarchies":[384,393],"#Script includes#Discovery script includes#Getting Table Hierarchies#{1}":[386,393],"#Script includes#Discovery script includes#Using DiscoveryException and AutomationException":[394,417],"#Script includes#Discovery script includes#Using DiscoveryException and AutomationException#{1}":[396,417],"#Script includes#Related":[418,424],"#Script includes#Related#{1}":[420,420],"#Script includes#Related#{2}":[421,421],"#Script includes#Related#{3}":[422,422],"#Script includes#Related#{4}":[423,424]},"outlinks":[{"title":"Privacy settings on Glide AJAX enabled script includes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_ScriptIncludes.md","line":28},{"title":"Discovery script includes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_ScriptIncludes.md","line":28},{"title":"Useful scripts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/usefulScripts.md","line":30},{"title":"Server-side scripting","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_ServerScripting.md","line":32},{"title":"client scripts","target":"client-scripts","line":70},{"title":"Privacy settings on Glide AJAX enabled script includes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_ScriptIncludes.md","line":70},{"title":"Script sandbox evaluator","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/script-sandbox.md","line":88},{"title":"Versions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/c_Versions.md","line":194},{"title":"Use script includes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_ScriptIncludes.md","line":243},{"title":"Make UI pages public or private","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/t_MakeAPagePublic.md","line":266},{"title":"Require authentication by default for client-callable script includes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/sc-privacy-on-client-callable-script-includes.md","line":286},{"title":"Instance Security Hardening Settings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/security-hardening-settings.md","line":326},{"title":"scripting","target":"client-side-[[c_Script","line":332},{"title":"KB0550828","target":"https://support.servicenow.com/kb_view.do?sysparm_article=KB0550828","line":332},{"title":"GlideRecordUtil","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordUtilAPI.md","line":336},{"title":"update","target":"r_Update","line":374},{"title":"Client-side scripting","target":"client-side-scripting-overview","line":420},{"title":"Client scripts","target":"client-scripts","line":421},{"title":"Scripting","target":"c_Script","line":422},{"title":"update","target":"r_Update","line":423}],"metadata":{"title":"Script includes","description":"Script includes are used to store JavaScript that runs on the server.Script includes have a name, description, and, script. They also specify whether they are active or not, and whether they can be called from a client script. View existing or create a new script include using the Script Include form.Script includes are found under System Definition or System UI. You can call existing script includes from a script or create a new script include.Glide AJAX enabled Script Includes make the script include available to client scripts, list/report filters, reference qualifiers, or if specified as part of the URL.Privacy settings for Glide AJAX enabled script includes determine who can access a Glide AJAX enabled script include.Change the privacy setting for a single Glide AJAX enabled script include by adding the isPublic\\(\\) function.Protect your Glide AJAX enabled script includes against unauthorized use. For all records which are created a customer application, recommendations display that may help reduce security risk.Discovery script includes define JavaScript classes that you can use to accomplish Discovery tasks.When writing Discovery sensors and sensor-related scripts, you may want to use DiscoveryException or AutomationException to indicate that an exception has come from Discovery.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/scripts/c\\_ScriptIncludes.html","release":"australia","product":"Scripts","classification":"scripts","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["Server-side scripting","Scripting","API implementation","API implementation and reference"],"tags":["#api-reference","#script-includes","#server-side","#glideajax","#library","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[211,220],[224,227],[296,298],[302,312],[342,344],[348,350],[356,360],[366,372],[376,382],[388,392],[400,403],[407,414]],"key":"ServiceNowOfficialDocs/api-reference/scripts/c_ScriptIncludes.md"},
