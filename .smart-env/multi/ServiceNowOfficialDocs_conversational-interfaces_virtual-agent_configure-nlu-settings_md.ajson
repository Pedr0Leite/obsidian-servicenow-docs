},{"title":"Configure the Google DialogFlow ES intent and entity integration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/configure-dialogflow-es-integration.md","line":32},{"title":"Virtual Agent Lite","target":"va-lite","line":34},{"title":"Multilingual model management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/multilingual-model-managent.md","line":42},{"title":"Conversational Interfaces","target":"convint-landing-page","line":46},{"title":"Enable NLU languages in Virtual Agent settings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/enable-langs-va-gen-settings.md","line":97},{"title":"Hide or reveal the Show me everything button in Natural Language Understanding conversations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/hide-reveal-showme-button-nlu.md","line":106},{"title":"Configure IBM Watson Assistant as the NLU provider for Virtual Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/configure-watson-service-integration.md","line":108},{"title":"Configure Google Dialogflow ES as the NLU provider for Virtual Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/configure-dialogflow-es-integration.md","line":110},{"title":"Enhanced natural language handling of user inputs in NLU topic discovery","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/natural-language-user-response-handling.md","line":112},{"title":"Configuring Virtual Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowD