impact category and ratings#{5}":[57,64],"#Calculating RTO and RPO#Calculation of RPO score for the BIA with examples":[65,78],"#Calculating RTO and RPO#Calculation of RPO score for the BIA with examples#{1}":[67,78],"#Calculating RTO and RPO#Recovery time objective assessment":[79,84],"#Calculating RTO and RPO#Recovery time objective assessment#{1}":[81,84],"#Calculating RTO and RPO#Calculation of RTO score for the BIA with examples":[85,98],"#Calculating RTO and RPO#Calculation of RTO score for the BIA with examples#{1}":[87,98],"#Calculating RTO and RPO#Sample RTO calculation":[99,192],"#Calculating RTO and RPO#Sample RTO calculation#{1}":[101,192],"#Calculating RTO and RPO#Related":[193,198],"#Calculating RTO and RPO#Related#{1}":[195,195],"#Calculating RTO and RPO#Related#{2}":[196,196],"#Calculating RTO and RPO#Related#{3}":[197,198]},"outlinks":[{"title":"business impact analysis","target":"bia-uib","line":18},{"title":"business continuity management","target":"business-continuity-mangmt-overview","line":26},{"title":"Structured workflows for BIAs","target":"bia-tasks-performed-by-bia-owner","line":191},{"title":"Structured workflows for BIAs","target":"bia-tasks-performed-by-bia-owner","line":195},{"title":"Business impact analysis","target":"bia-uib","line":196},{"title":"Business Continuity Management","target":"business-continuity-mangmt-overview","line":197}],"metadata":{"title":"Calculating RTO and RPO","description":"The BCM application provides an assessment questionnaire for calculating the recovery time objective \\(RTO\\) and recovery point objective \\(RPO\\) in the business impact analysis \\(BIA\\). As a pre-requisite to the BIA, BCM administrator defines the impact ratings and sets up the assessment questions. After receiving the responses to the assessment, the BCM application calculates the RTO and RPO.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/rto-rpo-calculation.html","release":"australi