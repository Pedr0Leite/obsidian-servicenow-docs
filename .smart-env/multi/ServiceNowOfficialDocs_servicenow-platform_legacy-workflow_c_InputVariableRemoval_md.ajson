usercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/legacy-workflow/c_InputVariableMovement.md","line":27},{"title":"references","target":"reference-document-management","line":35},{"title":"System update sets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/system-update-sets.md","line":49},{"title":"ValidateUpdateSetDependencies","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/legacy-workflow/r_VldtUpdtStDpnd.md","line":57},{"title":"References","target":"reference-document-management","line":61}],"metadata":{"title":"Input variable removal","description":"Deleting workflow input variables, like insert and update actions, creates a customer update record in a user's current update set.An existing workflow already contains two input variables.When editing workflows, particularly when deleting input variables, be sure to use a single update set for all variable editing and workflow publishing.Prior to publishing a workflow version, the system validates the workflow model to assist the designer in planning for deployment.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/legacy-workflow/c\\_InputVariableRemoval.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Input variable movement","Workflow administration","Classic Workflow","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#legacy-workflow","#classic","#deprecated","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/legacy-workflow/c_InputVariableRemoval.md"},
