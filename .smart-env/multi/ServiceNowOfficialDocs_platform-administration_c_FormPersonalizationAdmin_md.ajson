106],"#Administering form personalization#Disable form personalization#Before you begin#{1}":[105,106],"#Administering form personalization#Disable form personalization#About this task":[107,110],"#Administering form personalization#Disable form personalization#About this task#{1}":[109,110],"#Administering form personalization#Disable form personalization#Procedure":[111,124],"#Administering form personalization#Disable form personalization#Procedure#{1}":[113,114],"#Administering form personalization#Disable form personalization#Procedure#{2}":[115,116],"#Administering form personalization#Disable form personalization#Procedure#{3}":[117,119],"#Administering form personalization#Disable form personalization#Procedure#{4}":[120,124],"#Administering form personalization#Related":[125,131],"#Administering form personalization#Related#{1}":[127,127],"#Administering form personalization#Related#{2}":[128,128],"#Administering form personalization#Related#{3}":[129,129],"#Administering form personalization#Related#{4}":[130,131]},"outlinks":[{"title":"Administering forms on the ServiceNow AI Platform","target":"form-administration","line":28},{"title":"Find components installed with an application","target":"find-components","line":48},{"title":"System Properties","target":"r_SetArchiveRuleProcessingBehavior","line":63},{"title":"Personalize a form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/t_PersonalizeAForm.md","line":71},{"title":"User Administration","target":"c_UserAdministration","line":83},{"title":"Personalize a form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/t_PersonalizeAForm.md","line":95},{"title":"User preferences","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_UserPreferences.md","line":97},{"title":"Personalize a form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/t_PersonalizeAForm.md","line":123},{"title":"Administering forms on the ServiceNow AI Platform","target":"form-administration","line":127},{"title":"Find components installed with an application","target":"find-components","line":128},{"title":"System properties","target":"r_SetArchiveRuleProcessingBehavior","line":129},{"title":"User administration","target":"c_UserAdministration","line":130}],"metadata":{"title":"Administering form personalization","description":"Administrators can configure several aspects of form personalization, which allows users to customize the layout for any form view.Form personalization is activated for new instances. To activate form personalization for upgraded instances, an administrator must activate the Form Personalization \\(com.glide.ui.personalize\\_form\\) plugin.By default, the itil role is required to personalize forms, but you can change this requirement with a system property.When a user personalizes a form, the system stores the customizations as a user preference record. You can view and manage the user preferences.If you do not want your users to customize forms, you can disable form personalization.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/c\\_FormPersonalizationAdmin.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Administer","Form administration","Forms","fields","and lists","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/c_FormPersonalizationAdmin.md"},
