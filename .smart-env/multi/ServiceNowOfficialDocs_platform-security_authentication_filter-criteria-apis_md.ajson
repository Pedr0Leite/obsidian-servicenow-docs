rkdown/platform-security/authentication/create-ip-filter-criteria.md","line":35},{"title":"Create role filter criteria","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/authentication/create-role-filter-criteria.md","line":37},{"title":"Create group filter criteria","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/authentication/create-group-filter-criteria.md","line":39},{"title":"Filter criteria","target":"adaptive-auth-filter-criteria","line":43},{"title":"Authentication","target":"c_Authentication","line":44},{"title":"IP Filter","target":"ip-filter","line":45},{"title":"Adaptive authentication","target":"adaptive-authentication","line":46}],"metadata":{"title":"Filter criteria for APIs","description":"Filter criteria contains filter conditions or queries that are used as policy inputs for an authentication policy. Policy inputs are used to group one or more filter criteria and define the policy conditions of an authentication policy. For example, an IP Filter Criteria define an IP address in the Classless Inter-Domain Routing \\(CIDR\\) format or a range of IP addresses.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/authentication/filter-criteria-apis.html","release":"australia","product":"Authentication","classification":"authentication","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["SOAP API access policies","API access policy","Authentication","Access Management"],"tags":["#platform-security","#sso","#oauth","#saml","#mfa","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-security/authentication/filter-criteria-apis.md"},
