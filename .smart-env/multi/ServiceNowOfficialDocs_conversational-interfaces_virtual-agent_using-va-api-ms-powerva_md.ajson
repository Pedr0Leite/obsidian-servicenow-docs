/markdown/conversational-interfaces/virtual-agent/create-primary-va-topic-ms-pva.md","line":40},{"title":"Using Virtual Agent Bot Interconnect in your configuration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/using-sn-va-primary-bot-api.md","line":43},{"title":"Virtual Agent","target":"virtual-agent-landing-page","line":47}],"metadata":{"title":"Using Microsoft Power Virtual Agents as a secondary bot with Virtual Agent Bot Interconnect","description":"With Bot Interconnect, you can use ServiceNow Virtual Agent as the primary bot with a Microsoft Power Virtual Agents secondary bot. All of the skills and topics available to Power Virtual Agents are made available to and executable from channels that are configured for ServiceNow Bot Interconnect.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/conversational-interfaces/virtual-agent/using-va-api-ms-powerva.html","release":"australia","product":"Virtual Agent","classification":"virtual-agent","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Using Virtual Agent Bot Interconnect in your configuration","Build and deploy","Virtual Agent","Conversational Interfaces"],"tags":["#conversational-interfaces","#virtual-agent","#chatbot","#nlu","#topics","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/conversational-interfaces/virtual-agent/using-va-api-ms-powerva.md"},
