":"purchase-lines","line":24},{"title":"Create an approval rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/create-approval-rule.md","line":28},{"title":"monitor an approval plan","target":"view-approval-plan","line":28},{"title":"Sourcing and Purchasing Automation","target":"purchase-experience-workflow","line":34},{"title":"purchase order","target":"purchase-order-table","line":56},{"title":"supplier","target":"supplier","line":57},{"title":"approval plan form","target":"approval-plan-form","line":62},{"title":"Sourcing and Purchasing Automation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/purchase-experience-workflow.md","line":64},{"title":"Purchase lines","target":"purchase-lines","line":68},{"title":"Monitor an approval plan","target":"view-approval-plan","line":69},{"title":"Sourcing and Purchasing Automation","target":"purchase-experience-workflow","line":70},{"title":"Purchase order","target":"purchase-order-table","line":71},{"title":"Supplier","target":"supplier","line":72},{"title":"Approval Plan form","target":"approval-plan-form","line":73}],"metadata":{"title":"Monitor an approval plan","description":"During evaluation, the approval engine converts each approval rule into one or multiple approval plans. You can monitor approval plans to understand how the overall approval process is being executed, the routing and decision methods, the list of approvers involved, the status on the approvals, the list of purchase lines the approval is planned for, and so on.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/source-to-pay-operations/sourcing-and-procurement-operations/work-with-approval-plan.html","release":"australia","product":"Sourcing and Procurement Operations","classification":"sourcing-and-procurement-operations","topi