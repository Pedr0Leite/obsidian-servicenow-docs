e-Visit Management#Related#{1}":[54,54],"#Domain separation and Pre-Visit Management#Related#{2}":[55,56]},"outlinks":[{"title":"Pre-Visit Management","target":"pre-visit-mgmt-app","line":18},{"title":"Application support for domain separation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-separated-apps.md","line":36},{"title":"Healthcare and Life Sciences data model","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/healthcare-life-sciences/healthcare-and-life-sciences-service-management-core/hcls-serv-mgmt-core.md","line":40},{"title":"Pre-Visit Management reference","target":"pre-visit-reference","line":50},{"title":"Pre-Visit Management reference","target":"pre-visit-reference","line":54},{"title":"Pre-Visit Management","target":"pre-visit-mgmt-app","line":55}],"metadata":{"title":"Domain separation and Pre-Visit Management","description":"If any conrefs are broken, re-add them from the doc/source/reuse/domain-separation/domain-separation-overview.dita file. In the short description, edit the first sentence to state whether domain separation is supported or not and add the application name. Keep the conref at the end that describes domain separation.Domain separation is supported for Pre-Visit Management. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/healthcare-life-sciences/pre-visit-domain-sep.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Reference","Pre-Visit Management","Healthcare and Life Sciences Service Management","Healthcare and Life Sciences"],"tags":["#healthcare-life-sciences","#type-concept"]},"task_lines":[],"tasks":{},"codeblock