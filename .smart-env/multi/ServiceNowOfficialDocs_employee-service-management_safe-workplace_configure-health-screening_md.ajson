ion emails":[281,353],"#Configure Employee Health Screening#Modify visitor notification emails#{1}":[283,284],"#Configure Employee Health Screening#Modify visitor notification emails#Before you begin":[285,288],"#Configure Employee Health Screening#Modify visitor notification emails#Before you begin#{1}":[287,288],"#Configure Employee Health Screening#Modify visitor notification emails#About this task":[289,341],"#Configure Employee Health Screening#Modify visitor notification emails#About this task#{1}":[291,341],"#Configure Employee Health Screening#Modify visitor notification emails#Procedure":[342,353],"#Configure Employee Health Screening#Modify visitor notification emails#Procedure#{1}":[344,345],"#Configure Employee Health Screening#Modify visitor notification emails#Procedure#{2}":[346,347],"#Configure Employee Health Screening#Modify visitor notification emails#Procedure#{3}":[348,349],"#Configure Employee Health Screening#Modify visitor notification emails#Procedure#{4}":[350,351],"#Configure Employee Health Screening#Modify visitor notification emails#Procedure#{5}":[352,353],"#Configure Employee Health Screening#Related":[354,360],"#Configure Employee Health Screening#Related#{1}":[356,356],"#Configure Employee Health Screening#Related#{2}":[357,357],"#Configure Employee Health Screening#Related#{3}":[358,358],"#Configure Employee Health Screening#Related#{4}":[359,360]},"outlinks":[{"title":"Send notifications for daily health verification","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/emergency-outreach/send-daily-health-verif-notif-outreach.md","line":28},{"title":"Employee Health Screening","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/safe-workplace/employee-health-screening.md","line":30},{"title":"Employee Health Screening","target":"employee-health-screening","line":46},{"title":"health and safety","target":"health-safety-overview","line":88},{"title":"Employee Readiness Core","target":"employee-readiness-core","line":168},{"title":"Employee Health and Safety Status","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/employee-readiness-core/employee-health-safety-status.md","line":168},{"title":"Now Mobile app","target":"mobile-employee-experience","line":170},{"title":"health and safety status","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/employee-readiness-core/employee-health-safety-status.md","line":178},{"title":"Employee Health and Safety Status","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/employee-readiness-core/employee-health-safety-status.md","line":315},{"title":"Email filters","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/c_EmailFilters.md","line":319},{"title":"Inbound mail configuration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/r_InboundMailConfiguration.md","line":319},{"title":"Set up Employee Health and Safety Status properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/employee-readiness-core/config-emp-core-properties.md","line":340},{"title":"Employee Health Screening","target":"employee-health-screening","line":356},{"title":"Health and Safety","target":"health-safety-overview","line":357},{"title":"Employee Readiness Core","target":"employee-readiness-core","line":358},{"title":"Now Mobile app","target":"mobile-employee-experience","line":359}],"metadata":{"title":"Configure Employee Health Screening","description":"Set properties to specify the global maximum temperature thresholds in Fahrenheit and Celsius. Temperatures taken during a health screening are compared to the global temperature threshold, established by the company, to allow or deny entry.Decide whether you store temperatures recorded during screening events. Also set the maximum temperature threshold to use to determine whether it is safe for employees or visitors to enter the workplace.Define overrides of the maximum temperature threshold specified in properties for particular locations. For example, a workplace in Mexico may have a higher setting because the climate is warmer. Also override the property for whether QR codes are generated.The Employee Health Screening application provides an employee health verification that is ready to use. However, you can modify the verification if you want to change the criteria that employees must agree to.The Employee Health Screening application provides visitor notifications that are ready to use. However, you can modify the notifications if you want to customize them for your company.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/safe-workplace/configure-health-screening.html","release":"australia","product":"Safe Workplace","classification":"safe-workplace","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Employee Health Screening","Safe Workplace","Health and Safety","Employee Service Management"],"tags":["#employee-service-management","#safe-workplace","#return-to-office","#covid","#facility","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/safe-workplace/configure-health-screening.md"},
