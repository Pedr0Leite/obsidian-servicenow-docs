an email or a work note#Use a response template to compose an email or a work note#Procedure#{8}":[84,86],"#Compose an email or a work note#Compose a work note for internal use":[87,121],"#Compose an email or a work note#Compose a work note for internal use#{1}":[89,90],"#Compose an email or a work note#Compose a work note for internal use#Before you begin":[91,94],"#Compose an email or a work note#Compose a work note for internal use#Before you begin#{1}":[93,94],"#Compose an email or a work note#Compose a work note for internal use#About this task":[95,98],"#Compose an email or a work note#Compose a work note for internal use#About this task#{1}":[97,98],"#Compose an email or a work note#Compose a work note for internal use#Procedure":[99,117],"#Compose an email or a work note#Compose a work note for internal use#Procedure#{1}":[101,102],"#Compose an email or a work note#Compose a work note for internal use#Procedure#{2}":[103,104],"#Compose an email or a work note#Compose a work note for internal use#Procedure#{3}":[105,106],"#Compose an email or a work note#Compose a work note for internal use#Procedure#{4}":[107,108],"#Compose an email or a work note#Compose a work note for internal use#Procedure#{5}":[109,110],"#Compose an email or a work note#Compose a work note for internal use#Procedure#{6}":[111,112],"#Compose an email or a work note#Compose a work note for internal use#Procedure#{7}":[113,114],"#Compose an email or a work note#Compose a work note for internal use#Procedure#{8}":[115,117],"#Compose an email or a work note#Compose a work note for internal use#Result":[118,121],"#Compose an email or a work note#Compose a work note for internal use#Result#{1}":[120,121],"#Compose an email or a work note#Related":[122,125],"#Compose an email or a work note#Related#{1}":[124,125]},"outlinks":[{"title":"email interaction","target":"email-as-an-interaction","line":19},{"title":"Email Interaction","target":"email-as-an-interaction","line":124}],"metadata":{"title":"Compose an email or a work note","description":"Use the Compose section in the email interaction to draft emails, create internal work notes, or draft email responses using response templates.Use the compose section to draft an email response to customers, addressing their inquiry or providing the necessary information.Use response templates to access predefined messages and compose emails. Agents can copy content from a template and add it to an email to save time.Compose a work note to document important information for internal reference. The information should be clear, concise, and relevant. This work note isn’t shared with customers.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/customer-service-management/composing-email-work-note.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"keywords":["Email Interaction for CSM","Email Interaction for CSM","Email Interaction for CSM","Email Interaction for CSM"],"breadcrumb":["Engage via email interactions","Using Email Interaction for CSM","Customer communication","Use","Customer Service Management"],"tags":["#customer-service-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/customer-service-management/composing-email-work-note.md"},
