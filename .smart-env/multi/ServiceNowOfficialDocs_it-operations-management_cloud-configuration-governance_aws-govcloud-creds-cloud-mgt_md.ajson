"line":148},{"title":"Discovery","target":"r-discovery","line":149},{"title":"Cloud Provisioning and Governance","target":"cloud-management-v2-landing-page","line":150},{"title":"Create a service account","target":"create-service-account","line":151}],"metadata":{"title":"Create AWS GovCloud credentials for Cloud Provisioning and Governance","description":"Skip this procedure if your organization does not use AWS GovCloud \\(US\\). To securely access data on your provider account, the Discovery process must present appropriate credentials. An AWS GovCloud \\(US\\) region is an isolated AWS region that meets stringent US government security and compliance requirements to host sensitive workloads. Cloud Provisioning and Governance supports all AWS GovCloud \\(US\\) services.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/cloud-configuration-governance/aws-govcloud-creds-cloud-mgt.html","release":"australia","product":"Cloud Configuration Governance","classification":"cloud-configuration-governance","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Day 1 setup guide for Amazon Web Services on Cloud Provisioning and Governance","Cloud Provisioning and Governance","ITOM Cloud Accelerate","IT Operations Management"],"tags":["#it-operations-management","#cloud-config","#drift","#compliance","#itom","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/cloud-configuration-governance/aws-govcloud-creds-cloud-mgt.md"},"smart_blocks:ServiceNowOfficialDocs/it-operations-management/cloud-configuration-governance/aws-govcloud-creds-cloud-mgt.md#---frontmatter---": {"path":null,"last_embed":{"hash":"19yxokh","at":1784578168337},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.00350574,-0.0887472,-0.00381518,-0.07386725,0.05781256,0.05333931,0.001105,-0.01727757,-0.06721457,0.05829857,0.01241018,-0.06141739,0.05770921,-0.01837616,0.07