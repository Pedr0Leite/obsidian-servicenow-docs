To\\(String path\\_to\\_resource, Object context\\)#{6}":[122,122],"#GlideSecurityManager- Global#GlideSecurityManager - hasRightsTo\\(String path\\_to\\_resource, Object context\\)#{7}":[123,124],"#GlideSecurityManager- Global#GlideSecurityManager - hasRightsTo\\(String path\\_to\\_resource, Object context\\)#{8}":[125,143]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":26},{"title":"Access Controls Evaluation Order","target":"https://developer.servicenow.com/dev.do#!/learn/learning-plans/yokohama/servicenow_application_developer/app_store_learnv2_securingapps_yokohama_access_controls_evaluation_order","line":61}],"metadata":{"title":"GlideSecurityManager - Global","description":"The GlideSecurityManager API provides methods that enable you to retrieve a SecurityManager object and to check if the current user has access rights, both table-level and field-level, to a specified GlideRecord table based on the configured Access Control Rules \\(ACLs\\).Returns a SecurityManager object.Indicates whether the current user has table-level access rights to a specified GlideRecord table based on the configured Access Control Rules \\(ACLs\\). This method evaluates all available ACLs for the specific resource.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/GlideSecurityManagerAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[42,49],[53,55],[128,135],[139,141]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GlideSecurityManagerAPI.md"},
