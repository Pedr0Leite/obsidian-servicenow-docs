current\\_location#Response body parameters \\(JSON or XML\\)":[808,987],"#WSD Unified Search API#WSD Unified Search - GET /api/sn\\_wsd\\_core/wsd\\_unified\\_search/current\\_location#Response body parameters \\(JSON or XML\\)#{1}":[810,827],"#WSD Unified Search API#WSD Unified Search - GET /api/sn\\_wsd\\_core/wsd\\_unified\\_search/current\\_location#Response body parameters \\(JSON or XML\\)#{2}":[828,828],"#WSD Unified Search API#WSD Unified Search - GET /api/sn\\_wsd\\_core/wsd\\_unified\\_search/current\\_location#Response body parameters \\(JSON or XML\\)#{3}":[829,830],"#WSD Unified Search API#WSD Unified Search - GET /api/sn\\_wsd\\_core/wsd\\_unified\\_search/current\\_location#Response body parameters \\(JSON or XML\\)#{4}":[831,937],"#WSD Unified Search API#WSD Unified Search - GET /api/sn\\_wsd\\_core/wsd\\_unified\\_search/current\\_location#Response body parameters \\(JSON or XML\\)#{5}":[938,938],"#WSD Unified Search API#WSD Unified Search - GET /api/sn\\_wsd\\_core/wsd\\_unified\\_search/current\\_location#Response body parameters \\(JSON or XML\\)#{6}":[939,940],"#WSD Unified Search API#WSD Unified Search - GET /api/sn\\_wsd\\_core/wsd\\_unified\\_search/current\\_location#Response body parameters \\(JSON or XML\\)#{7}":[941,987]},"outlinks":[{"title":"REST API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/api-rest.md","line":37},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":291},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":305},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":767},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":800}],"metadata":{"title":"WSD Unified Search API","description":"The WSD Unified Search API provides an endpoint to search across workplace users and locations.Searches for users and workplace locations \\(case-insensitive\\) matching the provided search term. Returns a combined list of matching results with pagination support.Retrieve the current location of a specific user based on their active reservations, workplace profile, or neighborhood assignment. Returns the most relevant public location first, falling back to private locations if no public location is found.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/wsd\\_unified-search-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-04-28","reading_time_minutes":12,"keywords":["Workplace Service Delivery Core","WSD"],"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[163,167],[192,198],[234,239],[333,339],[375,390],[463,468],[494,502],[567,589],[593,631],[639,646],[650,659],[663,673],[677,694],[881,886],[948,954],[958,977],[981,985]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/wsd_unified-search-api.md"},
