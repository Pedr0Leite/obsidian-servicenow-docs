stand your System Events Dashboard#Details-Configure an alert":[126,155],"#Understand your System Events Dashboard#Details-Configure an alert#{1}":[128,129],"#Understand your System Events Dashboard#Details-Configure an alert#Before you begin":[130,133],"#Understand your System Events Dashboard#Details-Configure an alert#Before you begin#{1}":[132,133],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure":[134,155],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{1}":[136,137],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{2}":[138,139],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{3}":[140,141],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{4}":[142,143],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{5}":[144,145],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{6}":[146,149],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{7}":[150,151],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{8}":[152,153],"#Understand your System Events Dashboard#Details-Configure an alert#Procedure#{9}":[154,155],"#Understand your System Events Dashboard#Related":[156,162],"#Understand your System Events Dashboard#Related#{1}":[158,158],"#Understand your System Events Dashboard#Related#{2}":[159,159],"#Understand your System Events Dashboard#Related#{3}":[160,160],"#Understand your System Events Dashboard#Related#{4}":[161,162]},"outlinks":[{"title":"System Events","target":"events","line":26},{"title":"System Diagnostics","target":"sys-diag","line":26},{"title":"scheduled jobs","target":"c_ScheduledJobs","line":97},{"title":"Configurations","target":"clone-configurations-tab","line":138},{"title":"System Diagnostics","target":"sys-diag","line":158},{"title":"System Events","target":"events","line":159},{"title":"Scheduled jobs","target":"c_ScheduledJobs","line":160},{"title":"Configurations","target":"clone-configurations-tab","line":161}],"metadata":{"title":"Understand your System Events Dashboard","description":"Use the System Event Processing dashboard to set the filters to display information about events and queues.The Scores and tab shows what's going on in the event processing system.Use the Current Scores section to have a direct check on the sysevent table and shows the current states of the events.Use the Trends section to have a metric-based graphical understanding of the activities in the event processing system.Review the details of an alert set every 15 minutes mostly on an instance level. By default, five alerts are provided along with the application. The alerts are setup based on a set of conditions, including what queue it applies to.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/setup-event-monitoring-dashboard.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Monitor System Events and Scheduled Jobs dashboard","Maintain and monitor","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/setup-event-monitoring-dashboard.md"},
