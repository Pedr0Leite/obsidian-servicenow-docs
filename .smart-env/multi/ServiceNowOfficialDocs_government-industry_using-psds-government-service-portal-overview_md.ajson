get":"psds-service-catalog-list","line":200},{"title":"Government Service Portal","target":"gsp-overview-public-sector","line":201}],"metadata":{"title":"Using the Government Service Portal in Public Sector Digital Services","description":"By using the Government Service Portal, constituents and businesses can report issues, access and view the status of existing service requests, and request public records. You can also search for information about a question or issue, view and update their contact information, and request assistance from a government service agent— all within a customizable interface.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/government-industry/using-psds-government-service-portal-overview.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Portals","Use","Public Sector Digital Services \\(PSDS\\)"],"tags":["#government-industry","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/government-industry/using-psds-government-service-portal-overview.md"},
