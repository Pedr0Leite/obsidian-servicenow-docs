","line":20},{"title":"FSO table definitions","target":"fso-int_guide-table_defs","line":20},{"title":"Financial Services Payment Operations","target":"payment-ops-landing-page","line":24},{"title":"Financial Services Card Operations","target":"card-ops-landing-page","line":25},{"title":"User roles and FSO Business rules","target":"fso-core-roles","line":29},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/use-REST-API-Explorer.md","line":33},{"title":"Financial Services Operations Core","target":"financial-services-operations-core-data-model","line":37},{"title":"FSO table definitions","target":"fso-int_guide-table_defs","line":38},{"title":"User roles and FSO Business rules","target":"fso-core-roles","line":39},{"title":"Financial Services","target":"fso-overview","line":40},{"title":"Financial Services Payment Operations","target":"payment-ops-landing-page","line":41},{"title":"Financial Services Card Operations","target":"card-ops-landing-page","line":42}],"metadata":{"title":"Working with ServiceNow REST APIs","description":"Financial Services Operations \\(FSO\\) leverages the REST Table API to enable external sources, such as bank applications, to interact with the FSO data stored on a ServiceNow instance. The Table API provides endpoints that enable you to perform all CRUD operations \\(create, read, update, and delete\\) on your FSO centric tables from an external source.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/financial-services-operations/fso-int\\_guide-work\\_rest\\_apis.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Developer resources","Financial Services Operations \\(FSO\\)"],"tags":["#financial-services-operations","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/financial-services-operations/fso-int_guide-work_rest_apis.md"},
