stions#Can I use different documents for the same HR case?#{1}":[99,101],"##Frequently asked questions#Can generalPdfUtils.prefillPdf() be used to generate an editable PDF? If not, how can I generate an editable PDF?":[102,121],"##Frequently asked questions#Can generalPdfUtils.prefillPdf() be used to generate an editable PDF? If not, how can I generate an editable PDF?#{1}":[104,105],"##Frequently asked questions#Can generalPdfUtils.prefillPdf() be used to generate an editable PDF? If not, how can I generate an editable PDF?#Sample Code:":[106,121],"##Frequently asked questions#Can generalPdfUtils.prefillPdf() be used to generate an editable PDF? If not, how can I generate an editable PDF?#Sample Code:#{1}":[108,121],"##Frequently asked questions#Why is a fillable PDF not editable for the user?":[122,130],"##Frequently asked questions#Why is a fillable PDF not editable for the user?#{1}":[124,130],"##Frequently asked questions#Why can a user edit fields on the fillable PDF of an HR PDF template on an E-signature task, yet after signing and submission, only the signature is updated and not the edited fields?":[131,135],"##Frequently asked questions#Why can a user edit fields on the fillable PDF of an HR PDF template on an E-signature task, yet after signing and submission, only the signature is updated and not the edited fields?#{1}":[133,135],"##Frequently asked questions#I have an issue with the old \"sign document\" task type. What should I do?":[136,139],"##Frequently asked questions#I have an issue with the old \"sign document\" task type. What should I do?#{1}":[138,139],"##Frequently asked questions#Can you confirm whether \"Automatically Create Draft Document\" (HR Service Case Option) works with Document templates (not HR Documents)?":[140,143],"##Frequently asked questions#Can you confirm whether \"Automatically Create Draft Document\" (HR Service Case Option) works with Document templates (not HR Documents)?#{1}":[142,143],"##Frequently asked questions#Can you confirm whether \"Preview document\" works with Document Templates of type PDF on the new HR Agent workspace (configurable)? We already know they work with HTML documents.":[144,147],"##Frequently asked questions#Can you confirm whether \"Preview document\" works with Document Templates of type PDF on the new HR Agent workspace (configurable)? We already know they work with HTML documents.#{1}":[146,147],"##Frequently asked questions#Are Document Templates \\[sn\\_doc\\] going to replace HR Document Templates, as HR Document Templates offer limited functionality and will not be updated in the future?":[148,153],"##Frequently asked questions#Are Document Templates \\[sn\\_doc\\] going to replace HR Document Templates, as HR Document Templates offer limited functionality and will not be updated in the future?#{1}":[150,153],"##Frequently asked questions#How to increase the size of an e-signature on the generated PDF?":[154,157],"##Frequently asked questions#How to increase the size of an e-signature on the generated PDF?#{1}":[156,157],"##Additional information":[158,170],"##Additional information##Product Documentation:":[160,170],"##Additional information##Product Documentation:#{1}":[162,162],"##Additional information##Product Documentation:#{2}":[163,163],"##Additional information##Product Documentation:#{3}":[164,165],"##Additional information##Product Documentation:#{4}":[166,168],"##Additional information##Product Documentation:#{5}":[169,170]},"outlinks":[{"title":"Additional Information","target":"#mcetoc_1hhkhd6jo8v","line":17},{"title":"What are the various E-signature applications available with HR Service Delivery?","target":"#mcetoc_1hhkhd6jo8h","line":21},{"title":"How do I generate documents in HR Service Delivery?","target":"#mcetoc_1hhkhd6jo8i","line":22},{"title":"How can I use E-signature outside of HR?","target":"#mcetoc_1hhkhd6jo8j","line":23},{"title":"I e-signed, but the signature doesn't appear in the document. Why?","target":"#mcetoc_1hhkhd6jo8k","line":24},{"title":"How do I solve HTML to PDF conversion issues?","target":"#mcetoc_1hhkhd6jo8l","line":25},{"title":"Can I use different documents for the same HR case?","target":"#mcetoc_1hhkhd6jo8m","line":26},{"title":"Can generalPdfUtils.prefillPdf() be used to generate an editable PDF? If not, how can I generate an editable PDF?","target":"#mcetoc_1hhkhd6jo8n","line":27},{"title":"Why is a fillable PDF not editable for the user?","target":"#mcetoc_1hhkhd6jo8o","line":28},{"title":"Why can a user edit fields on the fillable PDF of HR PDF Template on an E-signature task, yet after signing and submission, only the signature is updated and not the edited fields?","target":"#mcetoc_1hhkhd6jo8p","line":29},{"title":"I have an issue with the old \"sign document\" task type. What should I do?","target":"#mcetoc_1hhkhd6jo8q","line":30},{"title":"Can you confirm whether \"Automatically Create Draft Document\" (HR Service Case Option) works with Document templates (not HR Documents)?","target":"#mcetoc_1hhkhd6jo8r","line":31},{"title":"Can you confirm whether \"Preview document\" works with Document Templates of type PDF on the new HR Agent workspace (configurable)? We already know they work with HTML documents.","target":"#mcetoc_1hhkhd6jo8s","line":32},{"title":"How to increase the size of an e-signature on the generated PDF?","target":"#mcetoc_1hhkhd6jo8u","line":34},{"title":"Additional information","target":"#mcetoc_1hhkhd6jo8v","line":35},{"title":"HR e-signature","target":"https://www.servicenow.com/docs/bundle/yokohama-employee-service-management/page/product/human-resources/concept/hr-e-signature.html \"Sign electronic documents from any desktop or mobile device with e-signature. E-signature is a scoped application that enables users to sign managed documents, knowledge articles, or HR document templates with their typed or drawn e-signature, their credentials, or as an acknowledgment.\"","line":39},{"title":"HR document templates","target":"https://www.servicenow.com/docs/bundle/yokohama-employee-service-management/page/product/human-resources/concept/c_HRDocumentTemplates.html \"HR Document Templates are used to create and modify reuseable HR documents.\"","line":40},{"title":"Document Templates","target":"https://www.servicenow.com/docs/bundle/yokohama-employee-service-management/page/product/human-resources/concept/document-templates-overview.html \"With the ServiceNow Document Templates application, you can create HTML and PDF document templates to generate standard letters or documents. You can automate and simplify the process of filling, signing, and reviewing a document online.\"","line":41},{"title":"E-signature applications of HR Service Delivery","target":"https://www.servicenow.com/docs/csh?topicname=hr-esigning-app.html&version=latest \"E-signature applications of HR Service Delivery\"","line":43},{"title":"KB1633478","target":"/kb?id=kb_article_view&sys_kb_id=b51b4954472c8690f93138ce536d4365","line":93},{"title":"PDFGenerationAPI API - Scoped, Global","target":"https://docs.servicenow.com/csh?topicname=PDFGenerationAPIBothAPI.html&version=latest","line":120},{"title":"Configure an HR PDF document template","target":"https://docs.servicenow.com/bundle/washingtondc-employee-service-management/page/product/human-resources/task/PDFTemplate.html","line":126},{"title":"KB0998546","target":"/kb?id=kb_article_view&sysparm_article=KB0998546","line":128},{"title":"Configure an HR PDF document template","target":"https://docs.servicenow.com/bundle/washingtondc-employee-service-management/page/product/human-resources/task/PDFTemplate.html","line":134},{"title":"Migrate existing HR task templates and open HR tasks to e-signature","target":"https://docs.servicenow.com/bundle/washingtondc-employee-service-management/page/product/human-resources/task/migrate-existing-tasks-to-scoped-e-signature.html","line":138},{"title":"HR Document Templates","target":"https://www.servicenow.com/docs/csh?topicname=c_HRDocumentTemplates.html&version=latest \"HR Document Templates\"","line":150},{"title":"Document Templates","target":"https://www.servicenow.com/docs/csh?topicname=document-templates-overview.html&version=latest \"With the ServiceNow Document Templates application, you can create HTML and PDF document templates to generate standard letters or documents. You can automate and simplify the process of filling, signing, and reviewing a document online.\"","line":152},{"title":"Migrating from HR Document Templates to Document Templates","target":"https://www.servicenow.com/docs/csh?topicname=migration-hrdt-dt.html&version=latest \"Review these guidelines to successfully migrate from HR Document Templates to Document Templates. Document Templates provides the latest experience of HR Document Templates functionality with additional features and capabilities.\"","line":152},{"title":"KB1590161","target":"/kb?id=kb_article_view&sysparm_article=KB1590161","line":156},{"title":"HR Document Templates","target":"https://docs.servicenow.com/csh?topicname=c_HRDocumentTemplates.html&version=latest","line":162},{"title":"HR E-signature","target":"https://docs.servicenow.com/csh?topicname=hr-e-signature.html&version=latest","line":163},{"title":"Document Templates","target":"https://docs.servicenow.com/csh?topicname=document-templates-overview.html&version=latest","line":164},{"title":"E-Signature","target":"https://docs.servicenow.com/csh?topicname=e-signature.html&version=latest","line":166},{"title":"Advanced Forms Management in HR Service Delivery","target":"https://www.servicenow.com/community/hrsd-articles/advanced-forms-management-in-hr-service-delivery/ta-p/2309758","line":169}],"metadata":{"title":"E-Signature/Document Template FAQ","aliases":["KB0966931"],"tags":["#servicenow","#support-kb"],"source_url":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB0966931","kb_number":"KB0966931","last_modified":"2025-09-22"},"task_lines":[],"tasks":{},"codeblock_ranges":[