39},{"title":"Work item queues","target":"awa-queues","line":140},{"title":"Service channels","target":"awa-service-channels","line":141}],"metadata":{"title":"Exploring Advanced Work Assignment","description":"Use Advanced Work Assignment \\(AWA\\) to automatically assign work items to your agents, based on their availability, capacity, and optionally, skills. AWA pushes work to qualified agents using work item queues, routing conditions, and assignment criteria that you define. Agents see their assignments in their Agent Workspace inbox.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/conversational-interfaces/advanced-work-assignment/awa-overview.html","release":"australia","product":"Advanced Work Assignment","classification":"advanced-work-assignment","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Advanced Work Assignment","Manage people and work","Conversational Interfaces"],"tags":["#conversational-interfaces","#awa","#routing","#queues","#agents","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/conversational-interfaces/advanced-work-assignment/awa-overview.md"},
