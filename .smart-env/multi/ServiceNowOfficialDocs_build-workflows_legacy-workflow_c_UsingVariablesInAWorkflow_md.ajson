rkflow#Workflow scratchpad variables#Display#{1}":[164,167],"#Using variables in a workflow#Workflow scratchpad variables#Access and Assignment":[168,181],"#Using variables in a workflow#Workflow scratchpad variables#Access and Assignment#{1}":[170,181],"#Using variables in a workflow#Current variables":[182,213],"#Using variables in a workflow#Current variables#{1}":[184,185],"#Using variables in a workflow#Current variables#Declaration":[186,189],"#Using variables in a workflow#Current variables#Declaration#{1}":[188,189],"#Using variables in a workflow#Current variables#Display":[190,193],"#Using variables in a workflow#Current variables#Display#{1}":[192,193],"#Using variables in a workflow#Current variables#Access and Assignment":[194,213],"#Using variables in a workflow#Current variables#Access and Assignment#{1}":[196,213],"#Using variables in a workflow#Related":[214,220],"#Using variables in a workflow#Related#{1}":[216,216],"#Using variables in a workflow#Related#{2}":[217,217],"#Using variables in a workflow#Related#{3}":[218,218],"#Using variables in a workflow#Related#{4}":[219,220]},"outlinks":[{"title":"workflow activities","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/workflow-activities/c_WorkflowActivities.md","line":25},{"title":"Workflow management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/managing-workflows.md","line":27},{"title":"Activity Definitions","target":"activity-definitions","line":47},{"title":"Workflow catalog variables","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowCatalogVariables.md","line":76},{"title":"Workflow Editor","target":"workflow-editor","line":78},{"title":"Workflow Activities","target":"c_WorkflowActivities","line":86},{"title":"Workflows used as subflows","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/workflows-as-subflows.md","line":138},{"title":"Workflow properties","target":"r_WorkflowProperties","line":184},{"title":"Activity definitions","target":"activity-definitions","line":216},{"title":"Workflow editor","target":"workflow-editor","line":217},{"title":"Workflow activities","target":"c_WorkflowActivities","line":218},{"title":"Workflow properties","target":"r_WorkflowProperties","line":219}],"metadata":{"title":"Using variables in a workflow","description":"Within workflow there are several different types of variables that are available.Activity variables are properties specifically associated with a workflow activity.Workflow variables are external values that are passed into and referenced by a workflow during its execution.After being declared in a workflow, values can be assigned to the variables from where the workflow is kicked off.Store and share string-based variables as name-value pairs between workflow activities.Current is the database GlideRecord that kicked off the workflow, either by association to the table in the Workflow properties table or by being associated with a catalog item.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/legacy-workflow/c\\_UsingVariablesInAWorkflow.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Workflow management","Classic Workflow","Build workflows"],"tags":["#build-workflows","#legacy-workflow","#classic","#deprecated","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[59,61],[96,98],[107,117],[121,132],[144,146],[158,160],[172,174],[178,180],[198,200],[204,206],[210,212]],"key":"ServiceNowOfficialDocs/build-workflows/legacy-workflow/c_UsingVariablesInAWorkflow.md"},
