","line":65},{"title":"Manage people and work capabilities","target":"manage-people","line":69},{"title":"Components installed with Interaction Management","target":"components-installed-with-interaction-management","line":70},{"title":"Reference","target":"reference","line":71},{"title":"Interaction wrap up","target":"interaction-wrap-up-state","line":72},{"title":"Create an interaction","target":"create-interactions","line":73}],"metadata":{"title":"Interaction Management","description":"Interactions provide a centralized location for all communication channels in the platform. Each interaction represents a request for assistance through a given channel, for example, a call or a chat. The purpose of Interaction Management is to help get insights into the channel's effectiveness.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/interaction-management/interaction-management.html","release":"australia","product":"Interaction Management","classification":"interaction-management","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Manage people and work capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#interactions","#routing","#omnichannel","#platform","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/interaction-management/interaction-management.md"},
