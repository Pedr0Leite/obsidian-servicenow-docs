l multiple MID Servers on a single system#Multiple MID Server deployments#Load balancing#{1}":[117,118],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#Load balancing#{2}":[119,119],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#Load balancing#{3}":[120,120],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#Load balancing#{4}":[121,121],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#Load balancing#{5}":[122,123],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#High availability model":[124,129],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#High availability model#{1}":[126,129],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#Wide area network \\(WAN\\)":[130,133],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#Wide area network \\(WAN\\)#{1}":[132,133],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#Domain separation":[134,139],"#Install multiple MID Servers on a single system#Multiple MID Server deployments#Domain separation#{1}":[136,139],"#Install multiple MID Servers on a single system#Related":[140,144],"#Install multiple MID Servers on a single system#Related#{1}":[142,142],"#Install multiple MID Servers on a single system#Related#{2}":[143,144]},"outlinks":[{"title":"domain separation","target":"domain-separation-relationship-formatter-editor","line":24},{"title":"Set up indicator for installation phase","target":"../image/ProgressBarInstall.png","line":32,"embedded":true},{"title":"MID Server","target":"mid-server-landing","line":39},{"title":"configure your MID Server","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/c_MIDServerConfiguration.md","line":92},{"title":"Domain separation","target":"domain-separation-relationship-formatter-editor","line":142},{"title":"MID Server","target":"mid-server-landing","line":143}],"metadata":{"title":"Install multiple MID Servers on a single system","description":"Install multiple MID Servers on the same host computer. Multiple MID Servers can support each other with load balancing, as well as use domain separation. The number of MID Servers required is determined by factors like network policies, security restraints, and the reliability of the host computer.Depending upon how you use the MID Server \\(for an external integration, Discovery, Service Mapping, or Orchestration\\) and the load placed on it, you might find it necessary to deploy multiple MID Servers in your network.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/mid-server/t\\_InstallMultplMIDSvrOnASingleSys.html","release":"australia","product":"MID Server","classification":"mid-server","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Installing the MID Server","Configuring MID Server","MID Server","Manage instance data sources","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#mid-server","#on-premise","#proxy","#connectivity","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/mid-server/t_InstallMultplMIDSvrOnASingleSys.md"},
