","Customer communication","Use","Customer Service Management"],"tags":["#customer-service-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/customer-service-management/creating-case-from-email-interaction.md"},
