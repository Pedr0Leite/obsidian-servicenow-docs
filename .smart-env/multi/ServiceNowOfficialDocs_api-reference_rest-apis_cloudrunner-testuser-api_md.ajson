api-reference/cloudrnr-TestUserAPI-scoped.md","line":38},{"title":"REST API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/api-rest.md","line":40},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":81},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":106},{"title":"web services","target":"r_AvailableWebServices","line":243},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":288},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":313},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":412},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":445},{"title":"insert","target":"r_Insert","line":534},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":613},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":646},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":776},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":809},{"title":"Server API reference","target":"api-server","line":876},{"title":"Web services","target":"r_AvailableWebServices","line":877},{"title":"insert","target":"r_Insert","line":878}],"metadata":{"title":"Cloud Runner Test User REST API","description":"Manages test user jobs to be executed in a cloud runner for Automated Test Framework \\(ATF\\).Provides the status of the test user job for a provided Browser Orchestration Queue \\(BOQ\\) record.Checks whether a provided user is a valid cloud user.Inserts a test user job into the BOQ \\[sn\\_atf\\_tg\\_sn\\_boq\\] table for a given user name, which is then run on cloud runner.Sets the test user job status in the Browser Orchestration Queue \\(BOQ\\) \\[sn\\_atf\\_tg\\_sn\\_boq\\] table to complete.Starts an end-to-end test user job on cloud runner. If the user is able to log in with the admin role, the cloud user property defaults to this user for future test runs and test generations.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/cloudrunner-testuser-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":12,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[163,167],[171,213],[218,222],[229,341],[358,363],[367,373],[501,505],[509,536],[543,547],[553,557],[562,566],[572,703],[720,727],[731,737],[838,855],[862,866]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/cloudrunner-testuser-api.md"},
