":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Setting up and configuring Universal Request","Universal Request","Employee Service Management"],"tags":["#employee-service-management","#universal-request","#routing","#hr","#cross-department","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/universal-request-for-hr-service-delivery/domain-sep-universal-request.md"},
