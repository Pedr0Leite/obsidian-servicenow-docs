:"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/conversation-designer-virtual-agent.md","line":34},{"title":"Prebuilt Virtual Agent topics, topic blocks, and ServiceNow NLU models","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/prebuilt-topics-ITSM.md","line":36},{"title":"Designing a Virtual Agent topic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/design-va-topic.md","line":71},{"title":"Add a system property","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_AddAPropertyUsingSysPropsList.md","line":83},{"title":"Activate the NLU Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/activate-nlu-workbench.md","line":89},{"title":"Natural Language Understanding","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/nlu-landing.md","line":89},{"title":"Natural Language Understanding in Virtual Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/va-NLU.md","line":91},{"title":"subflows","target":"flows-ukg","line":97},{"title":"Prebuilt Virtual Agent topics, topic blocks, and ServiceNow NLU models","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/prebuilt-topics-ITSM.md","line":114},{"title":"Virtual Agent integration with messaging apps","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/va-integration-messaging-apps.md","line":120},{"title":"Setting up Virtual Agent notifications","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/configuring-va-notifications.md","line":122},{"title":"Virtual Agent notifications","target":"va-notification-ta","line":122},{"title":"Topic Recommendations settings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/tr-settings-page.md","line":126},{"title":"Using Virtual Agent Topic Recommendations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/va-topic-recommendations.md","line":130},{"title":"Topic Recommendations page","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/topic-recommendations-page.md","line":132},{"title":"Integration of HR Service Delivery with ServiceNow applications","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/hr-service-delivery/integrate-hr-platform-apps.md","line":142},{"title":"case and knowledge management","target":"case-knowledge-management-landing-page","line":159},{"title":"learning","target":"exploring-learning-exp","line":164},{"title":"Work an HR case","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/hr-service-delivery/t_CreateAnHRCase.md","line":171},{"title":"Find components installed with an application","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/find-components.md","line":185},{"title":"Virtual Agent Designer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/conversation-designer-virtual-agent.md","line":198},{"title":"Employee Center","target":"employee-center-landing-page","line":200},{"title":"Virtual Agent for HR Service Delivery","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/hr-service-delivery/hr-virtual-agent-conversations.md","line":210},{"title":"Configure a Virtual Agent chat experience","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/configure-default-chat-experience.md","line":263},{"title":"HR Service Delivery","target":"hr-service-delivery","line":303},{"title":"HR services","target":"hr-service-administration","line":304},{"title":"Subflows","target":"flows-ukg","line":305},{"title":"Virtual Agent notifications","target":"va-notification-ta","line":306},{"title":"Case and Knowledge Management","target":"case-knowledge-management-landing-page","line":307},{"title":"Learning","target":"exploring-learning-exp","line":308},{"title":"Employee Center","target":"employee-center-landing-page","line":309}],"metadata":{"title":"Virtual Agent for HR Service Delivery","description":"HR Service Delivery and Virtual Agent provide an automated chat with an employee requesting HR services. You can program Virtual Agent to understand the intent of an employee to handle repeatable requests.Activate Virtual Agent for HR Service Delivery to provide user assistance through a conversational messaging interface. You can also activate Virtual Agent for HR Service Delivery with ServiceNow Natural Language Understanding \\(NLU\\).Configuring Virtual Agent or Virtual Agent with NLU for HR Service Delivery requires multiple steps.Define a custom HR Service Delivery greeting experience for a specific context in which your users run Virtual Agent. Configure your greeting experience to initiate the virtual agent automatically or immediately transfer to a live agent.HR Service Delivery Virtual Agent provides pre-built patterns that enable you to track whether Virtual Agent conversations helped the end user.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/hr-service-delivery/hr-virtual-agent-conversations.html","release":"australia","product":"HR Service Delivery","classification":"hr-service-delivery","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":11,"breadcrumb":["Integration of HR Service Delivery with ServiceNow applications","HR Service Delivery","Employee Service Management"],"tags":["#employee-service-management","#hrsd","#hr","#cases","#service-catalog","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/hr-service-delivery/hr-virtual-agent-conversations.md"},
