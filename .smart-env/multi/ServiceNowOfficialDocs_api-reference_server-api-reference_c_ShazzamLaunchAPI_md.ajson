ion ipiec\\)#{5}":[84,85],"#ShazzamLaunch- Global#ShazzamLaunch - addPortProbe\\(String midPPs, String portProbes, IPIncludeExcluldeCollection ipiec\\)#{6}":[86,102],"#ShazzamLaunch- Global#ShazzamLaunch - addRange\\(IPCollection ipc, String portProbes, Boolean samePhase\\)":[103,161],"#ShazzamLaunch- Global#ShazzamLaunch - addRange\\(IPCollection ipc, String portProbes, Boolean samePhase\\)#{1}":[105,141],"#ShazzamLaunch- Global#ShazzamLaunch - addRange\\(IPCollection ipc, String portProbes, Boolean samePhase\\)#{2}":[142,142],"#ShazzamLaunch- Global#ShazzamLaunch - addRange\\(IPCollection ipc, String portProbes, Boolean samePhase\\)#{3}":[143,144],"#ShazzamLaunch- Global#ShazzamLaunch - addRange\\(IPCollection ipc, String portProbes, Boolean samePhase\\)#{4}":[145,161],"#ShazzamLaunch- Global#ShazzamLaunch - fireShazzamProbe\\(String portProbe, String ip, String sensor\\)":[162,219],"#ShazzamLaunch- Global#ShazzamLaunch - fireShazzamProbe\\(String portProbe, String ip, String sensor\\)#{1}":[164,188],"#ShazzamLaunch- Global#ShazzamLaunch - fireShazzamProbe\\(String portProbe, String ip, String sensor\\)#{2}":[189,190],"#ShazzamLaunch- Global#ShazzamLaunch - fireShazzamProbe\\(String portProbe, String ip, String sensor\\)#{3}":[191,219],"#ShazzamLaunch- Global#ShazzamLaunch - launch\\(String ip, Boolean samePhase, String sensor\\)":[220,233],"#ShazzamLaunch- Global#ShazzamLaunch - launch\\(String ip, Boolean samePhase, String sensor\\)#{1}":[222,233],"#ShazzamLaunch- Global#ShazzamLaunch - makeProbeSpec\\(String portProbe\\)":[234,269],"#ShazzamLaunch- Global#ShazzamLaunch - makeProbeSpec\\(String portProbe\\)#{1}":[236,260],"#ShazzamLaunch- Global#ShazzamLaunch - makeProbeSpec\\(String portProbe\\)#{2}":[261,261],"#ShazzamLaunch- Global#ShazzamLaunch - makeProbeSpec\\(String portProbe\\)#{3}":[262,263],"#ShazzamLaunch- Global#ShazzamLaunch - makeProbeSpec\\(String portProbe\\)#{4}":[264,269]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28}],"metadata":{"title":"ShazzamLaunch - Global","description":"The ShazzamLaunch script include provides methods to handle the details of launching a Shazzam probe for a given discovery.Creates an instance of the Shazzamlaunch class.Adds a single port probe to our MID services collection.Adds the specified range and this discovery's port probes to scan \\(as defined by behavior\\) to the collection of MID servers and port probes that need to be probed.Fires a Shazzam probe for the MID server and services in the given hash map.Launches Shazzam probes as necessary, depending on the current phase of each behavior used.Makes an XML port probe spec for the given port probe hashmap.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_ShazzamLaunchAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_ShazzamLaunchAPI.md"},
