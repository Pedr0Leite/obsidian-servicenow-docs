ps://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/third-party-risk-management/tprm-rir-form.md","line":48},{"title":"Track sanctions-related information","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/third-party-risk-management/tprm-riskintel-track-sanctions.md","line":52},{"title":"Request a risk intelligence report","target":"tprm-riskintel-request-tp","line":64},{"title":"Risk intelligence report request form","target":"tprm-rir-form","line":65}],"metadata":{"title":"Request a risk intelligence report associated with a due diligence request","description":"Request a risk intelligence report \\(RIR\\) or score to gain insight on how trustworthy a particular third party can be as part of the due diligence request process by using the Third-party Risk Management application. By associating your RIR request with a due diligence request, all activity, scores, reports, and details are available for you to see.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/third-party-risk-management/tprm-riskintel-request-dd.html","release":"australia","product":"Third-party Risk Management","classification":"third-party-risk-management","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Use risk intelligence reports and scores","Third-party Risk Management","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#vendor-risk","#tprm","#grc","#third-party","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/third-party-risk-management/tprm-riskintel-request-dd.md"},
