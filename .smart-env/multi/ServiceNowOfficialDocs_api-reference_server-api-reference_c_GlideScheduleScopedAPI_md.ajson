5,243],"#GlideSchedule- Scoped#GlideSchedule - load\\(String sysID, String timeZone, String excludeSpanID\\)#{1}":[227,243],"#GlideSchedule- Scoped#GlideSchedule - setTimeZone\\(String timeZone\\)":[244,289],"#GlideSchedule- Scoped#GlideSchedule - setTimeZone\\(String timeZone\\)#{1}":[246,271],"#GlideSchedule- Scoped#GlideSchedule - setTimeZone\\(String timeZone\\)#{2}":[272,272],"#GlideSchedule- Scoped#GlideSchedule - setTimeZone\\(String timeZone\\)#{3}":[273,273],"#GlideSchedule- Scoped#GlideSchedule - setTimeZone\\(String timeZone\\)#{4}":[274,275],"#GlideSchedule- Scoped#GlideSchedule - setTimeZone\\(String timeZone\\)#{5}":[276,289],"#GlideSchedule- Scoped#GlideSchedule - whenNext\\(GlideDateTime time, String timeZone\\)":[290,341],"#GlideSchedule- Scoped#GlideSchedule - whenNext\\(GlideDateTime time, String timeZone\\)#{1}":[292,341]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":26},{"title":"Time zones","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/r_TimeZones.md","line":82},{"title":"Time zones","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/r_TimeZones.md","line":276}],"metadata":{"title":"GlideSchedule - Scoped","description":"The scoped GlideSchedule API provides methods for performing operations on GlideSchedule objects, such as adding new schedule segments to a schedule, determining if a date/time is within the schedule, or setting the schedule timezone.Instantiates an empty GlideSchedule object.Instantiates a GlideSchedule object and loads the schedule information. If a time zone is not specified, the current session time zone is used.Adds a new schedule segment to the current schedule.Determines the elapsed time in the schedule between two date time values using the timezone of the schedule or, if that is not specified, the timezone of the session.Retrieves the schedule name.Determines if the specified date and time is within the current schedule.Determines if the current schedule is valid. A schedule is valid if it has at least one schedule span.Loads a schedule with the schedule information.Sets the timezone for the current schedule.Determines how much time \\(in milliseconds\\) until start time of the next schedule item.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_GlideScheduleScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[87,102],[109,113],[115,130],[138,152],[156,199],[209,223],[239,242],[285,288],[305,309],[313,315],[317,333],[337,339]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_GlideScheduleScopedAPI.md"},
