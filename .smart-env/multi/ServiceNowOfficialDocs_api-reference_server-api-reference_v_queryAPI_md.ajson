ttps://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/remote-table-script-def-example2.md","line":267},{"title":"v\\_table","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/v_tableAPI.md","line":268}],"metadata":{"title":"v\\_query – Scoped, Global","description":"The v\\_query API provides methods to obtain information about a scriptable object that represents a query running against a remote table.Gets an encoded query string for the specified field.Returns the query against a remote table as an encoded query stringGets the value of a field in an equality query condition.Returns the sys\\_id value in a get query.Gets a text search query parameter.Determines if the query is a get query, that is, a query that retrieves a record by sys\\_id.Indicates if the query contains a text query parameter.Sets the last error message in the GlideRecord.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/v\\_queryAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[48,51],[55,57],[77,79],[83,85],[106,108],[112,114],[130,132],[136,138],[160,163],[167,169],[206,218],[256,258],[280,292],[296,308]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/v_queryAPI.md"},
