ility#{5}":[55,60],"#Guardrails for PDF generation and accessibility#Dynamic guardrail for PDF generation and accessibility#{6}":[61,65]},"outlinks":[{"title":"PDF generation and accessibility","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/document-management-services/pdf-generation-accessibility.md","line":63}],"metadata":{"title":"Guardrails for PDF generation and accessibility","description":"Static and dynamic guardrails are safeguards that help maintain stability during PDF generation. Static guardrails enforce fixed limits like maximum PDF size, while dynamic guardrails monitor real-time memory usage and terminate exports when memory pressure exceeds a defined threshold.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/document-management-services/guardrails-pdf-generation-accessibility.html","release":"australia","product":"Document Management Services","classification":"document-management-services","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["PDF generation and accessibility","Document Services","Manage content capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#documents","#storage","#dms","#attachments","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/document-management-services/guardrails-pdf-generation-accessibility.md"},
