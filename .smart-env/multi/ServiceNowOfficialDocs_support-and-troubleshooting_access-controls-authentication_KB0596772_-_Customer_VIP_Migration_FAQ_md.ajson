-0.22351748,0.01000442,-0.01519195,0.00241144,-0.03839692,0.01758404,0.05301848,0.00623894,-0.04915566,0.03149033,-0.03921648,0.01943499,0.02060002,0.03222623,0.00239468,0.0614465,0.0365826,0.02299274,-0.06390139,-0.07061873,0.05195571,0.01866041,0.17727999,0.07651587,-0.02077039,0.03018118,0.01819765,0.0541471,-0.00758494,-0.01167279,-0.05258325,-0.07136814,0.06981182,-0.01841926,0.01920628,-0.02667608,-0.00640078,-0.04167546,0.00735951,-0.02038128,-0.02901285,-0.05212146,-0.02481071,0.07204883,0.09959396,0.01982058,-0.03130968,-0.02232126,0.03624098,0.02481161,-0.05293454,-0.06802186,-0.01314144,0.018771,0.02641539,0.05778524,-0.04043005,-0.05190582,-0.05827637,0.02776695,0.06356242,-0.07304651,0.02883058,-0.01791849,-0.01902242],"last_embed":{"tokens":448,"hash":"eii0d9"}}},"last_read":{"hash":"eii0d9","at":1784633623964},"class_name":"SmartSource","last_import":{"mtime":1783354565470,"size":4837,"at":1784561348393,"hash":"eii0d9"},"blocks":{"#---frontmatter---":[1,16],"##Issue":[18,19],"##VIP Migration | Customer FAQ":[20,75],"##VIP Migration | Customer FAQ##1\\. What is the Customer VIP Migration Project?":[22,25],"##VIP Migration | Customer FAQ##1\\. What is the Customer VIP Migration Project?#{1}":[24,25],"##VIP Migration | Customer FAQ##2\\. What do I need to do to prepare for this change prior to the planned start?":[26,29],"##VIP Migration | Customer FAQ##2\\. What do I need to do to prepare for this change prior to the planned start?#{1}":[28,29],"##VIP Migration | Customer FAQ##3\\. Will we be able to stage the transition by first testing the migration on our sub-production instances?":[30,33],"##VIP Migration | Customer FAQ##3\\. Will we be able to stage the transition by first testing the migration on our sub-production instances?#{1}":[32,33],"##VIP Migration | Customer FAQ##4\\. What happens if we don't update our firewalls or internal VPN with the new IP address before the change is executed?":[34,37],"##VIP Migration | Customer FAQ##4\\. What happens if we don't update our firewalls or internal VPN with the new IP address before the change is executed?#{1}":[36,37],"##VIP Migration | Customer FAQ##5\\. What are the new IP addresses? How will I be informed of the new IP addresses?":[38,41],"##VIP Migration | Customer FAQ##5\\. What are the new IP addresses? How will I be informed of the new IP addresses?#{1}":[40,41],"##VIP Migration | Customer FAQ##6\\. What happens if we are unable to access an instance after changes have been done to our VIPs?":[42,45],"##VIP Migration | Customer FAQ##6\\. What happens if we are unable to access an instance after changes have been done to our VIPs?#{1}":[44,45],"##VIP Migration | Customer FAQ##7\\. I need to reschedule this change as I have conflicting operations at this time. How can I reschedule the change for our instance?":[46,49],"##VIP Migration | Customer FAQ##7\\. I need to reschedule this change as I have conflicting operations at this time. How can I reschedule the change for our instance?#{1}":[48,49],"##VIP Migration | Customer FAQ##8\\. Will I be able to use a CNAME to direct traffic to the instance?":[50,53],"##VIP Migration | Customer FAQ##8\\. Will I be able to use a CNAME to direct traffic to the instance?#{1}":[52,53],"##VIP Migration | Customer FAQ##9\\. We restrict outbound communications from our networks to specific IPs. What services might be affected by the migration (MID Servers / user interfaces / webservices)?":[54,57],"##VIP Migration | Customer FAQ##9\\. We restrict outbound communications from our networks to specific IPs. What services might be affected by the migration (MID Servers / user interfaces / webservices)?#{1}":[56,57],"##VIP Migration | Customer FAQ##10\\. Will the Source IPs from my outbound integrations change?":[58,61],"##VIP Migration | Customer FAQ##10\\. Will the Source IPs from my outbound integrations change?#{1}":[60,61],"##VIP Migration | Customer FAQ##11\\. Will I experience downtime when switching from the old IP address to the new IP address?":[62,65],"##VIP Migration | Customer FAQ##11\\. Will I experience downtime when switching from the old IP address to the new IP address?#{1}":[64,65],"##VIP Migration | Customer FAQ##12\\. How do I get the new IP addresses?":[66,69],"##VIP Migration | Customer FAQ##12\\. How do I get the new IP addresses?#{1}":[68,69],"##VIP Migration | Customer FAQ##13\\. Our ServiceNow implementation has changed over time and we do not know what services or integrations are connecting to the instance. Can ServiceNow provide us with a list of impacted applications?":[70,75],"##VIP Migration | Customer FAQ##13\\. Our ServiceNow implementation has changed over time and we do not know what services or integrations are connecting to the instance. Can ServiceNow provide us with a list of impacted applications?#{1}":[72,75],"##Resolution":[76,77],"##Related":[78,81],"##Related#{1}":[80,81],"##Related Notes":[82,86],"##Related Notes#{1}":[84,84],"##Related Notes#{2}":[85,86]},"outlinks":[{"title":" Customer FAQ","target":"KB0623078 - Data Center Migration","line":80},{"title":"Data Center Migration | Customer FAQ","target":"ServiceNowOfficialDocs/support-and-troubleshooting/access-controls-authentication/KB0623078 - Data Center Migration Customer FAQ","line":84},{"title":"FAQ: Can an ACL work on the list view and be bypassed on the related list (or vice versa)?","target":"ServiceNowOfficialDocs/support-and-troubleshooting/access-controls-authentication/KB0727211 - FAQ Can an ACL work on the list view and be bypassed on the related list (or vice versa)","line":85}],"metadata":{"title":"Customer VIP Migration FAQ","aliases":["KB0596772"],"tags":["#servicenow","#support-kb","#ip-address","#migration","#data-center","#faq"],"area":"access-controls-authentication","source_url":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB0596772","kb_number":"KB0596772","last_modified":"2025-04-10"},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/support-and-troubleshooting/access-controls-authentication/KB0596772 - Customer VIP Migration FAQ.md"},
