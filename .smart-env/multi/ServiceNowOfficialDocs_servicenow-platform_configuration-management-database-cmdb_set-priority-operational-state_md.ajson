
"smart_sources:ServiceNowOfficialDocs/servicenow-platform/configuration-management-database-cmdb/set-priority-operational-state.md": {"path":"ServiceNowOfficialDocs/servicenow-platform/configuration-management-database-cmdb/set-priority-operational-state.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"1bpk2vd","at":1784561352976},"class_name":"SmartSource","last_import":{"mtime":1782933197933,"size":2204,"at":1784561352976,"hash":"1bpk2vd"},"blocks":{"#---frontmatter---":[1,20],"#Set priority for an operational state":[22,45],"#Set priority for an operational state#{1}":[24,25],"#Set priority for an operational state#Before you begin":[26,29],"#Set priority for an operational state#Before you begin#{1}":[28,29],"#Set priority for an operational state#About this task":[30,31],"#Set priority for an operational state#Procedure":[32,45],"#Set priority for an operational state#Procedure#{1}":[34,35],"#Set priority for an operational state#Procedure#{2}":[36,37],"#Set priority for an operational state#Procedure#{3}":[38,39],"#Set priority for an operational state#Procedure#{4}":[40,45]},"outlinks":[{"title":"CMDB CI Lifecycle Management \\(legacy\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-ci-lifecycle-mgmt.md","line":43}],"metadata":{"title":"Set priority for an operational state","description":"CI Lifecycle Management allows multiple operators or automations to simultaneously set different operational states for a CI. A CI can have only a single operational state, so in this case, the cumulative operational state of the CI is set to the one with the highest priority. It is recommended that you specify a priority for each operational state that you define so that a cumulative state can be correctly calculated.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/configuration-management-database-cmdb/set