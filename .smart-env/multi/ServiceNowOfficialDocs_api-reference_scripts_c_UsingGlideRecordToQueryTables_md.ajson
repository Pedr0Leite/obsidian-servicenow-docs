ples#{1}":[315,316],"#Querying tables in script#GlideRecord query examples#query":[317,325],"#Querying tables in script#GlideRecord query examples#query#{1}":[319,325],"#Querying tables in script#GlideRecord query examples#update":[326,337],"#Querying tables in script#GlideRecord query examples#update#{1}":[328,337],"#Querying tables in script#GlideRecord query examples#insert":[338,347],"#Querying tables in script#GlideRecord query examples#insert#{1}":[340,347],"#Querying tables in script#GlideRecord query examples#delete":[348,358],"#Querying tables in script#GlideRecord query examples#delete#{1}":[350,358],"#Querying tables in script#GlideRecord query examples#Querying Service Catalog Tables":[359,374],"#Querying tables in script#GlideRecord query examples#Querying Service Catalog Tables#{1}":[361,374],"#Querying tables in script#Related":[375,382],"#Querying tables in script#Related#{1}":[377,377],"#Querying tables in script#Related#{2}":[378,378],"#Querying tables in script#Related#{3}":[379,379],"#Querying tables in script#Related#{4}":[380,380],"#Querying tables in script#Related#{5}":[381,382]},"outlinks":[{"title":"API reference","target":"api-reference","line":26},{"title":"GlideRecord - Scoped","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordScopedAPI.md","line":26},{"title":"script includes","target":"c_ScriptIncludes","line":62},{"title":"Configure a single table for indexing and searching","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/configure-single-table-for-indexing.md","line":87},{"title":"Configure multiple tables for indexing and searching","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/index-multiple-tables.md","line":110},{"title":"Server-side scripting","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_ServerScripting.md","line":112},{"title":"Operators available for filters and queries","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/r_OpAvailableFiltersQueries.md","line":287},{"title":"GlideRecord","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordScopedAPI.md","line":311},{"title":"update","target":"r_Update","line":335},{"title":"insert","target":"r_Insert","line":345},{"title":"deleteRecord","target":"r_DeleteRecord","line":356},{"title":"GlideRecord","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordScopedAPI.md","line":373},{"title":"Script includes","target":"c_ScriptIncludes","line":377},{"title":"API reference","target":"api-reference","line":378},{"title":"deleteRecord","target":"r_DeleteRecord","line":379},{"title":"insert","target":"r_Insert","line":380},{"title":"update","target":"r_Update","line":381}],"metadata":{"title":"Querying tables in script","description":"Using methods in the GlideRecord API, you can return all records from a table, return records from a table that satisfy specific conditions, or return records that include a string from a single table or from multiple tables in a text index group.Describes the operators that can be used within an addQuery\\(\\) request.These examples demonstrate how to perform various GlideRecord queries.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/scripts/c\\_UsingGlideRecordToQueryTables.html","release":"australia","product":"Scripts","classification":"scripts","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Server-side scripting","Scripting","API implementation","API implementation and reference"],"tags":["#api-reference","#script-includes","#serv