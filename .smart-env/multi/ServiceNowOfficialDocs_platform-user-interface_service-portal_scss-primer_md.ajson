#List functions#{1}":[137,151],"#Service Portal SCSS Primer#SCSS functions#Adding custom functions":[152,155],"#Service Portal SCSS Primer#SCSS functions#Adding custom functions#{1}":[154,155],"#Service Portal SCSS Primer#SCSS nesting":[156,201],"#Service Portal SCSS Primer#SCSS nesting#{1}":[158,201],"#Service Portal SCSS Primer#SCSS operators":[202,241],"#Service Portal SCSS Primer#SCSS operators#{1}":[204,241],"#Service Portal SCSS Primer#SCSS mixins":[242,271],"#Service Portal SCSS Primer#SCSS mixins#{1}":[244,271],"#Service Portal SCSS Primer#Related":[272,280],"#Service Portal SCSS Primer#Related#{1}":[274,274],"#Service Portal SCSS Primer#Related#{2}":[275,275],"#Service Portal SCSS Primer#Related#{3}":[276,276],"#Service Portal SCSS Primer#Related#{4}":[277,277],"#Service Portal SCSS Primer#Related#{5}":[278,278],"#Service Portal SCSS Primer#Related#{6}":[279,280]},"outlinks":[{"title":"Service Portal reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/service-portal/reference-service-portal.md","line":26},{"title":"Sass/SCSS reference","target":"http://sass-lang.com/documentation/file.SASS_REFERENCE.html#operations","line":53},{"title":"Service Portal","target":"c_ServicePortal","line":57},{"title":"filters","target":"c_Filters","line":107},{"title":"Lists","target":"lists-configurable-workspace","line":137},{"title":"Sass/SCSS reference","target":"http://sass-lang.com/documentation/file.SASS_REFERENCE.html#operations","line":200},{"title":"Sass/SCSS reference","target":"http://sass-lang.com/documentation/file.SASS_REFERENCE.html#operations","line":240},{"title":"Sass/SCSS reference","target":"http://sass-lang.com/documentation/file.SASS_REFERENCE.html#operations","line":270},{"title":"Service Portal","target":"c_ServicePortal","line":274},{"title":"Filters","target":"c_Filters","line":275},{"title":"Lists","target":"lists-configurable-workspace","line":276},{"title":"Service Portal CSS","target":"css","line":277},{"title":"SCSS Functions","target":"css_functions","line":278},{"title":"SCSS Mixins","target":"css_mixins","line":279}],"metadata":{"title":"Service Portal SCSS Primer","description":"SCSS is a subset of the Syntactically Awesome StyleSheets \\(Sass\\) specification and is an extension of CSS. Every valid CSS style sheet is valid SCSS.SCSS variables are a way to store information that you want to reuse throughout your style sheet. You can store things like colors, font stacks, or any CSS value you think you want to reuse. SCSS uses the $ symbol to make something a variable.List of functions for Service Portal SCSS compiler.SCSS lets you nest your CSS selectors in a way that follows the same visual hierarchy of your HTML.SCSS has a handful of standard math operators like +, -, \\*, /, and %.A mixin lets you make groups of CSS declarations that you want to reuse throughout your site. You can pass in values to make your mixin more flexible.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-user-interface/service-portal/scss-primer.html","release":"australia","product":"Service Portal","classification":"service-portal","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Service Portal reference","Service Portal","Configure UIs and portals","Configure user experiences"],"tags":["#platform-user-interface","#service-portal","#widgets","#themes","#self-service","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[43,51],[162,178],[182,198],[208,220],[224,238],[248,257],[261,268]]},"smart_blocks:ServiceNowOfficialDocs/platform-user-interface/service-portal/scss-primer.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1kg1o9v","at":1784561347233},"key":"ServiceNowOfficialDocs/platform-user-interface/service-portal/scss-primer.md#---frontmatter---","lines":[1,20],"size":1303,"outlinks":[],"class_n