conditions#Procedure#{4}":[57,60],"#Define filter and aggregation criteria#Set filtering conditions#Procedure#{5}":[61,63],"#Define filter and aggregation criteria#Define aggregation conditions":[64,102],"#Define filter and aggregation criteria#Define aggregation conditions#{1}":[66,67],"#Define filter and aggregation criteria#Define aggregation conditions#Before you begin":[68,73],"#Define filter and aggregation criteria#Define aggregation conditions#Before you begin#{1}":[70,73],"#Define filter and aggregation criteria#Define aggregation conditions#About this task":[74,79],"#Define filter and aggregation criteria#Define aggregation conditions#About this task#{1}":[76,79],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure":[80,98],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure#{1}":[82,83],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure#{2}":[84,85],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure#{3}":[86,87],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure#{4}":[88,89],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure#{5}":[90,91],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure#{6}":[92,93],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure#{7}":[94,95],"#Define filter and aggregation criteria#Define aggregation conditions#Procedure#{8}":[96,98],"#Define filter and aggregation criteria#Define aggregation conditions#What to do next":[99,102],"#Define filter and aggregation criteria#Define aggregation conditions#What to do next#{1}":[101,102],"#Define filter and aggregation criteria#Related":[103,107],"#Define filter and aggregation criteria#Related#{1}":[105,105],"#Define filter and aggregation criteria#Related#{2}":[106,107]},"outlinks":[{"title":"mapping","target":"mapping-logrhythm","line":76},{"title":"Observables","target":"c_Observables","line":86},{"title":"Mapping","target":"mapping-logrhythm","line":105},{"title":"Observables","target":"c_Observables","line":106}],"metadata":{"title":"Define filter and aggregation criteria","description":"Define and set filter conditions to specify which incoming CrowdStrike Next-Gen SIEM detections should create security incidents. You can also define additional detection field criteria that allows an incoming detection to be appended to an open security incident instead of creating an incident.Set the filtering conditions so that security incidents are created only when the filtering conditions match.Define additional incident aggregation criteria that aggregates an incoming detection to an existing SIR security incident instead of creating similar, potentially duplicate detections. When you use field matching value criteria for each profile, this additional aggregation can reduce the number of active, overlapping security incidents by placing all related detections data on a single security incident.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/filtering-and-aggregation-cs-ng-siem.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"keywords":["Filtering and Aggregation"],"breadcrumb":["CrowdStrike Next-Gen SIEM integration","Security Incident Response integrations","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/security-incident-response/filtering-and-aggregation-cs-ng-siem.md"},
