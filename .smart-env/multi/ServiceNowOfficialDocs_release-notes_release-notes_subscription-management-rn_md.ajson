/ServiceNowDocs/australia/markdown/platform-administration/monitoring-now-assist-usage.md","line":47},{"title":"Changes to Now Assist usage measurement","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/monitoring-now-assist-usage.md","line":51},{"title":"Streamlined user-based subscription allocation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/managing-user-subscriptions-v2.md","line":55},{"title":"Hidden user-based subscription allocations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/subscriptions-overview-v2.md","line":59},{"title":"ServiceNow Store release notes","target":"https://www.servicenow.com/docs/bundle/store-release-notes/page/release-notes/store/sn-store-release-notes.html","line":66},{"title":"ServiceNow AI Platform administration release notes","target":"now-platform-admin-rn-landing","line":68},{"title":"ServiceNow AI Platform administration release notes","target":"now-platform-admin-rn-landing","line":72}],"metadata":{"title":"Subscription Management release notes","description":"The ServiceNow Subscription Management application enables you to manage your subscriptions proactively and monitor subscription usage on your instances. Subscription Management was enhanced and updated in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":2,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/subscription-management-rn.md"},
