r/add-components.md","line":232},{"title":"Page collections","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/ui-builder/page-collections.md","line":273},{"title":"page collections","target":"page-collections","line":273},{"title":"Configure how users interact with your applications in UI Builder","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/ui-builder/work-experiences.md","line":281},{"title":"Create a page in UI Builder","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/ui-builder/create-page.md","line":285},{"title":"Add and configure components","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/ui-builder/add-components.md","line":299},{"title":"Create a page collection across multiple UI pages","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/ui-builder/create-page-collection.md","line":313},{"title":"UI Builder","target":"ui-builder-overview","line":329},{"title":"Create a page in UI Builder","target":"create-page","line":330},{"title":"Page collections","target":"page-collections","line":331}],"metadata":{"title":"Add tabbed content to UI Builder pages","description":"Use the Tabs component to add tabbed content to pages in UI Builder.Use an empty container tab to manually create a static set of tabs on your page.Use the Tabs component to create a set of repeater tabs by linking tabs to a data array.Create a set of tabs on a page by linking to a related list.Use page collection tabs to recreate the same tabs across multiple pages in UI Builder.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/ui-builder/tabs-components.html","release":"australia","product":"UI Builder","classification":"ui-builder","