cf50f69577121153afb1","line":76,"embedded":true},{"title":"In the Mobile Verification dialog box, enter the 6-digit code. ","target":"/sys_attachment.do?sys_id=bccc26a097ddcf50f69577121153af4e","line":82,"embedded":true},{"title":"Managing company contacts on Now Support","target":"/kb_view.do?sysparm_article=KB0547262 \"Managing company contacts on Now Support\"","line":99},{"title":"Notification Preferences","target":"https://www.servicenow.com/docs/r/platform-administration/preferences-landing.html","line":104}],"class_name":"SmartBlock"},
