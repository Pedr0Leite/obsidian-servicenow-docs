lish a cost-based attribute adjustment#Procedure#{8}":[115,141],"#Create and publish a cost-based attribute adjustment#Procedure#{9}":[142,143],"#Create and publish a cost-based attribute adjustment#Procedure#{10}":[144,145],"#Create and publish a cost-based attribute adjustment#Procedure#{11}":[146,151],"#Create and publish a cost-based attribute adjustment#Procedure#{12}":[152,161],"#Create and publish a cost-based attribute adjustment#Procedure#{13}":[162,163],"#Create and publish a cost-based attribute adjustment#Procedure#{14}":[164,165],"#Create and publish a cost-based attribute adjustment#Procedure#{15}":[166,167],"#Create and publish a cost-based attribute adjustment#Procedure#{16}":[168,169],"#Create and publish a cost-based attribute adjustment#Related":[170,174],"#Create and publish a cost-based attribute adjustment#Related#{1}":[172,172],"#Create and publish a cost-based attribute adjustment#Related#{2}":[173,174]},"outlinks":[{"title":"rules","target":"rules_101","line":21},{"title":"Using decision tables","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/using-decision-builder.md","line":29},{"title":"fields","target":"fields","line":37},{"title":"Test a decision table in Workflow Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/test-decision-table-in-decision-builder.md","line":164},{"title":"Rules","target":"rules_101","line":172},{"title":"Fields","target":"fields","line":173}],"metadata":{"title":"Create and publish a cost-based attribute adjustment","description":"Set different product costs based on product attributes, such as model or size, by applying cost adjustments for a product offering by cost book or specified cost book line. The base cost is the cost at the cost book line. Product cost is the base cost plus attribute adjustments. These adjustments are used to display the profit margins in quotes and quote lines, which can be criteria for triggering quote approval rules.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/order-management/create-cost-attribute-adjustment.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Product pricing","Configure","price","quote apps","Configure","Sales Customer Relationship Management"],"tags":["#order-management","#fulfillment","#catalog","#orchestration","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/order-management/create-cost-attribute-adjustment.md"},
