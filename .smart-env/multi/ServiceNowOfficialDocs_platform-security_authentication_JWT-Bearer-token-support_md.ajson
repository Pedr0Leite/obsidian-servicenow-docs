Now/ServiceNowDocs/australia/markdown/platform-security/authentication/JWT-Bearer-token-support.md","line":44},{"title":"Connect to a third-party OAuth provider","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/authentication/connect-3rd-party-oauth-provider.md","line":48},{"title":"JWT Bearer","target":"jwt-bearer","line":50},{"title":"Specify an OAuth profile","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/t_SpecifyAnOAuthProfile.md","line":52},{"title":"email","target":"email","line":93},{"title":"configuration","target":"sc-configuration","line":161},{"title":"OAuth","target":"oauth-inbound-and-outbound","line":250},{"title":"OAuth 2.0","target":"c_OAuthApplications","line":251},{"title":"Authentication","target":"c_Authentication","line":252},{"title":"JWT Bearer","target":"jwt-bearer","line":253},{"title":"Email","target":"email","line":254},{"title":"Configuration","target":"sc-configuration","line":255}],"metadata":{"title":"Set up OAuth provider with JWT Bearer grant type","description":"JSON Web Tokens \\(JWTs\\) enable the capability to configure server-to-server API interactions between ServiceNow and external API providers without requiring any user intervention. This support enables Integration Hub or other automated tasks using JWTs to configure API and Service integrations with different providers.You can attach a Java KeyStore \\(JKS\\) certificate to your instance to use to enable the JWT client authentication.Create a JSON Web Token \\(JWT\\) signing key to assign to your Java KeyStore \\(JKS\\) certificate,Add a JSON Web Token \\(JWT\\) provider to your ServiceNow instance.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/authentication/JWT-Bearer-token-support.html","release":"australia","product":"Authentication","classification":"authentication","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["JWT Bearer","OAuth Outbound","OAuth authentication","Authentication","Access Management"],"tags":["#platform-security","#sso","#oauth","#saml","#mfa","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-security/authentication/JWT-Bearer-token-support.md"},
