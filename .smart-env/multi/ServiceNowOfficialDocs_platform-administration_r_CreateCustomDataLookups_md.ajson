reate custom data lookups#Create a data lookup definition record#Procedure#{13}":[241,243],"#Create custom data lookups#Create a data lookup module":[244,267],"#Create custom data lookups#Create a data lookup module#{1}":[246,247],"#Create custom data lookups#Create a data lookup module#Before you begin":[248,251],"#Create custom data lookups#Create a data lookup module#Before you begin#{1}":[250,251],"#Create custom data lookups#Create a data lookup module#Procedure":[252,267],"#Create custom data lookups#Create a data lookup module#Procedure#{1}":[254,255],"#Create custom data lookups#Create a data lookup module#Procedure#{2}":[256,257],"#Create custom data lookups#Create a data lookup module#Procedure#{3}":[258,259],"#Create custom data lookups#Create a data lookup module#Procedure#{4}":[260,264],"#Create custom data lookups#Create a data lookup module#Procedure#{5}":[265,267],"#Create custom data lookups#Troubleshooting data lookup":[268,280],"#Create custom data lookups#Troubleshooting data lookup#{1}":[270,271],"#Create custom data lookups#Troubleshooting data lookup#{2}":[272,272],"#Create custom data lookups#Troubleshooting data lookup#{3}":[273,273],"#Create custom data lookups#Troubleshooting data lookup#{4}":[274,274],"#Create custom data lookups#Troubleshooting data lookup#{5}":[275,275],"#Create custom data lookups#Troubleshooting data lookup#{6}":[276,276],"#Create custom data lookups#Troubleshooting data lookup#{7}":[277,278],"#Create custom data lookups#Troubleshooting data lookup#{8}":[279,280],"#Create custom data lookups#Related":[281,285],"#Create custom data lookups#Related#{1}":[283,283],"#Create custom data lookups#Related#{2}":[284,285]},"outlinks":[{"title":"Configuring lists on the ServiceNow AI Platform","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/list-administration/c_ListConfiguration.md","line":75},{"title":"Definitions","target":"clone-exclusions-preservers-cleanupscripts","line":100},{"title":"data lookup rules","target":"c_DataLookupRules","line":156},{"title":"Definitions","target":"clone-exclusions-preservers-cleanupscripts","line":283},{"title":"Data lookup rules","target":"c_DataLookupRules","line":284}],"metadata":{"title":"Create custom data lookups","description":"Creating custom data lookups involves adding a lookup value, creating the definition, and activating data lookup.Create a custom table to store lookup data.The columns of a data lookup table contain both matcher and setter field data.Data lookup requires a definition record that specifies how to set one or more field values when specified conditions are met.You can create a module for data lookup so it appears in the instance application navigator.If the custom data lookup definition rules are not behaving as expected, check for certain conditions.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/r\\_CreateCustomDataLookups.html","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Data lookup and record matching support","Administer","Field administration","Forms","fields","and lists","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/r_CreateCustomDataLookups.md"},
