:[98,102],"#Turn off workflows of related tables during remediation#Related#{1}":[100,100],"#Turn off workflows of related tables during remediation#Related#{2}":[101,102]},"outlinks":[{"title":"reference","target":"reference","line":28},{"title":"references","target":"reference-document-management","line":30},{"title":"Components installed for duplicate CI remediation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/components-installed-with-dup-ci.md","line":34},{"title":"Properties related to remediation of duplicate CIs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/properties-duplicate-ci.md","line":34},{"title":"Duplicate CIs remediation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/de-duplication-tasks.md","line":96},{"title":"Reference","target":"reference","line":100},{"title":"References","target":"reference-document-management","line":101}],"metadata":{"title":"Turn off workflows of related tables during remediation","description":"Configure de-duplication remediation processes for related tables, to turn off the execution of business rules, workflows, and any other automatic processes that might be turning off the update of referenced duplicate CIs to the main CI. Disabling all these workflows of related tables, allow de-duplication tasks, that would otherwise fail, to complete.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/configuration-management-database-cmdb/dedup-ci-disable-workflow.html","release":"australia","product":"Configuration Management Database \\(CMDB\\)","classification":"configuration-management-database-cmdb","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":