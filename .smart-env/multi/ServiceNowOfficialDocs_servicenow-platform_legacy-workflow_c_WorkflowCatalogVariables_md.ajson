w catalog variables#Display":[137,148],"#Workflow catalog variables#Display#{1}":[139,148],"#Workflow catalog variables#Access and assignment":[149,164],"#Workflow catalog variables#Access and assignment#{1}":[151,164],"#Workflow catalog variables#Related":[165,172],"#Workflow catalog variables#Related#{1}":[167,167],"#Workflow catalog variables#Related#{2}":[168,168],"#Workflow catalog variables#Related#{3}":[169,169],"#Workflow catalog variables#Related#{4}":[170,170],"#Workflow catalog variables#Related#{5}":[171,172]},"outlinks":[{"title":"Service Catalog","target":"service-catalog","line":29},{"title":"Workflow management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/legacy-workflow/managing-workflows.md","line":31},{"title":"Workflow Editor","target":"workflow-editor","line":39},{"title":"Global variable declaration option 2","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/legacy-workflow/c_WorkflowCatalogVariables.md","line":41},{"title":"check box","target":"check-box","line":53},{"title":"Change the filter","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_ConditionBuilder.md","line":66},{"title":"Global variable declaration option 1","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/legacy-workflow/c_WorkflowCatalogVariables.md","line":78},{"title":"reference","target":"reference","line":95},{"title":"Catalog item specific variable declaration option 2","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/legacy-workflow/c_WorkflowCatalogVariables.md","line":101},{"title":"references","target":"reference-document-management","line":122},{"title":"Catalog item specific variable declaration option 1","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/legacy-workflow/c_WorkflowCatalogVariables.md","line":134},{"title":"Service Catalog","target":"service-catalog","line":167},{"title":"Workflow editor","target":"workflow-editor","line":168},{"title":"Check box","target":"check-box","line":169},{"title":"Reference","target":"reference","line":170},{"title":"References","target":"reference-document-management","line":171}],"metadata":{"title":"Workflow catalog variables","description":"Workflows that are associated with the Requested Item \\[sc\\_req\\_item\\] table have a specific type of workflow input.You can declare requested item catalog variables at the catalog item level or at a global level.You can declare global catalog variables using the Service Catalog.You can declare a catalog item-specific variable.You can declare a catalog item-specific variable directly from a catalog item record.Catalog specific item variables are visible in several places depending on where in the process the variable is viewed.The Catalog Item Variables are available and assigned to a specific Catalog Task activity \\(thereby to a specific task\\) using the slushbucket entry of a catalog task.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/legacy-workflow/c\\_WorkflowCatalogVariables.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Workflow management","Classic Workflow","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#legacy-workflow","#classic","#deprecated","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[157,163]],"key":"ServiceNowOfficialDocs/servicenow-platform/legacy-workflow/c_WorkflowCatalogVariables.md"},
