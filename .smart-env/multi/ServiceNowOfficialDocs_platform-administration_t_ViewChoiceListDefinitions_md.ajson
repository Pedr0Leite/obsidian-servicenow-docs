list definitions#Display invalid choice list values":[294,314],"#View choice list definitions#Display invalid choice list values#{1}":[296,297],"#View choice list definitions#Display invalid choice list values#Before you begin":[298,301],"#View choice list definitions#Display invalid choice list values#Before you begin#{1}":[300,301],"#View choice list definitions#Display invalid choice list values#About this task":[302,307],"#View choice list definitions#Display invalid choice list values#About this task#{1}":[304,307],"#View choice list definitions#Display invalid choice list values#Procedure":[308,314],"#View choice list definitions#Display invalid choice list values#Procedure#{1}":[310,311],"#View choice list definitions#Display invalid choice list values#Procedure#{2}":[312,314],"#View choice list definitions#Add search option to a choice field":[315,338],"#View choice list definitions#Add search option to a choice field#{1}":[317,318],"#View choice list definitions#Add search option to a choice field#Before you begin":[319,322],"#View choice list definitions#Add search option to a choice field#Before you begin#{1}":[321,322],"#View choice list definitions#Add search option to a choice field#Procedure":[323,338],"#View choice list definitions#Add search option to a choice field#Procedure#{1}":[325,326],"#View choice list definitions#Add search option to a choice field#Procedure#{2}":[327,328],"#View choice list definitions#Add search option to a choice field#Procedure#{3}":[329,330],"#View choice list definitions#Add search option to a choice field#Procedure#{4}":[331,332],"#View choice list definitions#Add search option to a choice field#Procedure#{5}":[333,334],"#View choice list definitions#Add search option to a choice field#Procedure#{6}":[335,336],"#View choice list definitions#Add search option to a choice field#Procedure#{7}":[337,338],"#View choice list definitions#Related":[339,345],"#View choice list definitions#Related#{1}":[341,341],"#View choice list definitions#Related#{2}":[342,342],"#View choice list definitions#Related#{3}":[343,343],"#View choice list definitions#Related#{4}":[344,345]},"outlinks":[{"title":"Define an option for a choice list","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/t_ViewChoiceListDefinitions.md","line":48},{"title":"Choice table","target":"r_ChoicesTable","line":93},{"title":"reference","target":"reference-email-admin","line":266},{"title":"dictionary entry form","target":"r_DictionaryEntryForm","line":290},{"title":"System Properties","target":"r_SetArchiveRuleProcessingBehavior","line":310},{"title":"Choice table","target":"r_ChoicesTable","line":341},{"title":"Reference","target":"reference-email-admin","line":342},{"title":"Dictionary entry form","target":"r_DictionaryEntryForm","line":343},{"title":"System properties","target":"r_SetArchiveRuleProcessingBehavior","line":344}],"metadata":{"title":"View choice list definitions","description":"The Choice Set \\[sys\\_choice\\_set\\] table contains a record for every field that uses a choice list.You can personalize the options that are available in a choice list.After defining a set of choice list values, you can reuse the values for another field in a different table.You can remove the None option from a choice list if it is not necessary.You can change the default display label of the None option for a choice field.You can delete all choices for a choice field from the Choice Set record.You can create a choice list for a field with another type, such as an integer, string, or reference field.By default, inactive or invalid choice list values appear in blue text instead of black. You can disable the color indicator for invalid choices.Add a search field to choice fields that have a long list of options.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/t\\_ViewChoiceListDefinitions.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Choice list field type","Reference","Field administration","Forms","fields","and lists","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[205,207]],"key":"ServiceNowOfficialDocs/platform-administration/t_ViewChoiceListDefinitions.md"},
