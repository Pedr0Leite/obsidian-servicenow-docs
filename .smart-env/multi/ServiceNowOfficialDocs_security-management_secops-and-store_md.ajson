urity Incident Response","target":"sir-landing-page","line":22},{"title":"Vulnerability Response","target":"vuln-landing-page","line":23},{"title":"Threat Intelligence","target":"threat-intel-landing-page","line":24},{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":25},{"title":"Data Loss Prevention Incident Response","target":"dlp-landing","line":27},{"title":"Security Operations","target":"security-operations-landing-page","line":35},{"title":"Security Incident Response","target":"sir-landing-page","line":36},{"title":"Vulnerability Response","target":"vuln-landing-page","line":37},{"title":"Threat Intelligence","target":"threat-intel-landing-page","line":38},{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":39},{"title":"Data Loss Prevention Incident Response","target":"dlp-landing","line":40}],"metadata":{"title":"Security Operations and the ServiceNow Store","description":"Starting with Madrid, all Security Operations applications and supported integrations are available for download from the ServiceNow Store. This allows you to obtain new and updated features more rapidly. Before you can use any Security Operations applications, you must verify that you have entitlement to them \\(that is, you have valid licenses to use them\\), download them from the ServiceNow Store, and activate them.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/secops-and-store.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/secops-and-store.md"},
