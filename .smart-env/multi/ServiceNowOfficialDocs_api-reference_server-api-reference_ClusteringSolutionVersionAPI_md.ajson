erviceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":39},{"title":"update","target":"r_Update","line":43},{"title":"submitTrainingJob\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/ClusteringSolutionAPI.md","line":53},{"title":"GlideDateTime","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideDateTimeAPI.md","line":100},{"title":"Create and train a clustering solution","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/create-clustering-solution.md","line":226},{"title":"insert","target":"r_Insert","line":250},{"title":"GlideDateTime","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideDateTimeAPI.md","line":286},{"title":"GlideDateTime","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideDateTimeAPI.md","line":298},{"title":"Create and train a clustering solution","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/create-clustering-solution.md","line":450},{"title":"GlideDateTime","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideDateTimeAPI.md","line":510},{"title":"GlideDateTime","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideDateTimeAPI.md","line":522},{"title":"GlideDateTime","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideDateTimeScoped.md","line":616},{"title":"ClusteringSolution","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/ClusteringSolutionAPI.md","line":697},{"title":"DatatsetDefinition","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/DatasetDefinitionAPI.md","line":798},{"title":"Encoded query strings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_EncodedQueryStrings.md","line":817},{"title":"Domain separation and Predictive Intelligence","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/domain-separation-predictive-intelligence.md","line":874},{"title":"Create a custom stopwords list","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/create-custom-stopwords-list.md","line":957},{"title":"ClusteringSolution","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/ClusteringSolutionAPI.md","line":1101},{"title":"Create and train a clustering solution","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/create-clustering-solution.md","line":1264},{"title":"insert","target":"r_Insert","line":1554},{"title":"update","target":"r_Update","line":1555}],"metadata":{"title":"ClusteringSolutionVersion - Global","description":"The ClusteringSolutionVersion API is a scriptable object used in Predictive Intelligence stores.Cancels an update job on a trainer.Deletes cluster assignments from rows by position in table sequence or GlideDateTime.Gets assignments for a clustering solution.Gets information for a specified clustering solution in the store. The purity measurement provides insights as a percentage for the clustering fields on which the purity is based.Gets solution object properties and version number.Gets training completion status.Gets the top purity results for a clustering solution. The purity measurement provides insights as a percentage for the clustering fields on which the purity is based.Gets the status of the most recent clustering solution update job.Gets the version number of a solution object.Submits clustering update jobs with options to narrow results to a specific table and filter for matching records.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/ClusteringSolutionVersionAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":15,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[55,60],[102,116],[125,136],[140,142],[146,157],[161,163],[202,324],[361,378],[382,385],[424,552],[621,635],[639,673],[715,725],[730,740],[747,751],[756,800],[807,827],[834,915],[1010,1015],[1019,1051],[1108,1167],[1172,1176],[1183,1187],[1194,1198],[1204,1240],[1327,1340],[1358,1373],[1392,1396],[1399,1441],[1445,1449],[1451,1467],[1472,1476],[1478,1511],[1544,1550]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/ClusteringSolutionVersionAPI.md"},
