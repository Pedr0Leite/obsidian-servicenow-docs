eWithLocale\\(String number, String language, String country\\)#{4}":[117,117],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithLocale\\(String number, String language, String country\\)#{5}":[118,118],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithLocale\\(String number, String language, String country\\)#{6}":[119,120],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithLocale\\(String number, String language, String country\\)#{7}":[121,144],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithSeparators\\(String number, String groupingSeparator, String decimalSeparator\\)":[145,247],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithSeparators\\(String number, String groupingSeparator, String decimalSeparator\\)#{1}":[147,215],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithSeparators\\(String number, String groupingSeparator, String decimalSeparator\\)#{2}":[216,216],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithSeparators\\(String number, String groupingSeparator, String decimalSeparator\\)#{3}":[217,217],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithSeparators\\(String number, String groupingSeparator, String decimalSeparator\\)#{4}":[218,218],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithSeparators\\(String number, String groupingSeparator, String decimalSeparator\\)#{5}":[219,219],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithSeparators\\(String number, String groupingSeparator, String decimalSeparator\\)#{6}":[220,221],"#NumberFormatter - Scoped, Global#NumberFormatter - parseWithSeparators\\(String number, String groupingSeparator, String decimalSeparator\\)#{7}":[222,247]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":30}],"metadata":{"title":"NumberFormatter - Scoped, Global","description":"The NumberFormatter API includes methods that return numbers formatted according to the language of the current user.Returns a string representation of a number formatted according to the language setting of the current user.Returns a string representation of a number formatted according to the language passed as a parameter.Parses a number from a passed text string, traversing left-to-right, to extract the numeric value. It then uses the passed country and language codes to identify the locale of the number and returns the parsed number in that format.Parses and returns a number from a passed text string, traversing left-to-right, until it encounters a character that it can't parse. Parsable values include numbers and the specified grouping and decimal separators.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/NumberFormatterBoth.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[46,49],[53,56],[73,76],[80,83],[124,134],[138,143],[225,235],[239,245]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/NumberFormatterBoth.md"},
