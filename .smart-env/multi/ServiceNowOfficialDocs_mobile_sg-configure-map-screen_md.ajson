data":{"title":"Configure a map screen","description":"Configure a map screen so that your users can see location-based information on a map from their mobile app. The map highlights points of interest, and users can switch between a map view and list view to help them understand the information displayed on a map.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/mobile/sg-configure-map-screen.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Map screen","Mobile screen types","Mobile screens","Mobile app components","Building mobile apps","Mobile Platform"],"tags":["#mobile","#now-mobile","#apps","#platform","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/mobile/sg-configure-map-screen.md"},
