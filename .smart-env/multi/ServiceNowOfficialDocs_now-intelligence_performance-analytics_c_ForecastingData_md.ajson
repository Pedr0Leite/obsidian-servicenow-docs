rformance Analytics scores forecasts#Selecting the forecast method":[125,211],"#Performance Analytics scores forecasts#Selecting the forecast method#{1}":[127,132],"#Performance Analytics scores forecasts#Selecting the forecast method#Forecast methods":[133,211],"#Performance Analytics scores forecasts#Selecting the forecast method#Forecast methods#{1}":[135,211],"#Performance Analytics scores forecasts#Forecasting and targets":[212,224],"#Performance Analytics scores forecasts#Forecasting and targets#{1}":[214,224],"#Performance Analytics scores forecasts#Forecasting with time series aggregations":[225,255],"#Performance Analytics scores forecasts#Forecasting with time series aggregations#{1}":[227,255],"#Performance Analytics scores forecasts#Displaying indicator score forecasts":[256,278],"#Performance Analytics scores forecasts#Displaying indicator score forecasts#{1}":[258,278],"#Performance Analytics scores forecasts#Related":[279,292],"#Performance Analytics scores forecasts#Related#{1}":[281,281],"#Performance Analytics scores forecasts#Related#{2}":[282,282],"#Performance Analytics scores forecasts#Related#{3}":[283,283],"#Performance Analytics scores forecasts#Related#{4}":[284,284],"#Performance Analytics scores forecasts#Related#{5}":[285,285],"#Performance Analytics scores forecasts#Related#{6}":[286,286],"#Performance Analytics scores forecasts#Related#{7}":[287,287],"#Performance Analytics scores forecasts#Related#{8}":[288,288],"#Performance Analytics scores forecasts#Related#{9}":[289,289],"#Performance Analytics scores forecasts#Related#{10}":[290,290],"#Performance Analytics scores forecasts#Related#{11}":[291,292]},"outlinks":[{"title":"Analytics Hub","target":"c_UsePerformanceAnalyticsScorecards","line":25},{"title":"KPI Details","target":"kpi-details","line":25},{"title":"time series widgets","target":"time-series-widgets","line":25},{"title":"Performance Analytics indicators","target":"c_Indicators","line":31},{"title":"Create time series data visualizations","target":"create-dv-time-series-ac","line":31},{"title":"Create an automated indicator","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/t_CreateAnAutomatedIndicator.md","line":36},{"title":"Performance Analytics widgets","target":"c_Widgets","line":40},{"title":"Automated indicators","target":"automated-indicators","line":48},{"title":"Platform Analytics","target":"c_performanceAnalyticsAndReporting","line":48},{"title":"Selecting the forecast method","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/c_ForecastingData.md","line":70},{"title":"Indicator forecast periods","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/c_ForecastingData.md","line":78},{"title":"Medium article","target":"https://williamkoehrsen.medium.com/random-forest-simple-explanation-377895a60d2d","line":183},{"title":"Performance Analytics targets and thresholds","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/pa-targets-thresholds.md","line":223},{"title":"Time series widgets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/time-series-widgets.md","line":260},{"title":"Chart options in KPI Details","target":"chart-options","line":266},{"title":"Additional settings for time series widgets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/optional-settings-ts-widgets.md","line":271},{"title":"Analytics Hub for a specific indicator","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/view-scorecard.md","line":273},{"title":"Indicator data options for time series data visualizations","target":"config-dv-time-series-ind-data","line":275},{"title":"Examining indicators with KPI Details","target":"kpi-details-components","line":277},{"title":"Create time series data visualizations","target":"create-dv-time-series-ac","line":281},{"title":"Chart options in KPI Details","target":"chart-options","line":282},{"title":"Indicator data options for time series data visualizations","target":"config-dv-time-series-ind-data","line":283},{"title":"Examining indicators with KPI Details","target":"kpi-details-components","line":284},{"title":"Time series widgets","target":"time-series-widgets","line":285},{"title":"KPI Details","target":"kpi-details","line":286},{"title":"Analytics Hub","target":"c_UsePerformanceAnalyticsScorecards","line":287},{"title":"Performance Analytics indicators","target":"c_Indicators","line":288},{"title":"Performance Analytics widgets","target":"c_Widgets","line":289},{"title":"Platform Analytics","target":"c_performanceAnalyticsAndReporting","line":290},{"title":"Automated indicators","target":"automated-indicators","line":291}],"metadata":{"title":"Performance Analytics scores forecasts","description":"Performance Analytics enables you to forecast future scores based on past behavior. You can forecast scores on time series widgets, time series data visualizations, KPI Details, and the Analytics Hub. Forecast scores appear as a dotted line.In the record of an automated indicator, configure forecasts as they will appear on the Analytics Hub, Performance Analytics widgets, and time series data visualizations.If you are a statistics expert, you can select a forecast method manually. By default, the instance chooses the best method for you automatically, based on the fit of the method.Depending on the frequency of the score, a different period length is selected. Consult the table to find out the length of the period that is used for your series.When forecasting is enabled for an indicator and there is a global target defined, the forecast shows when the target will be reached.If you apply a time series aggregation to an indicator, the forecast period length changes. The change depends on the type of the time series.In the classic environment, show the forecasts on a time series widget or the Analytics Hub. On a configurable workspace, show the forecasts on a time series data visualization or KPI Details.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/performance-analytics/c\\_ForecastingData.html","release":"australia","product":"Performance Analytics","classification":"performance-analytics","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":9,"keywords":["Forecast method used","Forecasting method used","Selecting the forecast method","Forecasting and targets","Forecasting with time series"],"breadcrumb":["Indicators","Configure fundamentals","Performance Analytics \\(Indicator data sources\\)","Platform Analytics"],"tags":["#now-intelligence","#pa","#scorecards","#indicators","#analytics","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/performance-analytics/c_ForecastingData.md"},
