":[{"title":"Service Catalog REST API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/c_ServiceCatalogAPI.md","line":28},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":30},{"title":"Insert","target":"r_Insert","line":150},{"title":"deleteRecord","target":"r_DeleteRecord","line":230},{"title":"update","target":"r_Update","line":447},{"title":"deleteRecord","target":"r_DeleteRecord","line":454},{"title":"insert","target":"r_Insert","line":455},{"title":"update","target":"r_Update","line":456}],"metadata":{"title":"CatCategory - Scoped","description":"The CatCategory API provides methods that enable you to create and modify service catalog categories using scripts.Adds the Available For user criteria to the current catalog category.Determines whether a specified user can view a specified category on a mobile device or desktop.Insert the defined category.Deletes the category record on which the CatCategory class was initially instantiated.Returns the sys\\_id of the current category.Adds the Not Available For user criteria to a catalog category.Returns a mapping of the category.Defines the attribute values for this category.Defines the table name for this category.Updates the current category with the specified name-value pairs.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_CatCategory.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[78,81],[146,184],[190,228],[234,250],[254,258],[260,296],[299,349],[353,367],[373,387],[395,445]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_CatCategory.md"},
