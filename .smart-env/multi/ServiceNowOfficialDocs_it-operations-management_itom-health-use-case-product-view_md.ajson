/csdm-implementation-stages.md","line":31},{"title":"Exploring the CSDM model","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/csdm-content-frame-exploring.md","line":33},{"title":"ITOM AIOps","target":"itom-health-landing-page","line":37},{"title":"Event Management","target":"c_EM","line":38},{"title":"Discovery","target":"r-discovery","line":39},{"title":"Dashboards","target":"otto-aiops-dashboards","line":40}],"metadata":{"title":"Applying the CSDM guidelines to ITOM AIOps","description":"ITOM AIOps helps you track and maintain the health of services in your organization. ITOM AIOps CSDM reference serves as a foundational blueprint for maintaining optimal IT operations by standardizing data models and processes. The main goal is to help you understand the two main capabilities that work together within the CSDM framework.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/itom-health-use-case-product-view.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["ITOM AIOps","IT Operations Management"],"tags":["#it-operations-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/itom-health-use-case-product-view.md"},
