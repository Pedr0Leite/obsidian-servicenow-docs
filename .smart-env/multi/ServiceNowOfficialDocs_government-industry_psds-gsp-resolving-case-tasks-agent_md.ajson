ce#Create a service request case task in CSM Configurable Workspace#About this task":[51,54],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Create a service request case task in CSM Configurable Workspace#About this task#{1}":[53,54],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Create a service request case task in CSM Configurable Workspace#Procedure":[55,67],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Create a service request case task in CSM Configurable Workspace#Procedure#{1}":[57,58],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Create a service request case task in CSM Configurable Workspace#Procedure#{2}":[59,60],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Create a service request case task in CSM Configurable Workspace#Procedure#{3}":[61,62],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Create a service request case task in CSM Configurable Workspace#Procedure#{4}":[63,64],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Create a service request case task in CSM Configurable Workspace#Procedure#{5}":[65,67],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace":[68,93],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#{1}":[70,71],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Before you begin":[72,75],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Before you begin#{1}":[74,75],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure":[76,93],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure#{1}":[78,79],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure#{2}":[80,81],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure#{3}":[82,83],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure#{4}":[84,85],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure#{5}":[86,87],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure#{6}":[88,89],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure#{7}":[90,91],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Resolve a service request case task in CSM Configurable Workspace#Procedure#{8}":[92,93],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Related":[94,97],"#Creating and resolving case tasks as a government service agent in CSM Configurable Workspace#Related#{1}":[96,97]},"outlinks":[{"title":"Service Request Case Task form","target":"service-request-case-form-new","line":63},{"title":"Service Request case form","target":"service-request-case-form-new","line":96}],"metadata":{"title":"Creating and resolving case tasks as a government service agent in CSM Configurable Workspace","description":"Service request case tasks in Public Sector Digital Services are automatically created and assigned to agents as each service request case moves through its life cycle. Government service agents can view and complete these case tasks \\(or even create their own tasks\\) in the CSM Configurable Workspace.View a list of the case tasks that are associated with a service request case, regardless of whether the case task was created automatically or manually, in the CSM Configurable Workspace.Manually create case tasks from information that you gathered from a service request case in CSM Configurable Workspace.Resolve a service request case in CSM Configurable Workspace. After all information has been added to the comments or work notes of a service request case task, you can mark the case task as resolved.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/government-industry/psds-gsp-resolving-case-tasks-agent.html","release":"australia","topic_type":"concept","last_updated":"2025-07-31","reading_time_minutes":2,"breadcrumb":["CSM Configurable Workspace","Use","Public Sector Digital Services \\(PSDS\\)"],"tags":["#government-industry","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/government-industry/psds-gsp-resolving-case-tasks-agent.md"},
