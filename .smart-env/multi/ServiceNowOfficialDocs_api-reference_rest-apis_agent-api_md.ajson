ralia/markdown/conversational-interfaces/awa-configure-agent-presence.md","line":1116},{"title":"Scripted REST Service form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":1233},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":1233},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1333},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1366},{"title":"Components installed with Advanced Work Assignment","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/installed-with-awa.md","line":1409},{"title":"AWA Agent - GET /now/awa/agents/\\{user\\_id\\}/capacities","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/agent-api.md","line":1764},{"title":"Service channel capacity and utilization","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/awa-service-channel-capacity.md","line":1768},{"title":"Create or configure a service channel","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/awa-create-service-channel.md","line":1769},{"title":"Configure an agent's maximum universal capacity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/awa-universal-capacity.md","line":1770},{"title":"Scripted REST Service form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":1778},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":1778},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1855},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1880},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":2019},{"title":"REST APIs","target":"c_RESTAPI","line":2020}],"metadata":{"title":"AWA Agent API","description":"The AWA \\(Advanced Work Assignment\\) Agent API provides endpoints to manage agent presence, channel availability, and workload.Returns the current agent presence state and channel availability.Returns an agent's channel capacities, universal capacity, and the current workload to see if the agent can handle a case.Returns an agent's presence states and indicates whether the agent is available or in another presence state.Sets the state of a specified agent’s presence and, if provided, sets the agent’s channel availability for that state.Enables updating an agent's maximum capacity \\(workload\\) for channel capacities and universal capacity.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/agent-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":23,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[237,242],[273,280],[303,311],[520,526],[528,546],[718,756],[761,814],[819,823],[837,995],[1000,1026],[1035,1058],[1068,1172],[1177,1181],[1221,1284],[1291,1444],[1449,1480],[1487,1510],[1518,1738],[1740,1758],[1840,1842],[1911,1941],[1946,1989],[1999,2003]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/agent-api.md"},
