rated-apps.md","line":36},{"title":"Procurement","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/procurement/c_Procurement.md","line":42},{"title":"Domain separation for service providers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-sep-landing-page.md","line":61},{"title":"Procurement","target":"c_Procurement","line":65}],"metadata":{"title":"Domain separation and Procurement","description":"Domain separation is supported in Procurement processing. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/procurement/domain-separation-procurement.html","release":"australia","product":"Procurement","classification":"procurement","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Procurement","IT Asset Management"],"tags":["#it-asset-management","#procurement","#purchasing","#vendors","#itam","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/procurement/domain-separation-procurement.md"},
