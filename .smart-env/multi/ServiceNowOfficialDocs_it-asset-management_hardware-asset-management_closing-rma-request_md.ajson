-management/hardware-asset-management/closing-rma-request.html","release":"australia","product":"Hardware Asset Management","classification":"hardware-asset-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Manage RMA requests","Use","Hardware Asset Management","IT Asset Management"],"tags":["#it-asset-management","#ham","#hardware","#procurement","#disposal","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/hardware-asset-management/closing-rma-request.md"},
