ent/track-software-rights.md","line":364},{"title":"Create entitlements in workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/create-entitlements-workspace.md","line":365},{"title":"Create entitlements using the guided walk-through","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/guidedwalk-workspace.md","line":366},{"title":"License Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-license-workbench.md","line":368},{"title":"License usage view","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-workspace-workbench.md","line":368},{"title":"Run software reconciliation in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/t_RunReconciliation.md","line":370},{"title":"Run software reconciliation in the workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/run-recon-workspace.md","line":371},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":375},{"title":"SaaS License Management","target":"sam-subscription-management","line":376},{"title":"Using Software Asset Workspace","target":"using-sam-workspace","line":377},{"title":"Software Asset Workspace","target":"sam-workspace","line":378},{"title":"Software models","target":"c_CreatingSoftwareModels","line":379}],"metadata":{"title":"Integrate with Docusign at Organization level","description":"Integrating your Software Asset Management application with the Docusign service at the organization level enables you to track your software subscriptions and envelope consumption data.Register a Docusign application through the Docusign admin portal.Generate RSA keys to integrate the Docusign application with your ServiceNow instance.Generate a Java Key Store \\(JKS\\) certificate for the JSON Web Token \\(JWT\\) authentication of your Docusign integration profile.Create an integration profile to track software subscriptions and optimize licensing for the Docusign service.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/saas-license-management/integrate-with-docusign-org.html","release":"australia","product":"SaaS License Management","classification":"saas-license-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":11,"breadcrumb":["Integrating with Docusign","Integrate with SaaS applications","SaaS License Management","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#saas","#license-management","#discovery","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[152,154],[162,164],[172,174]],"key":"ServiceNowOfficialDocs/it-asset-management/saas-license-management/integrate-with-docusign-org.md"},
