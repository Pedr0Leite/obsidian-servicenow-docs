ication-development/now-assist-for-creator/configuring-ui-generation.md","line":45},{"title":"Install Now Assist for Creator","target":"install-now-assist-for-creator","line":49},{"title":"UI Generation","target":"ui-generation-landing","line":49},{"title":"now assist for creator","target":"now-assist-for-creator-landing","line":67},{"title":"Install required applications for UI Builder Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/now-assist-for-creator/configure-ui-builder-agent.md","line":96},{"title":"application scope","target":"c_ApplicationScope","line":104},{"title":"Activate AI search","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/now-assist-for-creator/configure-ui-builder-agent.md","line":241},{"title":"UI Builder","target":"ui-builder-overview","line":252},{"title":"UI Builder Agent","target":"uib-builder-agent-concept","line":256},{"title":"Working in UI Builder","target":"using-ui-builder","line":257},{"title":"Install Now Assist for Creator","target":"install-now-assist-for-creator","line":258},{"title":"UI generation","target":"ui-generation-landing","line":259},{"title":"Now Assist for Creator","target":"now-assist-for-creator-landing","line":260},{"title":"Application scope","target":"c_ApplicationScope","line":261},{"title":"UI Builder","target":"ui-builder-overview","line":262}],"metadata":{"title":"Configure UI Builder Agent","description":"The UI Builder Agent is a Now Assist AI agent that assists low-code developers working in UI Builder by responding to questions, information requests, and page editing instructions.Install Now Assist for Creator, UI Generation, and Conversational Studio from Application Manager before configuring the UI Builder Agent.Follow the UI Builder Agent setup wizard in AI Agent Studio to review and confirm your agent configuration.Enable the Now Assist panel in Now Assist Admin.A