logic#Related#{2}":[169,169],"#Make a decision flow logic#Related#{3}":[170,170],"#Make a decision flow logic#Related#{4}":[171,171],"#Make a decision flow logic#Related#{5}":[172,172],"#Make a decision flow logic#Related#{6}":[173,174]},"outlinks":[{"title":"data pills","target":"data-population","line":26},{"title":"Exploring Decision Tables","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/workflow-studio/decision-designer-overview.md","line":26},{"title":"If flow logic","target":"flow-logic-if","line":83},{"title":"For Each flow logic","target":"flow-logic-for-each","line":109},{"title":"Look Up Record action","target":"lookup-record-flow-designer","line":109},{"title":"Flow execution details","target":"flow-execution-details","line":123},{"title":"Workflow Studio flow logic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/workflow-studio/flow-logic.md","line":129},{"title":"Flow Variables","target":"flow-variables","line":134},{"title":"Data pills","target":"data-population","line":168},{"title":"If flow logic","target":"flow-logic-if","line":169},{"title":"For Each flow logic","target":"flow-logic-for-each","line":170},{"title":"Look Up Record action","target":"lookup-record-flow-designer","line":171},{"title":"Flow execution details","target":"flow-execution-details","line":172},{"title":"Flow variables","target":"flow-variables","line":173}],"metadata":{"title":"Make a decision flow logic","description":"You can use the decision table branching logic in situations where multiple conditional paths are required, as an alternative to nested If, Else If, or Else flow logic. For example, if you want to determine what kind of car insurance you need, you can add inputs such as your age, accident history, and car model to the decision table to determine a level of insurance coverage. This logic can save you time and present a more readable format than nested if conditions or switch case statements.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/workflow-studio/flow-logic-make-decision.html","release":"australia","product":"Workflow Studio","classification":"workflow-studio","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Flow logic","Flows","subflows","and actions reference","Flows","subflows","and actions","Workflow Studio","Build workflows"],"tags":["#build-workflows","#workflow-studio","#visual","#process-design","#flow-designer","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/build-workflows/workflow-studio/flow-logic-make-decision.md"},
