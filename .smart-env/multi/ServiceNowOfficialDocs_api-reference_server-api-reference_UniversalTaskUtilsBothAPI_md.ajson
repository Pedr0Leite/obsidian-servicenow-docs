Utils - Scoped, Global#UniversalTaskUtils - markActiveChildTasksCompleted\\(String parentSysId\\)":[174,193],"#UniversalTaskUtils - Scoped, Global#UniversalTaskUtils - markActiveChildTasksCompleted\\(String parentSysId\\)#{1}":[176,193],"#UniversalTaskUtils - Scoped, Global#Related":[194,197],"#UniversalTaskUtils - Scoped, Global#Related#{1}":[196,197]},"outlinks":[{"title":"Add a Task tab on the Standard Ticket page","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/config-stdtktpage-for-ut.md","line":28},{"title":"Universal Task","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/universal-task-landing.md","line":34},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":36},{"title":"Universal Task templates","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/ut-task-template-landing.md","line":42},{"title":"global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordAPI.md","line":100},{"title":"scoped","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordScopedAPI.md","line":100},{"title":"update","target":"r_Update","line":166},{"title":"update","target":"r_Update","line":196}],"metadata":{"title":"UniversalTaskUtils - Scoped, Global","description":"The UniversalTaskUtils script include provides methods for managing universal tasks.Applies the specified universal task template to the specified universal task record.Returns the active child task records, in the form of a GlideRecord, for the specified parent ticket.Checks whether the specified parent ticket has any universal tasks that are in the work-in progress or complete state.Changes the state of all active universal tasks under the specified parent ticket to \"Cancelled\".Changes the state of all active child universal tasks associated with the specified parent ticket to \"Complete\".","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/UniversalTaskUtilsBothAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[87,94],[112,117],[148,152],[168,172],[188,192]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/UniversalTaskUtilsBothAPI.md"},
