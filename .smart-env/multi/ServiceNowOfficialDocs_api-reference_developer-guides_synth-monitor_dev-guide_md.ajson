 using API#Example of bulk monitors using CSV file":[595,614],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#{1}":[597,598],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#Step 1: Submit bulk job in CSV format":[599,602],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#Step 1: Submit bulk job in CSV format#{1}":[601,602],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#Response":[603,606],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#Response#{1}":[605,606],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#Step 2: Check the job status":[607,610],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#Step 2: Check the job status#{1}":[609,610],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#Response#{2}":[611,614],"#Synthetic Monitoring Developer Guide#Import and create synthetic monitors in bulk using API#Example of bulk monitors using CSV file#Response#{2}#{1}":[613,614],"#Synthetic Monitoring Developer Guide#Related":[615,620],"#Synthetic Monitoring Developer Guide#Related#{1}":[617,617],"#Synthetic Monitoring Developer Guide#Related#{2}":[618,618],"#Synthetic Monitoring Developer Guide#Related#{3}":[619,620]},"outlinks":[{"title":"SyntheticsAsyncBulkCreate API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/synth-async-api.md","line":26},{"title":"Synthetic monitoring","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/synthetic-monitoring-landing-page.md","line":28},{"title":"SyntheticsAsyncBulkCreate API","target":"synth-async-api","line":32},{"title":"scripting","target":"c_Script","line":51},{"title":"Update","target":"r_Update","line":93},{"title":"use Terminal instead","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/developer-guides/synth-monitor_dev-guide.md","line":342},{"title":"SyntheticsAsyncBulkCreate API","target":"synth-async-api","line":617},{"title":"Scripting","target":"c_Script","line":618},{"title":"update","target":"r_Update","line":619}],"metadata":{"title":"Synthetic Monitoring Developer Guide","description":"Use Synthetic Monitoring APIs create multiple synthetic monitors in a single operation.Create multiple synthetic monitors simultaneously by importing raw JSON or CSV files through the SyntheticsAsyncBulkCreate API.Use curl commands in Terminal to create multiple synthetic monitors simultaneously by importing JSON or CSV files through the SyntheticsAsyncBulkCreate API.Use Postman to create multiple synthetic monitors simultaneously by importing JSON files through the SyntheticsAsyncBulkCreate API.The JSON file should contain an array of monitor objects, either directly or wrapped in a checks or monitors property.CSV files must include a header row followed by data rows.This is an example of using a CSV file wrapped in a JSON object to create bulk monitors using terminal.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/developer-guides/synth-monitor\\_dev-guide.html","release":"australia","product":"Developer Guides","classification":"developer-guides","topic_type":"concept","last_updated":"2026-04-29","reading_time_minutes":10,"breadcrumb":["Developer guides","API implementation and reference"],"tags":["#api-reference","#developer","#guides","#patterns","#best-practices","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[70,72],[76,78],[141,147],[151,157],[165,173],[179,183],[189,198],[202,213],[217,241],[271,277],[281,289],[293,297],[301,311],[408,417],[421,432],[436,460],[498,506],[516,526],[540,553],[557,568],[576,578],[582,585]],"key":"ServiceNowOfficialDocs/api-reference/developer-guides/synth-monitor_dev-guide.md"},
