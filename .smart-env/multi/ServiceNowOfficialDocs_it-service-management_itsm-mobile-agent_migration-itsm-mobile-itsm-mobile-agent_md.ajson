ivate the ITSM Mobile launcher screens and notifications#Procedure#{4}":[66,69],"#Migration from ITSM Mobile to ITSM Mobile Agent#Deactivate the ITSM Mobile launcher screens and notifications#Procedure#{5}":[70,82],"#Migration from ITSM Mobile to ITSM Mobile Agent#Migrate customizations from the ITSM Mobile application scope to the ITSM Mobile Agent scope":[83,95],"#Migration from ITSM Mobile to ITSM Mobile Agent#Migrate customizations from the ITSM Mobile application scope to the ITSM Mobile Agent scope#{1}":[85,92],"#Migration from ITSM Mobile to ITSM Mobile Agent#Migrate customizations from the ITSM Mobile application scope to the ITSM Mobile Agent scope#{2}":[93,93],"#Migration from ITSM Mobile to ITSM Mobile Agent#Migrate customizations from the ITSM Mobile application scope to the ITSM Mobile Agent scope#{3}":[94,95],"#Migration from ITSM Mobile to ITSM Mobile Agent#Related":[96,100],"#Migration from ITSM Mobile to ITSM Mobile Agent#Related#{1}":[98,98],"#Migration from ITSM Mobile to ITSM Mobile Agent#Related#{2}":[99,100]},"outlinks":[{"title":"ITSM Mobile Agent","target":"itsm-mobile-agent","line":24},{"title":"Log in to ITSM Mobile Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/itsm-mobile-agent/install-itsm-mobile-app.md","line":26},{"title":"Configuring ITSM Mobile Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/itsm-mobile-agent/configuring-itsm-mobile-agent.md","line":28},{"title":"Applications","target":"dex-workspace-application-tab","line":50},{"title":"ITSM Mobile Agent","target":"itsm-mobile-agent","line":98},{"title":"Applications","target":"dex-workspace-application-tab","line":99}],"metadata":{"title":"Migration from ITSM Mobile to ITSM Mobile Agent","description":"The ITSM Mobile plugin \\(com.sn\\_itsm\\_mobile\\) was deprecated in Quebec. The existing customers can migrate to ITSM Mobile Agent for enhanced mobile-first experiences in the base system, designed for agents to triage, act on, and resolve incidents on the go. ITSM Mobile Agent application improves productivity with an intuitive interface to manage all the work, view schedules, check who is on-call, respond to major incidents, and more.After you install the ServiceNow Agent app, avoid duplication of launcher screens and notifications from the deprecated ITSM Mobile app.When migrating from ITSM Mobile to ITSM Mobile Agent, an admin must verify if any customizations are defined in the deprecated ITSM Mobile application scope. Such customizations should be deactivated or moved to the ITSM Mobile Agent scope.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-service-management/itsm-mobile-agent/migration-itsm-mobile-itsm-mobile-agent.html","release":"australia","product":"ITSM Mobile Agent","classification":"itsm-mobile-agent","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Configuring ITSM Mobile Agent","ITSM Mobile Agent","IT Service Management"],"tags":["#it-service-management","#mobile","#agents","#itsm","#ios-android","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/it-service-management/itsm-mobile-agent/migration-itsm-mobile-itsm-mobile-agent.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"pp2uzg","at":1784561344175},"key":"ServiceNowOfficialDocs/it-service-management/itsm-mobile-agent/migration-itsm-mobile-itsm-mobile-agent.md#---frontmatter---","lines":[1,20],"size":1372,"outlinks":[],"class_name":"SmartBlock"},
