-operations","#sourcing","#procurement","#rfx","#s2p","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/source-to-pay-operations/sourcing-and-procurement-operations/decision-config-third-party-sourcing.md"},
