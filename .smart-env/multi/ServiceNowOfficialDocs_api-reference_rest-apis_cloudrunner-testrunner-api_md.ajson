ce/cloudrnr-TestRunnerAPI-scoped.md","line":36},{"title":"REST API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/api-rest.md","line":38},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":79},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":104},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":308},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":341},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":458},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":491},{"title":"Server API reference","target":"api-server","line":606}],"metadata":{"title":"Cloud Runner Test Runner REST API","description":"Manages tests to be executed in a cloud runner for Automated Test Framework \\(ATF\\).Provides the status of each test ran for a provided Browser Orchestration Queue \\(BOQ\\) record.Sets the test runner job to complete status and cancels the root trackers of any generated tests that are running.Inserts a test runner job into the BOQ \\[sn\\_atf\\_tg\\_sn\\_boq\\] table for given test or test suite, which is then run on the cloud runner.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/cloudrunner-testrunner-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[158,163],[167,173],[213,218],[222,229],[233,238],[242,248],[252,257],[261,267],[398,415],[422,426],[432,545],[551,555],[560,585],[592,596]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/cloudrunner-testrunner-api.md"},
