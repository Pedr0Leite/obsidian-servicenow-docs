"line":61},{"title":"Request due diligence for a third-party engagement","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/third-party-risk-management/tprm-ws-request-dd-for-engagement.md","line":61},{"title":"Assessing your third-party risk","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/third-party-risk-management/tprm-assessing-tpr.md","line":69},{"title":"Due diligence workflow","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/third-party-risk-management/tprm-workflow-in-workspace.md","line":69},{"title":"Due diligence workflow","target":"tprm-workflow-in-workspace","line":73}],"metadata":{"title":"Requesting third-party risk due diligence","description":"Request third-party risk due diligence to determine the level of risk for interactions with a third party, engagement, or fourth party by using Third-party Risk Management. You conduct due diligence to become aware of the associated risks so that you can make informed decisions, establish appropriate controls, and mitigate the potential negative impact when working with external parties.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/third-party-risk-management/tprm-requesting-tpr-due-diligence.html","release":"australia","product":"Third-party Risk Management","classification":"third-party-risk-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Third-party Risk Management","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#vendor-risk","#tprm","#grc","#third-party","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/third-party-risk-management/tprm-requesting-tpr-due-diligence.md"},
