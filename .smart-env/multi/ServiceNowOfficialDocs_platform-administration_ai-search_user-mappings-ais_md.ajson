viceNow AI Platform users#Related#{6}":[230,231]},"outlinks":[{"title":"results","target":"hs-results","line":24},{"title":"AI Search","target":"ia-ai-search","line":24},{"title":"defining access permissions for external documents","target":"defining-access-perms-ext-docs-ais","line":26},{"title":"External Content Ingestion API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/external-content-ingestion-api.md","line":26},{"title":"Create a user mapping table","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/ai-search/user-mappings-ais.md","line":32},{"title":"Link a user mapping table to an external content indexed source","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/ai-search/user-mappings-ais.md","line":33},{"title":"AI Search External User Mapping API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/ext-user-mapping-api.md","line":37},{"title":"View history records for user mapping import operations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/ai-search/user-mappings-ais.md","line":39},{"title":"External content security for AI Search","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/ai-search/external-content-security-ais.md","line":41},{"title":"Create a user","target":"t_CreateAUser","line":72},{"title":"dictionary form","target":"dictionary-form-ais","line":96},{"title":"AI Search External User Mapping API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/ext-user-mapping-api.md","line":101},{"title":"Importing user mappings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/ai-search/user-mappings-ais.md","line":101},{"title":"AI Search External Search User Mapping Table Data Source Relationship form","target":"ext-usr-map-idx-src-form-ais","line":133},{"title":"AI Search External User Mapping API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/ext-user-mapping-api.md","line":150},{"title":"AI Search External User Mapping API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/ext-user-mapping-api.md","line":162},{"title":"AI Search","target":"ia-ai-search","line":225},{"title":"Results","target":"hs-results","line":226},{"title":"Defining access permissions for external documents","target":"defining-access-perms-ext-docs-ais","line":227},{"title":"Create a user","target":"t_CreateAUser","line":228},{"title":"Dictionary form","target":"dictionary-form-ais","line":229},{"title":"AI Search External Search User Mapping Table Data Source Relationship form","target":"ext-usr-map-idx-src-form-ais","line":230}],"metadata":{"title":"Mapping external users and groups to ServiceNow AI Platform users","description":"AI Search external user mappings enable you to configure externally defined user and group aliases for ServiceNow AI Platform users. AI Search uses these aliased security principals to apply content security filters that control user access to search results indexed from external documents.AI Search user mapping aliases can include externally defined group and user security principals.Define a table to store externally defined user and group aliases for ServiceNow AI Platform users.Specify the user mapping table you want AI Search to use for external documents ingested through an indexed source.You can use the AI Search External User Mapping API to import mappings between ServiceNow AI Platform users and externally defined users and groups.Review the results for your user mapping import operations, including data, log messages, and any errors. Use this procedure to verify that your user mappings are imported correctly.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/ai-search/user-mappings-ais.html","release":"australia","product":"AI Search","classification":"ai-search","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["External content security","Indexing and searching external content","Configuring AI Search","AI Search","Search administration","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#ai-search","#indexing","#relevancy","#search","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/platform-administration/ai-search/user-mappings-ais.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"nk6z9b","at":1784561347462},"key":"ServiceNowOfficialDocs/platform-administration/ai-search/user-mappings-ais.md#---frontmatter---","lines":[1,20],"size":1586,"outlinks":[],"class_name":"SmartBlock"},
