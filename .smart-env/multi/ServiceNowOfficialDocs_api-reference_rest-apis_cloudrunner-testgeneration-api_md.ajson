own/api-reference/rest-api-explorer/c_RESTAPI.md","line":332},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":365},{"title":"Encoded query strings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_EncodedQueryStrings.md","line":529},{"title":"Encoded query strings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_EncodedQueryStrings.md","line":614},{"title":"Encoded query strings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_EncodedQueryStrings.md","line":622},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":627},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":660},{"title":"Server API reference","target":"api-server","line":745},{"title":"update","target":"r_Update","line":746}],"metadata":{"title":"Cloud Runner Test Generation REST API","description":"Manages test job generation to be executed in a cloud runner for Automated Test Framework \\(ATF\\).Provides the status of each generated test for a provided Browser Orchestration Queue \\(BOQ\\) record.Sets the test generation job and its associated update set record to complete status. Cancels the root trackers of any generated tests that are running. If any test jobs are in progress on cancellation, this method sets any of the in-progress test records generated to skipped.Inserts a record into the Browser Orchestration Queue \\(BOQ\\) \\[sn\\_atf\\_tg\\_sn\\_boq\\] table to start a test job.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/cloudrunner-testgeneration-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[158,167],[171,177],[232,237],[241,251],[255,260],[264,270],[274,279],[283,289],[419,423],[438,445],[449,455],[459,464],[468,474],[478,485],[489,495],[688,705],[710,714],[720,724],[731,735]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/cloudrunner-testgeneration-api.md"},
