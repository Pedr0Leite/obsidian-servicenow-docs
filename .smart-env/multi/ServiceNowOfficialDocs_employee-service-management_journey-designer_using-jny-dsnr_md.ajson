/employee-service-management/journey-designer/jny-process-owners-maint.md","line":28},{"title":"Managers, mentors, and employees work with journeys in the Employee Center","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/journey-designer/jny-working-with-journeys.md","line":30},{"title":"Employee Center","target":"employee-center-landing-page","line":31},{"title":"Journey designer dashboards and reports","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/journey-designer/jny-report-dashboards.md","line":32},{"title":"Now Assist Virtual Agent topics for Journey designer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/journey-designer/jd-va-topic.md","line":34},{"title":"Agentic workflows for Journey designer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/journey-designer/agentic-wf-jny-dsgnr-na-hrsd.md","line":36},{"title":"Journey designer","target":"jny-dsgnr-landing-page-1","line":43},{"title":"Employee Center","target":"employee-center-landing-page","line":44}],"metadata":{"title":"Using Journey designer","description":"Journey designer enables managers, mentors, and employees to create and manage personalized journeys through configurable templates. It allows users to guide and track individual progress with access to dashboards and reports, while leveraging the Now Assist Virtual Agent for automated support.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/journey-designer/using-jny-dsnr.html","release":"australia","product":"Journey Designer","classification":"journey-designer","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Journey designer","Employee Journey Management","HR Service Delivery","Employ