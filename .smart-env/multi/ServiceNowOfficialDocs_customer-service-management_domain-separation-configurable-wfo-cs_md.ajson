orkforce Optimization for Customer Service#Domain separation for Scheduling in Workforce Optimization for Customer Service#{9}":[58,58],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Scheduling in Workforce Optimization for Customer Service#{10}":[59,59],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Scheduling in Workforce Optimization for Customer Service#{11}":[60,61],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Teams in Workforce Optimization for Customer Service":[62,65],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Teams in Workforce Optimization for Customer Service#{1}":[64,65],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Skill Recommendation in Workforce Optimization for Customer Service":[66,72],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Skill Recommendation in Workforce Optimization for Customer Service#{1}":[68,69],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Skill Recommendation in Workforce Optimization for Customer Service#{2}":[70,70],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Skill Recommendation in Workforce Optimization for Customer Service#{3}":[71,72],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Coaching in Workforce Optimization for Customer Service":[73,83],"#Domain separation in Workforce Optimization for Customer Service#Domain separation for Coaching in Workforce Optimization for Customer Service#{1}":[75,83],"#Domain separation in Workforce Optimization for Customer Service#Related":[84,89],"#Domain separation in Workforce Optimization for Customer Service#Related#{1}":[86,86],"#Domain separation in Workforce Optimization for Customer Service#Related#{2}":[87,87],"#Domain separation in Workforce Optimization for Customer Service#Related#{3}":[88,89]},"outlinks":[{"title":"Workforce Optimization for Customer Service","target":"configurable-wfo-cs","line":18},{"title":"Application support for domain separation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-separated-apps.md","line":30},{"title":"Domain separation and Advanced Work Assignment","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/awa-domain-separation.md","line":38},{"title":"Domain separation and Coaching","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/cf-domain-separation-coaching.md","line":75},{"title":"Optimization","target":"optimization","line":75},{"title":"Optimize workforce operations","target":"setup-configurable-wfo-cs","line":77},{"title":"Domain separation for service providers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-sep-landing-page.md","line":82},{"title":"Optimize workforce operations","target":"setup-configurable-wfo-cs","line":86},{"title":"Workforce Optimization for Customer Service","target":"configurable-wfo-cs","line":87},{"title":"Optimization","target":"optimization","line":88}],"metadata":{"title":"Domain separation in Workforce Optimization for Customer Service","description":"Domain separation is supported in Workforce Optimization for Customer Service. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data. Domain separation in Workforce Optimization for Customer Service is configured to apply to all features of the application. Separation of data is configured along with separation of logic and process.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/customer-service-management/domain-separation-configurable-wfo-cs.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Optimize workforce operations","Extend capabilities","Configure","Customer Service Management"],"tags":["#customer-service-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/customer-service-management/domain-separation-configurable-wfo-cs.md"},
