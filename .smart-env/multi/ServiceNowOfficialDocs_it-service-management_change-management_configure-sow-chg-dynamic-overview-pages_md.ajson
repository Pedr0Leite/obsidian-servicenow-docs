ions Workspace#Related#{4}":[200,201]},"outlinks":[{"title":"UI Builder tutorial.","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/uib-tutorial.md","line":28},{"title":"Using Change Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/change-management/using-change-management.md","line":37},{"title":"Change Management in Service Operations Workspace","target":"change-sow","line":41},{"title":"models","target":"c_Models","line":49},{"title":"create a change request","target":"t_CreateAChange","line":67},{"title":"Configure the fields for change overview cards","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/change-management/configure-sow-chg-dynamic-overview-pages.md","line":94},{"title":"Create a custom field","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/change-management/t_CreateCustomField.md","line":96},{"title":"Manage the workspace configuration for a Change request in Service Operations Workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/change-management/configure-sow-chg-dynamic-overview-pages.md","line":98},{"title":"Configure change overview container and cards","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/change-management/configure-sow-chg-dynamic-overview-pages.md","line":106},{"title":"Change Management","target":"c_ITILChangeManagement","line":118},{"title":"Change Management in Service Operations Workspace","target":"change-sow","line":197},{"title":"Models","target":"c_Models","line":198},{"title":"Create a change request","target":"t_CreateAChange","line":199},{"title":"Change Management","target":"c_ITILChangeManagement","line":200}],"metadata":{"title":"Manage the workspace configuration for a Change request in Service Operations Workspace","description":"Utilize the new table-based configuration to align with the Service Operations Workspace Dynamic Overview Pages with the change process of your organization.Configure the layout of the overview page for Change Management in Service Operations Workspace.Configure or modify fields for change overview cards containing forms to display the fields that you need in the change request form in Service Operations Workspace.Show the activity stream bar for a for a change request in Service Operations Workspace.Configure the order of the cards that display in the Overview section for a change request in Service Operations Workspace.You can configure if the Work notes or Additional comments sections to display for a change request.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-service-management/change-management/configure-sow-chg-dynamic-overview-pages.html","release":"australia","product":"Change Management","classification":"change-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Use","Change Management","IT Service Management"],"tags":["#it-service-management","#change-management","#cab","#risk","#itsm","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-service-management/change-management/configure-sow-chg-dynamic-overview-pages.md"},
