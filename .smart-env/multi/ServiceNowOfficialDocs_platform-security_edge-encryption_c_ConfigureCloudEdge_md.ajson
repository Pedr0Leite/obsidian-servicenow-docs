n configurations#Schedule a decryption job#Before you begin#{1}":[314,317],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure":[318,424],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure#{1}":[320,321],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure#{2}":[322,323],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure#{3}":[324,325],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure#{4}":[326,327],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure#{5}":[328,329],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure#{6}":[330,420],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure#{7}":[421,422],"#Encrypt fields using encryption configurations#Schedule a decryption job#Procedure#{8}":[423,424],"#Encrypt fields using encryption configurations#Related":[425,432],"#Encrypt fields using encryption configurations#Related#{1}":[427,427],"#Encrypt fields using encryption configurations#Related#{2}":[428,428],"#Encrypt fields using encryption configurations#Related#{3}":[429,429],"#Encrypt fields using encryption configurations#Related#{4}":[430,430],"#Encrypt fields using encryption configurations#Related#{5}":[431,432]},"outlinks":[{"title":"encryption","target":"encryption-landing","line":24},{"title":"Edge Encryption","target":"edge-encryption","line":26},{"title":"Field Encryption","target":"field-encryption","line":44},{"title":"Configuring Edge Encryption","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/edge-encryption/edge-config.md","line":59},{"title":"Configuration","target":"sc-configuration","line":71},{"title":"Schedule an encryption job","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/edge-encryption/c_ConfigureCloudEdge.md","line":127},{"title":"Schedule an encryption job","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/edge-encryption/c_ConfigureCloudEdge.md","line":155},{"title":"Auditing","target":"c_AuditedTables","line":274},{"title":"Auditing","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_AuditedTables.md","line":392},{"title":"Auditing","target":"c_AuditedTables","line":427},{"title":"Encryption","target":"encryption-landing","line":428},{"title":"Edge Encryption","target":"edge-encryption","line":429},{"title":"Field Encryption","target":"field-encryption","line":430},{"title":"Configuration","target":"sc-configuration","line":431}],"metadata":{"title":"Encrypt fields using encryption configurations","description":"Encrypt fields by creating encryption configurations.Select the fields to be encrypted and identify the encryption type.Select service catalog variables to be encrypted and identify the encryption type.After configuring a field or a table's attachments to be encrypted, you can stop encryption by deactivating the encryption configuration. After deactivating encryption, you can run a Decryption job for fields or an Attachment Decryption job for attachments to remove the encrypted data from the instance.You can schedule a job to find and encrypt any unencrypted data in a specified field, using the default encryption key configured for the field. If you do not create an encryption job after configuring a field for encryption, only new values are encrypted.You can schedule a job to decrypt data in an encrypted field, to store clear data in the instance.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/edge-encryption/c\\_ConfigureCloudEdge.html","release":"australia","product":"Edge Encryption","classification":"edge-encryption","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Configuring Edge Encryption","Edge Encryption","Encryption"],"tags":["#platform-security","#edge-encryption","#field-level","#proxy","#security","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[48,55]]},"smart_blocks:ServiceNowOfficialDocs/platform-security/edge-encryption/c_ConfigureCloudEdge.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1fxfjgt","at":1784561346178},"key":"ServiceNowOfficialDocs/platform-security/edge-encryption/c_ConfigureCloudEdge.md#---frontmatter---","lines":[1,20],"size":1381,"outlinks":[],"class_name":"SmartBlock"},
