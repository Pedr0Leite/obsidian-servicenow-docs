 records#Procedure#{8}":[92,93],"#Content references in GRC#Add content reference tags to records#Procedure#{9}":[94,95],"#Content references in GRC#Add content reference tags to records#Procedure#{10}":[96,99],"#Content references in GRC#Add content reference tags to records#Procedure#{11}":[100,102],"#Content references in GRC#Create content reference tags":[103,130],"#Content references in GRC#Create content reference tags#{1}":[105,106],"#Content references in GRC#Create content reference tags#Before you begin":[107,110],"#Content references in GRC#Create content reference tags#Before you begin#{1}":[109,110],"#Content references in GRC#Create content reference tags#Procedure":[111,130],"#Content references in GRC#Create content reference tags#Procedure#{1}":[113,114],"#Content references in GRC#Create content reference tags#Procedure#{2}":[115,118],"#Content references in GRC#Create content reference tags#Procedure#{3}":[119,120],"#Content references in GRC#Create content reference tags#Procedure#{4}":[121,122],"#Content references in GRC#Create content reference tags#Procedure#{5}":[123,124],"#Content references in GRC#Create content reference tags#Procedure#{6}":[125,126],"#Content references in GRC#Create content reference tags#Procedure#{7}":[127,128],"#Content references in GRC#Create content reference tags#Procedure#{8}":[129,130],"#Content references in GRC#Related":[131,138],"#Content references in GRC#Related#{1}":[133,133],"#Content references in GRC#Related#{2}":[134,134],"#Content references in GRC#Related#{3}":[135,135],"#Content references in GRC#Related#{4}":[136,136],"#Content references in GRC#Related#{5}":[137,138]},"outlinks":[{"title":"Audit Management","target":"c_GRCAudits","line":38},{"title":"Policy and Compliance Management","target":"r_PolicyComplianceMgmt","line":38},{"title":"Entity Types","target":"entity-type-in-risk-ws","line":47},{"title":"Common Governance, Risk, and Compliance features","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/grc-common-functions/common-grc-features.md","line":62},{"title":"NIST RMF Use Case Accelerator","target":"grc-and-nistrmf-usecase-accelerator","line":92},{"title":"Administration","target":"Administration","line":96},{"title":"Audit Management","target":"c_GRCAudits","line":133},{"title":"Policy and Compliance Management","target":"r_PolicyComplianceMgmt","line":134},{"title":"Entity types","target":"entity-type-in-risk-ws","line":135},{"title":"NIST RMF Use Case Accelerator","target":"grc-and-nistrmf-usecase-accelerator","line":136},{"title":"Administration","target":"Administration","line":137}],"metadata":{"title":"Content references in GRC","description":"You can add tags to virtually any type of record defined in GRC applications that reference GRC content packs, integrations, use case accelerators, or any new regulations that use those records. After the records have been tagged, you can filter the content reference tags to identify which records are used within each application.As you're analyzing any of the many types of records available in GRC applications, it is easy to add a content reference tag so the record can be included when you perform searches for records associated with a given integration, content pack, use case accelerator, and so forth.You can define new content reference tags, as needed, to accommodate new regulations as they arise. You can define new tags in any GRC application, and they are then available in all GRC applications.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/grc-common-functions/content-references.html","release":"australia","product":"GRC Common Functions","classification":"grc-common-functions","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Common GRC features","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#grc","#attestation","#evidence","#scoping","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/grc-common-functions/content-references.md"},
