,{"title":"column reports","target":"c_CreateColumnCharts","line":85},{"title":"pie charts","target":"c_CreatePieCharts","line":85},{"title":"Chart interactions in a data visualization","target":"dv-chart-interactions","line":89},{"title":"Reporting","target":"reporting-landing-page","line":90},{"title":"Platform Analytics experience","target":"par-workspace","line":91},{"title":"Report types","target":"report-types-creation-details-rd","line":92},{"title":"Pie charts","target":"c_CreatePieCharts","line":93},{"title":"Column reports","target":"c_CreateColumnCharts","line":94},{"title":"Access control","target":"access-control","line":95}],"metadata":{"title":"Drilling down within Core UI reports","description":"You can drill down within a report to visualize a subset of its data. For example, you can click on the critical section of a report sorted by priority to view the categories of those critical incidents.You can define a report drilldown to enable reporting users to view subsets of the report data. When you define a report drilldown, it applies only to the report for which you define it.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/reporting/c\\_DrillingDownWithinReports.html","release":"australia","product":"Reporting","classification":"reporting","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Advanced Core UI reporting topics","Reporting","Reporting","dashboards","and Performance Analytics in the Core UI","Platform Analytics"],"tags":["#now-intelligence","#reports","#builder","#scheduling","#analytics","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/reporting/c_DrillingDownWithinReports.md"},
