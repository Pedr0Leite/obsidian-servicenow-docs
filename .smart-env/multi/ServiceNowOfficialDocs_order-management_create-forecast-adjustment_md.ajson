,69]},"outlinks":[{"title":"Modify","target":"Modify","line":21},{"title":"Using Sales Forecasting","target":"using-sales-forecasting","line":54},{"title":"Configure Sales Forecasting","target":"configure-sales-forecasting","line":59},{"title":"Sales Forecasting","target":"sales-forecasting","line":61},{"title":"Using Sales Forecasting","target":"using-sales-forecasting","line":65},{"title":"Configure Sales Forecasting","target":"configure-sales-forecasting","line":66},{"title":"Sales Forecasting","target":"sales-forecasting","line":67},{"title":"Modify","target":"Modify","line":68}],"metadata":{"title":"Create forecast adjustment","description":"Modify system-generated forecast values based on your judgment and prediction. Sales agents can adjust their individual forecasts and managers can modify team forecasts to align with overall targets. Sales managers can override team-level adjustments and the system automatically recalculates the roll-ups to reflect the updated forecast values.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/order-management/create-forecast-adjustment.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Sales Forecasting","Lead and opportunity apps","Use","Sales Customer Relationship Management"],"tags":["#order-management","#fulfillment","#catalog","#orchestration","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/order-management/create-forecast-adjustment.md"},
