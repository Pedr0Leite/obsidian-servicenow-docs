ity Incident Response setup tasks#Procedure#{9}":[118,120],"#Other additional Security Incident Response setup tasks#Procedure#{10}":[121,138],"#Other additional Security Incident Response setup tasks#Procedure#{11}":[139,139],"#Other additional Security Incident Response setup tasks#Procedure#{12}":[140,142],"#Other additional Security Incident Response setup tasks#Procedure#{13}":[143,157],"#Other additional Security Incident Response setup tasks#Procedure#{14}":[158,158],"#Other additional Security Incident Response setup tasks#Procedure#{15}":[159,161],"#Other additional Security Incident Response setup tasks#Procedure#{16}":[162,208],"#Other additional Security Incident Response setup tasks#Procedure#{17}":[209,209],"#Other additional Security Incident Response setup tasks#Procedure#{18}":[210,212],"#Other additional Security Incident Response setup tasks#Procedure#{19}":[213,230],"#Other additional Security Incident Response setup tasks#Procedure#{20}":[231,233],"#Other additional Security Incident Response setup tasks#Lock down security administration":[234,271],"#Other additional Security Incident Response setup tasks#Lock down security administration#{1}":[236,237],"#Other additional Security Incident Response setup tasks#Lock down security administration#Before you begin":[238,245],"#Other additional Security Incident Response setup tasks#Lock down security administration#Before you begin#{1}":[240,245],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure":[246,271],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{1}":[248,249],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{2}":[250,251],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{3}":[252,253],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{4}":[254,255],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{5}":[256,257],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{6}":[258,259],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{7}":[260,261],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{8}":[262,263],"#Other additional Security Incident Response setup tasks#Lock down security administration#Procedure#{9}":[264,271],"#Other additional Security Incident Response setup tasks#Manage Restricted Caller Access":[272,286],"#Other additional Security Incident Response setup tasks#Manage Restricted Caller Access#{1}":[274,286],"#Other additional Security Incident Response setup tasks#Run quick start tests for Security Incident Response":[287,578],"#Other additional Security Incident Response setup tasks#Run quick start tests for Security Incident Response#{1}":[289,578],"#Other additional Security Incident Response setup tasks#Related":[579,583],"#Other additional Security Incident Response setup tasks#Related#{1}":[581,581],"#Other additional Security Incident Response setup tasks#Related#{2}":[582,583]},"outlinks":[{"title":"Security Incident Response","target":"sir-landing-page","line":24},{"title":"location","target":"location","line":176},{"title":"Application administration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/application-administration.md","line":270},{"title":"Restricted caller access privilege settings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/restricted-caller-access-privilege.md","line":283},{"title":"Set the application scope, application resource, and event access","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/scope-resource-access.md","line":285},{"title":"Quick start tests","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/quick-start-tests.md","line":577},{"title":"Security Incident Response","target":"sir-landing-page","line":581},{"title":"Location","target":"location","line":582}],"metadata":{"title":"Other additional Security Incident Response setup tasks","description":"If you are an administrator in the global domain, you configure how Security Incident Response handles day-to-day operations.To protect investigations and keep security incidents private, you can restrict Security Incident Response access to security-specific roles and ACLs. Non-security administrators can be restricted from access, unless you expressly allow them entry.The Restricted Caller Access \\(RCA\\) feature enables an administrator to define cross-scope access to an application or application resource and allow or deny access requests. This feature is enabled in Security Incident Response by default so security analysts can protect sensitive security-related information.Validate that Security Incident Response still works after you make any configuration changes, such as applying an upgrade or developing an application. Copy and customize these quick start tests to pass when using your instance-specific data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/t\\_ConfigureSIM.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Install and configure Security Incident Response","Security Incident Response setup","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/security-incident-response/t_ConfigureSIM.md"},
