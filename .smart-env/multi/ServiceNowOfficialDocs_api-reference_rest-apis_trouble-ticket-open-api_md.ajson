prb\\_mgmt\\_case\\] table.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/trouble-ticket-open-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":28,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[276,280],[346,355],[397,408],[489,497],[588,592],[596,639],[778,782],[848,857],[899,910],[991,999],[1090,1095],[1099,1177],[1228,1232],[1268,1275],[1306,1313],[1362,1369],[1492,1496],[1562,1571],[1613,1624],[1705,1713],[1804,1819],[1823,1901],[1937,1941],[1977,1984],[2015,2022],[2071,2078],[2218,2222],[2288,2298],[2340,2351],[2432,2440],[2523,2561],[2565,2637]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/trouble-ticket-open-api.md"},
