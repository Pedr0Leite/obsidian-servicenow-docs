eate-reservation-request-1","line":43},{"title":"Define the capacity of workplace areas","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/workplace-core/define-capacity-of-workplace-areas-wsd.md","line":54},{"title":"Create workplace reservations for an employee","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/workplace-core/reserve-workspaces-for-employees-wsd.md","line":56},{"title":"Create workplace reservations for an employee","target":"reserve-workspaces-for-employees","line":57},{"title":"Create workplace reservations for multiple employees","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/workplace-core/reserve-spaces-bulk-assignment-multiple-employees-wsd.md","line":58},{"title":"Review pending workspace reservation requests","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/workplace-core/review-pending-reservation-requests.md","line":60},{"title":"Review pending workplace reservation requests","target":"work-with-pending-reservation-requests","line":61},{"title":"Manage workplace safety activities","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/workplace-core/manage-wsd-activites.md","line":63},{"title":"Workplace Core","target":"workplace-safety-mgmt-hr","line":108},{"title":"Workplace Service Delivery","target":"workplace-service-delivery-suite-landing-page","line":109},{"title":"Workplace Reservation Management","target":"workplace-rsv-mgmt-feat","line":110},{"title":"Create a reservation","target":"create-reservation-request-1","line":111},{"title":"Create workplace reservations for an employee","target":"reserve-workspaces-for-employees","line":112},{"title":"Review pending workplace reservation requests","target":"work-with-pending-reservation-requests","line":113}],"metadata":{"title":"Managing workplace reservations for employees","description":"Reserve available areas or spaces for your employees and review pending reservation requests from employees in Workplace Core so you can verify physical distancing measures when they return to the workplace. Once you make reservations, employees are notified about the locations to which they have access. The Workplace Service Delivery also offers more advanced workplace reservation options in the Workplace Reservation Management application.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/workplace-core/managing-workplace-reservations-wsd.html","release":"australia","product":"Workplace Core","classification":"workplace-core","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Manage workplace safety activities","Workplace Core","Workplace Service Delivery","Employee Service Management"],"tags":["#employee-service-management","#workplace-core","#data-model","#foundation","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/workplace-core/managing-workplace-reservations-wsd.md"},
