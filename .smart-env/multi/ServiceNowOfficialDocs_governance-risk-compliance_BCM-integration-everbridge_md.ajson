":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Using BCM Classic Workspace","Manage","Business Continuity Management","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/BCM-integration-everbridge.md"},
