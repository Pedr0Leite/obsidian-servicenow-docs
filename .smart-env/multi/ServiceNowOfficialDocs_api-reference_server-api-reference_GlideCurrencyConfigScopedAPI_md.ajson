},{"title":"Setting up and operating FX Currency fields","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/fx-currency.md","line":28},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":32},{"title":"GlideCurrencyConfig\\(Object ed\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/GlideCurrencyConfigScopedAPI.md","line":40},{"title":"Configuring FX Currency global settings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/fx-currency-configure.md","line":42},{"title":"Configuring FX Currency global settings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/fx-currency-configure.md","line":58},{"title":"Specify the table field and its currency display parameters","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/configure-fx-currency-field-behavior.md","line":77},{"title":"Identify the rate table and date source for currency conversions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/configure-fx-currency-field-behavior.md","line":130},{"title":"Select the rate and target table fields used for filtering","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/configure-fx-currency-field-behavior.md","line":267},{"title":"Select the rate and target table fields used for filtering","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/configure-fx-currency-field-behavior.md","line":307},{"title":"Identify the rate table and date source for currency conversions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/configure-fx-currency-field-behavior.md","line":354},{"title":"Set the reference currency","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/configure-fx-currency-field-behavior.md","line":401},{"title":"Set the reference currency","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/configure-fx-currency-field-behavior.md","line":451}],"metadata":{"title":"GlideCurrencyConfig - Scoped","description":"The GlideCurrencyConfig API provides methods to retrieve various configuration information for FX Currency fields.Instantiates a GlideCurrencyConfig object that enables the retrieval of global default FX Currency configuration information.Instantiates a GlideCurrencyConfig object that enables the retrieval of the configuration information for a specific FX Currency field.Returns the aggregation source value for an FX Currency field.Returns the field used as the source of the date and time for the currency conversion.Returns the number of digits to display for an FX Currency field.Returns the currency code used to convert the FX Currency value when it appears in lists and reports.Returns the rate table field used as a rate table filter for an FX Currency field.Returns the target table field used to filter the rate table records for an FX Currency field.Returns the rate table used to convert currency for an FX Currency field.Returns the reference currency for an FX Currency field.Returns the reference currency source for an FX Currency field.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/GlideCurrencyConfigScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":11,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[48,50],[64,69],[109,112],[116,122],[156,162],[194,197],[201,207],[246,249],[253,259],[293,299],[333,336],[340,346],[380,383],[387,393],[430,433],[437,443],[477,480],[484,490]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GlideCurrencyConfigScopedAPI.md"},
