tegrating ServiceNow Virtual Agent with Slack#Related#{3}":[46,47]},"outlinks":[{"title":"Virtual Agent","target":"virtual-agent-landing-page","line":25},{"title":"Install the Conversational Integration with Slack","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/install-slack-from-store.md","line":27},{"title":"install the Conversational Integration with Slack","target":"install-slack-from-store","line":28},{"title":"Integrate ServiceNow Virtual Agent with Slack","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/add-slack-snow-bot.md","line":29},{"title":"Override Slack integration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/override-slack-install.md","line":31},{"title":"Manage the ServiceNow Virtual Agent integration with Slack","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/configure-va-slack.md","line":33},{"title":"Conversational Integration with Slack","target":"mssg-slack","line":34},{"title":"Remove ServiceNow Virtual Agent integration with Slack","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/uninstall-virtual-agent-slack.md","line":35},{"title":"Integrating a self-configured bot with Slack workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/va-integ-single-slack.md","line":37},{"title":"Conversational Integration with Slack","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/mssg-slack.md","line":40},{"title":"Virtual Agent","target":"virtual-agent-landing-page","line":44},{"title":"Install the Conversational Integration with Slack","target":"install-slack-from-store","line":45},{"title":"Conversational Integration with Slack","target":"mssg-slack","line":46}],"metadata":{"title":"Integrating ServiceNow Virtual Agent with Slack","description":"The Virtual Agent integration with Slack creates a one-to-one association between the ServiceNow instance that you are installing from and the Slack workspace in which the integration runs. By default, Virtual Agent supports one-click installation that integrates one Slack workspace with one ServiceNow instance.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/conversational-interfaces/virtual-agent/va-integ-slack.html","release":"australia","product":"Virtual Agent","classification":"virtual-agent","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"keywords":["Virtual Agent","Slack","integration"],"breadcrumb":["Conversational Integration with Slack","Integrate VA with messaging apps","Integrate VA with other channels","Virtual Agent","Conversational Interfaces"],"tags":["#conversational-interfaces","#virtual-agent","#chatbot","#nlu","#topics","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/conversational-interfaces/virtual-agent/va-integ-slack.md"},
