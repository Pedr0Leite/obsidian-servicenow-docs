ment2 - getDocumentElement\\(\\)#{1}":[138,169],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - getFirstNode\\(String xPath\\)":[170,250],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - getFirstNode\\(String xPath\\)#{1}":[172,250],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - getNextNode\\(Object current\\)":[251,287],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - getNextNode\\(Object current\\)#{1}":[253,287],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - getNode\\(String xPath\\)":[288,349],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - getNode\\(String xPath\\)#{1}":[290,349],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - getNodeText\\(String xPath\\)":[350,381],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - getNodeText\\(String xPath\\)#{1}":[352,381],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - parseXML\\(String xmlDoc\\)":[382,409],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - parseXML\\(String xmlDoc\\)#{1}":[384,409],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setCurrentElement\\(XMLNode element\\)":[410,438],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setCurrentElement\\(XMLNode element\\)#{1}":[412,438],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setEnableCDATAReporting\\(Boolean enable\\)":[439,512],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setEnableCDATAReporting\\(Boolean enable\\)#{1}":[441,470],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setEnableCDATAReporting\\(Boolean enable\\)#{2}":[471,471],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setEnableCDATAReporting\\(Boolean enable\\)#{3}":[472,473],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setEnableCDATAReporting\\(Boolean enable\\)#{4}":[474,512],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setNamespaceAware\\(Boolean aware\\)":[513,526],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - setNamespaceAware\\(Boolean aware\\)#{1}":[515,526],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - toString\\(\\)":[527,567],"#XMLDocument2 - Scoped, Global#Scoped XMLDocument2 - toString\\(\\)#{1}":[529,567]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":32},{"title":"getNextNode\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_XMLDocument2ScopedAPI.md","line":220},{"title":"getFirstNode\\(String xPath\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_XMLDocument2ScopedAPI.md","line":292},{"title":"getNextNode\\(Object current\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_XMLDocument2ScopedAPI.md","line":292},{"title":"Scoped XMLDocument2 - parseXML\\(String xmlDoc\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_XMLDocument2ScopedAPI.md","line":443},{"title":"Scoped XMLNode - isCDATANode\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_XMLNodeScopedAPI.md","line":445}],"metadata":{"title":"XMLDocument2 - Scoped, Global","description":"The XMLDocument2 API is a JavaScript object wrapper for parsing and extracting XML data from an XML string.Creates an XMLDocument2 object.Creates an XMLDocument2 object from an attachment stream.Creates and adds an element node to the current node. The element name is the string passed in as a parameter. The new element has no text child nodes.Creates and adds an element node with a text child node to the current node.Gets the document element node of the XMLdocument2 object. The document element node is the root node.Gets the first node in the specified xPath.Gets the node after the specified node.Gets the node specified in the xPath.Gets all the text child nodes from the node referenced in the specified XPath.Parses the XML string and loads it into the XMLDocument2 object.Makes the node passed in as a parameter the current node.Sets whether nodes are treated as CDATA or regular text after parsing. CDATA reporting is deactivated by default.When set to true, the XMLDocument2 object processes the document with XML namespaces.Returns a string containing the XML.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_XMLDocument2ScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[62,76],[80,91],[106,119],[123,134],[148,162],[166,168],[176,202],[206,210],[214,218],[230,243],[247,249],[263,278],[282,286],[302,341],[345,348],[362,374],[378,380],[396,408],[422,437],[483,497],[501,504],[508,511],[539,551],[555,565]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_XMLDocument2ScopedAPI.md"},
