elease":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":13,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[78,85],[89,92],[96,104],[108,113],[142,151],[155,158],[200,205],[214,229],[233,238],[272,280],[284,286],[330,340],[344,347],[384,388],[432,442],[446,448],[476,484],[488,493],[521,529],[533,536],[553,560],[564,567],[583,588],[592,594],[636,641],[650,667],[671,676],[705,719],[723,727],[744,757],[761,763],[782,810]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GlideSysAttachmentGlobalAPI.md"},
