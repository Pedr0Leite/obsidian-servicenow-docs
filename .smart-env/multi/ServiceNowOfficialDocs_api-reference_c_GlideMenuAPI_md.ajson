HTML.Displays the specified item.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/c\\_GlideMenuAPI.html","release":"australia","product":"API Reference","classification":"api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Client API reference","API reference","API implementation and reference"],"tags":["#api-reference","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[41,43],[83,85],[99,101],[117,119],[134,136],[151,153],[167,169]],"key":"ServiceNowOfficialDocs/api-reference/c_GlideMenuAPI.md"},
