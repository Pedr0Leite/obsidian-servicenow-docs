"target":"sg-workspace","line":38},{"title":"domain separation","target":"domain-separation-relationship-formatter-editor","line":50},{"title":"Ask questions and explore other resources for  in the ServiceNow Community","target":"https://www.servicenow.com/community/","line":55},{"title":"Search the Known Error Portal for known error articles","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB0597477","line":56},{"title":"Contact Customer Service and Support","target":"https://support.servicenow.com/now","line":57},{"title":"Exploring CMDB Health","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/exploring-cmdb-health-parent.md","line":59},{"title":"CMDB Health experience in CMDB Workspace and in Service Graph Workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-health-exp-cmdb-workspace.md","line":61},{"title":"View CMDB Health Dashboard","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_MonitorCMDBHealth.md","line":63},{"title":"View relationships health","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/t_ViewRelationshipsHealth.md","line":65},{"title":"View CI health","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/t_ViewCIHealth.md","line":67},{"title":"Create a CMDB remediation rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/t_CreateCMDBRemediationRule.md","line":69},{"title":"CMDB Health process tracking and troubleshooting","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_CMDBHealthTroubleshooting.md","line":71},{"title":"CMDB Health reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-health-ref-parent.md","line":73},{"title":"Reference","target":"reference","line":74},{"title":"Configuration Management Database \\(CMDB\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_ITILConfigurationManagement.md","line":76},{"title":"Service Graph Workspace","target":"sg-workspace","line":80},{"title":"Domain separation","target":"domain-separation-relationship-formatter-editor","line":81},{"title":"Reference","target":"reference","line":82}],"metadata":{"title":"CMDB Health","description":"A healthy CMDB, based on health benchmarks in an organization, is essential to an effective and continuous use of the product. Health indicators such as duplicate CIs, required CI fields, and audits are evaluated and aggregated into health scores at the class, health group, and service levels. CMDB Health also provides a framework for applying standardized CI remediation.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/configuration-management-database-cmdb/c\\_CMDBHealth.html","release":"australia","product":"Configuration Management Database \\(CMDB\\)","classification":"configuration-management-database-cmdb","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Configuration Management Database \\(CMDB\\)","Configuration Management","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#cmdb","#cis","#relationships","#health","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"