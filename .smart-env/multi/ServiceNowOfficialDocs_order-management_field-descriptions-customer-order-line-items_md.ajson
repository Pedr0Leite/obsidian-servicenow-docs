rice adjustment fields#{6}":[434,434],"#Customer and service order line items forms#Price adjustment fields#{7}":[435,435],"#Customer and service order line items forms#Price adjustment fields#{8}":[436,437],"#Customer and service order line items forms#Price adjustment fields#{9}":[438,488],"#Customer and service order line items forms#Related":[489,502],"#Customer and service order line items forms#Related#{1}":[491,491],"#Customer and service order line items forms#Related#{2}":[492,492],"#Customer and service order line items forms#Related#{3}":[493,493],"#Customer and service order line items forms#Related#{4}":[494,494],"#Customer and service order line items forms#Related#{5}":[495,495],"#Customer and service order line items forms#Related#{6}":[496,496],"#Customer and service order line items forms#Related#{7}":[497,497],"#Customer and service order line items forms#Related#{8}":[498,498],"#Customer and service order line items forms#Related#{9}":[499,499],"#Customer and service order line items forms#Related#{10}":[500,500],"#Customer and service order line items forms#Related#{11}":[501,502]},"outlinks":[{"title":"modify","target":"Modify","line":21},{"title":"Order Management reference","target":"order-mgt-reference","line":23},{"title":"Order line item form states","target":"order-mgt-state-values","line":93},{"title":"Service order states","target":"service-order-mgt-state-values","line":95},{"title":"Cancel","target":"cancel","line":119},{"title":"Suspend","target":"Suspend","line":136},{"title":"Resume","target":"Resume","line":137},{"title":"Action types for customer and service orders","target":"order-mgt-customer-order-types","line":140},{"title":"Sales Agreement Management","target":"sales-agreement-mgmt","line":244},{"title":"Renew","target":"Renew","line":265},{"title":"fields","target":"fields","line":276},{"title":"Order Management reference","target":"order-mgt-reference","line":491},{"title":"Customer order states","target":"order-mgt-state-values","line":492},{"title":"Service order states","target":"service-order-mgt-state-values","line":493},{"title":"Action types for customer and service orders","target":"order-mgt-customer-order-types","line":494},{"title":"Modify","target":"Modify","line":495},{"title":"Cancel","target":"cancel","line":496},{"title":"Suspend","target":"Suspend","line":497},{"title":"Resume","target":"Resume","line":498},{"title":"Sales Agreement Management","target":"sales-agreement-mgmt","line":499},{"title":"Renew","target":"Renew","line":500},{"title":"Fields","target":"fields","line":501}],"metadata":{"title":"Customer and service order line items forms","description":"The Order Line Items form enables you to select, review, and modify the captured customer or service order line items.The order line items form line item details section enables you to review and modify general details for a customer or service order line item.The Order Line Items form - dates section enables you to review and modify crucial date details for a customer order line item.The Order Line Items form - shipping address details section enables you to review and modify the shipping details for a customer order line item.The Order Line Items form - notes section enables you to review and modify the additional details for a customer order line item.The Order Line Related Items form enables you to review, create, and modify the related items for a customer order line item.OM revamp project - This table has been moved from the order-mgt-review-update-order-line-related-item.dita topic as we're deprecating that topic and removing it from the SOM bundle.The Price Adjustments tab on the order line item details enables you to review and modify manual price adjustments applied to an order line item.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/order-management/field-descriptions-customer-order-line-items.html","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Order Management reference","Reference","Sales Customer Relationship Management"],"tags":["#order-management","#fulfillment","#catalog","#orchestration","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/order-management/field-descriptions-customer-order-line-items.md"},
