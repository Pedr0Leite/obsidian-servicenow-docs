.md","line":30},{"title":"Lists","target":"migration-lists","line":52},{"title":"Scheduling in Workforce Optimization for Customer Service","target":"scheduling-configurable-wfo-cs","line":86},{"title":"Setting up Scheduling in Workforce Optimization for Customer Service","target":"setup-scheduling-configurable-wfo-cs","line":90},{"title":"Scheduling in Workforce Optimization for Customer Service","target":"scheduling-configurable-wfo-cs","line":91},{"title":"Lists","target":"migration-lists","line":92}],"metadata":{"title":"Analyze adherence and conformance from the time worked summary","description":"View the time worked summary of your team members to determine if your teams are adhering to the planned schedules. You can also use historical adherence, which is a reporting view of real-time adherence, to see how well your agents have followed their schedules in the past.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/customer-service-management/analyze-time-worked-summary-configurable-wfo-cs.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Schedule","Workforce Optimization for Customer Service","Agent management","Use","Customer Service Management"],"tags":["#customer-service-management","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/customer-service-management/analyze-time-worked-summary-configurable-wfo-cs.md"},
