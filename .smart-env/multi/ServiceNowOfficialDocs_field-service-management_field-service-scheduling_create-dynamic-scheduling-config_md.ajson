ed#{5}":[965,965],"#Configure dynamic scheduling#Related#{6}":[966,966],"#Configure dynamic scheduling#Related#{7}":[967,968]},"outlinks":[{"title":"Dynamic Scheduling","target":"dynamic-scheduling","line":24},{"title":"task assignment method","target":"t_ConfigureFieldService","line":28},{"title":"Set up agent schedules for dynamic scheduling","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/agent-schedule-dynamic.md","line":29},{"title":"Review system properties and components for Dynamic Scheduling","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/dynamic-sched-system-properties.md","line":30},{"title":"Configuring Field Service Work Configurations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/configuring-work-configs.md","line":47},{"title":"Field Service Territory Planning","target":"territory-planning-fsm","line":63},{"title":"Create a task filter for dynamic scheduling","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/create-dynamic-scheduling-config.md","line":67},{"title":"Create a task ordering rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/create-dynamic-scheduling-config.md","line":71},{"title":"Create a task unassignment constraint","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/create-dynamic-scheduling-config.md","line":75},{"title":"Example - configure dynamic scheduling to assign preferred technicians to tasks","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/excluded-preferred-agents.md","line":91},{"title":"Example - configure dynamic scheduling to ignore excluded technicians","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/prevent-excluded-agents.md","line":93},{"title":"Assigning work order tasks to agents using dynamic scheduling","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/using-dynamic-scheduling.md","line":95},{"title":"Matching criteria for assigning tasks","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/create-dynamic-scheduling-config.md","line":220},{"title":"Create a task ordering rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/create-dynamic-scheduling-config.md","line":237},{"title":"Workforce optimization","target":"using-wfo-fsm","line":249},{"title":"Mandatory Skills","target":"mandatory-skills","line":461},{"title":"mandatory skills","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/workforce-optimization-for-field-service/configure-mandatory-skills-feature.md","line":465},{"title":"Field Service Crew Operations","target":"field-service-crew-scheduling","line":573},{"title":"Field Service Agent Efficiency","target":"agent-efficiency","line":653},{"title":"Create a task unassignment constraint","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/field-service-scheduling/create-dynamic-scheduling-config.md","line":839},{"title":"Global domain configurations","target":"t_ConfigureFieldService","line":961},{"title":"Dynamic scheduling","target":"dynamic-scheduling","line":962},{"title":"Field Service Territory Planning","target":"territory-planning-fsm","line":963},{"title":"Workforce Optimization","target":"using-wfo-fsm","line":964},{"title":"Mandatory skills","target":"mandatory-skills","line":965},{"title":"Field Service Crew Operations","target":"field-service-crew-scheduling","line":966},{"title":"Field Service Agent Efficiency","target":"agent-efficiency","line":967}],"metadata":{"title":"Configure dynamic scheduling","description":"Dynamic Scheduling enables automatic task assignment to field agents based on predefined rules and configurations. This feature helps streamline task distribution by verifying the correct tasks are assigned to the most suitable agents, optimizing travel time, skill matching, and task priority.Task filters allow you to define criteria for selecting and assigning tasks to the most suitable agents using dynamic scheduling.The Dynamic Scheduling uses configurable matching criteria, such as skills and availability, to evaluate the agents in a selected group and provide an overall ranking.Dynamic scheduling uses task ordering rules to prioritize and arrange tasks effectively. These rules ensure tasks are handled in the right sequence, helping you streamline field service operations.Dynamic scheduling allows you to define unassignment constraints that prevent certain tasks from being unassigned, even when lower in priority. This feature ensures that critical tasks stay assigned, based on dependencies or urgency.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/field-service-management/field-service-scheduling/create-dynamic-scheduling-config.html","release":"australia","product":"Field Service Scheduling","classification":"field-service-scheduling","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":22,"breadcrumb":["Dynamic Scheduling","Setting up a Field Service scheduling method","Configure","Field Service Management"],"tags":["#field-service-management","#scheduling","#territories","#optimization","#dispatch","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[229,233],[741,743],[745,747],[749,751]],"key":"ServiceNowOfficialDocs/field-service-management/field-service-scheduling/create-dynamic-scheduling-config.md"},
