ubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/create-child-alias-saas.md","line":324},{"title":"Review a software reclamation rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/add-reclamation-rule-sub.md","line":326},{"title":"Create entitlements in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/track-software-rights.md","line":330},{"title":"Create entitlements in workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/create-entitlements-workspace.md","line":331},{"title":"Create entitlements using the guided walk-through","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/guidedwalk-workspace.md","line":332},{"title":"License Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-license-workbench.md","line":334},{"title":"License usage view","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-workspace-workbench.md","line":334},{"title":"Run software reconciliation in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/t_RunReconciliation.md","line":336},{"title":"Run software reconciliation in the workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/run-recon-workspace.md","line":337},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":341},{"title":"SaaS License Management","target":"sam-subscription-management","line":342},{"title":"Using Software Asset Workspace","target":"using-sam-workspace","line":343},{"title":"Software Asset Workspace","target":"sam-workspace","line":344},{"title":"Software reclamation rules","target":"sw-reclamation-rules","line":345},{"title":"Software models","target":"c_CreatingSoftwareModels","line":346}],"metadata":{"title":"Integrating with PagerDuty","description":"Integrating your Software Asset Management application with the PagerDuty application enables you to track your software subscriptions and to reclaim unused licenses.Create a PagerDuty application to integrate with your ServiceNow instance.After you create a PagerDuty application, configure OAuth 2.0 to authorize your application to administer PagerDuty and access user-specific data on user login.Create a PagerDuty integration profile to track software subscriptions and optimize licensing for your PagerDuty applications.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/saas-license-management/integrate-with-pagerduty.html","release":"australia","product":"SaaS License Management","classification":"saas-license-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["Integrate with SaaS applications","SaaS License Management","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#saas","#license-management","#discovery","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/saas-license-management/integrate-with-pagerduty.md"},
