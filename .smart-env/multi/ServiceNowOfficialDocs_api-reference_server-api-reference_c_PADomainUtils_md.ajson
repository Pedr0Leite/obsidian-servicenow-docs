tring paJob, String runAs\\)#{1}":[113,133],"#PADomainUtils- Global#PADomainUtils - isWriteable\\(String table, String id\\)":[134,151],"#PADomainUtils- Global#PADomainUtils - isWriteable\\(String table, String id\\)#{1}":[136,151],"#PADomainUtils- Global#PADomainUtils - move\\(String runAs\\)":[152,169],"#PADomainUtils- Global#PADomainUtils - move\\(String runAs\\)#{1}":[154,169],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)":[170,202],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{1}":[172,175],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{2}":[176,176],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{3}":[177,177],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{4}":[178,178],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{5}":[179,179],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{6}":[180,180],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{7}":[181,181],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{8}":[182,182],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{9}":[183,183],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{10}":[184,184],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{11}":[185,185],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{12}":[186,187],"#PADomainUtils- Global#PADomainUtils - setFoundation\\(Boolean foundation\\)#{13}":[188,202],"#PADomainUtils- Global#PADomainUtils - setOverrides\\(Boolean overrides\\)":[203,223],"#PADomainUtils- Global#PADomainUtils - setOverrides\\(Boolean overrides\\)#{1}":[205,223]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":40},{"title":"copyDashboard","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_PADomainUtils.md","line":76},{"title":"copyJob","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_PADomainUtils.md","line":76}],"metadata":{"title":"PADomainUtils - Global","description":"The PADomainUtils API enables you to copy Performance Analytics records between different domains on the same instance.Instantiates a new PADomainUtils object to move or copy Performance Analytics records from the global domain.Instantiates a new PADomainUtils object to move or copy Performance Analytics records from the specified domain.Copies Performance Analytics records to a different domain.Copy a dashboard to another domain.Copies a Performance Analytics scheduled data collection job record to another domain.Evaluate if you can write to a specific record identified by table and sys\\_id.Moves Performance Analytics records to a different domain.Use this method to move or copy only foundational records in a hybrid domain configuration.Use this method before copying records to set the sys\\_override value of the new record to the original parent record.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_PADomainUtils.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[52,55],[67,70],[86,90],[105,109],[124,132],[147,150],[164,168],[198,201],[217,221]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_PADomainUtils.md"},
