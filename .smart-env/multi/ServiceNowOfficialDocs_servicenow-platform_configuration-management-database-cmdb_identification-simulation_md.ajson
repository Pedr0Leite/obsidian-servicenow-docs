 run logs#About this task":[157,173],"#Using identification simulation#Examine run logs#About this task#{1}":[159,164],"#Using identification simulation#Examine run logs#About this task#{2}":[165,165],"#Using identification simulation#Examine run logs#About this task#{3}":[166,166],"#Using identification simulation#Examine run logs#About this task#{4}":[167,167],"#Using identification simulation#Examine run logs#About this task#{5}":[168,168],"#Using identification simulation#Examine run logs#About this task#{6}":[169,169],"#Using identification simulation#Examine run logs#About this task#{7}":[170,171],"#Using identification simulation#Examine run logs#About this task#{8}":[172,173],"#Using identification simulation#Examine run logs#Procedure":[174,195],"#Using identification simulation#Examine run logs#Procedure#{1}":[176,177],"#Using identification simulation#Examine run logs#Procedure#{2}":[178,183],"#Using identification simulation#Examine run logs#Procedure#{3}":[184,185],"#Using identification simulation#Examine run logs#Procedure#{4}":[186,187],"#Using identification simulation#Examine run logs#Procedure#{5}":[188,189],"#Using identification simulation#Examine run logs#Procedure#{6}":[190,195],"#Using identification simulation#Related":[196,200],"#Using identification simulation#Related#{1}":[198,198],"#Using identification simulation#Related#{2}":[199,200]},"outlinks":[{"title":"Identification and Reconciliation Engine \\(IRE\\)","target":"ire","line":24},{"title":"identification rules","target":"c_IdentificationRules","line":26},{"title":"CMDB Identification and Reconciliation \\(IRE\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_CMDBIdentifyandReconcile.md","line":39},{"title":"CMDB dependent relationship rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_ServiceRulesMetadata.md","line":44},{"title":"createOrUpdateCI\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_IdentEngineScriptAPI.md","line":86},{"title":"identifyCIEnhanced","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_IdentEngineScriptAPI.md","line":107},{"title":"Automatically generate payload","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/identification-simulation.md","line":113},{"title":"createOrUpdateCI\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_IdentEngineScriptAPI.md","line":126},{"title":"glide.identification\\_logs.max\\_run\\_ids","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/properties-id-reconciliation.md","line":161},{"title":"Identification and Reconciliation Engine \\(IRE\\)","target":"ire","line":198},{"title":"Identification rules","target":"c_IdentificationRules","line":199}],"metadata":{"title":"Using identification simulation","description":"Identification simulation is a central location for automatically constructing a payload that is guaranteed to be complete and valid. You can then simulate the processing of the payload by the Identification and Reconciliation Engine \\(IRE\\) and examine the results before actually submitting it for execution by IRE.Use identification simulation to automatically construct an input payload for a specified class. The constructed payload is complete with any required dependent CIs, correctly structured, and syntactically valid for processing by the identification and reconciliation engine \\(IRE\\).Use identification simulation to simulate the identification and reconciliation engine \\(IRE\\) process of CI identification for an input payload. Provide a valid payload, which was constructed using identification simulation or that was created manually.Identification simulation logs each step of a simulated payload processing. You can then examine these run logs to determine if a payload was processed as expected, and if identification rules are effective. You can adjust the level of logging so it is helpful, and so that the amount of messages is not excessive or insufficient.Identification simulation provides run logs which are generated by Identification and Reconciliation Engine \\(IRE\\). You can access these run logs for payload runs, to examine results and for debugging purposes. IRE payload output logs appear in a user friendly format on a central page.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/configuration-management-database-cmdb/identification-simulation.html","release":"australia","product":"Configuration Management Database \\(CMDB\\)","classification":"configuration-management-database-cmdb","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["CMDB Identification and Reconciliation \\(IRE\\)","Configuration Management Database \\(CMDB\\)","Configuration Management","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#cmdb","#cis","#relationships","#health","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/configuration-management-database-cmdb/identification-simulation.md"},
