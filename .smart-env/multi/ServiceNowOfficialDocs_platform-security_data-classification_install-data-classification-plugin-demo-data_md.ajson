ation plugin demo data#Components installed with Data Classification demo data#Data Classifications installed#{1}":[62,69],"#Installing Data Classification plugin demo data#Components installed with Data Classification demo data#Data Classification assignments":[70,88],"#Installing Data Classification plugin demo data#Components installed with Data Classification demo data#Data Classification assignments#{1}":[72,88],"#Installing Data Classification plugin demo data#Related":[89,94],"#Installing Data Classification plugin demo data#Related#{1}":[91,91],"#Installing Data Classification plugin demo data#Related#{2}":[92,92],"#Installing Data Classification plugin demo data#Related#{3}":[93,94]},"outlinks":[{"title":"Data Classification","target":"data-classification","line":24},{"title":"data protection","target":"naai-data-protection","line":41},{"title":"filter criteria","target":"adaptive-auth-filter-criteria","line":47},{"title":"Data Classification","target":"data-classification","line":91},{"title":"Data protection","target":"naai-data-protection","line":92},{"title":"Filter criteria","target":"adaptive-auth-filter-criteria","line":93}],"metadata":{"title":"Installing Data Classification plugin demo data","description":"When you upgrade to or install Australia \\(and above\\), the Data Classification \\(com.glide.data\\_classification\\) plugin is automatically activated. However, you should manually install the demo data that comes with the plugin. It includes several important pre-defined data classifications, and it also assigns one of them to specific User \\[sys\\_user\\] table columns in your instance.When you install the demo data included in the Data Classification \\(com.glide.data\\_classification\\) plugin, several types of components are installed in your instance. These components include pre-defined data classifications and code assignments for specific User \\[sys\\_user\\} columns.","locale":"en-US","canonical_url":"https://www.servicenow.com/doc