arget":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_NavigationStack.md","line":31},{"title":"GlideURI - Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/GlideURIGlobalAPI.md","line":33},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":35}],"metadata":{"title":"GlideURI - Scoped","description":"The GlideURI API provides methods to handle URI parameters in a scoped application.Instantiates a GlideURI object.Returns the value of the specified parameter.Returns the file name portion of the URI.Sets the specified parameter to the specified value.Reconstructs the URI string and performs the proper URL encoding by converting non-valid characters to their URL code. For example, converting &amp; to '%26'.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_GlideURIScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[57,62],[66,68],[82,87],[102,107],[111,113],[129,132]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_GlideURIScopedAPI.md"},
