es#Set batch size for a specific saved query#{1}":[50,51],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#Before you begin":[52,55],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#Before you begin#{1}":[54,55],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#About this task":[56,59],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#About this task#{1}":[58,59],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#Procedure":[60,69],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#Procedure#{1}":[62,63],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#Procedure#{2}":[64,65],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#Procedure#{3}":[66,67],"#Batch size for CMDB Query Builder queries#Set batch size for a specific saved query#Procedure#{4}":[68,69],"#Batch size for CMDB Query Builder queries#Related":[70,73],"#Batch size for CMDB Query Builder queries#Related#{1}":[72,73]},"outlinks":[{"title":"Query Builder Scriptable API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/CMDBQueryBuilderAPI.md","line":31},{"title":"CMDB groups","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-groups.md","line":33},{"title":"glide.cmdb.query.batch\\_size","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-querybldr-sysproprties.md","line":37},{"title":"glide.cmdb.query.batch\\_size","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-querybldr-sysproprties.md","line":38},{"title":"glide.cmdb.query.batch\\_size","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-querybldr-sysproprties.md","line":45},{"title":"Set batch size for a specific saved query","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/batch-size-query.md","line":46},{"title":"CMDB Query Builder","target":"cmdb-query-builder-landing-page","line":50},{"title":"glide.cmdb.query.batch.size","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-querybldr-sysproprties.md","line":68},{"title":"CMDB Query Builder","target":"cmdb-query-builder-landing-page","line":72}],"metadata":{"title":"Batch size for CMDB Query Builder queries","description":"In a base system, a global batch size of 100 is allocated for every Query Builder query run. If needed, you can use a system property to override the default global batch size, or optimize the batch size value per saved query.Configure a custom batch size for a CMDB Query Builder saved query that takes a long time to complete or that times out. A custom batch size overrides the global batch size in the base system and the value of the glide.cmdb.query.batch.size system property.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/configuration-management-database-cmdb/batch-size-query.html","release":"australia","product":"Configuration Management Database \\(CMDB\\)","classification":"configuration-management-database-cmdb","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Configure","CMDB Query Builder","Configuration Management Database \\(CMDB\\)","Configuration Management","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#cmdb","#cis","#relationships","#health","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/configuration-management-database-cmdb/batch-size-query.md"},
