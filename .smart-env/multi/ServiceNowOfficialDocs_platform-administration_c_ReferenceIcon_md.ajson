ocedure#{5}":[68,70],"#Reference field icon#Configure the reference icon view of fields#Procedure#{6}":[71,75],"#Reference field icon#Configure pop-ups on read-only fields":[76,96],"#Reference field icon#Configure pop-ups on read-only fields#{1}":[78,79],"#Reference field icon#Configure pop-ups on read-only fields#Before you begin":[80,83],"#Reference field icon#Configure pop-ups on read-only fields#Before you begin#{1}":[82,83],"#Reference field icon#Configure pop-ups on read-only fields#Procedure":[84,92],"#Reference field icon#Configure pop-ups on read-only fields#Procedure#{1}":[86,87],"#Reference field icon#Configure pop-ups on read-only fields#Procedure#{2}":[88,89],"#Reference field icon#Configure pop-ups on read-only fields#Procedure#{3}":[90,92],"#Reference field icon#Configure pop-ups on read-only fields#What to do next":[93,96],"#Reference field icon#Configure pop-ups on read-only fields#What to do next#{1}":[95,96],"#Reference field icon#Related":[97,102],"#Reference field icon#Related#{1}":[99,99],"#Reference field icon#Related#{2}":[100,100],"#Reference field icon#Related#{3}":[101,102]},"outlinks":[{"title":"reference","target":"reference-email-admin","line":18},{"title":"Configuring the form layout","target":"configure-form-layout","line":74},{"title":"System Properties","target":"r_SetArchiveRuleProcessingBehavior","line":86},{"title":"Configuring the form layout","target":"configure-form-layout","line":99},{"title":"Reference","target":"reference-email-admin","line":100},{"title":"System properties","target":"r_SetArchiveRuleProcessingBehavior","line":101}],"metadata":{"title":"Reference field icon","description":"On forms, the reference icon \\( Core UI reference icon \\) appears by populated reference fields. Clicking the icon opens a read-only preview of the referenced record.Use a table's sys\\_popup form view to configure the fields in the pop-up form that appear when pointing to a reference icon. If the table has no sys\\_popup view, the pop-up uses the default view.Reference pop-ups and click-throughs are hidden by default when a client script, UI policy, variable, or ACL makes the field read-only. The ability to see or click through to the target record does not depend on whether the reference field is writable. You can change the read-only setting.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/c\\_ReferenceIcon.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Decorations","Reference field type","Reference","Field administration","Forms","fields","and lists","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[44,46],[52,54],[58,60],[64,66]],"key":"ServiceNowOfficialDocs/platform-administration/c_ReferenceIcon.md"},
