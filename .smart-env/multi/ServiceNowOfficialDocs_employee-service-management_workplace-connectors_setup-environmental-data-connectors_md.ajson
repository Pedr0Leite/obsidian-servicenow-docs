hive-purge-occupancy-data.md","line":43},{"title":"Set up Connector Configuration for Environmental sensor data","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/workplace-connectors/wsd-connectorconfiguration-environment.md","line":45},{"title":"Workplace Connectors","target":"workplace-connectors-landing-page","line":49},{"title":"Connector Configurations","target":"connector-configuration-occupancy","line":50},{"title":"Provider connector configuration","target":"provider-configuration-ovw","line":51}],"metadata":{"title":"Setup Workplace Connectors for environmental data","description":"Configure the workplace environment data sensors to retrieve and fetch air quality and temperature data for a workplace. Define the units to measure air quality and temperature in the Unit of Measure table \\[sn\\_wsd\\_wc\\_unit\\_of\\_measure\\]. The units are added in the Environmental data table.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/workplace-connectors/setup-environmental-data-connectors.html","release":"australia","product":"Workplace Connectors","classification":"workplace-connectors","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Configure","Workplace Connectors","Workplace Service Delivery","Employee Service Management"],"tags":["#employee-service-management","#connectors","#integration","#workplace","#facilities","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/workplace-connectors/setup-environmental-data-connectors.md"},
