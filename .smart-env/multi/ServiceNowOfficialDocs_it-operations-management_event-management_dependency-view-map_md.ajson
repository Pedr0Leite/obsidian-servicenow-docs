#{2}":[57,57],"#View the Dependency map for CMDB alerts#Related#{3}":[58,59]},"outlinks":[{"title":"alert grouping","target":"c_ServiceAnalyticsOverview","line":32},{"title":"Create Group automation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/service-operations-workspace-for-itom-apps/group-alert-sow-itom.md","line":32},{"title":"Service Operations Workspace","target":"workspace-dashboard-use","line":32},{"title":"Event Management","target":"c_EM","line":36},{"title":"Alert grouping","target":"c_ServiceAnalyticsOverview","line":56},{"title":"Service Operations Workspace","target":"workspace-dashboard-use","line":57},{"title":"Event Management","target":"c_EM","line":58}],"metadata":{"title":"View the Dependency map for CMDB alerts","description":"The Dependency map illustrates how and why alerts are grouped, simplifying troubleshooting and issue management. It reveals connections between CIs within a CMDB alert group, enhancing visibility into their relationships. Additionally, if a CI is not part of the group but connects to other alert CIs, it remains visible on the map, aiding alert resolution and proactive management.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/event-management/dependency-view-map.html","release":"australia","product":"Event Management","classification":"event-management","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["CMDB based alert grouping","Mixed alert grouping","Alert grouping types and creation methods","Alert grouping","Configuring Event Management","Event Management","ITOM AIOps","IT Operations Management"],"tags":["#it-operations-management","#event-management","#alerts","#correlation","#aiops","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/event-management/dependency-view-map.md"},
