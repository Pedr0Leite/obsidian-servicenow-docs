d up loading large lists#Procedure#{4}":[169,170],"#Configure and use list functions#Speed up loading large lists#Procedure#{5}":[171,175],"#Configure and use list functions#Perform actions on selected items in a list":[176,198],"#Configure and use list functions#Perform actions on selected items in a list#{1}":[178,179],"#Configure and use list functions#Perform actions on selected items in a list#Before you begin":[180,183],"#Configure and use list functions#Perform actions on selected items in a list#Before you begin#{1}":[182,183],"#Configure and use list functions#Perform actions on selected items in a list#About this task":[184,187],"#Configure and use list functions#Perform actions on selected items in a list#About this task#{1}":[186,187],"#Configure and use list functions#Perform actions on selected items in a list#Procedure":[188,198],"#Configure and use list functions#Perform actions on selected items in a list#Procedure#{1}":[190,191],"#Configure and use list functions#Perform actions on selected items in a list#Procedure#{2}":[192,193],"#Configure and use list functions#Perform actions on selected items in a list#Procedure#{3}":[194,198],"#Configure and use list functions#Embedded lists":[199,214],"#Configure and use list functions#Embedded lists#{1}":[201,214],"#Configure and use list functions#Related":[215,226],"#Configure and use list functions#Related#{1}":[217,217],"#Configure and use list functions#Related#{2}":[218,218],"#Configure and use list functions#Related#{3}":[219,219],"#Configure and use list functions#Related#{4}":[220,220],"#Configure and use list functions#Related#{5}":[221,221],"#Configure and use list functions#Related#{6}":[222,222],"#Configure and use list functions#Related#{7}":[223,223],"#Configure and use list functions#Related#{8}":[224,224],"#Configure and use list functions#Related#{9}":[225,226]},"outlinks":[{"title":"lists","target":"lists-configurable-workspace","line":18},{"title":"configure","target":"configure-onboarding-modals","line":26},{"title":"Lists in the classic environment","target":"c_UseLists","line":28},{"title":"list fields","target":"r_Fields","line":42},{"title":"Filters","target":"c_Filters","line":66},{"title":"Choice lists","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/c_ChoiceLists.md","line":72},{"title":"Integer values for default choice lists","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/c_IntValsForDfltChoiceList.md","line":74},{"title":"Creating Personal Lists","target":"c_PersonalLists","line":100},{"title":"forms","target":"form-configurable-workspace","line":201},{"title":"Edit a form","target":"t_EditingInForms","line":203},{"title":"Use the list editor","target":"t_UseTheListEditor","line":210},{"title":"Lists in the classic environment","target":"c_UseLists","line":217},{"title":"Personal lists","target":"c_PersonalLists","line":218},{"title":"Edit a form","target":"t_EditingInForms","line":219},{"title":"Use the list editor","target":"t_UseTheListEditor","line":220},{"title":"Lists","target":"lists-configurable-workspace","line":221},{"title":"Configure","target":"configure-onboarding-modals","line":222},{"title":"List fields","target":"r_Fields","line":223},{"title":"Filters","target":"c_Filters","line":224},{"title":"Forms","target":"form-configurable-workspace","line":225}],"metadata":{"title":"Configure and use list functions","description":"All users can interact with lists for the tables their role permits them to access. Some list and column header menu options are controlled by permissions grated to the user role.You can quickly find information in a list by sorting the list. The method that the system uses to sort a list depends on the type of record in the sort column.You can enable or disable modern cell coloring for list field status indicators. This setting is available when you personalize a list. This setting is available in your system settings.You can customize the number of records, or rows, to display on each page of a list. The default is 20 rows per page.A view defines the elements that appear when a user opens a list.Remove the calculation of the total number of records in a list to speed up loading lists.Action check boxes enable you to perform actions on one or more items in a list.Some lists may be embedded in forms. Use list controls to work with records in an embedded list within a form.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-user-interface/configure-use-list-functions.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Lists in the classic environment","Working in the classic environment","Working in Core UI","Configure UIs and portals","Configure user experiences"],"tags":["#platform-user-interface","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-user-interface/configure-use-list-functions.md"},
