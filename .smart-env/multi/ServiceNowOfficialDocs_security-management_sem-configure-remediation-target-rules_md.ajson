#{3}":[94,97],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#Procedure#{4}":[98,101],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#Procedure#{5}":[102,145],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#What to do next":[146,153],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#What to do next#{1}":[148,149],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#What to do next#{2}":[150,150],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#What to do next#{3}":[151,151],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#What to do next#{4}":[152,153],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#Examples of recalculating a remediation target date":[154,326],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#Examples of recalculating a remediation target date#{1}":[156,159],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#Examples of recalculating a remediation target date#{2}":[160,160],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#Examples of recalculating a remediation target date#{3}":[161,161],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#Examples of recalculating a remediation target date#{4}":[162,163],"#Configuring remediation target rules#Create or edit remediation target rules#Recalculate a remediation target date#Examples of recalculating a remediation target date#{5}":[164,326],"#Configuring remediation target rules#Related":[327,334],"#Configuring remediation target rules#Related#{1}":[329,329],"#Configuring remediation target rules#Related#{2}":[330,330],"#Configuring remediation target rules#Related#{3}":[331,331],"#Configuring remediation target rules#Related#{4}":[332,332],"#Configuring remediation target rules#Related#{5}":[333,334]},"outlinks":[{"title":"vulnerabilities","target":"vulnerabilities","line":19},{"title":"Configure rules to manage findings","target":"sem-configure-rules-manage-findings","line":29},{"title":"Defining your own service level agreements \\(SLAs\\) using remediation target rules","target":"sem-defining-your-own-sla","line":34},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"sem-acls-for-admin-rules","line":42},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":46},{"title":"Remediation target rule fields","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/vulnerability-response/sem-rt-rules-fields.md","line":58},{"title":"Create or edit a Vulnerability Response remediation target rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/vulnerability-response/create-time-to-remediate-rule.md","line":96},{"title":"Vulnerability Response remediation target rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/vulnerability-response/time-to-remediate-rules.md","line":150},{"title":"Create or edit a Vulnerability Response remediation target rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/vulnerability-response/create-time-to-remediate-rule.md","line":151},{"title":"Examples of recalculating a remediation target date","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/sem-configure-remediation-target-rules.md","line":152},{"title":"Configure rules to manage findings","target":"sem-configure-rules-manage-findings","line":329},{"title":"Defining your own service level agreements \\(SLAs\\) using remediation target rules","target":"sem-defining-your-own-sla","line":330},{"title":"Access control lists \\(ACLs\\) for administration rules","target":"sem-acls-for-admin-rules","line":331},{"title":"Vulnerabilities","target":"vulnerabilities","line":332},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":333}],"metadata":{"title":"Configuring remediation target rules","description":"By configuring remediation target rules, you can set the expected time frame for addressing findings, similar to how service level agreements \\(SLAs\\) set deadlines for fixing vulnerabilities.Create remediation target rules to ensure the timely remediation of high-risk vulnerabilities by setting up a remediation target rule at the findings level.The remediation target \\(RT\\) date defines when a finding must be remediated. Recalculation verifies that RT dates stay accurate and reflect the latest risk rating updates. When a finding’s risk rating changes, the system can recalculate RT dates using the most recent update date, helping maintain accurate SLAs and avoid outdated or overdue target dates.The following examples show how the system recalculates the remediation target date based on different rule selections and risk rating changes.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/sem-configure-remediation-target-rules.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"keywords":["Remediation target","Recalculate remediation target date"],"breadcrumb":["Configure rules to manage findings","Implement","Unified Security Exposure Management","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/sem-configure-remediation-target-rules.md"},
