{2}":[249,249],"#Install and uninstall Nmap on a MID Server#Related#{3}":[250,251]},"outlinks":[{"title":"MID Server","target":"mid-server-landing","line":24},{"title":"Setup indicator for configuration phase","target":"../image/ProgressBarConfig.png","line":32,"embedded":true},{"title":"Discovery Quick Start","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery-quick-start.md","line":35},{"title":"Using MID Server IP range auto-assignment","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/mid-servers-auto-assignment.md","line":35},{"title":"IP address","target":"ip-address","line":35},{"title":"MID Server selection","target":"c_MIDServerSelector","line":41},{"title":"AWS Vulnerability/Penetration Testing Request","target":"https://aws.amazon.com/security/penetration-testing/","line":61},{"title":"capability","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown","line":75},{"title":"Configuring MID Servers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/c_MIDServerConfiguration.md","line":132},{"title":"Credential-less Discovery","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/nmap-credential-less-discovery.md","line":137},{"title":"https://nmap.org/dist/","target":"https://nmap.org/dist/","line":161},{"title":"MID Server","target":"mid-server-landing","line":248},{"title":"IP Address","target":"ip-address","line":249},{"title":"MID Server selection","target":"c_MIDServerSelector","line":250}],"metadata":{"title":"Install and uninstall Nmap on a MID Server","description":"If you decide to use credential-less Discovery in your network, you must install Nmap on each Windows MID Server that you want to use for this purpose. Self-hosted customers whose network security does not permit downloads from install.service-now.com must use a specific manual process to install and configure Nmap.Use this procedure to install Nmap on MID Server host machines in a self-hosted environment that does not allow network access to the ServiceNow install.service-now.com download site.Use this procedure to uninstall Nmap in a self-hosted environment that does not allow network access to the ServiceNow install.service-now.com download site.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/mid-server/install-nmap-on-mid-server.html","release":"australia","product":"MID Server","classification":"mid-server","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":12,"breadcrumb":["Configuring MID Servers","Configuring MID Server","MID Server","Manage instance data sources","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#mid-server","#on-premise","#proxy","#connectivity","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[190,199]]},"smart_blocks:ServiceNowOfficialDocs/servicenow-platform/mid-server/install-nmap-on-mid-server.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"mauub2","at":1784561353187},"key":"ServiceNowOfficialDocs/servicenow-platform/mid-server/install-nmap-on-mid-server.md#---frontmatter---","lines":[1,20],"size":1238,"outlinks":[],"class_name":"SmartBlock"},
