twork Discovery, you must convert the IP networks that were found into range sets for use in discovering other devices.After creating discovery range sets from a network discovery, add the sets to a discovery schedule. This process narrows down the range of IP addresses that Shazzam probes can scan. You can also add a behavior.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/discovery/c\\_NetworkDiscovery.html","release":"australia","product":"Discovery","classification":"discovery","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Running discoveries in your network","Using Discovery","Discovery","ITOM Visibility","IT Operations Management"],"tags":["#it-operations-management","#discovery","#cmdb","#patterns","#ci","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/discovery/c_NetworkDiscovery.md"},"smart_blocks:ServiceNowOfficialDocs/it-operations-management/discovery/c_NetworkDiscovery.md#---frontmatter---": {"path":null,"last_embed":{"hash":"zi1ppc","at":1784578493337},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.05500039,-0.00911458,0.05740862,-0.08485992,0.00669955,0.00272339,0.03136717,0.00234833,0.00269146,0.02260342,0.06256939,-0.01444134,0.05514056,-0.00706099,-0.00292029,0.01295778,-0.00980027,-0.00216468,0.04243834,0.01932414,0.08661878,-0.01399279,-0.04717559,0.00263828,0.04241381,0.1232268,0.04376062,-0.00820533,-0.05102124,-0.21781081,-0.01042608,-0.0089192,0.02107652,-0.02227747,0.00827267,-0.0462904,-0.0260831,0.01641394,-0.04896742,0.07042854,0.03785105,-0.01645648,0.0247754,-0.02571205,-0.11127525,-0.0431596,0.00810885,0.00251861,0.03122559,-0.08285904,-0.03519938,-0.0308374,-0.01481597,0.03242635,0.02144893,0.04323909,0.06641147,0.03595562,0.03705805,-0.03129804,0.06449383,0.04068807,-0.2058735,0.06835259,0.03676752,0.01326584,-0.05681347,-0.03422897,0.11443821,0.0470003,0.02485239,0.015