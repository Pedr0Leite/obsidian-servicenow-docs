ata- Global#CIData - getData\\(\\)#{1}":[159,168],"#CIData- Global#CIData - getM2MTable\\(String table, String refField\\)":[169,235],"#CIData- Global#CIData - getM2MTable\\(String table, String refField\\)#{1}":[171,235],"#CIData- Global#CIData - getRelatedList\\(String table, String refField\\)":[236,250],"#CIData- Global#CIData - getRelatedList\\(String table, String refField\\)#{1}":[238,250],"#CIData- Global#CIData - getRelatedListInstance\\(String table, String refField\\)":[251,275],"#CIData- Global#CIData - getRelatedListInstance\\(String table, String refField\\)#{1}":[253,275],"#CIData- Global#CIData - init\\(\\)":[276,292],"#CIData- Global#CIData - init\\(\\)#{1}":[278,292],"#CIData- Global#CIData - loadFromCI\\(String cmdb\\_ci\\)":[293,310],"#CIData- Global#CIData - loadFromCI\\(String cmdb\\_ci\\)#{1}":[295,310],"#CIData- Global#CIData - toString\\(\\)":[311,384],"#CIData- Global#CIData - toString\\(\\)#{1}":[313,384],"#CIData- Global#CIData - toXML\\(\\)":[385,402],"#CIData- Global#CIData - toXML\\(\\)#{1}":[387,402]},"outlinks":[{"title":"CIData - getData\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_CIDataAPI.md","line":32},{"title":"CIData - getRelatedList\\(String table, String refField\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_CIDataAPI.md","line":33},{"title":"CIData - getM2MTable\\(String table, String refField\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_CIDataAPI.md","line":34},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":36}],"metadata":{"title":"CIData - Global","description":"The CIData script include is a utility class that provides methods for working with configuration item \\(CI\\) data structures in JavaScript.Creates an instance of the CIData class.Adds the specified related list to this instance.Converts the specified related list to a related list in a given sensor.Initializes the current CIData instance from the specified XML string.Gets the data map in the base CI record.Returns an array of data maps in the given many-to-many list \\(to this CI\\).Gets an array of maps of data in the given related list \\(to this CI\\).Returns the instance of CIRelatedList for the given list.Initializes this instance in preparation for loading a new CI.Loads the current data from a specified sys\\_id.Converts the name of this CIData instance to a string.Returns an XML string containing a serialized version of this instance \\(including any related lists\\).","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_CIDataAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[72,81],[97,106],[137,144],[148,155],[197,211],[215,234],[266,274],[288,291],[305,309],[325,330],[334,383],[397,400]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_CIDataAPI.md"},
