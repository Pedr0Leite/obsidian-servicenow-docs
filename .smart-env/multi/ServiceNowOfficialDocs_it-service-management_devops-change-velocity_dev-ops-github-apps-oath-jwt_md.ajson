WT#Related#{1}":[447,447],"#OAuth 2.0 credentials for GitHub Apps - JWT#Related#{2}":[448,448],"#OAuth 2.0 credentials for GitHub Apps - JWT#Related#{3}":[449,449],"#OAuth 2.0 credentials for GitHub Apps - JWT#Related#{4}":[450,451]},"outlinks":[{"title":"DevOps Change Velocity","target":"devops-landing-page-new","line":30},{"title":"applications","target":"dex-workspace-application-tab","line":48},{"title":"Building GitHub Apps","target":"https://developer.github.com/apps/building-github-apps/","line":48},{"title":"Settings","target":"settings-mobile","line":52},{"title":"Installing GitHub Apps","target":"https://docs.github.com/en/developers/apps/managing-github-apps/installing-github-apps","line":176},{"title":"reference","target":"reference-for-itsm-mobile-agent","line":363},{"title":"DevOps Change Velocity","target":"devops-landing-page-new","line":447},{"title":"Applications","target":"dex-workspace-application-tab","line":448},{"title":"Settings","target":"settings-mobile","line":449},{"title":"Reference","target":"reference-for-itsm-mobile-agent","line":450}],"metadata":{"title":"OAuth 2.0 credentials for GitHub Apps - JWT","description":"Perform the following steps to integrate your GitHub Apps using the JWT bearer token.Create a custom GitHub App from your GitHub account to enable OAuth 2.0 authentication with your ServiceNow instance.Generate a Java KeyStore \\(JKS\\) certificate for the JWT authentication.Enable the JWT Bearer Grant token authentication by attaching the valid GitHub Java KeyStore \\(JKS\\) certificate to your ServiceNow instance.Create a JSON Web Token \\(JWT\\) signing key to assign to your GitHub Java KeyStore certificate.Add a JSON Web Token \\(JWT\\) provider to your ServiceNow instance for GitHub.Use the information generated during GitHub App account configuration to register GitHub as an OAuth provider and allow the instance to request OAuth 2.0 tokens.Create a credential record to the GitHub App provider previously created to authorize actions.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-service-management/devops-change-velocity/dev-ops-github-apps-oath-jwt.html","release":"australia","product":"DevOps Change Velocity","classification":"devops-change-velocity","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Setting up GitHub OAuth 2.0 credentials for DevOps Change Velocity","GitHub","Integrate","DevOps Change Velocity","IT Service Management"],"tags":["#it-service-management","#devops","#change-velocity","#itsm","#ci-cd","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[191,193],[199,201],[207,209]],"key":"ServiceNowOfficialDocs/it-service-management/devops-change-velocity/dev-ops-github-apps-oath-jwt.md"},
