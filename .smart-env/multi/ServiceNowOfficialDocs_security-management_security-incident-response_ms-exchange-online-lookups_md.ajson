hubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/ms-azure-account.md","line":58},{"title":"Install Microsoft Exchange Online application","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/install-and-configure-ms-exchange-online.md","line":60},{"title":"Configure the Microsoft Exchange Online integration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/msx_configure.md","line":62},{"title":"Define email search criteria and request a search","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/verify-expected-results-ms-exchange-online.md","line":64},{"title":"Request delete approval for emails on Microsoft Exchange online service","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/ms-delete-email.md","line":66},{"title":"Approve delete email requests for the Microsoft Exchange Online integration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/ms-approve-delete.md","line":68},{"title":"Recover deleted emails on the Microsoft Exchange Online service","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/ms-recover-deleted-emails.md","line":70},{"title":"Edit security tags for the Microsoft Exchange Online integration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/ms-edit-tags.md","line":72},{"title":"Security Incident Response integrations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/austra