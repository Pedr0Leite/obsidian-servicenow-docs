r-service-delivery-advanced-integration-with-workday","line":54},{"title":"HR Service Delivery release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/hr-service-delivery-landing.md","line":59},{"title":"Employee Service Management","target":"https://mynow.servicenow.com/now/best-practices/collections/employee-service-management-best-practices","line":60},{"title":"ServiceNow University","target":"https://learning.servicenow.com/lxp/en/pages/servicenow","line":61},{"title":"Customer Success Center","target":"https://www.servicenow.com/success.html","line":62},{"title":"Now Community","target":"https://www.servicenow.com/community/","line":63},{"title":"Learning","target":"exploring-learning-exp","line":67},{"title":"Manage Learning","target":"manage-learning-achievements","line":68},{"title":"Components installed with Learning Core","target":"learning-core-components-installed","line":69},{"title":"Reference","target":"reference-hr-service-delivery-advanced-integration-with-workday","line":70}],"metadata":{"title":"Learning Core","description":"The ServiceNow Learning Core application enables you to build a learning content repository by integrating with third-party Learning Management Systems, such as Cornerstone OnDemand, Udemy, PluralSight, Sumtotal and Saba learning systems. It allows you to configure learning catalogs that contain course items from both external learning systems and internal learning systems.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/learning-core/learning-core\\_overview.html","release":"australia","product":"Learning Core","classification":"learning-core","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["HR Service Delivery","Employee Service Management"],"tags":["#employee-service-management","#learning","#lms","#courses","#training","#type-concept"]},"task_lines":[],"tasks":{},"codeblo