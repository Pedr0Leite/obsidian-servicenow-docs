xample business rule scripts":[528,798],"#Classic Business rules#Example business rule scripts#{1}":[530,533],"#Classic Business rules#Example business rule scripts#Compare date fields in a business rule":[534,617],"#Classic Business rules#Example business rule scripts#Compare date fields in a business rule#{1}":[536,554],"#Classic Business rules#Example business rule scripts#Compare date fields in a business rule#{2}":[555,555],"#Classic Business rules#Example business rule scripts#Compare date fields in a business rule#{3}":[556,556],"#Classic Business rules#Example business rule scripts#Compare date fields in a business rule#{4}":[557,557],"#Classic Business rules#Example business rule scripts#Compare date fields in a business rule#{5}":[558,558],"#Classic Business rules#Example business rule scripts#Compare date fields in a business rule#{6}":[559,560],"#Classic Business rules#Example business rule scripts#Compare date fields in a business rule#{7}":[561,617],"#Classic Business rules#Example business rule scripts#Parse XML payloads":[618,637],"#Classic Business rules#Example business rule scripts#Parse XML payloads#{1}":[620,637],"#Classic Business rules#Example business rule scripts#Abort a database action in a before business-rule":[638,647],"#Classic Business rules#Example business rule scripts#Abort a database action in a before business-rule#{1}":[640,647],"#Classic Business rules#Example business rule scripts#Determine the operation that triggered the business rule":[648,660],"#Classic Business rules#Example business rule scripts#Determine the operation that triggered the business rule#{1}":[650,660],"#Classic Business rules#Example business rule scripts#Use an OR condition in a business rule":[661,690],"#Classic Business rules#Example business rule scripts#Use an OR condition in a business rule#{1}":[663,690],"#Classic Business rules#Example business rule scripts#Reference a Glide list from a business rule":[691,742],"#Classic Business rules#Example business rule scripts#Reference a Glide list from a business rule#{1}":[693,696],"#Classic Business rules#Example business rule scripts#Reference a Glide list from a business rule#Examples":[697,742],"#Classic Business rules#Example business rule scripts#Reference a Glide list from a business rule#Examples#{1}":[699,742],"#Classic Business rules#Example business rule scripts#Use indexOf\\(\"searchString\"\\) to find a string in a Glide list":[743,751],"#Classic Business rules#Example business rule scripts#Use indexOf\\(\"searchString\"\\) to find a string in a Glide list#{1}":[745,748],"#Classic Business rules#Example business rule scripts#Use indexOf\\(\"searchString\"\\) to find a string in a Glide list#{2}":[749,749],"#Classic Business rules#Example business rule scripts#Use indexOf\\(\"searchString\"\\) to find a string in a Glide list#{3}":[750,751],"#Classic Business rules#Example business rule scripts#Lock user accounts":[752,776],"#Classic Business rules#Example business rule scripts#Lock user accounts#{1}":[754,776],"#Classic Business rules#Example business rule scripts#Default before-query business rule":[777,798],"#Classic Business rules#Example business rule scripts#Default before-query business rule#{1}":[779,782],"#Classic Business rules#Example business rule scripts#Default before-query business rule#{2}":[783,783],"#Classic Business rules#Example business rule scripts#Default before-query business rule#{3}":[784,784],"#Classic Business rules#Example business rule scripts#Default before-query business rule#{4}":[785,785],"#Classic Business rules#Example business rule scripts#Default before-query business rule#{5}":[786,798],"#Classic Business rules#Example business rule scripts#Default before-query business rule#{6}":[788,798],"#Classic Business rules#Related":[799,803],"#Classic Business rules#Related#{1}":[801,801],"#Classic Business rules#Related#{2}":[802,803]},"outlinks":[{"title":"Workflow Studio","target":"workflow-studio","line":27},{"title":"System Events","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/system-events/events.md","line":76},{"title":"Relationship between Business Rules and Access Control Rules \\(ACLs\\)","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB0656366","line":90},{"title":"triggers","target":"process-automation-designer-triggers","line":123},{"title":"Developer Community Forum","target":"https://community.servicenow.com/community?id=community_forum&sys_id=75291a2ddbd897c068c1fb651f9619f3","line":177},{"title":"Example business rule scripts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/business-rules-classic/c_BusinessRules.md","line":383},{"title":"Developer Community Forum","target":"https://community.servicenow.com/community?id=community_forum&sys_id=75291a2ddbd897c068c1fb651f9619f3","line":532},{"title":"w3schools","target":"http://www.w3schools.com/xml/xpath_intro.asp","line":636},{"title":"Workflow Studio","target":"workflow-studio","line":801},{"title":"Triggers","target":"process-automation-designer-triggers","line":802}],"metadata":{"title":"Classic Business rules","description":"A business rule is a server-side script that runs when a record is displayed, inserted, updated, or deleted, or when a table is queried.To configure business rules, you first need to determine when the business rule should run and what action it should take.Every business rule is assigned to either a private application scope or to the global scope.You can create any type of business rule to run when a record is displayed, inserted, updated, or deleted, or when a table is queried.Predefined global variables are available for use in business rules.Implement both business rules and client scripts for a field to enable users to set record values properly using both forms and lists, and to see immediate changes to the values in forms as edits are made.The string NULL has a particular role in scripts and is a reserved word.Display rules are processed when a user requests a record form.This business rule determines whether the active field value needs to change based on changes to the State field.Find an example business rule script that helps you with a requirement of your organization.It is possible to compare two date fields or two date and time fields in a business rule, and abort a record insert or update if they are not correct.Fields in XML format can be parsed with the system's getXMLText function.In a before business rule script, you can cancel or abort the current database action using the setAbortAction\\(\\) method.You can write a script for a business rule that is triggered on more than one database action.An OR condition can be added to any query part within a business rule.A field defined as a glide list is an array of values stored in a single field.Use indexOf\\(\"searchString\"\\) to return the location of the string passed into the method if the glide list field, such as a Watch list, has at least one value in it.You can lock user accounts if the user is not active.You can use a query business rule that executes before a database query is made.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/business-rules-classic/c\\_BusinessRules.html","release":"australia","product":"Business rules \\(Classic\\)","classification":"business-rules-classic","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":28,"breadcrumb":["Build workflows"],"tags":["#build-workflows","#business-rules","#automation","#triggers","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[422,425],[435,443],[447,456],[494,504],[508,513],[540,549],[563,616],[624,626],[632,634],[654,659],[667,675],[679,689],[703,711],[715,720],[724,732],[736,741],[758,775],[788,793]],"key":"ServiceNowOfficialDocs/build-workflows/business-rules-classic/c_BusinessRules.md"},
