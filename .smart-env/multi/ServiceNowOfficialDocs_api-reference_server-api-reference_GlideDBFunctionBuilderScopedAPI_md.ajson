ionBuilder - datediff\\(\\)#{1}":[346,365],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)":[366,831],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{1}":[368,394],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{2}":[395,395],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{3}":[396,396],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{4}":[397,397],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{5}":[398,398],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{6}":[399,399],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{7}":[400,401],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{8}":[402,404],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{9}":[405,405],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{10}":[406,406],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{11}":[407,407],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{12}":[408,408],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{13}":[409,409],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{14}":[410,411],"#GlideDBFunctionBuilder - Scoped, Global#Scoped GlideDBFunctionBuilder - dayofweek\\(\\)#{15}":[412,831]},"outlinks":[{"title":"Function field","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/platform-support-functions.md","line":56},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":58},{"title":"update","target":"r_Update","line":657},{"title":"update","target":"r_Update","line":830}],"metadata":{"title":"GlideDBFunctionBuilder - Scoped, Global","description":"The GlideDBFunctionBuilder API provides methods to build functions to perform SQL operations in the database.Instantiates a GlideDBFunctionBuilder object.Begins a new AND expression, which returns true only if all expressions provided to it as parameters are true. At least one boolean-valued expression must be provided as a parameter.Adds the values of two or more integer fields.Builds the database function defined by the GlideDBFunctionBuilder object.Takes any number of comma-separated fields as input and returns the first non-empty value.Begins a new COMPARE expression which performs a comparison between two expressions.Concatenates the values of two or more fields.Defines a constant value to use in the function. If used with the dayofweek\\(\\) method, the string defines whether to use Sunday or Monday as the first day of the week.Determines the duration using a given start date/time and end date/time.Returns an integer representing the day of the week for a given date.Divides the value of one integer field by another.Defines a field on which a SQL operation is performed.Determines the number of code units in a field.Multiplies the values of two integer fields.Begins a new OR expression which returns true if at least one of the expressions provided to it as a parameter is true.Returns the first occurrence of a specified string within a column of a table.Returns a substring from a specified column of a table starting at a specified location.Subtracts the value of one integer field from another.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/GlideDBFunctionBuilderScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":13,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[37,54],[68,71],[87,95],[99,101],[117,123],[137,144],[148,150],[166,173],[177,183],[248,255],[259,261],[277,283],[325,342],[358,364],[428,444],[450,464],[470,486],[492,508],[514,532],[540,544],[546,628],[645,649],[681,750],[768,772],[804,820]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GlideDBFunctionBuilderScopedAPI.md"},
