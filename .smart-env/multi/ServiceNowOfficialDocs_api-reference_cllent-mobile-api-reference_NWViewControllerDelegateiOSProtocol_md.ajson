tedUrl: URL\\)":[70,94],"#NowWebViewControllerDelegate protocol- iOS#NowWebViewControllerDelegate - nowWebViewController\\(\\_ nowWebViewController: NowWebViewController, didReceive unsupportedUrl: URL\\)#{1}":[72,94],"#NowWebViewControllerDelegate protocol- iOS#NowWebViewControllerDelegate - nowWebViewControllerDidRequestDismissal\\(\\_ nowWebViewController: NowWebViewController\\)":[95,114],"#NowWebViewControllerDelegate protocol- iOS#NowWebViewControllerDelegate - nowWebViewControllerDidRequestDismissal\\(\\_ nowWebViewController: NowWebViewController\\)#{1}":[97,114],"#NowWebViewControllerDelegate protocol- iOS#NowWebViewControllerDelegate - nowWebViewController\\(\\_ nowWebViewController: NowWebViewController, systemThemeDidChange traitCollection: UITraitCollection\\)":[115,141],"#NowWebViewControllerDelegate protocol- iOS#NowWebViewControllerDelegate - nowWebViewController\\(\\_ nowWebViewController: NowWebViewController, systemThemeDidChange traitCollection: UITraitCollection\\)#{1}":[117,141]},"outlinks":[{"title":"Mobile SDK - iOS","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/cllent-mobile-api-reference/MobileSDKiOSAPI.md","line":26},{"title":"NowWebViewController","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/cllent-mobile-api-reference/NWebViewControlleriOSAPI.md","line":34},{"title":"NowWebViewController","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/cllent-mobile-api-reference/NWebViewControlleriOSAPI.md","line":55},{"title":"NowWebViewController","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/cllent-mobile-api-reference/NWebViewControlleriOSAPI.md","line":80},{"title":"NowWebViewController","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/cllent-mobile-api-reference/NWebViewControlleriOSAPI.md","line":101},{"title":"NowWebViewController","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/cllent-mobile-api-reference/NWebViewControlleriOSAPI.md","line":121},{"title":"UITraitCollection","target":"https://developer.apple.com/documentation/uikit/uitraitcollection","line":122}],"metadata":{"title":"NowWebViewControllerDelegate protocol - iOS","description":"The NowWebViewControllerDelegate protocol provides callbacks for notification of issues within the NowWebViewController processing such as when a flow ends or a navigation fails.Callback that notifies the host application that the specified Cabrillo \\(mobile web\\) flow has ended.Callback that notifies the host application that the web view navigation has failed.Callback that notifies the host application that the web view attempted to load an unsupported URL.Callback that notifies the host application that during a back navigation attempt, the stack was exhausted. The host application can then decide whether to dismiss the NowWebViewController instance.Callback that notifies the host application that the system web UI theme changed.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/cllent-mobile-api-reference/NWViewControllerDelegateiOSProtocol.html","release":"australia","product":"Cllent Mobile API Reference","classification":"cllent-mobile-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Mobile SDK - iOS","Mobile SDK API reference","API reference","API implementation and reference"],"tags":["#api-reference","#client-scripts","#mobile","#glideform","#glideuser","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[43,47],[64,68],[89,93],[109,113],[130,139]],"key":"ServiceNowOfficialDocs/api-reference/cllent-mobile-api-reference/NWViewControllerDelegateiOSProtocol.md"},
