SoftwareAssetMgmt","line":24},{"title":"SmartRecruiters","target":"https://www.smartrecruiters.com/","line":44},{"title":"ServiceNow Store","target":"https://store.servicenow.com/","line":73},{"title":"SaaS License Management","target":"sam-subscription-management","line":73},{"title":"Request SaaS License Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/request-saas-license-management.md","line":77},{"title":"Application Manager","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/application-manager.md","line":77},{"title":"using Software Asset Workspace","target":"using-sam-workspace","line":81},{"title":"Software Asset Workspace","target":"sam-workspace","line":108},{"title":"Minimal user permissions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/integrate-with-smartrecruiters.md","line":158},{"title":"Review a software reclamation rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/add-reclamation-rule-sub.md","line":172},{"title":"software reclamation rules","target":"sw-reclamation-rules","line":172},{"title":"Generate a SmartRecruiters API key","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/integrate-with-smartrecruiters.md","line":228},{"title":"software models","target":"c_CreatingSoftwareModels","line":251},{"title":"Subscription exclusions for SaaS and SSO applications","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/subscription-exclusions.md","line":263},{"title":"Create a child alias to set up multiple integration profiles","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/create-child-alias-saas.md","line":265},{"title":"Review a software reclamation rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/add-reclamation-rule-sub.md","line":267},{"title":"Create entitlements in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/track-software-rights.md","line":271},{"title":"Create entitlements in workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/create-entitlements-workspace.md","line":272},{"title":"Create entitlements using the guided walk-through","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/guidedwalk-workspace.md","line":273},{"title":"License Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-license-workbench.md","line":275},{"title":"License usage view","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-workspace-workbench.md","line":275},{"title":"Run software reconciliation in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/t_RunReconciliation.md","line":277},{"title":"Run software reconciliation in the workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/run-recon-workspace.md","line":278},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":282},{"title":"SaaS License Management","target":"sam-subscription-management","line":283},{"title":"Using Software Asset Workspace","target":"using-sam-workspace","line":284},{"title":"Software Asset Workspace","target":"sam-workspace","line":285},{"title":"Software reclamation rules","target":"sw-reclamation-rules","line":286},{"title":"Software models","target":"c_CreatingSoftwareModels","line":287}],"metadata":{"title":"Integrating with SmartRecruiters","description":"Integrating your Software Asset Management application with the SmartRecruiters application enables you to track your software subscriptions and deactivate stale users. The reclamation flow deactivates only the users’ access. The reclamation flow does not affect the subscription cost because SmartRecruiters is not priced based on the number of users.Generate an API key for authenticating SmartRecruiters API requests.Create a SmartRecruiters integration profile to track software subscriptions and usage. Identify users that no longer require access to SmartRecruiters and deactivate their access.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/saas-license-management/integrate-with-smartrecruiters.html","release":"australia","product":"SaaS License Management","classification":"saas-license-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Integrate with SaaS applications","SaaS License Management","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#saas","#license-management","#discovery","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/saas-license-management/integrate-with-smartrecruiters.md"},
