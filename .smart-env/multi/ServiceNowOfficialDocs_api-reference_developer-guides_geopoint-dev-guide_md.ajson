de#Calculate the distance between two geopoints":[114,158],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{1}":[116,119],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{2}":[120,120],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{3}":[121,121],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{4}":[122,123],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{5}":[124,125],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{6}":[126,126],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{7}":[127,127],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{8}":[128,129],"#GlideGeoPoint Developer Guide#Calculate the distance between two geopoints#{9}":[130,158],"#GlideGeoPoint Developer Guide#Filter the distance between two geopoints":[159,212],"#GlideGeoPoint Developer Guide#Filter the distance between two geopoints#{1}":[161,164],"#GlideGeoPoint Developer Guide#Filter the distance between two geopoints#{2}":[165,165],"#GlideGeoPoint Developer Guide#Filter the distance between two geopoints#{3}":[166,166],"#GlideGeoPoint Developer Guide#Filter the distance between two geopoints#{4}":[167,168],"#GlideGeoPoint Developer Guide#Filter the distance between two geopoints#{5}":[169,212],"#GlideGeoPoint Developer Guide#Related":[213,216],"#GlideGeoPoint Developer Guide#Related#{1}":[215,216]},"outlinks":[{"title":"Geo point field type","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/geo-point-field-type.md","line":26},{"title":"Function field","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/platform-support-functions.md","line":36},{"title":"insert","target":"r_Insert","line":42},{"title":"GlideGeoPoint - Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/GlideGeopointGlobalAPI.md","line":44},{"title":"GlideGeoPoint - getDisplayValue\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/GlideGeopointGlobalAPI.md","line":85},{"title":"insert","target":"r_Insert","line":215}],"metadata":{"title":"GlideGeoPoint Developer Guide","description":"The GlideGeoPoint developer guide contains information about how to compute distances between latitude and longitude values \\(geopoints\\), return locations within given geopoint and radius values, and use additional functionality provided by supported GlideGeoPoint API functions.Use the GlideGeoPoint API to insert new records and create new geopoints.Use the getDisplayValue\\(\\) GlideGeoPoint API function to read all geopoint values from a specific table.Use the distance\\_sphere glide function to return the distance between geopoints in meters.Use the DISTANCE\\_SPHERE\\_WITHIN query condition to filter for records having a geopoint value within the radius of a defined latitude, longitude point. ","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/developer-guides/geopoint-dev-guide.html","release":"australia","product":"Developer Guides","classification":"developer-guides","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Developer guides","API implementation and reference"],"tags":["#api-reference","#developer","#guides","#patterns","#best-practices","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[52,62],[68,78],[89,97],[101,112],[132,143],[147,157],[175,183],[187,191],[195,203],[207,211]],"key":"ServiceNowOfficialDocs/api-reference/developer-guides/geopoint-dev-guide.md"},
