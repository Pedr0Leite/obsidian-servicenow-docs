0],"#MID Server ECC Queue#ECC queue security considerations#OS command injection via WMI Runner source parameter#{3}":[261,261],"#MID Server ECC Queue#ECC queue security considerations#OS command injection via WMI Runner source parameter#{4}":[262,263],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy":[264,280],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy#{1}":[266,267],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy#{2}":[268,268],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy#{3}":[269,270],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy#{4}":[271,274],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy#{5}":[275,275],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy#{6}":[276,276],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy#{7}":[277,278],"#MID Server ECC Queue#ECC queue security considerations#ECC firewall security control bypass via default accept policy#{8}":[279,280],"#MID Server ECC Queue#Related":[281,286],"#MID Server ECC Queue#Related#{1}":[283,283],"#MID Server ECC Queue#Related#{2}":[284,284],"#MID Server ECC Queue#Related#{3}":[285,286]},"outlinks":[{"title":"MID Server","target":"mid-server-landing","line":25},{"title":"Links to each of the MID Server sections","target":"../image/MIDRefIconBar.png","line":29,"embedded":true},{"title":"MID Server parameters","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/mid-server-parameters.md","line":42},{"title":"Horizontal Pattern probe","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/r-HorizontalPatternProbe.md","line":77},{"title":"Horizontal Pattern probe","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/r-HorizontalPatternProbe.md","line":77},{"title":"IP address","target":"ip-address","line":93},{"title":"reference","target":"reference","line":101},{"title":"Operating system security","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/operating-system-security.md","line":241},{"title":"Virtual infrastructure security","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/virtual-infrastructure-security.md","line":241},{"title":"MID Server","target":"mid-server-landing","line":283},{"title":"IP Address","target":"ip-address","line":284},{"title":"Reference","target":"reference","line":285}],"metadata":{"title":"MID Server ECC Queue","description":"The External Communication Channel \\(ECC\\) Queue is a connection point between an instance and the MID Server. Jobs that the MID Server needs to perform are saved in this queue until the MID Server is ready to handle them.The ECC Queue allows you to create ECC Queue messages, access MID Server log entries, and retrieve statistics from an individual MID Server record.The ECC queue is a connection point between an instance and the MID Server. Because the ECC queue processes commands and scripts in managed environments, it is essential to understand the security boundaries and shared responsibilities for secure deployment.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/mid-server/ecc-queue-mid-server.html","release":"australia","product":"MID Server","classification":"mid-server","topic_type":"concept","last_update