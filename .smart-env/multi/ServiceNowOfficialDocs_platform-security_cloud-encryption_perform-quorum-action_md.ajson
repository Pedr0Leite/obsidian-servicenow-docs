
"smart_sources:ServiceNowOfficialDocs/platform-security/cloud-encryption/perform-quorum-action.md": {"path":"ServiceNowOfficialDocs/platform-security/cloud-encryption/perform-quorum-action.md","last_embed":{"hash":null},"embeddings":{},"last_read":{"hash":"fh63wt","at":1784561345924},"class_name":"SmartSource","last_import":{"mtime":1782933197815,"size":1834,"at":1784561345924,"hash":"fh63wt"},"blocks":{"#---frontmatter---":[1,19],"#Approve or deny a quorum request":[21,37],"#Approve or deny a quorum request#{1}":[23,24],"#Approve or deny a quorum request#Before you begin":[25,30],"#Approve or deny a quorum request#Before you begin#{1}":[27,30],"#Approve or deny a quorum request#Related":[31,37],"#Approve or deny a quorum request#Related#{1}":[33,33],"#Approve or deny a quorum request#Related#{2}":[34,34],"#Approve or deny a quorum request#Related#{3}":[35,35],"#Approve or deny a quorum request#Related#{4}":[36,37]},"outlinks":[{"title":"request","target":"c_requestAPI","line":23},{"title":"email","target":"email","line":23},{"title":"Key Management Operations","target":"key-mgmt-operations-ce","line":23},{"title":"users","target":"users","line":23},{"title":"Manage Quorum Control","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/cloud-encryption/quorum-ctrl-mgmt.md","line":29},{"title":"request","target":"c_requestAPI","line":33},{"title":"Users","target":"users","line":34},{"title":"Key management operations","target":"key-mgmt-operations-ce","line":35},{"title":"Email","target":"email","line":36}],"metadata":{"title":"Approve or deny a quorum request","description":"When a quorum request has been created, the minimum number of approvals is required by the members. After a withdrawal operation workflow is triggered, quorum actions can be managed using several methods. The users can grant approvals from the Key Management Operations page, My Approvals in the Instance, or directly from the request email. The key withdrawal operation is blocked until the quorum is met.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/cloud-encryption/perform-quorum-action.html","release":"australia","product":"Cloud Encryption","classification":"cloud-encryption","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Manage Quorum Control","Quorum Control Policy","Cloud Encryption with Key Management","Encryption"],"tags":["#platform-security","#cloud-encryption","#kms","#keys","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/platform-security/cloud-encryption/perform-quorum-action.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"ecjb48","at":1784561345924},"key":"ServiceNowOfficialDocs/platform-security/cloud-encryption/perform-quorum-action.md#---frontmatter---","lines":[1,19],"size":927,"outlinks":[],"class_name":"SmartBlock"},
