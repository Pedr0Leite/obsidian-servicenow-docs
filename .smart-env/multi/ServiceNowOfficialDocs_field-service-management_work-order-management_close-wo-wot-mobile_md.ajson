k order task#Before you begin#{1}":[408,409],"#Closing tasks on Mobile Agent#Edit or delete an incidental expense for a work order task#Procedure":[410,428],"#Closing tasks on Mobile Agent#Edit or delete an incidental expense for a work order task#Procedure#{1}":[412,413],"#Closing tasks on Mobile Agent#Edit or delete an incidental expense for a work order task#Procedure#{2}":[414,422],"#Closing tasks on Mobile Agent#Edit or delete an incidental expense for a work order task#Procedure#{3}":[423,424],"#Closing tasks on Mobile Agent#Edit or delete an incidental expense for a work order task#Procedure#{4}":[425,426],"#Closing tasks on Mobile Agent#Edit or delete an incidental expense for a work order task#Procedure#{5}":[427,428],"#Closing tasks on Mobile Agent#Related":[429,436],"#Closing tasks on Mobile Agent#Related#{1}":[431,431],"#Closing tasks on Mobile Agent#Related#{2}":[432,432],"#Closing tasks on Mobile Agent#Related#{3}":[433,433],"#Closing tasks on Mobile Agent#Related#{4}":[434,434],"#Closing tasks on Mobile Agent#Related#{5}":[435,436]},"outlinks":[{"title":"Close a work order task as complete","target":"t_CloseAWorkOrderTaskAsComplete","line":28},{"title":"Close a work order task as incomplete","target":"t_CloseAWorkOrderTaskAsIncomplete","line":71},{"title":"Enable PDF summaries at work order task level","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/enable-pdf-summary.md","line":95},{"title":"Closing work orders","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/c_CloseAWorkOrder.md","line":105},{"title":"System properties","target":"r_InstalledWithFSM","line":107},{"title":"Activate Field Service Quality Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/activate-quality-mgmt.md","line":115},{"title":"Review a task","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/review-send-task-back.md","line":121},{"title":"Signed PDF summaries for closed work orders","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/field-service-management/work-order-management/work-order-sign-and-confirm-pdf.md","line":166},{"title":"Cancel a work order","target":"t_CancelAWorkOrder","line":256},{"title":"execute work order tasks","target":"c_ExecuteWorkOrderTasks","line":369},{"title":"Components installed with Field Service Management","target":"r_InstalledWithFSM","line":431},{"title":"Close a work order task as complete","target":"t_CloseAWorkOrderTaskAsComplete","line":432},{"title":"Close a work order task as incomplete","target":"t_CloseAWorkOrderTaskAsIncomplete","line":433},{"title":"Cancel a work order","target":"t_CancelAWorkOrder","line":434},{"title":"Execute work order tasks","target":"c_ExecuteWorkOrderTasks","line":435}],"metadata":{"title":"Closing tasks on Mobile Agent","description":"A work order is automatically closed when all work order tasks associated with it have been closed.Close a work order task as complete or as incomplete with optionally a follow-on task to complete.Respond to a task that was sent back to you for review. Update the work order task with the requested details and submit the task back to reviewer.Receive a digital signature and confirmation from a customer that a work order has been completed.Enable customers to digitally sign and confirm a work order on the Mobile Agent application after it has been closed.Cancel a work order if it is no longer needed or suspend a work order if you want to work on it later.Record a break from a work order task on Mobile Agent if you are unable to continue the work for any reason. You can resume the work order task when you start working on it again. The system automatically tracks and calculates the actual time taken to complete the task even though you worked at different intervals.Record the duration for executing a task using the Mobile Agent application.Record incidental expenses associated with your business travel through the Mobile Agent application to execute work order tasks.Edit or delete your logged incidentals from WOT forms or from My Incidentals applets.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/field-service-management/work-order-management/close-wo-wot-mobile.html","release":"australia","product":"Work Order Management","classification":"work-order-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":12,"breadcrumb":["ServiceNow Agent mobile app","Completing work on mobile","Use","Field Service Management"],"tags":["#field-service-management","#work-orders","#fsm","#tasks","#management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/field-service-management/work-order-management/close-wo-wot-mobile.md"},
