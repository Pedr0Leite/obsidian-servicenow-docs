"target":"r-discovery","line":18},{"title":"MID Server properties used by Service Mapping","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/service-mapping/mid-server-properties-service-mapping.md","line":32},{"title":"Install and configure MID Servers to access cloud environments","target":"mid-server-configuration-cloud","line":79},{"title":"Install a MID Server on Windows","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server-install-prereqs.md","line":84},{"title":"Install a MID Server on Linux","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/t_InstallAMIDServerOnLinux.md","line":86},{"title":"MID Server parameters","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server-parameters.md","line":88},{"title":"Install and configure MID Servers to access cloud environments","target":"mid-server-configuration-cloud","line":92},{"title":"Cloud Provisioning and Governance","target":"cloud-management-v2-landing-page","line":93},{"title":"Discovery","target":"r-discovery","line":94}],"metadata":{"title":"Proxy server configuration for MID Servers used for Cloud Discovery and Cloud Provisioning and Governance","description":"You can configure the MID Server for Cloud Provisioning and Governance to use a proxy server. Using a proxy server supports all cloud-based activities such as running Discovery, billing downloads, provisioning virtual machines, and running life-cycle operations on virtual machines.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/mid-server-proxy.html","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Install and configure MID Servers to access cloud environments","Access to cloud environments