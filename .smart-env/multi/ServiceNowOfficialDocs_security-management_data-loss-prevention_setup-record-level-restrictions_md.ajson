[{"title":"DLP Incident Access Restrictions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/data-loss-prevention/dlp-incident-access-restrictions.md","line":112}],"metadata":{"title":"Create record level restrictions","description":"Set record level restrictions in DLP incidents to protect sensitive records from being exposed. You can use record level restrictions to control the users or groups who can access specific records in the DLP incidents.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/data-loss-prevention/setup-record-level-restrictions.html","release":"australia","product":"Data Loss Prevention","classification":"data-loss-prevention","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["DLP Incident Access Restrictions","Administer","Data Loss Prevention Incident Response","Security Operations"],"tags":["#security-management","#dlp","#data-loss","#incidents","#policy","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/data-loss-prevention/setup-record-level-restrictions.md"},
