rvices#Service Model Foundation":[51,58],"#Data management for Public Sector Digital Services#Service Model Foundation#{1}":[53,58],"#Data management for Public Sector Digital Services#Internal user data":[59,62],"#Data management for Public Sector Digital Services#Internal user data#{1}":[61,62],"#Data management for Public Sector Digital Services#Business stakeholders for Public Sector Digital Services":[63,68],"#Data management for Public Sector Digital Services#Business stakeholders for Public Sector Digital Services#{1}":[65,68],"#Data management for Public Sector Digital Services#Related":[69,75],"#Data management for Public Sector Digital Services#Related#{1}":[71,71],"#Data management for Public Sector Digital Services#Related#{2}":[72,72],"#Data management for Public Sector Digital Services#Related#{3}":[73,73],"#Data management for Public Sector Digital Services#Related#{4}":[74,75]},"outlinks":[{"title":"Customer Data","target":"psds-config-customer-data","line":43},{"title":"Product Data","target":"psds-config-product-data","line":49},{"title":"Service Model Foundation overview","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/customer-service-management/csm-industry-data-model.md","line":55},{"title":"Using the BLSP","target":"psds-using-business-location-service-portal","line":57},{"title":"Business Stakeholder for Public Sector Digital Services","target":"roles-installed-with-public-sector-digital-services","line":67},{"title":"Configuring Public Sector Digital Services customer data","target":"psds-config-customer-data","line":71},{"title":"Configuring product data in Public Sector Digital Services","target":"psds-config-product-data","line":72},{"title":"Using the Business Location Service Portal in Public Sector Digital Services","target":"psds-using-business-location-service-portal","line":73},{"title":"Roles installed with Public Sector Digital Services","target":"roles-installed-with-public-sector-digital-services","line":74}],"metadata":{"title":"Data management for Public Sector Digital Services","description":"Data management refers to the processes and tools used to collect, organize, secure, and use constituent-related data effectively so that government service agent teams can deliver better service experiences. You can give your managers and agents a comprehensive view of constituent data, including constituent details, products and services, assets, service contracts, and entitlements.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/government-industry/psds-explore-data-management.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Explore","Public Sector Digital Services \\(PSDS\\)"],"tags":["#government-industry","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/government-industry/psds-explore-data-management.md"},
