/default-prompt-system-property-lens.md","line":73},{"title":"trigger ServiceNow AI Lens from the desktop app","target":"preview-desktop-others-lens","line":85},{"title":"Auto-map Excel sheet column headers with table columns.","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":97},{"title":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":169},{"title":"Field types supported","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/field-types-supported.md","line":223},{"title":"Now Assist","target":"platform-now-assist-landing","line":313},{"title":"using ServiceNow AI Lens","target":"servicenow-lens-use","line":415},{"title":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":502},{"title":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":513},{"title":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":524},{"title":"Define a Lens action","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md","line":790},{"title":"ServiceNow AI Lens","target":"servicenow-lens-landing-page","line":893},{"title":"Cases","target":"cases","line":894},{"title":"Trigger ServiceNow AI Lens from the desktop app","target":"preview-desktop-others-lens","line":895},{"title":"Now Assist","target":"platform-now-assist-landing","line":896},{"title":"Using ServiceNow AI Lens","target":"servicenow-lens-use","line":897}],"metadata":{"title":"Define ServiceNow AI Lens behavior with Lens actions","description":"As a Lens admin, you can create Lens actions in ServiceNow AI Lens to customize Lens behavior by providing default instructions, configuring context, and more.Create a Lens action to define custom context, trigger options, and default instructions for the ServiceNow AI Lens execution.Enable customers to scan documents related to car accident on their desktop to auto-fill the Insurance Request form on the ServiceNow instance.Enable compliance analysts to digitize and review several vendor agreements. Instead of manually entering details, they can launch ServiceNow AI Lens directly from the desktop, scan agreements, and adjust extracted values in the preview window before saving.Enable service agents to create user records by extracting specific information from identity documents using ServiceNow AI Lens, directly from the ServiceNow instance.Use ServiceNow AI Lens to map the column headers of an Excel sheet that you specify with ServiceNow table columns and then insert the Excel sheet data into the table.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/intelligent-experiences/servicenow-lens/servicenow-lens-actions.html","release":"australia","product":"ServiceNow Lens","classification":"servicenow-lens","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":22,"breadcrumb":["Configure","ServiceNow AI Lens","Enable AI experiences"],"tags":["#intelligent-experiences","#lens","#visualization","#ar","#digital-twin","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[235,257],[266,305],[333,344],[353,359],[377,384],[571,594],[643,690]],"key":"ServiceNowOfficialDocs/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md"},"smart_blocks:ServiceNowOfficialDocs/intelligent-experiences/servicenow-lens/servicenow-lens-actions.md#---frontmatter---": {"path":null,"last_embed":{"hash":"ott6k2","at":1784579604134},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06898374,-0.03981289,0.00866384,-0.04137486,-0.04334304,0.03178854,0.04406951,-0.00899214,0.00278926,-0.01361783,0.03320308,-0.04165298,0.00494162,0.02377828,0.0102495,-0.05452937,-0.01730944,0.03323478,-0.06016433,0.05064533,0.07749712,-0.01124972,-0.02417929,0.01413658,0.02404727,0.06266763,0.03142784,-0.05263785,-0.0045859,-0.16164316,0.04926375,-0.01242649,0.05698577,-0.01067052,0.00443596,-0.06035593,-0.04999688,0.04390445,-0.02745411,0.03121506,0.02249518,-0.01076138,-0.04009467,-0.02662954,-0.03697686,-0.04741298,0.0239684,-0.02679038,-0.01385836,-0.03033717,-0.01532694,-0.06672116,-0.00781584,-0.04117417,-0.01684186,0.02871044,-0.00166349,0.04654239,0.06233636,0.01463657,0.05063377,-0.01759289,-0.17620838,0.10770855,-0.06739027,0.05353285,-0.01182097,-0.03724399,0.06939406,-0.04547293,-0.07760312,0.0303738,-0.00246478,0.04347495,-0.02142517,-0.02136168,-0.00213229,0.02165967,0.01416919,-0.0118626,-0.04251524,-0.02099591,-0.05940449,0.04609622,-0.08484755,-0.02075523,0.00043549,-0.04834736,0.05511251,0.02141823,-0.05028516,-0.02095997,0.00104783,0.04064992,-0.01523504,0.01166798,0.00989287,-0.04042773,-0.12862082,0.1507972,-0.03324338,0.02295115,-0.04147295,0.00013621,0.0332517,-0.03422698,-0.03032838,-0.02437647,-0.07008701,0.03710011,-0.010948,0.04817658,-0.00181649,-0.05065306,0.01067566,