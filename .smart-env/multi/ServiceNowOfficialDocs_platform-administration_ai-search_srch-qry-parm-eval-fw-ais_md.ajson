nce","target":"reference-email-admin","line":170},{"title":"parameters","target":"r_DirectJDBCProbeParameters","line":215},{"title":"configurations","target":"clone-configurations-tab","line":280},{"title":"Q&amp;A Genius Results","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/ai-search/genius-result-q-a-ais.md","line":338},{"title":"Machine learning relevancy in AI Search","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/ai-search/machine-learning-relevancy-ais.md","line":338},{"title":"Search Profile form","target":"search-profile-form-ais","line":346},{"title":"Configuring the form layout","target":"configure-form-layout","line":348},{"title":"Configuring the form layout","target":"configure-form-layout","line":361},{"title":"AI Search","target":"ia-ai-search","line":362},{"title":"Q&amp;A Genius Results","target":"genius-result-q-a-ais","line":363},{"title":"Results","target":"hs-results","line":364},{"title":"Metrics","target":"c_MetricDefinitionSupport","line":365},{"title":"Search signals","target":"search-signals","line":366},{"title":"Reference","target":"reference-email-admin","line":367},{"title":"Parameters","target":"r_DirectJDBCProbeParameters","line":368},{"title":"Configurations","target":"clone-configurations-tab","line":369},{"title":"Search Profile form","target":"search-profile-form-ais","line":370}],"metadata":{"title":"Search query parameter evaluation framework","description":"AI Search performs A/B test evaluations that compare result relevancy for alternate sets of search query parameter values. These evaluations determine the models that AI Search uses for machine learning relevancy and for Q&amp;A Genius Results.The search query parameter evaluation framework for AI Search uses tables to store results and metrics from A/B testing of live search traffic. AI Search uses the stored data when determining which relevancy model and Q&amp;A Genius Result answer validation model to publish for a search application.Exclude a search profile from A/B testing evaluations of live AI Search traffic. This procedure prevents AI Search from using A/B testing evaluation results when publishing the search profile's search result relevancy model and its Q&amp;A Genius Result answer validation model.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/ai-search/srch-qry-parm-eval-fw-ais.html","release":"australia","product":"AI Search","classification":"ai-search","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Administer","AI Search","Search administration","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#ai-search","#indexing","#relevancy","#search","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/ai-search/srch-qry-parm-eval-fw-ais.md"},
