ance.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/legacy-workflow/c\\_AvoidingDuplicateWorkflows.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Input variable movement","Workflow administration","Classic Workflow","Build workflows"],"tags":["#build-workflows","#legacy-workflow","#classic","#deprecated","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/build-workflows/legacy-workflow/c_AvoidingDuplicateWorkflows.md"},
