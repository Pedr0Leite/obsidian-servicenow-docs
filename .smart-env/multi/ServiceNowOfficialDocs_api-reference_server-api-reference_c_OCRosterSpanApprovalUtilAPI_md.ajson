erty com.snc.on\\_call\\_rotation.pto.approval.required is true.Changes the type of the roster\\_schedule\\_span to rejected from approval.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_OCRosterSpanApprovalUtilAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[78,155],[159,161]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_OCRosterSpanApprovalUtilAPI.md"},
