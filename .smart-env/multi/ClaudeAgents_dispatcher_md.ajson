g Logic#Step 4 — Multi-skill requests#{3}":[104,104],"#Dispatcher Agent#Routing Logic#Step 4 — Multi-skill requests#{4}":[105,105],"#Dispatcher Agent#Routing Logic#Step 4 — Multi-skill requests#{5}":[106,106],"#Dispatcher Agent#Routing Logic#Step 4 — Multi-skill requests#{6}":[107,108],"#Dispatcher Agent#Routing Logic#Step 4 — Multi-skill requests#{7}":[109,110],"#Dispatcher Agent#ServiceNow Scoped App Rules":[111,123],"#Dispatcher Agent#ServiceNow Scoped App Rules#{1}":[113,114],"#Dispatcher Agent#ServiceNow Scoped App Rules#{2}":[115,115],"#Dispatcher Agent#ServiceNow Scoped App Rules#{3}":[116,116],"#Dispatcher Agent#ServiceNow Scoped App Rules#{4}":[117,117],"#Dispatcher Agent#ServiceNow Scoped App Rules#{5}":[118,118],"#Dispatcher Agent#ServiceNow Scoped App Rules#{6}":[119,119],"#Dispatcher Agent#ServiceNow Scoped App Rules#{7}":[120,121],"#Dispatcher Agent#ServiceNow Scoped App Rules#{8}":[122,123],"#Dispatcher Agent#General Coding Fallback":[124,133],"#Dispatcher Agent#General Coding Fallback#{1}":[126,127],"#Dispatcher Agent#General Coding Fallback#{2}":[128,128],"#Dispatcher Agent#General Coding Fallback#{3}":[129,129],"#Dispatcher Agent#General Coding Fallback#{4}":[130,131],"#Dispatcher Agent#General Coding Fallback#{5}":[132,133],"#Dispatcher Agent#Response Format":[134,154],"#Dispatcher Agent#Response Format#{1}":[136,154],"#Dispatcher Agent#Decision Rules":[155,164],"#Dispatcher Agent#Decision Rules#{1}":[157,164]},"outlinks":[],"metadata":{"name":"dispatcher","description":"General-purpose ServiceNow + full-stack dev entry point that routes a single task to the right skill from a 185+ skill index (business rules, client scripts, script includes, ACLs, catalog items, flows, GenAI/Now Assist, CMDB, ATF tests, Fluent SDK/now-sdk, and general JS/TS/Python/React) and executes it directly. Use for scoped, single-shot tasks that don't need a full pipeline — 'fix this business rule', 'write a script include for X', 'create a catalog item', 'debug this client script', 'build a Now Assist skill', 'how do I query CMDB relationships', or any general coding question. This is the default agent when no more specific one (orchestrator, ba-agent, architect, governance, developer, tester, bug-hunter) clearly fits.","color":"green"},"task_lines":[],"tasks":{},"codeblock_ranges":[[18,20],[138,143],[146,151]],"key":"ClaudeAgents/dispatcher.md"},
