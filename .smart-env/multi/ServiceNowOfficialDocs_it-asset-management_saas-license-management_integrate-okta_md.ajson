/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/integrate-okta.md","line":271},{"title":"Minimal user permissions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/integrate-okta.md","line":336},{"title":"software models","target":"c_CreatingSoftwareModels","line":351},{"title":"Okta SSO direct integration profile","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/integrate-okta.md","line":357},{"title":"Review a software reclamation rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/add-reclamation-rule-sub.md","line":365},{"title":"Integrate with SaaS applications","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/create-integration-profile.md","line":430},{"title":"Create software models in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/record-terms-software-licenses.md","line":442},{"title":"models","target":"c_Models","line":446},{"title":"Create an SSO group software model mapping","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/create-ssogrp-swmodel-mapping.md","line":448},{"title":"Review a software reclamation rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/add-reclamation-rule-sub.md","line":465},{"title":"reclaiming user subscriptions","target":"reclaiming-user-subscriptions-saas","line":465},{"title":"Subscription exclusions for SaaS and SSO applications","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/saas-license-management/subscription-exclusions.md","line":477},{"title":"Create entitlements in workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/create-entitlements-workspace.md","line":479},{"title":"Create entitlements using the guided walk-through","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/guidedwalk-workspace.md","line":479},{"title":"Create entitlements in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/track-software-rights.md","line":479},{"title":"Run software reconciliation in the workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/run-recon-workspace.md","line":481},{"title":"License Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-license-workbench.md","line":481},{"title":"License usage view","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-workspace-workbench.md","line":481},{"title":"Run software reconciliation in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/t_RunReconciliation.md","line":481},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":485},{"title":"SaaS License Management","target":"sam-subscription-management","line":486},{"title":"Using Software Asset Workspace","target":"using-sam-workspace","line":487},{"title":"Software Asset Workspace","target":"sam-workspace","line":488},{"title":"Software models","target":"c_CreatingSoftwareModels","line":489},{"title":"Models","target":"c_Models","line":490},{"title":"Reclaiming user subscriptions","target":"reclaiming-user-subscriptions-saas","line":491}],"metadata":{"title":"Integrating with Okta","description":"You can integrate your ServiceNow instance with Okta to view software usage for all connected SSO applications.Create an Okta application that you can integrate with the ServiceNow AI Platform.Create an Okta integration profile in your ServiceNow instance.Okta SSO direct integration profile helps you manage Okta user licenses by creating subscriptions for Okta users while setting up an Okta SSO integration.Connect an SSO application to monitor all the users and groups who have access to that application. While SSO integration provides a summary of application usage and activity, direct integration offers detailed insights into these metrics.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/saas-license-management/integrate-okta.html","release":"australia","product":"SaaS License Management","classification":"saas-license-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":14,"breadcrumb":["Integrate with SSO providers","SaaS License Management","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#saas","#license-management","#discovery","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/saas-license-management/integrate-okta.md"},
