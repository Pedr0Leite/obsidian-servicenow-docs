rviceNow AI Platform#Procedure#{3}":[245,251],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder":[252,279],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder#{1}":[254,255],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder#Before you begin":[256,261],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder#Before you begin#{1}":[258,261],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder#Procedure":[262,279],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder#Procedure#{1}":[264,265],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder#Procedure#{2}":[266,267],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder#Procedure#{3}":[268,269],"#Catalog Conversational Coverage#View the conversational catalog overview dashboard using Catalog Builder#Procedure#{4}":[270,279],"#Catalog Conversational Coverage#Related":[280,286],"#Catalog Conversational Coverage#Related#{1}":[282,282],"#Catalog Conversational Coverage#Related#{2}":[283,283],"#Catalog Conversational Coverage#Related#{3}":[284,284],"#Catalog Conversational Coverage#Related#{4}":[285,286]},"outlinks":[{"title":"Now Assist in Conversational Catalog Request","target":"now-assist-in-conversational-catalog-request","line":24},{"title":"Configure Now Assist in Conversational Catalog Request","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/configure-gen-ai-catalog-item.md","line":43},{"title":"View the conversational catalog overview dashboard using Catalog Builder","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown","line":45},{"title":"Catalog builder","target":"catalog-builder","line":187},{"title":"check box","target":"check-box","line":212},{"title":"Service Catalog","target":"service-catalog","line":241},{"title":"Edit a catalog item in Catalog Builder","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/service-catalog/edit-cat-item-cat-builder.md","line":278},{"title":"Now Assist in Conversational Catalog Request","target":"now-assist-in-conversational-catalog-request","line":282},{"title":"Catalog Builder","target":"catalog-builder","line":283},{"title":"Check box","target":"check-box","line":284},{"title":"Service Catalog","target":"service-catalog","line":285}],"metadata":{"title":"Catalog Conversational Coverage","description":"ServiceNow Catalog Conversational Coverage provides a dashboard to view a high-level overview of the conversational and non-conversational catalog items.The dashboard shows the information that you need in graphs and a table.View the details page for your catalog item. If your item is non-conversational, view why your catalog item isn’t conversational and review the suggestions to know what you can do to make the item conversational.Use the ServiceNow AI Platform to view the dashboard that shows the catalog items that are conversational or non-conversational. Understand why catalog items aren't conversational, and explore the potential suggestions that might help make the items conversational.Use Catalog Builder to view the dashboard that shows the catalog items that are conversational or non-conversational. Understand why catalog items aren’t conversational, and explore the potential suggestions that might help make the items conversational.","locale":"en-US","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"tags":["#servicenow-platform","#platform","#architecture","#tables","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/servicenow-platform/using-catalog-conversational-experience.md"},
