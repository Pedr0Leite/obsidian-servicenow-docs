c commands in a defined order.You can create a special configuration for the pbrun privileged command that allows it to run as a profile.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/mid-server/c\\_PrivilegedCommandsForMIDServer.html","release":"australia","product":"MID Server","classification":"mid-server","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["MID Server reference","MID Server","Manage instance data sources","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#mid-server","#on-premise","#proxy","#connectivity","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/servicenow-platform/mid-server/c_PrivilegedCommandsForMIDServer.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"9wptca","at":1784561353175},"key":"ServiceNowOfficialDocs/servicenow-platform/mid-server/c_PrivilegedCommandsForMIDServer.md#---frontmatter---","lines":[1,20],"size":1230,"outlinks":[],"class_name":"SmartBlock"},
