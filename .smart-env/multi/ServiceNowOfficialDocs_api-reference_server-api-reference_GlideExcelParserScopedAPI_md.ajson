xcelParser - getSheetNames\\(\\)#{1}":[281,366],"#GlideExcelParser - Scoped, Global#GlideExcelParser - getTableInfo\\(\\)":[367,419],"#GlideExcelParser - Scoped, Global#GlideExcelParser - getTableInfo\\(\\)#{1}":[369,419],"#GlideExcelParser - Scoped, Global#GlideExcelParser - next\\(\\)":[420,507],"#GlideExcelParser - Scoped, Global#GlideExcelParser - next\\(\\)#{1}":[422,507],"#GlideExcelParser - Scoped, Global#GlideExcelParser - parse\\(InputStream inputStream\\)":[508,639],"#GlideExcelParser - Scoped, Global#GlideExcelParser - parse\\(InputStream inputStream\\)#{1}":[510,552],"#GlideExcelParser - Scoped, Global#GlideExcelParser - parse\\(InputStream inputStream\\)#{2}":[553,553],"#GlideExcelParser - Scoped, Global#GlideExcelParser - parse\\(InputStream inputStream\\)#{3}":[554,555],"#GlideExcelParser - Scoped, Global#GlideExcelParser - parse\\(InputStream inputStream\\)#{4}":[556,639],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setHeaderRowNumber\\(Number headerRowNumber\\)":[640,651],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setHeaderRowNumber\\(Number headerRowNumber\\)#{1}":[642,651],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setNullToEmpty\\(Boolean empty\\)":[652,663],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setNullToEmpty\\(Boolean empty\\)#{1}":[654,663],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setSheetName\\(String sheetName\\)":[664,753],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setSheetName\\(String sheetName\\)#{1}":[666,753],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setSheetNumber\\(Number sheetNumber\\)":[754,801],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setSheetNumber\\(Number sheetNumber\\)#{1}":[756,801],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setSource\\(InputStream inputStream\\)":[802,890],"#GlideExcelParser - Scoped, Global#GlideExcelParser - setSource\\(InputStream inputStream\\)#{1}":[804,890]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28},{"title":"GlideScriptableInputStream","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideScriptableInpStrmScopedAPI.md","line":530},{"title":"setSource\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/GlideExcelParserScopedAPI.md","line":534},{"title":"GlideScriptableInputStream","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideScriptableInpStrmScopedAPI.md","line":808}],"metadata":{"title":"GlideExcelParser - Scoped, Global","description":"The GlideExcelParser API parses .xlsx formatted Excel files and access file data in scripts.Creates an instance of GlideExcelParser.Close the connection to the input stream and release the document.Returns a list of column headers from the parsed document.Returns the error message when the parse\\(\\) method fails.Get the current row values and headers.Gets a list of all worksheet names in an Excel workbook.Gets table column types and max character length from a spreadsheet or CSV attachment.Moves to the next row.Parses an XLSX-formatted Excel document.Set the number of the header row to be retrieved.Return an empty value instead of null when an Excel cell is not present.Set the name of the sheet to be retrieved.Set the number of the Excel sheet to be retrieved.Defines an input source for parsing multiple times or parsing each worksheet in an Excel file.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/GlideExcelParserScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":19,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[40,61],[77,89],[105,149],[153,177],[205,249],[253,277],[293,337],[341,365],[383,397],[401,418],[434,478],[482,506],[559,562],[566,610],[614,638],[680,724],[728,752],[770,792],[796,800],[816,860],[864,888]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GlideExcelParserScopedAPI.md"},
