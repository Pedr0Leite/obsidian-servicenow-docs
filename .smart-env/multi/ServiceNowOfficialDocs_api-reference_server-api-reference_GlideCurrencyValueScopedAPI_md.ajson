now.com/docs/r/api-reference/server-api-reference/GlideCurrencyValueScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[46,52],[56,58],[74,80],[84,86]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GlideCurrencyValueScopedAPI.md"},
