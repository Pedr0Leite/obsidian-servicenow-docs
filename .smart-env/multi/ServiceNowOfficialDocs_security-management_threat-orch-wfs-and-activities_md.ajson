ctivities#Threat Intelligence - Run IoC Lookup workflow#Update observable with lookup result activity#{6}":[115,115],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Update observable with lookup result activity#{7}":[116,117],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Update observable with lookup result activity#{8}":[118,119],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Update observable with lookup result activity#Input variables":[120,127],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Update observable with lookup result activity#Input variables#{1}":[122,127],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Update observable with lookup result activity#Output variables":[128,136],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Update observable with lookup result activity#Output variables#{1}":[130,136],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Run Default IoC Lookup Sources activity":[137,158],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Run Default IoC Lookup Sources activity#{1}":[139,142],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Run Default IoC Lookup Sources activity#Input variables":[143,150],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Run Default IoC Lookup Sources activity#Input variables#{1}":[145,150],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Run Default IoC Lookup Sources activity#Output variables":[151,158],"#Threat Intelligence Orchestration workflows and activities#Threat Intelligence - Run IoC Lookup workflow#Run Default IoC Lookup Sources activity#Output variables#{1}":[153,158],"#Threat Intelligence Orchestration workflows and activities#Related":[159,164],"#Threat Intelligence Orchestration workflows and activities#Related#{1}":[161,161],"#Threat Intelligence Orchestration workflows and activities#Related#{2}":[162,162],"#Threat Intelligence Orchestration workflows and activities#Related#{3}":[163,164]},"outlinks":[{"title":"Threat Intelligence Orchestration","target":"c_ThreatIntelligenceOrchestration","line":20},{"title":"Threat Intelligence","target":"threat-intel-landing-page","line":24},{"title":"indicators","target":"indicator","line":36},{"title":"Populate lookup with observable activity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/threat-orch-wfs-and-activities.md","line":44},{"title":"Perform IoC Lookup activity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/threat-orch-wfs-and-activities.md","line":45},{"title":"Update observable with lookup result activity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/threat-orch-wfs-and-activities.md","line":47},{"title":"Threat Intelligence Orchestration","target":"c_ThreatIntelligenceOrchestration","line":161},{"title":"Threat Intelligence","target":"threat-intel-landing-page","line":162},{"title":"Indicators","target":"indicator","line":163}],"metadata":{"title":"Threat Intelligence Orchestration workflows and activities","description":"The base system includes workflows and workflow activities you can use to automate actions on your instance.The Threat Intelligence - Run IoC Lookup workflow checks whether there is an unexpired observable and if so, the lookup is set to Complete and updated with the data from the observable.If an unexpired observable is found, the Threat Intelligence Orchestration - Populate lookup with observable workflow activity supplies data from an existing observable to a lookup. This activity can accelerate the investigation and remediation process.The Threat Intelligence Orchestration - Perform IoC Lookup workflow activity performs a given lookup. This activity can accelerate the investigation and remediation process.The Threat Intelligence Orchestration - Update observable with lookup result workflow activity updates the observable record. If one does not exist, it creates a new observable. This activity is useful for logging information.When triggered by a workflow, Threat Intelligence - Run Default IoC Lookup Sources takes in a lookup request ID and creates multiple lookups depending on the entered data values.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/threat-orch-wfs-and-activities.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Threat Intelligence Orchestration","Threat Intelligence","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/threat-orch-wfs-and-activities.md"},
