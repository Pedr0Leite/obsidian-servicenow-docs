Uri\\(uri: Uri, context: Context\\)":[149,176],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - loadUri\\(uri: Uri, context: Context\\)#{1}":[151,176],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - onExit\\(exitCode: NowChatExitCode\\)":[177,234],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - onExit\\(exitCode: NowChatExitCode\\)#{1}":[179,206],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - onExit\\(exitCode: NowChatExitCode\\)#{2}":[207,207],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - onExit\\(exitCode: NowChatExitCode\\)#{3}":[208,208],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - onExit\\(exitCode: NowChatExitCode\\)#{4}":[209,209],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - onExit\\(exitCode: NowChatExitCode\\)#{5}":[210,211],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - onExit\\(exitCode: NowChatExitCode\\)#{6}":[212,234],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - provideProgressView\\(context: Context\\)":[235,266],"#NowChatSdkCallbacks interface- Android#NowChatSdkCallbacks - provideProgressView\\(context: Context\\)#{1}":[237,266]},"outlinks":[{"title":"Mobile SDK - Android","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/cllent-mobile-api-reference/MobileSDKAndroidAPI.md","line":99},{"title":"Uri","target":"https://developer.android.com/reference/kotlin/android/net/Uri.html","line":155},{"title":"Context","target":"https://developer.android.com/reference/kotlin/android/content/Context.html","line":156},{"title":"Context","target":"https://developer.android.com/reference/kotlin/android/content/Context.html","line":241},{"title":"View","target":"https://developer.android.com/reference/kotlin/android/view/View.html","line":245}],"metadata":{"title":"NowChatSdkCallbacks interface - Android","description":"The NowChatSdkCallbacks interface provides functions that enable callbacks for host applications to configure or handle actions from the NowChatSDK.Called when the chat screen is closed and the chat session ends.Handles the specified URI, such as opening it in a webview, custom tab, or external browser.Sets the result code to return when NowChat is exited.Returns the view to display when the NowChat UI data is loading; typically a configured indeterminate progress bar.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/cllent-mobile-api-reference/NowChatSdkCallbacksAndroidInt.html","release":"australia","product":"Cllent Mobile API Reference","classification":"cllent-mobile-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Mobile SDK - Android","Mobile SDK API reference","API reference","API implementation and reference"],"tags":["#api-reference","#client-scripts","#mobile","#glideform","#glideuser","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[138,147],[164,175],[219,233],[249,264]],"key":"ServiceNowOfficialDocs/api-reference/cllent-mobile-api-reference/NowChatSdkCallbacksAndroidInt.md"},
