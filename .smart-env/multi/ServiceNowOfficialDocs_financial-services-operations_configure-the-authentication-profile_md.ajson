":"jwt-authentication","line":32},{"title":"Storing credentials for Verifi CDRN","target":"store-credentials-for-verifi-cdrn","line":37},{"title":"Financial Services Operations Integration with Verifi","target":"financial-services-operations-verifi-cdrn-integration-app-landing-page","line":38},{"title":"Configuring Financial Services Operations Integration with Verifi","target":"configure-financial-services-integration-with-verifi-cdrn","line":40},{"title":"JWT Authentication","target":"jwt-authentication","line":44},{"title":"Storing credentials for Verifi CDRN","target":"store-credentials-for-verifi-cdrn","line":45},{"title":"Configuring Financial Services Operations Integration with Verifi","target":"configure-financial-services-integration-with-verifi-cdrn","line":46},{"title":"Financial Services Operations Integration with Verifi","target":"financial-services-operations-verifi-cdrn-integration-app-landing-page","line":47}],"metadata":{"title":"Configure the Authentication Profile","description":"The Verifi Issuer API uses JSON Web Tokens \\(JWT\\) for authentication. A fresh JWT must be generated for every API call. This section explains how to store credentials securely and how the ServiceNow script generates and attaches the JWT.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/financial-services-operations/configure-the-authentication-profile.html","release":"australia","topic_type":"task","last_updated":"2026-04-02","reading_time_minutes":1,"breadcrumb":["Configure","Verifi","Integrate","Financial Services Operations \\(FSO\\)"],"tags":["#financial-services-operations","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/financial-services-operations/configure-the-authentication-profile.md"},
