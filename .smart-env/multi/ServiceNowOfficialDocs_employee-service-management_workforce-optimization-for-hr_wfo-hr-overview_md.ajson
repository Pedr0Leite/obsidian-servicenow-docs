itle":"HR Service Delivery release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/hr-service-delivery-landing.md","line":89},{"title":"Employee Service Management","target":"https://mynow.servicenow.com/now/best-practices/collections/employee-service-management-best-practices","line":90},{"title":"ServiceNow University","target":"https://learning.servicenow.com/lxp/en/pages/servicenow","line":91},{"title":"Customer Success Center","target":"https://www.servicenow.com/success.html","line":92},{"title":"Now Community","target":"https://www.servicenow.com/community/","line":93},{"title":"Using Workforce Optimization for HR","target":"use-wfo-hr","line":97},{"title":"Learning","target":"exploring-learning-exp","line":98},{"title":"Mentoring","target":"mentoring-egd-overview","line":99},{"title":"Reference","target":"reference-hr-service-delivery-advanced-integration-with-workday","line":100}],"metadata":{"title":"Workforce Optimization for HR Overview","description":"Workforce Optimization for HR simplifies the daily routine of HR Agent Managers to develop high-performing teams by optimizing schedules and work assignments, respond to ad hoc changes in real time, manage time-off requests and providing the skills they need to succeed—all in one workspace.Manage and maintain the productivity of your workforce from a single application using Workforce Optimization for HR. With this application, you can efficiently route work to your team, manage your team's skills and schedules, and monitor their performance.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/workforce-optimization-for-hr/wfo-hr-overview.html","release":"australia","product":"Workforce Optimization for HR","classification":"workforce-optimization-for-hr","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["HR Service Delivery","Employee Service Management"],"tags":["#employee-service-management","#workforce-optimization","#scheduling","#hr","#capacity","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/workforce-optimization-for-hr/wfo-hr-overview.md"},
