on Autopilot#Using Autopilot":[91,100],"#Using Agent Chat#Automatically displaying topics with Conversation Autopilot#Using Autopilot#{1}":[93,100],"#Using Agent Chat#Automatically displaying topics with Conversation Autopilot#While Autopilot is on":[101,108],"#Using Agent Chat#Automatically displaying topics with Conversation Autopilot#While Autopilot is on#{1}":[103,108],"#Using Agent Chat#Automatically displaying topics with Conversation Autopilot#When Autopilot is ended":[109,114],"#Using Agent Chat#Automatically displaying topics with Conversation Autopilot#When Autopilot is ended#{1}":[111,114],"#Using Agent Chat#Conveying emotions using emojis":[115,142],"#Using Agent Chat#Conveying emotions using emojis#{1}":[117,118],"#Using Agent Chat#Conveying emotions using emojis#Before you begin":[119,124],"#Using Agent Chat#Conveying emotions using emojis#Before you begin#{1}":[121,124],"#Using Agent Chat#Conveying emotions using emojis#Procedure":[125,142],"#Using Agent Chat#Conveying emotions using emojis#Procedure#{1}":[127,129],"#Using Agent Chat#Conveying emotions using emojis#Procedure#{2}":[130,137],"#Using Agent Chat#Conveying emotions using emojis#Procedure#{3}":[138,139],"#Using Agent Chat#Conveying emotions using emojis#Procedure#{4}":[140,142],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat":[143,186],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#{1}":[145,146],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Translation indicators":[147,152],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Translation indicators#{1}":[149,152],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Dynamic translations control for bilingual agents":[153,164],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Dynamic translations control for bilingual agents#{1}":[155,164],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Troubleshoot translated messages":[165,172],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Troubleshoot translated messages#{1}":[167,172],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Translated chat transcripts":[173,176],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Translated chat transcripts#{1}":[175,176],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Chat transferred from Virtual Agent":[177,182],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Chat transferred from Virtual Agent#{1}":[179,182],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Attachments within DTAC":[183,186],"#Using Agent Chat#Conversing in a different language with Dynamic Translation for Agent Chat#Attachments within DTAC#{1}":[185,186],"#Using Agent Chat#Sending an agent-initiated message during an async chat":[187,220],"#Using Agent Chat#Sending an agent-initiated message during an async chat#{1}":[189,190],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Before you begin":[191,194],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Before you begin#{1}":[193,194],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Procedure":[195,220],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Procedure#{1}":[197,198],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Procedure#{2}":[199,200],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Procedure#{3}":[201,202],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Procedure#{4}":[203,210],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Procedure#{5}":[211,213],"#Using Agent Chat#Sending an agent-initiated message during an async chat#Procedure#{6}":[214,220],"#Using Agent Chat#Using the action bar in chat interaction records":[221,240],"#Using Agent Chat#Using the action bar in chat interaction records#{1}":[223,226],"#Using Agent Chat#Using the action bar in chat interaction records#{2}":[227,228],"#Using Agent Chat#Using the action bar in chat interaction records#{3}":[229,230],"#Using Agent Chat#Using the action bar in chat interaction records#{4}":[231,231],"#Using Agent Chat#Using the action bar in chat interaction records#{5}":[232,232],"#Using Agent Chat#Using the action bar in chat interaction records#{6}":[233,233],"#Using Agent Chat#Using the action bar in chat interaction records#{7}":[234,238],"#Using Agent Chat#Using the action bar in chat interaction records#{8}":[239,240],"#Using Agent Chat#Related":[241,249],"#Using Agent Chat#Related#{1}":[243,243],"#Using Agent Chat#Related#{2}":[244,244],"#Using Agent Chat#Related#{3}":[245,245],"#Using Agent Chat#Related#{4}":[246,246],"#Using Agent Chat#Related#{5}":[247,247],"#Using Agent Chat#Related#{6}":[248,249]},"outlinks":[{"title":"Agent Chat","target":"ci-use-agent-chat","line":25},{"title":"Define a quick action parameter","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/agent-chat/ci-quick-actions-overview.md","line":73},{"title":"Virtual Agent","target":"virtual-agent-landing-page","line":77},{"title":"Setting up Agent Chat","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/agent-chat/ac-configure-agent-chat.md","line":81},{"title":"Using quick actions in Agent Chat","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/agent-chat/ci-agent-chat-using.md","line":89},{"title":"Agent Whisper","target":"ci-agent-whisper","line":107},{"title":"Setting up Agent Chat","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/agent-chat/ac-configure-agent-chat.md","line":121},{"title":"Chat transcript downloads for requesters","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/agent-chat/ci-chat-transcripts.md","line":175},{"title":"Asynchronous chat","target":"async-chat","line":217},{"title":"Configure asynchronous chat for the web channel","target":"configure-async-web","line":219},{"title":"Sidebar","target":"sidebar-landing","line":231},{"title":"Using Asynchronous Chat in messaging channels","target":"async-chat","line":243},{"title":"Configure asynchronous chat for the web channel","target":"configure-async-web","line":244},{"title":"Agent Chat","target":"ci-use-agent-chat","line":245},{"title":"Virtual Agent","target":"virtual-agent-landing-page","line":246},{"title":"Agent Whisper","target":"ci-agent-whisper","line":247},{"title":"Sidebar","target":"sidebar-landing","line":248}],"metadata":{"title":"Using Agent Chat","description":"Agent Chat enables live agents to have conversations with requesters and for managers to help agents and monitor them.Use shortcuts, known as quick actions, for common activities that are performed frequently.Agents can use Conversation Autopilot to display Virtual Agent topics during Agent Chat conversations. While the requester interacts with the Virtual Agent topics, agents can multitask and work on other items. Conversation Autopilot is not available for HR Service Delivery \\(HRSD\\).Use emojis in Agent Chat conversations to convey emotions to requesters. This helps requesters feel like they're having a conversation with a friend and builds customer brand loyalty.Use Dynamic Translation for Agent Chat \\(DTAC\\) to have a chat conversation with a requester who uses a different language.Send a message to a requester even when the requester isn't online while working on issues in Workspace. A long-running conversation between an an agent and a requester who are not online concurrently is called an asynchronous, or async, chat.Use the action bar in chat interaction records to access a range of actions that help manage and respond to records efficiently.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/conversational-interfaces/agent-chat/ci-agent-chat-using.html","release":"australia","product":"Agent Chat","classification":"agent-chat","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":11,"keywords":["Using","Agent Chat","Virtual Agent","live","conversation"],"breadcrumb":["Agent Chat","Conversational Interfaces"],"tags":["#conversational-interfaces","#agent-chat","#live-chat","#messaging","#support","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/conversational-interfaces/agent-chat/ci-agent-chat-using.md"},
