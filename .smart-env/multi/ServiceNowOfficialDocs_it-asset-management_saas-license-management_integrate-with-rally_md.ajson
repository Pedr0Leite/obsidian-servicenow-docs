kdown/it-asset-management/software-asset-management/sam-workspace-workbench.md","line":230},{"title":"Run software reconciliation in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/t_RunReconciliation.md","line":232},{"title":"Run software reconciliation in the workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/run-recon-workspace.md","line":233},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":237},{"title":"SaaS License Management","target":"sam-subscription-management","line":238},{"title":"Using Software Asset Workspace","target":"using-sam-workspace","line":239},{"title":"Software Asset Workspace","target":"sam-workspace","line":240},{"title":"Software models","target":"c_CreatingSoftwareModels","line":241}],"metadata":{"title":"Integrating with Rally","description":"Integrating your Software Asset Management application with the Broadcom Rally application enables you to track your software subscriptions and to reclaim unused licenses.Register the Rally OAuth application to access the Rally API 2.0 and to receive a Client ID and Client secret.Create a Rally integration profile to track software subscriptions and optimize licensing for your Rally solutions.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/saas-license-management/integrate-with-rally.html","release":"australia","product":"SaaS License Management","classification":"saas-license-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Integrate with SaaS applications","SaaS License Management","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#saas","#license-management","#discovery","#optimization","#type-concept"]},"task_lines":[],"tasks":{}