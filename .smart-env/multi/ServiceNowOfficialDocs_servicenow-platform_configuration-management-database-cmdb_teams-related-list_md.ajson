 Lists of CI components","CMDB classifications and class dependency","Configuration Management Database \\(CMDB\\)","Configuration Management","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#cmdb","#cis","#relationships","#health","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/configuration-management-database-cmdb/teams-related-list.md"},
