plications#Procedure#{6}":[196,200],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{7}":[201,209],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{8}":[203,209],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{9}":[210,219],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{10}":[212,219],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{11}":[220,226],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{12}":[222,226],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{13}":[227,230],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{14}":[231,236],"#Enabling accessibility features#Configure a Windows 64-bit host to use 32-bit NVDA with Java applications#Procedure#{15}":[233,236],"#Enabling accessibility features#Related":[237,246],"#Enabling accessibility features#Related#{1}":[239,239],"#Enabling accessibility features#Related#{2}":[240,240],"#Enabling accessibility features#Related#{3}":[241,241],"#Enabling accessibility features#Related#{4}":[242,242],"#Enabling accessibility features#Related#{5}":[243,243],"#Enabling accessibility features#Related#{6}":[244,244],"#Enabling accessibility features#Related#{7}":[245,246]},"outlinks":[{"title":"configure","target":"configure-onboarding-modals","line":18},{"title":"User interface configuration","target":"p_NavigationAndUIConfiguration","line":31},{"title":"User preferences","target":"c_UserPreferences","line":43},{"title":"forms","target":"form-configurable-workspace","line":53},{"title":"Use skip links","target":"keyboard-accessibility","line":58},{"title":"User preferences","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_UserPreferences.md","line":65},{"title":"Core UI","target":"c_UI16","line":69},{"title":"system settings","target":"r_UI16BannerFrame","line":77},{"title":"User preferences","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_UserPreferences.md","line":133},{"title":"User preferences","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_UserPreferences.md","line":153},{"title":"Oracle Java SE downloads page","target":"http://www.oracle.com/technetwork/java/javase/downloads/index.html","line":178},{"title":"Oracle Java SE jdk download page","target":"http://www.oracle.com/technetwork/java/javase/downloads/jdk8-downloads-2133151.html","line":182},{"title":"User interface configuration","target":"p_NavigationAndUIConfiguration","line":239},{"title":"User preferences","target":"c_UserPreferences","line":240},{"title":"Using accessibility features","target":"keyboard-accessibility","line":241},{"title":"System settings for the Core UI","target":"r_UI16BannerFrame","line":242},{"title":"Configure","target":"configure-onboarding-modals","line":243},{"title":"Forms","target":"form-configurable-workspace","line":244},{"title":"Core UI","target":"c_UI16","line":245}],"metadata":{"title":"Enabling accessibility features","description":"You can configure accessibility features globally or for specific users. Users can also individually enable user preferences for themselves to meet their specific accessibility needs.Enable accessibility mode on your instance.In Core UI, administrators can enable the Contrast UI theme for users who need a greater contrast in color.When a form loads, the system automatically sends focus to the first field on the form. For accessibility reasons, you can disable this option so that focus starts on the first element on the top of the page.The accessible tooltips user preference adds a tooltip icon that users can tab to, to view a tooltip for a field.The NVDA Assistive Technology screen reader is a 32-bit application that, when the Java Access bridge has been enabled, reads aloud Java applications built to support accessibility. If you encounter a problem using NVDA to access Java applications on a 64-bit Windows host, you must configure the Java Access bridge.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-user-interface/c\\_SetUpSect508ComplianceFeature.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["User interface configuration","Working in Core UI","Configure UIs and portals","Configure user experiences"],"tags":["#platform-user-interface","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[186,188],[196,199],[203,206],[212,214],[222,225],[233,235]],"key":"ServiceNowOfficialDocs/platform-user-interface/c_SetUpSect508ComplianceFeature.md"},
