-management/cncore-cmpro-landing-page.md","line":29},{"title":"Support for offline signatures","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cncore-signature-workflow.md#section_offline_workflow","line":35},{"title":"Add signatory initials placeholders to contract templates","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cncore-addin-add-signatory.md","line":41},{"title":"Better visibility of undelivered signature requests for a contract","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cncore-cr-state-status.md","line":46},{"title":"Send contracts for signature using Adobe Sign without signing in","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cncore-nss-review-request.md","line":53},{"title":"Compare contract revisions in Contract Management Pro","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cmpro-compare-docs.md","line":57},{"title":"Validations for content control placement in the Microsoft Word add‑in","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cncore-addin-add-clauses.md","line":61},{"title":"Improved Microsoft Word document processing","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cncore-set-ext-app-config.md","line":65},{"title":"ServiceNow Store","target":"https://store.servicenow.com/sn_appstore_store.do#!/store/home","line":72},{"title":"ServiceNow Store version history release notes","target":"https://www.servicenow.com/docs/bundle/store-release-notes/page/release-notes/store/sn-store-release-notes.html","line":72},{"title":"Contract Management Pro","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cncore-cmpro-landing-page.md","line":76},{"title":"Now Assist in Contract Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/cncore-now-assit-landing.md","line":80},{"title":"Now Assist in Contract Management release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/cmpro-na-rn.md","line":85},{"title":"Employee Service Management release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/employee-service-management-rn-landing.md","line":88}],"metadata":{"title":"Contract Management Pro release notes","description":"The ServiceNow Contract Management Pro solution enables you to set up contract document templates, clauses, and clause variations, and to initiate contract and amendment requests. It also supports Now Assist driven contract analysis and metadata extraction, e-signatures, wet signatures, and external storage systems.Contract Management Pro was enhanced and updated in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":3,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/cmpro-rn.md"},
