63,328],"#PSBScratchpadUtil- Scoped#PSBScratchpadUtil - update\\(GlideRecord taskGR, String name, String value, Boolean client\\_side\\_accessible\\)":[329,424],"#PSBScratchpadUtil- Scoped#PSBScratchpadUtil - update\\(GlideRecord taskGR, String name, String value, Boolean client\\_side\\_accessible\\)#{1}":[331,394],"#PSBScratchpadUtil- Scoped#PSBScratchpadUtil - update\\(GlideRecord taskGR, String name, String value, Boolean client\\_side\\_accessible\\)#{2}":[395,395],"#PSBScratchpadUtil- Scoped#PSBScratchpadUtil - update\\(GlideRecord taskGR, String name, String value, Boolean client\\_side\\_accessible\\)#{3}":[396,397],"#PSBScratchpadUtil- Scoped#PSBScratchpadUtil - update\\(GlideRecord taskGR, String name, String value, Boolean client\\_side\\_accessible\\)#{4}":[398,424],"#PSBScratchpadUtil- Scoped#Related":[425,428],"#PSBScratchpadUtil- Scoped#Related#{1}":[427,428]},"outlinks":[{"title":"update","target":"r_Update","line":30},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":34},{"title":"update","target":"r_Update","line":427}],"metadata":{"title":"PSBScratchpadUtil - Scoped","description":"The PSBScratchpadUtil API provides methods that allow providers to share \"extra\" information that is outside of any other Service Exchange service, with their consumers.Returns the value of a specified scratchpad property.Returns the property names and values \\(name-value pairs\\) of all scratchpad properties associated with the specified task.Returns the list of names of all scratchpad properties associated with the specified task record.Places the scratchpad properties associated with the specified remote task or provider task in the client g\\_scratchpad.Deletes the specified scratchpad property from the Scratchpad \\[sn\\_sb\\_scratchpad\\] table.Inserts a property or updates the value of a property in the Scratchpad \\[sn\\_sb\\_scratchpad\\] table.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/PSBScratchpadUtilScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[83,93],[97,99],[149,159],[163,165],[202,212],[216,218],[257,259],[310,321],[325,327],[407,417],[421,423]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/PSBScratchpadUtilScopedAPI.md"},
