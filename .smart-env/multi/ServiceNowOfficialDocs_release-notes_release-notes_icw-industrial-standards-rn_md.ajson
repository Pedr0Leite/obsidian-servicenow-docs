dards features#{7}":[59,60],"#Industrial Standards release notes#Industrial Standards features#{8}":[61,63],"#Industrial Standards release notes#Activation information":[64,67],"#Industrial Standards release notes#Activation information#{1}":[66,67],"#Industrial Standards release notes#Plugin information":[68,76],"#Industrial Standards release notes#Plugin information#{1}":[70,71],"#Industrial Standards release notes#Plugin information#{2}":[72,76],"#Industrial Standards release notes#Related ServiceNow applications and features":[77,94],"#Industrial Standards release notes#Related ServiceNow applications and features#{1}":[79,80],"#Industrial Standards release notes#Related ServiceNow applications and features#{2}":[81,82],"#Industrial Standards release notes#Related ServiceNow applications and features#{3}":[83,84],"#Industrial Standards release notes#Related ServiceNow applications and features#{4}":[85,86],"#Industrial Standards release notes#Related ServiceNow applications and features#{5}":[87,88],"#Industrial Standards release notes#Related ServiceNow applications and features#{6}":[89,94]},"outlinks":[{"title":"Exploring Industrial Standards","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/industrial-standards-landing-page.md","line":30},{"title":"Work set standards","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/work-set-standards.md","line":36},{"title":"Industrial Standards Library","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/industrial-standards-library.md","line":43},{"title":"Scheduling standards","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/industrial-connected-workforce/scheduling-standards.md","line":51},{"title":"Skill-based task management","target":"https://raw.githubusercontent.com/Ser