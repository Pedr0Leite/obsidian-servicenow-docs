T provider with a JWT signing key#Procedure#{1}":[217,218],"#Set up OAuth provider with JWT Bearer grant type#Create a JWT provider with a JWT signing key#Procedure#{2}":[219,220],"#Set up OAuth provider with JWT Bearer grant type#Create a JWT provider with a JWT signing key#Procedure#{3}":[221,247],"#Set up OAuth provider with JWT Bearer grant type#Related":[248,256],"#Set up OAuth provider with JWT Bearer grant type#Related#{1}":[250,250],"#Set up OAuth provider with JWT Bearer grant type#Related#{2}":[251,251],"#Set up OAuth provider with JWT Bearer grant type#Related#{3}":[252,252],"#Set up OAuth provider with JWT Bearer grant type#Related#{4}":[253,253],"#Set up OAuth provider with JWT Bearer grant type#Related#{5}":[254,254],"#Set up OAuth provider with JWT Bearer grant type#Related#{6}":[255,256]},"outlinks":[{"title":"oauth","target":"oauth-inbound-and-outbound","line":28},{"title":"authentication","target":"c_Authentication","line":32},{"title":"OAuth 2.0","target":"c_OAuthApplications","line":32},{"title":"Upload Java Key Store certificate","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/authentication/JWT-Bearer-token-support.md","line":36},{"title":"Configure a JWT signing key","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/authentication/JWT-Bearer-token-support.md","line":40},{"title":"Create a JWT provider with a JWT signing key","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/authentication/JWT-Bearer-token-support.md","line":44},{"title":"Connect to a third-party OAuth provider","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/authentication/connect-3rd-party-oauth-provider.md","line":48},{"title":"JWT Bearer","target":"jwt-bearer","line":50},{"title":"Specify an OAuth profile","target":"https://raw.githubusercontent.