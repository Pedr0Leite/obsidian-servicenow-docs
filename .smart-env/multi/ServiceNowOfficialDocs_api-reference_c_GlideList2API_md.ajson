lter\\)#{1}":[555,575],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - setFirstRow\\(Number rowNum\\)":[576,598],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - setFirstRow\\(Number rowNum\\)#{1}":[578,598],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - setGroupBy\\(String groupBy\\)":[599,618],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - setGroupBy\\(String groupBy\\)#{1}":[601,618],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - setOrderBy\\(String orderBy\\)":[619,640],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - setOrderBy\\(String orderBy\\)#{1}":[621,640],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - setRowsPerPage\\(Number rows\\)":[641,660],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - setRowsPerPage\\(Number rows\\)#{1}":[643,660],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - showHideGroups\\(Boolean showFlag\\)":[661,681],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - showHideGroups\\(Boolean showFlag\\)#{1}":[663,681],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - showHideList\\(Boolean showFlag\\)":[682,701],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - showHideList\\(Boolean showFlag\\)#{1}":[684,701],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - sort\\(String field\\)":[702,730],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - sort\\(String field\\)#{1}":[704,730],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - sortDescending\\(String field, Number amount\\)":[731,759],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - sortDescending\\(String field, Number amount\\)#{1}":[733,759],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - toggleList\\(\\)":[760,778],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - toggleList\\(\\)#{1}":[762,778],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - toggleListNoPref\\(\\)":[779,797],"#GlideList2 \\(g\\_list\\)- Client#GlideList2 - toggleListNoPref\\(\\)#{1}":[781,797],"#GlideList2 \\(g\\_list\\)- Client#Related":[798,802],"#GlideList2 \\(g\\_list\\)- Client#Related#{1}":[800,800],"#GlideList2 \\(g\\_list\\)- Client#Related#{2}":[801,802]},"outlinks":[{"title":"GlideList \\(Next Experience UI Framework\\)","target":"GlideListClientAPINEx","line":26},{"title":"Client API reference","target":"api-client","line":28},{"title":"Encoded query strings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_EncodedQueryStrings.md","line":36},{"title":"Encoded query strings","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_EncodedQueryStrings.md","line":539},{"title":"GlideList \\(Next Experience\\) - Client","target":"GlideListClientAPINEx","line":800},{"title":"Client API reference","target":"api-client","line":801}],"metadata":{"title":"GlideList2 \\(g\\_list\\) - Client","description":"The GlideList2 API provides methods to customize \\(v2\\) lists.Adds a single term to the list query filter.Returns the GlideList2 object for the list that contains the specified item.Returns the GlideList2 object for the list specified.Returns a comma-separated list of the sys\\_ids for the items that are checked in the associated list.Returns the fixed query. Returns the field or comma-separated list of fields that are used to group the list.Returns the name of the list, which is usually the table name.Returns the first field used to order the list.Returns the name of the parent table for a related list \\(the table associated with the form\\).Returns the encoded query string for the list.Returns the related list field that associates the related list to the parent form.Returns the table name for the list.Returns the view used to display the list.Returns the list title.Returns true if the list has been personalized by the user by choosing the list mechanic and changing the list layout.Refreshes the list. The orderBy part of the list filter is ignored so that the list uses its natural ordering when it is refreshed.Refreshes the list. The orderBy part of the list filter is included if it is specified for the list.Sets the encoded query string for the list, ignoring the orderBy and groupBy parts of the query string.Sets the encoded query string for the list, including the orderBy and groupBy if specified, and then refreshes the list using the new filter.Sets the first row that appears in the list when the list is refreshed.Sets the list groupBy criteria for a single field.Sets the orderBy criteria for the list.Sets the number of rows per page to display.Shows or hides all the groups within the list and saves the current collapsed/expanded state of the groups as a user preference.Displays or hides the list and saves the current collapsed/expanded state of the list as a user preference.Sorts the list in ascending order and sets the field as an orderBy column.Sorts a single field in the list in descending order and sets the field as an orderByDescField column.Toggles the display of the list and saves the current collapsed/expanded state of the list as a user preference.Toggles the display of the list but does not save the current collapsed/expanded state of the list as a user preference.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/c\\_GlideList2API.html","release":"australia","product":"API Reference","classification":"api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Client API reference","API reference","API implementation and reference"],"tags":["#api-reference","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[42,44],[70,78],[92,104],[120,126],[140,151],[165,169],[183,188],[202,209],[300,306],[320,325],[339,349],[363,371],[385,389],[403,409],[456,471],[518,531],[545,551],[565,574],[588,597],[611,617],[633,639],[653,659],[673,680],[694,700],[714,729],[743,758],[772,777],[791,796]],"key":"ServiceNowOfficialDocs/api-reference/c_GlideList2API.md"},
