],"metadata":{"title":"Feature mapping for Oracle Database options and management packs","description":"The Software Asset Management application automatically maps discovered Oracle features to the Oracle Database options and management packs that they’re associated with. These mappings can help you determine the usage and license compliance of your database options and management packs.If a discovered feature is associated with more than one Oracle Database option or management pack, you can change the database option or management pack that the feature usage data is applied to by updating the default mapping for that feature.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/software-asset-management/oracle-feature-option-mapping.html","release":"australia","product":"Software Asset Management","classification":"software-asset-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Oracle Database options and management packs","Software Asset Management publisher pack for Oracle","Supported software publisher licenses","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#sam","#software-licenses","#compliance","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/it-asset-management/software-asset-management/oracle-feature-option-mapping.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"mn1ame","at":1784561339177},"key":"ServiceNowOfficialDocs/it-asset-management/software-asset-management/oracle-feature-option-mapping.md#---frontmatter---","lines":[1,20],"size":1244,"outlinks":[],"class_name":"SmartBlock"},
