l document","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/operational-technology/use-ai-enhanced-ra-otsm.md","line":31},{"title":"Contextualize UI action","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/operational-technology/use-ai-enhanced-ra-otsm.md","line":38},{"title":"ServiceNow Store","target":"https://store.servicenow.com/sn_appstore_store.do#!/store/home","line":54},{"title":"ServiceNow Store version history release notes","target":"https://www.servicenow.com/docs/bundle/store-release-notes/page/release-notes/store/sn-store-release-notes.html","line":54},{"title":"Operational Technology Incident Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/operational-technology/operational-technology-incident-management-landing-page.md","line":58},{"title":"Operational Technology release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/operational-technology-rn-landing.md","line":63}],"metadata":{"title":"Recommended Actions for Operational Technology Service Management \\(OTSM\\) release notes","description":"The ServiceNow Recommended Actions for Operational Technology Service Management \\(OTSM\\) application enables you to set up and apply real-time, actionable recommendations. These recommendations help you speed up the triage process and resolve issues quickly across various records in the Industrial Workspace, including Operational Technology \\(OT\\) incidents. Recommended Actions for OTSM was enhanced and updated in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":1,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/recommended-actions-for-otsm