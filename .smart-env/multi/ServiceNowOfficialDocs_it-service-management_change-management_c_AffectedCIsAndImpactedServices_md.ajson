ssociated CIs on a change request#Associate multiple CIs with a change request#Procedure":[101,124],"#Associated CIs on a change request#Associate multiple CIs with a change request#Procedure#{1}":[103,104],"#Associated CIs on a change request#Associate multiple CIs with a change request#Procedure#{2}":[105,106],"#Associated CIs on a change request#Associate multiple CIs with a change request#Procedure#{3}":[107,108],"#Associated CIs on a change request#Associate multiple CIs with a change request#Procedure#{4}":[109,110],"#Associated CIs on a change request#Associate multiple CIs with a change request#Procedure#{5}":[111,114],"#Associated CIs on a change request#Associate multiple CIs with a change request#Procedure#{6}":[115,119],"#Associated CIs on a change request#Associate multiple CIs with a change request#Procedure#{7}":[120,124],"#Associated CIs on a change request#Add an affected CI with a calculated application service":[125,148],"#Associated CIs on a change request#Add an affected CI with a calculated application service#{1}":[127,128],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Before you begin":[129,132],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Before you begin#{1}":[131,132],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Procedure":[133,148],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Procedure#{1}":[135,136],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Procedure#{2}":[137,138],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Procedure#{3}":[139,140],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Procedure#{4}":[141,142],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Procedure#{5}":[143,144],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Procedure#{6}":[145,146],"#Associated CIs on a change request#Add an affected CI with a calculated application service#Procedure#{7}":[147,148],"#Associated CIs on a change request#Related":[149,153],"#Associated CIs on a change request#Related#{1}":[151,151],"#Associated CIs on a change request#Related#{2}":[152,153]},"outlinks":[{"title":"problem form","target":"problem-form","line":34},{"title":"Process a change request","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/change-management/t_ProcessAChangeRequest.md","line":42},{"title":"create a change request","target":"t_CreateAChange","line":99},{"title":"Problem form","target":"problem-form","line":151},{"title":"Create a change request","target":"t_CreateAChange","line":152}],"metadata":{"title":"Associated CIs on a change request","description":"You can associate additional CIs or services to change requests through related lists on the Change Request form. You can also associate CIs with a change request from the dependency views map.You can use dependency views to identify dependent CIs affected by a change request, and then add them to the Affected CIs related list.You can associate multiple impacted or affected CIs with a single change request.From the change request form, you can add an affected CI that is associated with a calculated application service.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-service-management/change-management/c\\_AffectedCIsAndImpactedServices.html","release":"australia","product":"Change Management","classification":"change-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Process a change request","Use","Change Management","IT Service Management"],"tags":["#it-service-management","#change-management","#cab","#risk","#itsm",