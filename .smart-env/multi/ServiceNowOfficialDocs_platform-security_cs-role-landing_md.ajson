#Code signing manager \\[codesigning\\_manager\\]#Contains Roles":[46,51],"#Roles installed with Code Signing#Code signing manager \\[codesigning\\_manager\\]#Contains Roles#{1}":[48,51],"#Roles installed with Code Signing#Code signing manager \\[codesigning\\_manager\\]#Groups":[52,57],"#Roles installed with Code Signing#Code signing manager \\[codesigning\\_manager\\]#Groups#{1}":[54,57],"#Roles installed with Code Signing#Code signing manager \\[codesigning\\_manager\\]#Special considerations":[58,61],"#Roles installed with Code Signing#Code signing manager \\[codesigning\\_manager\\]#Special considerations#{1}":[60,61],"#Roles installed with Code Signing#Code signing auditor \\[codesigning\\_auditor\\]":[62,81],"#Roles installed with Code Signing#Code signing auditor \\[codesigning\\_auditor\\]#{1}":[64,65],"#Roles installed with Code Signing#Code signing auditor \\[codesigning\\_auditor\\]#Contains Roles":[66,71],"#Roles installed with Code Signing#Code signing auditor \\[codesigning\\_auditor\\]#Contains Roles#{1}":[68,71],"#Roles installed with Code Signing#Code signing auditor \\[codesigning\\_auditor\\]#Groups":[72,77],"#Roles installed with Code Signing#Code signing auditor \\[codesigning\\_auditor\\]#Groups#{1}":[74,77],"#Roles installed with Code Signing#Code signing auditor \\[codesigning\\_auditor\\]#Special considerations":[78,81],"#Roles installed with Code Signing#Code signing auditor \\[codesigning\\_auditor\\]#Special considerations#{1}":[80,81],"#Roles installed with Code Signing#Related":[82,88],"#Roles installed with Code Signing#Related#{1}":[84,84],"#Roles installed with Code Signing#Related#{2}":[85,85],"#Roles installed with Code Signing#Related#{3}":[86,86],"#Roles installed with Code Signing#Related#{4}":[87,88]},"outlinks":[{"title":"Code Signing","target":"code-signing-landing","line":18},{"title":"Code Signing reference","target":"code-signing-reference","line":20},{"title":"users","target":"users","line":24},{"title":"configuration","target":"sc-configuration","line":44},{"title":"Code Signing reference","target":"code-signing-reference","line":84},{"title":"Code Signing","target":"code-signing-landing","line":85},{"title":"Users","target":"users","line":86},{"title":"Configuration","target":"sc-configuration","line":87}],"metadata":{"title":"Roles installed with Code Signing","description":"Code Signing includes the following roles.Use the code signing admin role to assign codesigning\\_manager and codesigning\\_auditor roles to other users.Use the code signing manager role to create and update signature configuration, and create and run code signing jobs.Use the code signing auditor role to view signature configurations and signing jobs. The auditor role does not have create or write access to code signing assets.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/cs-role-landing.html","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Administer and Troubleshoot","Code Signing","Platform Security"],"tags":["#platform-security","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-security/cs-role-landing.md"},
