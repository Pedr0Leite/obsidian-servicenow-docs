ure#{3}":[47,48],"#SCCM software revocation#Revoke software deployed through the service catalog#Procedure#{4}":[49,50],"#SCCM software revocation#Revoke software deployed through the service catalog#Procedure#{5}":[51,53],"#SCCM software revocation#Revoke unentitled software":[54,78],"#SCCM software revocation#Revoke unentitled software#{1}":[56,57],"#SCCM software revocation#Revoke unentitled software#Before you begin":[58,65],"#SCCM software revocation#Revoke unentitled software#Before you begin#{1}":[60,65],"#SCCM software revocation#Revoke unentitled software#Procedure":[66,78],"#SCCM software revocation#Revoke unentitled software#Procedure#{1}":[68,69],"#SCCM software revocation#Revoke unentitled software#Procedure#{2}":[70,71],"#SCCM software revocation#Revoke unentitled software#Procedure#{3}":[72,73],"#SCCM software revocation#Revoke unentitled software#Procedure#{4}":[74,78],"#SCCM software revocation#SCCM software revocation workflow":[79,88],"#SCCM software revocation#SCCM software revocation workflow#{1}":[81,88],"#SCCM software revocation#Related":[89,92],"#SCCM software revocation#Related#{1}":[91,92]},"outlinks":[{"title":"Client software distribution from SCCM","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_CSDFromAnSCCMHost.md","line":26},{"title":"SCCM configuration record","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_ConfigureSCCMCollections.md","line":34},{"title":"CSD catalog item","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateCatItemSCCMApp.md","line":35},{"title":"Revoke SCCM Application","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_SCCMSoftwareRevocation.md","line":39},{"title":"Client Software Distribution","target":"c_ClientSoftwareDistribution","line":43},{"title":"Software discovery models","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/c_DiscoveryModels.md","line":60},{"title":"SCCM configuration record","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_ConfigureSCCMCollections.md","line":60},{"title":"Software Asset Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/c_SAMOverview.md","line":64},{"title":"**Installed**","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_ClientSWDistValidProcess.md","line":83},{"title":"Revoke software deployed through the service catalog","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_SCCMSoftwareRevocation.md","line":83},{"title":"Add to Device Collection","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/r_AddToDeviceCollectionActivity.md","line":85},{"title":"Add to User Collection","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/r_AddToUserCollectionActivity.md","line":85},{"title":"Remove from Device Collection","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/r_RemoveFmDevicCollectionActivity.md","line":85},{"title":"Remove from User Collection","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/r_RemoveFromUserCollectionActivity.md","line":85},{"title":"Client Software Distribution","target":"c_ClientSoftwareDistribution","line":91}],"metadata":{"title":"SCCM software revocation","description":"An administrator can revoke software without any user interaction using Microsoft System Center Configuration Manager \\(SCCM\\) if the software configuration specifies an SCCM uninstall collection, even if the software was installed by some other process or user.Software deployed by SCCM can be revoked, but only when the software's status is Installed and the application associated with the software configuration has an uninstall collection configured.An administrator can revoke software using Microsoft System Center Configuration Manager \\(SCCM\\) that a user is not entitled to use even if the software was installed by some other process or user.The Revoke SCCM Application workflow moves a user or device from an install collection to an uninstall collection to revoke software installed from Microsoft System Center Configuration Manager \\(SCCM\\).","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/orchestration/c\\_SCCMSoftwareRevocation.html","release":"australia","product":"Orchestration","classification":"orchestration","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Client software distribution from SCCM","Client Software Distribution","Orchestration applications","Classic Orchestration","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#orchestration","#itpa","#automation","#runbooks","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/orchestration/c_SCCMSoftwareRevocation.md"},
