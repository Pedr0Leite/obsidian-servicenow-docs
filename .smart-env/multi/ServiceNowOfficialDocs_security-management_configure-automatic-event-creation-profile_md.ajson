03,403],"#Configure how an automatic event is created#Related#{6}":[404,404],"#Configure how an automatic event is created#Related#{7}":[405,405],"#Configure how an automatic event is created#Related#{8}":[406,407]},"outlinks":[{"title":"Review the MISP user role and permissions","target":"misp-user-roles-and-permissions","line":22},{"title":"MISP administration","target":"misp-administration","line":85},{"title":"observables","target":"c_Observables","line":120},{"title":"Security Incident Response","target":"sir-landing-page","line":204},{"title":"malware","target":"threat-intelligence-malware","line":224},{"title":"mapping","target":"mapping-logrhythm","line":245},{"title":"MISP integration for Security Operations","target":"misp-integration-for-security-operations","line":260},{"title":"MISP documentation","target":"https://www.circl.lu/doc/misp/categories-and-types/#types","line":302},{"title":"Associated MISP Events","target":"associated-misp-events","line":368},{"title":"MISP user roles and permissions","target":"misp-user-roles-and-permissions","line":399},{"title":"MISP administration","target":"misp-administration","line":400},{"title":"Observables","target":"c_Observables","line":401},{"title":"Security Incident Response","target":"sir-landing-page","line":402},{"title":"Malware","target":"threat-intelligence-malware","line":403},{"title":"Mapping","target":"mapping-logrhythm","line":404},{"title":"MISP integration for Security Operations","target":"misp-integration-for-security-operations","line":405},{"title":"Associated MISP events","target":"associated-misp-events","line":406}],"metadata":{"title":"Configure how an automatic event is created","description":"Configure the ServiceNow AI Platform to automatically create events in MISP.Configure the event trigger conditions in the ServiceNow AI Platform so that you can automatically trigger an event in MISP when the conditions are met.Map the MISP event fields in the ServiceNow AI Platform so that security incident information is available when MISP events are created.Map the Security Incident Response observable types to the MISP attribute types because the MISP attribute types and the SIR observables may be different.Synchronize the MITRE-ATT&amp;CK information with MISP attributes for better security incident and threat analysis.Add MISP tags to the created MISP events.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/configure-automatic-event-creation-profile.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["MISP administration","MISP integration for Security Operations","Threat Intelligence integrations","Threat Intelligence","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/configure-automatic-event-creation-profile.md"},
