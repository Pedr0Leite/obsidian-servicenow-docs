:"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/enterprise-asset-management/receive-drop-off-asset-eam-mobile.md","line":83},{"title":"Create a Drop off task for enterprise assets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/enterprise-asset-management/create-dropoff-task-eam.md","line":86},{"title":"Drop off enterprise assets at a stockroom","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/enterprise-asset-management/add-eam-assets-drop-off.md","line":88},{"title":"Verify the enterprise assets received through a Drop off task","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/enterprise-asset-management/verify-assets-eam-receive.md","line":90},{"title":"Record time worked on Drop off and Receive tasks for enterprise assets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/enterprise-asset-management/record-time-drop-receive.md","line":92},{"title":"Receive asset","target":"receive-rma-asset","line":93},{"title":"IT Asset Management","target":"it-asset-management","line":95},{"title":"IT Asset Management","target":"it-asset-management","line":99},{"title":"Enterprise Asset Management","target":"enterprise-asset-management","line":100},{"title":"Enterprise Asset Workspace","target":"using-eam-workspace","line":101},{"title":"Receive asset","target":"receive-rma-asset","line":102}],"metadata":{"title":"Delivering enterprise assets in your personal stockroom through Drop off tasks","description":"As an enterprise asset technician, manage the delivery of enterprise assets that you have in your personal stockroom to any other warehouse stockroom by creating Drop off tasks. The asset manager of the destination stockroom receives the assets that you dropped off, verifies the asset,