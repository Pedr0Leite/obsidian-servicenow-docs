rkdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2253},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2598},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2611},{"title":"**sn\\_dpr.out\\_of\\_band\\_release\\_allowed**","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/digital-product-release-properties.md","line":2767},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2875},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2888}],"metadata":{"title":"Digital Product Release API","description":"The Digital Product Release API provides endpoints to manage releases and policy compliance.Retrieves release bundle details.Gets policy execution details by product for the current phase of a release.Creates an enhancement for a product or service.Creates a release.Creates a key date for a release.Executes mapped policies for the current phase of a release.Adds related tasks to a release.Creates a release calendar.Completes the current phase of a release.Creates a release readiness target or a set of recurring release readiness targets.Changes the readiness target for a release.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/digital-product-release-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":35,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[146,153],[165,170],[180,185],[195,205],[215,220],[249,286],[290,294],[322,420],[425,435],[444,509],[519,531],[542,634],[641,685],[690,694],[738,901],[906,936],[951,955],[962,1020],[1027,1236],[1243,1291],[1318,1322],[1331,1337],[1358,1362],[1370,1376],[1396,1400],[1408,1587],[1593,1631],[1645,1649],[1657,1750],[1757,1806],[1811,1815],[1824,1938],[1943,1971],[1978,1982],[1989,2113],[2119,2157],[2168,2172],[2180,2281],[2287,2291],[2296,2341],[2346,2350],[2358,2364],[2369,2373],[2380,2493],[2499,2517],[2522,2565],[2572,2636],[2642,2678],[2717,2721],[2729,2735],[2749,2753],[2761,2914],[2919,2947],[2956,2960],[2967,2973],[2984,2988]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/digital-product-release-api.md"},
