s://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":820},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":853},{"title":"Scripted REST Service form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":981},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":981},{"title":"Voice Interaction Resource - POST /cs/voice-interactions","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/voice-interaction-resource-api.md","line":1032},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1213},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1246},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":1332},{"title":"Web services","target":"r_AvailableWebServices","line":1333},{"title":"REST APIs","target":"c_RESTAPI","line":1334}],"metadata":{"title":"Voice Interaction Resource API","description":"The Voice Interaction API provides endpoints to transcribe and store voice interactions between agents and callers during a telephone conversation. It works in conjunction with Virtual Agent and Live Agent chats.Terminates the specified voice interaction. Once called, no additional voice messages are translated and stored for the phone conversation.Creates a voice interaction record within the Interaction \\[interaction\\] table.Creates a conversation record within the Conversation \\[sys\\_cs\\_conversation\\] table for the specified interaction.Adds the specified voice conversations messages to the specified voice transaction record. These messages are typically generated using third-party vendor software. Currently, only Amazon Connect is supported.Adds messages to an existing voice interaction after a call is completed. You can use this API to attach transcribed messages of a voice call between an agent and caller.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/voice-interaction-resource-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":20,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[191,201],[205,209],[382,394],[398,404],[578,590],[594,598],[661,676],[894,961],[965,969],[1067,1287],[1320,1324]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/voice-interaction-resource-api.md"},
