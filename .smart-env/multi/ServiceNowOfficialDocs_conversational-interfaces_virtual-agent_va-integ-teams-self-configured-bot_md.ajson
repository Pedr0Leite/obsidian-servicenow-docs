 tenant","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/teams-install-custom-app.md","line":34},{"title":"Conversational Integration with Microsoft Teams","target":"teams-conv-integration","line":42},{"title":"Knowledge Base","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB1116195","line":44},{"title":"Plugins for Conversational Integration with Microsoft Teams","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/addtional-plugins-msteams.md","line":52},{"title":"Create a bot in Microsoft Teams","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/create-bot-msteams.md","line":53},{"title":"Auto-generate the manifest file for uploading on Microsoft Teams","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/generate-manifest-file-msteams.md","line":54},{"title":"Upload the manifest package file to publish your bot","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/upload-package-file-msteams.md","line":55},{"title":"Auto-generate the manifest file for uploading on Microsoft Teams","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/generate-manifest-file-msteams.md","line":57},{"title":"Upload the manifest package file to publish your bot","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/upload-package-file-msteams.md","line":59},{"title":"Specialized Virtual Agent integrations for Microsoft Teams","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/specialized-va-integs-msteams.md","line":62},{"title":"Integrate Virtual Agent with Microsoft Teams","target":"va-integ-msteams","line":66},{"title":"Virtual Agent","target":"virtual-agent-landing-page","line":67},{"title":"Conversational Integration with Microsoft Teams","target":"teams-conv-integration","line":68}],"metadata":{"title":"Integrating Virtual Agent with Microsoft Teams using the self-configured bot","description":"You can integrate Virtual Agent with Microsoft Teams by configuring your own bots. The self-configured method provides another way for customers to enable the integration without installing the default Now Virtual Agent app that is published on the Microsoft Store. Unlike the pre-published app, the self-configured bot bypasses the collaboration proxy architecture.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/conversational-interfaces/virtual-agent/va-integ-teams-self-configured-bot.html","release":"australia","product":"Virtual Agent","classification":"virtual-agent","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Specialized VA integrations for Teams","Integrate VA with Teams","Conversational Integration with Microsoft Teams","Integrate VA with messaging apps","Integrate VA with other channels","Virtual Agent","Conversational Interfaces"],"tags":["#conversational-interfaces","#virtual-agent","#chatbot","#nlu","#topics","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/conversational-interfaces/virtual-agent/va-integ-teams-self-configured-bot.md"},
