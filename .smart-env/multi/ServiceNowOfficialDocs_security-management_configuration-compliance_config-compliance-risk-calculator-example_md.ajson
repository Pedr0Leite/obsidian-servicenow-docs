ce \\(v15.0 and later\\)":[496,557],"#Examples for Configuration Compliance risk score calculation#Risk rollup calculation example for Configuration Compliance \\(v15.0 and later\\)#{1}":[498,505],"#Examples for Configuration Compliance risk score calculation#Risk rollup calculation example for Configuration Compliance \\(v15.0 and later\\)#{2}":[506,506],"#Examples for Configuration Compliance risk score calculation#Risk rollup calculation example for Configuration Compliance \\(v15.0 and later\\)#{3}":[507,507],"#Examples for Configuration Compliance risk score calculation#Risk rollup calculation example for Configuration Compliance \\(v15.0 and later\\)#{4}":[508,509],"#Examples for Configuration Compliance risk score calculation#Risk rollup calculation example for Configuration Compliance \\(v15.0 and later\\)#{5}":[510,557],"#Examples for Configuration Compliance risk score calculation#Related":[558,562],"#Examples for Configuration Compliance risk score calculation#Related#{1}":[560,560],"#Examples for Configuration Compliance risk score calculation#Related#{2}":[561,562]},"outlinks":[{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":24},{"title":"mapping","target":"mapping-logrhythm","line":118},{"title":"Configuration Compliance calculator groups","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/configuration-compliance/vuln-config-compl-calc-groups.md","line":193},{"title":"Edit risk rollup calculators for Configuration Compliance","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/configuration-compliance/v11create-rollup-calc.md","line":510},{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":560},{"title":"Mapping","target":"mapping-logrhythm","line":561}],"metadata":{"title":"Examples for Configuration Compliance risk score calculation","description":"Starting with v13.0 of Configuration Compliance, you can customize the criteria for the default risk rule. Use risk scores provided by third-party vendors like Qualys and Tenable for risk score calculations.Use scores based on criticality provided by third-party vendors to compute risk scores.Specify a criticality value to business services and use the business criticality to compute the risk scores.Use custom conditions to the risk rule for risk score calculation.Determine the risk score calculators to generate risk scores that use the test and asset data specific to your organization.The following example demonstrates how scores for risk rollup calculators are determined.The following example demonstrates how scores for risk rollup calculators are determined.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/configuration-compliance/config-compliance-risk-calculator-example.html","release":"australia","product":"Configuration Compliance","classification":"configuration-compliance","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":9,"breadcrumb":["Configuration Compliance calculators and calculator rules","Create a Configuration Compliance calculator group","Configure","Configuration Compliance","Unified Security Exposure Management","Security Operations"],"tags":["#security-management","#config-compliance","#cis","#scap","#security","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/configuration-compliance/config-compliance-risk-calculator-example.md"},
