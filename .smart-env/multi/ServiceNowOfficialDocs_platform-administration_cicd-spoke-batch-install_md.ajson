a/markdown/application-development/flow-designer.md","line":33},{"title":"Continuous Integration and Continuous Delivery \\(CICD\\) spoke","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/integrate-applications/cicd-spoke.md","line":33},{"title":"Using Legacy Application Manager","target":"using-legacy-application-manager","line":35},{"title":"Using Legacy Application Manager","target":"using-legacy-application-manager","line":39},{"title":"ServiceNow Store","target":"servicenow-store","line":40}],"metadata":{"title":"Install multiple applications in a batch","description":"The Batch Installation feature helps you install multiple applications, plugins, or application-customizations together, instead of having to install them serially one at a time. You can access this feature either from the Continuous Integration and Continuous Delivery \\(CI/CD\\) APIs via three new endpoints, or via the CI/CD Spoke on Integration Hub using Workflow Studio subflows and actions.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/cicd-spoke-batch-install.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Use","Legacy Application Manager","Administering applications","Get started","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/cicd-spoke-batch-install.md"},
