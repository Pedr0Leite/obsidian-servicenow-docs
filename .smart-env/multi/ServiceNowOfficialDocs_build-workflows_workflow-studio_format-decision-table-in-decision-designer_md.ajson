n column#Procedure#{6}":[198,199],"#Modify decision table structure in Workflow Studio#Modify a decision table condition column#Procedure#{7}":[200,202],"#Modify decision table structure in Workflow Studio#Modify a decision table result column":[203,228],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#{1}":[205,206],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Before you begin":[207,210],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Before you begin#{1}":[209,210],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure":[211,228],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure#{1}":[213,214],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure#{2}":[215,216],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure#{3}":[217,218],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure#{4}":[219,220],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure#{5}":[221,222],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure#{6}":[223,224],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure#{7}":[225,226],"#Modify decision table structure in Workflow Studio#Modify a decision table result column#Procedure#{8}":[227,228],"#Modify decision table structure in Workflow Studio#Related":[229,232],"#Modify decision table structure in Workflow Studio#Related#{1}":[231,232]},"outlinks":[{"title":"Workflow Studio","target":"workflow-studio","line":24},{"title":"Using decision tables","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/workflow-studio/using-decision-builder.md","line":26},{"title":"Workflow Studio","target":"workflow-studio","line":231}],"metadata":{"title":"Modify decision table structure in Workflow Studio","description":"Evolve with your business logic by modifying the inputs or columns of your decision table in Workflow Studio.Modify an input by changing the label, modifying the type and associated properties, and changing the mandatory toggle.Narrow down the list of results to only information that you need to see for Reference type input and result fields in decision tables in Workflow Studio.Make changes to an existing filter on Reference type inputs or results in decision tables in Workflow Studio.Delete inputs that are no longer necessary from your decision table in Workflow Studio. Deleting an input also deletes any related condition columns.Modify a condition column by renaming the label, editing the description, or updating the input type or default operator of your decision table in Workflow Studio.Change the data that a decision evaluates by changing the source table for that decision table in Workflow Studio.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/workflow-studio/format-decision-table-in-decision-designer.html","release":"australia","product":"Workflow Studio","classification":"workflow-studio","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Using decision tables","Decision tables","Workflow Studio","Build workflows"],"tags":["#build-workflows","#workflow-studio","#visual","#process-design","#flow-designer","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/build-workflows/workflow-studio/format-decision-table-in-decision-designer.md"},
