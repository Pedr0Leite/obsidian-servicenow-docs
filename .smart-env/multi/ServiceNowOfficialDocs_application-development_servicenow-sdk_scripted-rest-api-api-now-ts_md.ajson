ow-ts.md","line":152},{"title":"routes object","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/scripted-rest-api-api-now-ts.md","line":178},{"title":"application files","target":"c_ApplicationFiles","line":190},{"title":"versions","target":"c_Versions","line":197},{"title":"versions object","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/scripted-rest-api-api-now-ts.md","line":205},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":305},{"title":"JavaScript modules and third-party libraries","target":"javascript-modules-third-party-libraries","line":331},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":332},{"title":"parameters and headers objects","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/scripted-rest-api-api-now-ts.md","line":345},{"title":"parameters and headers objects","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/scripted-rest-api-api-now-ts.md","line":357},{"title":"Access Control List API - ServiceNow Fluent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/acl-api-now-ts.md","line":424},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":614},{"title":"ServiceNow Fluent language constructs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/servicenow-sdk/fluent-constructs.md","line":726},{"title":"ServiceNow Fluent","target":"servicenow-fluent","line":838},{"title":"JavaScript modules and third-party libraries","target":"javascript-modules-third-party-libraries","line":839},{"title":"Application files","target":"c_ApplicationFiles","line":840},{"title":"Versions","target":"c_Versions","line":841}],"metadata":{"title":"Scripted REST API - ServiceNow Fluent","description":"The Scripted REST API defines the endpoints, query parameters, and headers for a scripted REST service \\[sys\\_ws\\_definition\\].Create a scripted REST API \\[sys\\_ws\\_definition\\] to define web service endpoints.Create a scripted REST resource \\[sys\\_ws\\_operation\\] to define the HTTP method, the processing script, and to override settings from the parent service.Create query parameters \\[sys\\_ws\\_query\\_parameter\\] and headers \\[sys\\_ws\\_header\\] for routes in a scripted REST API. Query parameters control what values a requesting user can pass in the request URI. Headers specify what the API accepts and can respond with.Create versions for a scripted REST API \\[sys\\_ws\\_version\\] to define web service endpoints.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/servicenow-sdk/scripted-rest-api-api-now-ts.html","release":"australia","product":"ServiceNow SDK","classification":"servicenow-sdk","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":11,"breadcrumb":["ServiceNow Fluent API reference","Reference","ServiceNow SDK","Building applications in source code","Building pro-code applications","Developing your application","Building applications"],"tags":["#application-development","#sdk","#local-dev","#developer-tools","#typescript","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[219,223],[260,264],[275,560],[564,584],[681,685],[696,815],[819,834]],"key":"ServiceNowOfficialDocs/application-development/servicenow-sdk/scripted-rest-api-api-now-ts.md"},
