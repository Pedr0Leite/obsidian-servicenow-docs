":"cj-discovered-items","line":40},{"title":"Automatically close test results related to retired CIs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/configuration-compliance/cc-auto-close-vis.md","line":43},{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":52},{"title":"Discovered Items","target":"cj-discovered-items","line":53}],"metadata":{"title":"Working with retired configuration items in Configuration Compliance","description":"Decommissioned configuration items \\(CIs\\) are moved to retired, archived, or deleted state in the Configuration Management Database \\(CMDB\\). Configuration Compliance contains test results \\(TRs\\) that are made up of CIs. When the state of a CI is updated to retired, the associated TRs are closed with the substate 'CI decommissioned'.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/configuration-compliance/cc-working-with-retired-CIs.html","release":"australia","product":"Configuration Compliance","classification":"configuration-compliance","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Automatic closing of test results","Use","Configuration Compliance","Unified Security Exposure Management","Security Operations"],"tags":["#security-management","#config-compliance","#cis","#scap","#security","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/configuration-compliance/cc-working-with-retired-CIs.md"},
