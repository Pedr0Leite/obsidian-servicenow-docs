ion-request-1","line":44},{"title":"Define the capacity of workplace areas","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/safe-workplace/define-capacity-of-workplace-areas-hr.md","line":55},{"title":"Create workplace reservations for an employee","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/safe-workplace/reserve-workspaces-for-employees.md","line":57},{"title":"Create workplace reservations for an employee","target":"reserve-workspaces-for-employees","line":58},{"title":"Create workplace reservations for multiple employees","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/safe-workplace/reserve-spaces-bulk-assignment-multiple-employees.md","line":59},{"title":"Review pending workplace reservation requests","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/safe-workplace/work-with-pending-reservation-requests.md","line":61},{"title":"Review pending workplace reservation requests","target":"work-with-pending-reservation-requests","line":62},{"title":"Workplace Core","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/safe-workplace/workplace-safety-mgmt-hr.md","line":64},{"title":"Workplace Core","target":"workplace-safety-mgmt-hr","line":68},{"title":"Workplace Service Delivery","target":"workplace-service-delivery-suite-landing-page","line":69},{"title":"Workplace Reservation Management","target":"workplace-rsv-mgmt-feat","line":70},{"title":"Create a reservation","target":"create-reservation-request-1","line":71},{"title":"Create workplace reservations for an employee","target":"reserve-workspaces-for-employees","line":72},{"title":"Review pending workplace reservation requests","target":"work-with-pending-reservation-requests","line":73}],"metadata":{"title":"Managing workplace reservations for employees","description":"Reserve available areas or spaces for your employees and review pending reservation requests from employees in Workplace Core so you can ensure physical distancing measures when they return to the workplace. Once you make reservations, employees are notified about the locations to which they have access. The Workplace Service Delivery also offers more advanced workplace reservation options in the Workplace Reservation Management application.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/employee-service-management/safe-workplace/managing-workplace-reservations.html","release":"australia","product":"Safe Workplace","classification":"safe-workplace","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Workplace Core","Safe Workplace","Health and Safety","Employee Service Management"],"tags":["#employee-service-management","#safe-workplace","#return-to-office","#covid","#facility","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/safe-workplace/managing-workplace-reservations.md"},
