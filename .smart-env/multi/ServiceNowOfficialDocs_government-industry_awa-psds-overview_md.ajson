nfigure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{14}":[443,443],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{15}":[444,446],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{16}":[447,452],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{17}":[453,453],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{18}":[454,455],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{19}":[456,457],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{20}":[458,458],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{21}":[459,466],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{22}":[467,467],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{23}":[468,468],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{24}":[469,469],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{25}":[470,470],"#Configure Advanced Work Assignment for Public Sector Digital Services#Configure Service Requests service channel#Procedure#{26}":[471,475],"#Configure Advanced Work Assignment for Public Sector Digital Services#Related":[476,482],"#Configure Advanced Work Assignment for Public Sector Digital Services#Related#{1}":[478,478],"#Configure Advanced Work Assignment for Public Sector Digital Services#Related#{2}":[479,479],"#Configure Advanced Work Assignment for Public Sector Digital Services#Related#{3}":[480,480],"#Configure Advanced Work Assignment for Public Sector Digital Services#Related#{4}":[481,482]},"outlinks":[{"title":"Configure Social Benefit Requests service channel","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/government-industry/awa-psds-overview.md","line":71},{"title":"Install the Social Benefits Playbook application","target":"install-psds-social-benefits-playbook","line":81},{"title":"Configure License and Permits Requests service channel","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/government-industry/awa-psds-overview.md","line":175},{"title":"Install the License and Permit Request Playbook application","target":"install-psds-license-permit-request-playbook","line":185},{"title":"Configure Information Requests service channel","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/government-industry/awa-psds-overview.md","line":280},{"title":"Install the Information Request Playbook application","target":"install-psds-information-request-playbook","line":290},{"title":"Configure Service Requests service channel","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/government-industry/awa-psds-overview.md","line":385},{"title":"Install the Service Request Playbook application","target":"install-psds-service-request-playbook","line":395},{"title":"Install Social Benefits Playbook for Public Sector Digital Services","target":"install-psds-social-benefits-playbook","line":478},{"title":"Install License and Permit Playbook for Public Sector Digital Services","target":"install-psds-license-permit-request-playbook","line":479},{"title":"Install Information Request Playbook for Public Sector Digital Services","target":"install-psds-information-request-playbook","line":480},{"title":"Install Service Request Playbook for Public Sector Digital Services","target":"install-psds-service-request-playbook","line":481}],"metadata":{"title":"Configure Advanced Work Assignment for Public Sector Digital Services","description":"Use the Advanced Work Assignment \\(AWA\\) for Public Sector Digital Services feature to automatically assign work items to agents based on their availability, capacity, and skills. AWA for Public Sector Digital Services pushes work to qualified agents using work item queues, routing conditions, and assignment criteria that you define. Agents see their assignments in their Agent Workspace inbox.Use the ServiceNow Advanced Work Assignment \\(AWA\\) application to route and assign social benefits requests to designated agents.Change the default Social Benefit Requests service channel attributes in Advanced Work Assignment to control how public sector social benefit requests are routed and assigned to government agents.Use the ServiceNow Advanced Work Assignment \\(AWA\\) application to route and assign license/permit requests to designated agents.Change the default License and Permit Requests service channel attributes in Advanced Work Assignment to control how public sector license and permit requests are routed and assigned to government agents.Use the ServiceNow Advanced Work Assignment \\(AWA\\) application to route and assign information requests, such as public records requests, to designated agents.Change the default Information Requests service channel attributes in Advanced Work Assignment to control how public sector information requests are routed and assigned to government agents.Use the ServiceNow Advanced Work Assignment \\(AWA\\) application to route and assign public sector service requests, such as non-emergency requests, to designated agents.Change the default Service Requests service channel attributes in Advanced Work Assignment to control how public sector service requests are routed and assigned to government agents.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/government-industry/awa-psds-overview.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":16,"breadcrumb":["Case Routing and Assignment","Configure agent workspaces","Configure","Public Sector Digital Services \\(PSDS\\)"],"tags":["#government-industry","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/government-industry/awa-psds-overview.md"},
