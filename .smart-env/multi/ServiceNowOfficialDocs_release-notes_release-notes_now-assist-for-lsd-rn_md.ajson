","line":31},{"title":"Summarize a legal request or matter by using Now Assist for Legal Service Delivery \\(LSD\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/now-assist-lsd-summarize-case.md","line":38},{"title":"ServiceNow Store","target":"https://store.servicenow.com/sn_appstore_store.do#!/store/home","line":45},{"title":"ServiceNow Store version history release notes","target":"https://www.servicenow.com/docs/bundle/store-release-notes/page/release-notes/store/sn-store-release-notes.html","line":45},{"title":"Browser support","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/browser-support.md","line":49},{"title":"Legal Service Delivery","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/legal-management-overview.md","line":53},{"title":"Overview tab in Now Assist Admin","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/configuring-now-assist.md","line":57},{"title":"Now Assist","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/platform-now-assist-landing.md","line":61},{"title":"Now Assist skills","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/now-assist-skills.md","line":65},{"title":"Legal Service Delivery release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/lsd-rn-landing-page.md","line":70},{"title":"Now Assist and agentic AI release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/release-notes/now-assist-rn-landing.md","line":72}],"metadata":{"title":"Now Assist for Legal Service Delivery \\(LSD\\) release notes","description":"The ServiceNow Now Assist for Legal Service Delivery \\(LSD\\) application leverages generative AI capabilities to summarize a legal request or legal matter. This summary can help you understand context quickly so you can then refresh the summary and add context to the work notes. Now Assist for Legal Service Delivery \\(LSD\\) was enhanced and updated in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":2,"keywords":["Now Assist","AI Agents","generative AI","agentic AI"],"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/now-assist-for-lsd-rn.md"},
