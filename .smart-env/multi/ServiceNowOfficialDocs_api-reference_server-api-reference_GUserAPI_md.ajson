[395,426],"#GlideUser- Global#GlideUser - getUserByID \\(String id\\)#{1}":[397,426],"#GlideUser- Global#GlideUser - getUserRoles\\(\\)":[427,587],"#GlideUser- Global#GlideUser - getUserRoles\\(\\)#{1}":[429,587]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28},{"title":"getCompanyID\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":49},{"title":"getDisplayName\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":70},{"title":"getEmail\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":136},{"title":"getFirstName\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":177},{"title":"getID\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":198},{"title":"getLastName\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":239},{"title":"getName\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":289},{"title":"getRoles\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":318},{"title":"User specific language","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/r_UserSpecificLanguage.md","line":324},{"title":"getUserRoles\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":466},{"title":"hasRole\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":489},{"title":"isMemberOf\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideUserScopedAPI.md","line":585}],"metadata":{"title":"GlideUser - Global","description":"The GlideUser API provides methods to access information about the current user and current user roles.Returns the current user's company sys\\_id.Returns the current user's display name.Returns the display value of the user's session domain.Returns the identifier of the user's current session domain.Returns the user's email address.Returns the user's first name.Returns the sys\\_id of the current user.Returns the user's last name.Returns an iterator containing the list of all groups to which the user belongs. Only active groups are returned.Returns the user ID, or login name, of the current user.Returns a list of roles associated with the user. Includes explicitly granted roles, inherited roles, and roles acquired by group membership.Returns the current user's time zone label in the current user's preferred language.Returns the current user's time zone label in the specified language.Returns the user object associated with the passed-in user ID \\(sys\\_id in sys\\_user\\) or user\\_name.Returns the list of roles explicitly granted to the user.Determines if the current user has the specified role.Determines if the current user is an explicit member of the specified group. Only active groups are evaluated by this method.Determines if the current user is a member of the specified group. Only active groups are evaluated by this method.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/GUserAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[42,45],[63,66],[84,87],[111,115],[129,132],[168,170],[173,191],[194,230],[232,235],[255,258],[262,264],[282,285],[305,308],[312,314],[336,338],[342,344],[381,385],[389,393],[409,415],[419,425],[457,459],[462,482],[485,525],[528,532],[534,572],[575,579]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GUserAPI.md"},
