efining filter and aggregation criteria#Set the filtering conditions for security incidents#Procedure#{2}":[50,61],"#Defining filter and aggregation criteria#Set the filtering conditions for security incidents#Procedure#{3}":[62,63],"#Defining filter and aggregation criteria#Set the filtering conditions for security incidents#Procedure#{4}":[64,67],"#Defining filter and aggregation criteria#Set the filtering conditions for security incidents#Procedure#{5}":[68,70],"#Defining filter and aggregation criteria#Define aggregation conditions":[71,111],"#Defining filter and aggregation criteria#Define aggregation conditions#{1}":[73,74],"#Defining filter and aggregation criteria#Define aggregation conditions#Before you begin":[75,80],"#Defining filter and aggregation criteria#Define aggregation conditions#Before you begin#{1}":[77,80],"#Defining filter and aggregation criteria#Define aggregation conditions#About this task":[81,86],"#Defining filter and aggregation criteria#Define aggregation conditions#About this task#{1}":[83,86],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure":[87,107],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{1}":[89,90],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{2}":[91,92],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{3}":[93,94],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{4}":[95,96],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{5}":[97,98],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{6}":[99,100],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{7}":[101,102],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{8}":[103,104],"#Defining filter and aggregation criteria#Define aggregation conditions#Procedure#{9}":[105,107],"#Defining filter and aggregation criteria#Define aggregation conditions#What to do next":[108,111],"#Defining filter and aggregation criteria#Define aggregation conditions#What to do next#{1}":[110,111],"#Defining filter and aggregation criteria#Related":[112,117],"#Defining filter and aggregation criteria#Related#{1}":[114,114],"#Defining filter and aggregation criteria#Related#{2}":[115,115],"#Defining filter and aggregation criteria#Related#{3}":[116,117]},"outlinks":[{"title":"Microsoft Sentinel to Defender Migration Guide","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB2795226","line":30},{"title":"Security Incident Response","target":"sir-landing-page","line":30},{"title":"mapping","target":"mapping-logrhythm","line":83},{"title":"Observables","target":"c_Observables","line":95},{"title":"Security Incident Response","target":"sir-landing-page","line":114},{"title":"Mapping","target":"mapping-logrhythm","line":115},{"title":"Observables","target":"c_Observables","line":116}],"metadata":{"title":"Defining filter and aggregation criteria","description":"You can define and set filter conditions so that you can specify which incoming Microsoft Azure Sentinel incidents should create security incidents. You can also define additional incident field criteria that allows an incoming incident to be appended to an open security incident instead of creating an incident.Set the filtering conditions so that security incidents are created only when the filtering conditions match.Define additional incident aggregation criteria that aggregates an incoming incident to an existing SIR security incident instead of creating similar, potentially duplicate incidents. When you use field matching value criteria for each profile, this additional aggregation can reduce the number of active, overlapping security incidents by placing all related incidents data on a single security incident.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/filter-and-aggregation-criteria.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Microsoft Azure Sentinel integration","Security Incident Response integrations","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/security-incident-response/filter-and-aggregation-criteria.md"},
