ices#Procedure#{4}":[53,54],"#Keep native apps active during authentication on Android devices#Procedure#{5}":[55,56],"#Keep native apps active during authentication on Android devices#Procedure#{6}":[57,105],"#Keep native apps active during authentication on Android devices#Procedure#{7}":[106,108],"#Keep native apps active during authentication on Android devices#Procedure#{8}":[109,147],"#Keep native apps active during authentication on Android devices#Procedure#{9}":[148,149],"#Keep native apps active during authentication on Android devices#Procedure#{10}":[150,151],"#Keep native apps active during authentication on Android devices#Procedure#{11}":[152,153],"#Keep native apps active during authentication on Android devices#Procedure#{12}":[154,156],"#Keep native apps active during authentication on Android devices#Procedure#{13}":[157,158],"#Keep native apps active during authentication on Android devices#Related":[159,163],"#Keep native apps active during authentication on Android devices#Related#{1}":[161,161],"#Keep native apps active during authentication on Android devices#Related#{2}":[162,163]},"outlinks":[{"title":"Mobile Platform","target":"mobile-config-navigation","line":33},{"title":"Mobile properties","target":"mobile-properties","line":81},{"title":"Mobile properties","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/mobile/mobile-properties.md","line":157},{"title":"Mobile properties","target":"mobile-properties","line":161},{"title":"Mobile Platform","target":"mobile-config-navigation","line":162}],"metadata":{"title":"Keep native apps active during authentication on Android devices","description":"Use the preventAppKillOnAuth property on your ServiceNow instance to help prevent Android devices from killing the mobile app when put to background during login. Use this configuration to allow for a smoother authentication experience by keeping the app active until users complete or cancel the login process.","