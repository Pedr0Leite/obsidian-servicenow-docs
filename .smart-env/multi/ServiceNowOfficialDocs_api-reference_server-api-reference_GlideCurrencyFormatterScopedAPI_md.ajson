\)#{6}":[74,85],"#GlideCurrencyFormatter- Scoped#GlideCurrencyFormatter - format\\(String value, String currencyCode\\)":[86,150],"#GlideCurrencyFormatter- Scoped#GlideCurrencyFormatter - format\\(String value, String currencyCode\\)#{1}":[88,150],"#GlideCurrencyFormatter- Scoped#GlideCurrencyFormatter - setLocale\\(String language, String country\\)":[151,183],"#GlideCurrencyFormatter- Scoped#GlideCurrencyFormatter - setLocale\\(String language, String country\\)#{1}":[153,183],"#GlideCurrencyFormatter- Scoped#GlideCurrencyFormatter - setMaxFractionDigits\\(Number maxFractionDigits\\)":[184,211],"#GlideCurrencyFormatter- Scoped#GlideCurrencyFormatter - setMaxFractionDigits\\(Number maxFractionDigits\\)#{1}":[186,211],"#GlideCurrencyFormatter- Scoped#GlideCurrencyFormatter - setMinFractionDigits\\(Number minFractionDigits\\)":[212,238],"#GlideCurrencyFormatter- Scoped#GlideCurrencyFormatter - setMinFractionDigits\\(Number minFractionDigits\\)#{1}":[214,238]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":36}],"metadata":{"title":"GlideCurrencyFormatter - Scoped","description":"The GlideCurrencyFormatter API provides methods to format FX Currency strings.Instantiates a GlideCurrencyFormatter object and defines the format string to use to format FX Currency.Formats a specified currency value using the specified currency code.Sets the default language and country, which constitutes the locale, for the currency formatter.Sets the maximum number of digits to the right of the decimal point/decimal comma to return.Sets the minimum number of fraction digits \\(right of the decimal point/decimal comma\\) to return.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/GlideCurrencyFormatterScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[81,84],[137,143],[147,149],[168,176],[180,182],[198,204],[208,210],[224,230],[234,236]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/GlideCurrencyFormatterScopedAPI.md"},
