title":"Cloud Admin Portal","target":"cloud-admin-portal","line":41},{"title":"create a service account","target":"create-service-account","line":52},{"title":"configured AWS credentials at ServiceNow AI Platform","target":"aws-create-creds-cloud-mgt","line":88},{"title":"discovery status","target":"c_DiscoveryStatus","line":118},{"title":"AWS documentation","target":"https://aws.amazon.com/documentation/","line":140},{"title":"Control AWS access and permissions using policies","target":"aws-create-user-policy-cloud-mgt","line":142},{"title":"Set up an additional cloud account","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/cloud-configuration-governance/add-cloud-account-cloud-mgt.md","line":181},{"title":"Add an AWS service account to the cloud account","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/cloud-configuration-governance/aws-add-service-account-cloud-mgt.md","line":183},{"title":"Configure access to the AWS accounts using permanent AWS credentials","target":"aws-create-creds-cloud-mgt","line":187},{"title":"Control AWS access and permissions using policies","target":"aws-create-user-policy-cloud-mgt","line":188},{"title":"Discovery","target":"r-discovery","line":189},{"title":"Cloud Provisioning and Governance","target":"cloud-management-v2-landing-page","line":190},{"title":"Cloud Admin Portal","target":"cloud-admin-portal","line":191},{"title":"Cloud accounts","target":"cloud-accounts","line":192},{"title":"Create a service account","target":"create-service-account","line":193},{"title":"Discovery status","target":"c_DiscoveryStatus","line":194}],"metadata":{"title":"Set up a cloud account and service account for AWS","description":"A service account is a secure record on your instance that stores the credential and access information for your provider account. Discovery uses the information to access your provider account to get data on each resource in each specified datacenter. A cloud account is the logical representation in Cloud Provisioning and Governance of all or part of your managed cloud infrastructure. A cloud account can include multiple service accounts — even service accounts from different providers. For each service account, you specify which datacenters to include in the cloud account.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/cloud-configuration-governance/aws-first-cld-and-srvc-accts.html","release":"australia","product":"Cloud Configuration Governance","classification":"cloud-configuration-governance","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Day 1 setup guide for Amazon Web Services on Cloud Provisioning and Governance","Cloud Provisioning and Governance","ITOM Cloud Accelerate","IT Operations Management"],"tags":["#it-operations-management","#cloud-config","#drift","#compliance","#itom","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/cloud-configuration-governance/aws-first-cld-and-srvc-accts.md"},"smart_blocks:ServiceNowOfficialDocs/it-operations-management/cloud-configuration-governance/aws-first-cld-and-srvc-accts.md#---frontmatter---": {"path":null,"last_embed":{"hash":"1enitra","at":1784578167720},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[0.00572537,-0.07063951,-0.01368074,-0.03003488,0.00914546,0.01552357,0.04557853,-0.05098414,-0.00537671,0.03949295,0.01914208,-0.05318768,0.03587215,-0.03991639,0.04577486,-0.0233852,0.02286688,-0.00347906,-0.04387769,0.06962824,0.10874314,-0.02808974,-0.05001705,-0.03780551,-0.02385079,0.03532576,-0.00380659,-0.09659832,-0.04691874,-0.15599014,0.00552599,-0.11659773,-0.00858018,0.00090444,-0.0142991,-0.05159145,-0.02305806,0.04010825,-0.05201209,-0.02384071,0.06053284,-0.02905242,-0.04161662,-0.00219759,-0.09231288,-0.05725231,0.01440944,0.03850554,-