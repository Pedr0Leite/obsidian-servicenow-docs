d\\(\\)#{1}":[195,256],"#JSONStreamingBuilder- Scoped#JSONStreamingBuilder - expiresAt\\(Object expiresAt\\)":[257,342],"#JSONStreamingBuilder- Scoped#JSONStreamingBuilder - expiresAt\\(Object expiresAt\\)#{1}":[259,283],"#JSONStreamingBuilder- Scoped#JSONStreamingBuilder - expiresAt\\(Object expiresAt\\)#{2}":[284,285],"#JSONStreamingBuilder- Scoped#JSONStreamingBuilder - expiresAt\\(Object expiresAt\\)#{3}":[286,342],"#JSONStreamingBuilder- Scoped#JSONStreamingBuilder - withAttachment\\(\\)":[343,478],"#JSONStreamingBuilder- Scoped#JSONStreamingBuilder - withAttachment\\(\\)#{1}":[345,478]},"outlinks":[{"title":"Script step","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/javascript-step-action-designer.md","line":26},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":179},{"title":"GlideDateTime","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideDateTimeScoped.md","line":279}],"metadata":{"title":"JSONStreamingBuilder - Scoped","description":"Create a builder object used to build a large streaming JSON payload to use in a REST or SOAP request to send bulk data to a third-party API. You can also create the payload as a JSON string for a non-streaming option.Instantiates the JSONStreamingBuilder object.Returns a JSONStreamingAPI object.Sets a time when the attachment expires. Must also call the withAttachment\\(\\) method. If you do not call this method, the attachment expires two hours from the time the attachment is created.Creates the JSON object as a streaming attachment and stores it in the Streaming Attachments \\[streaming\\_attachment\\] table. If you do not call this method, the API creates the payload as a JSON string.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/JSONStreamingBuilderScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[63,111],[115,154],[158,177],[189,191],[207,255],[293,341],[357,405],[409,453],[457,476]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/JSONStreamingBuilderScopedAPI.md"},
