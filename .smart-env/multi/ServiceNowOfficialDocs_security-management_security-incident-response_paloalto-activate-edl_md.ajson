ocs/australia/markdown/security-management/security-incident-response/paloalto_activate_edl_manually.md","line":87},{"title":"Configure an EDL","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/paloalto-config_firewall_pa.md","line":92}],"metadata":{"title":"Activate an EDL for Palo Alto Networks Next-Generation Firewall","description":"After the External Dynamic List \\(EDL\\) has been created in your ServiceNow AI Platform and the URL is available, the Palo Alto Networks firewall administrator configures the EDL in the Palo Alto Networks Next-Generation Firewall. The retrieval URL is used by the Palo Alto Networks firewall administrator to configure the EDL in the Palo Alto Networks Next-Generation Firewall server. Before it can accept EDL entries, the EDL must be configured in Palo Alto Networks and activated in the ServiceNow AI Platform.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/paloalto-activate-edl.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Palo Alto Networks Next-Generation Firewall integration","Security Incident Response integrations","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/security-incident-response/paloalto-activate-edl.md"},
