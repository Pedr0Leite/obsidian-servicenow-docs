{8}":[116,117],"#NotifyClient- Client#NotifyClient - Client\\(Object notifyConfig, Boolean initializeVendorClientLazily\\)#{9}":[118,128],"#NotifyClient- Client#NotifyClient - Client\\(Object notifyConfig, Boolean initializeVendorClientLazily\\)#{10}":[129,130],"#NotifyClient- Client#NotifyClient - Client\\(Object notifyConfig, Boolean initializeVendorClientLazily\\)#{11}":[131,162],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)":[163,257],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{1}":[165,193],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{2}":[194,194],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{3}":[195,195],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{4}":[196,196],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{5}":[197,199],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{6}":[200,206],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{7}":[207,207],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{8}":[208,208],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{9}":[209,209],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{10}":[210,211],"#NotifyClient- Client#NotifyClient - addEventListener\\(String event, Function fn\\)#{11}":[212,257],"#NotifyClient- Client#NotifyClient - call\\(Object identifier\\)":[258,330],"#NotifyClient- Client#NotifyClient - call\\(Object identifier\\)#{1}":[260,330],"#NotifyClient- Client#NotifyClient - destroy\\(\\)":[331,342],"#NotifyClient- Client#NotifyClient - destroy\\(\\)#{1}":[333,342],"#NotifyClient- Client#NotifyClient - forwardCall\\(Object argument\\)":[343,375],"#NotifyClient- Client#NotifyClient - forwardCall\\(Object argument\\)#{1}":[345,375],"#NotifyClient- Client#NotifyClient - getAvailableClients\\(Function callback\\)":[376,687],"#NotifyClient- Client#NotifyClient - getAvailableClients\\(Function callback\\)#{1}":[378,687]},"outlinks":[{"title":"Client API reference","target":"api-client","line":24},{"title":"Notify-getAvailableClients\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_NotifyAPI.md","line":380},{"title":"update","target":"r_Update","line":592},{"title":"Client API reference","target":"api-client","line":685},{"title":"update","target":"r_Update","line":686}],"metadata":{"title":"NotifyClient - Client","description":"The NotifyClient API provides methods that enable you to use Notify telephony functionality, such as making and receiving calls from a web browser.Instantiates a new Notify WebRTC Client object.Registers an event handler to listen for changes in a Notify client.Calls the specified phone number or the phone number associated with a specified user.Kills the current Notify client, rendering it unusable.Forwards an ongoing incoming or outgoing phone call to either a different phone number or a different WebRTC client.Returns a list of clients available to accept calls.Returns the parent call identifier for a specified call identifier, if one exists.Returns the normalized status of the current call.End the current call.Initializes the client driver.Mute or unmute the current client.Answers and connects to an incoming call from a WebRTC client.Send one or more DTMF-valid digits over the current call.Sets the caller ID for the current client session.Sets the availability of an active WebRTC client agent.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/c\\_Notify2WebRTCClient.html","release":"australia","product":"API Reference","classification":"api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["Client API reference","API reference","API implementation and reference"],"tags":["#api-reference","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[134,161],[219,246],[250,256],[297,301],[305,309],[313,317],[321,329],[357,364],[368,374],[409,433],[435,439],[444,460],[462,478],[482,500],[506,544],[546,564],[568,584],[586,637]],"key":"ServiceNowOfficialDocs/api-reference/c_Notify2WebRTCClient.md"},
