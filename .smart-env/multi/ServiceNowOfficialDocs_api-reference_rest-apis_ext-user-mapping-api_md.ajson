26},{"title":"External content security for AI Search","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/external-content-security-ais.md","line":32},{"title":"External Content Ingestion API","target":"external-content-ingestion-api","line":34},{"title":"External Content Ingestion API","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/external-content-ingestion-api.md","line":34},{"title":"scripted REST APIs","target":"c_CustomWebServices","line":42},{"title":"Scripted REST Service form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":42},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":42},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":180},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":193},{"title":"External Content Ingestion API","target":"external-content-ingestion-api","line":381},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":382}],"metadata":{"title":"AI Search External User Mapping API","description":"The AI Search External User Mapping API provides endpoints that enable ingestion of user mapping information from external sources into the ServiceNow AI Search application's index.Imports a list of external user mappings into an AI Search user mapping table. Each mapping specifies externally defined user and group aliases for a ServiceNow AI Platform user. AI Search uses these aliases to determine which external document search results the user can view.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/ext-user-mapping-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[97,101],[113,121],[135,141],[155,161],[221,226],[297,330],[334,339],[345,369],[373,377]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/ext-user-mapping-api.md"},
