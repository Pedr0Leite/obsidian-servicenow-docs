AP field values#{1}":[85,92],"#LDAP scripting#Exclude particular LDAP users":[93,134],"#LDAP scripting#Exclude particular LDAP users#{1}":[95,134],"#LDAP scripting#Related":[135,138],"#LDAP scripting#Related#{1}":[137,138]},"outlinks":[{"title":"users","target":"users","line":43},{"title":"Users","target":"users","line":137}],"metadata":{"title":"LDAP scripting","description":"Create custom transform maps, scripts, and business rules to specify requirements when importing data.Use the following script to automatically deactivate users when the associated AD user is disabled.You can use a script to assign a value to any field for which there is a field mapping.If you cannot completely filter the LDAP user list using LDAP filter properties, you can exclude users with a map script.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/ldap-integration/r\\_CommonLDAPScripts.html","release":"australia","product":"LDAP integration","classification":"ldap-integration","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Import and map data","LDAP integration","Authentication","Access Management"],"tags":["#platform-security","#ldap","#active-directory","#sync","#authentication","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[30,33],[37,39],[72,80],[89,91],[99,101],[105,113],[117,133]],"key":"ServiceNowOfficialDocs/platform-security/ldap-integration/r_CommonLDAPScripts.md"},
