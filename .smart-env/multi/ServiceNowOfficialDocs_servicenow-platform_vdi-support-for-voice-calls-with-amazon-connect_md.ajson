onfigure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Admin Use Case":[32,68],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Admin Use Case#{1}":[34,35],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Admin Use Case#{2}":[36,60],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Admin Use Case#{3}":[61,66],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Admin Use Case#{4}":[67,68],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Related":[69,75],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Related#{1}":[71,71],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Related#{2}":[72,72],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Related#{3}":[73,73],"#Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect#Related#{4}":[74,75]},"outlinks":[{"title":"Connect","target":"c_Connect","line":18},{"title":"reference","target":"reference","line":42},{"title":"Optimize Amazon Connect audio for Amazon WorkSpaces cloud desktops","target":"https://docs.aws.amazon.com/connect/latest/adminguide/using-ccp-vdi-workspaces.html","line":44},{"title":"Amazon Connect audio optimization for WorkSpaces","target":"https://docs.aws.amazon.com/connect/latest/adminguide/using-ccp-vdi-workspaces.html","line":45},{"title":"Use Amazon Connect in a VDI environment","target":"https://docs.aws.amazon.com/connect/latest/adminguide/using-ccp-vdi.html","line":48},{"title":"Setup network to use the Amazon Connect CCP","target":"https://docs.aws.amazon.com/connect/latest/adminguide/ccp-networking.html","line":49},{"title":"System settings for Amazon Connect with Citrix VDI","target":"https://docs.aws.amazon.com/connect/latest/adminguide/using-ccp-vdi-citrix-step-by-step.html","line":50},{"title":"Optimize Amazon Connect audio for Omnissa cloud desktops","target":"https://docs.aws.amazon.com/connect/latest/adminguide/using-ccp-vdi-omnissa-step-by-step.html","line":51},{"title":"ServiceNow Voice","target":"cloud-call-center-overview","line":62},{"title":"Integrate ServiceNow Voice with Amazon Connect","target":"integrate-ccc-amazonconnect","line":67},{"title":"Integrate ServiceNow Voice with Amazon Connect","target":"integrate-ccc-amazonconnect","line":71},{"title":"Connect","target":"c_Connect","line":72},{"title":"Reference","target":"reference","line":73},{"title":"ServiceNow Voice","target":"cloud-call-center-overview","line":74}],"metadata":{"title":"Configure a Virtual Desktop Infrastructure \\(VDI\\) for voice calls with Amazon Connect","description":"Contact centers commonly use Virtual Desktop Infrastructure \\(VDI\\) to optimize agent usage of browser applications. This feature enables agents to use ServiceNow and the Amazon Connect Contact Control Panel \\(CCP\\) within a VDI environment, taking both inbound and outbound calls without disruption. Administrators can configure groups of agents to use either VDI or non-VDI browsers based on OpenFrame configuration values.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/vdi-support-for-voice-calls-with-amazon-connect.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Integrate ServiceNow Voice with Amazon Connect","Integrating Voice with other applications","ServiceNow Voice","Manage people and work capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/vdi-support-for-voice-calls-with-amazon-connect.md"},
