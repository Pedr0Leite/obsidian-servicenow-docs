n and Workflow#Workflows and delegated administration":[57,66],"#Domain separation and Workflow#Workflows and delegated administration#{1}":[59,66],"#Domain separation and Workflow#Workflow permissions":[67,72],"#Domain separation and Workflow#Workflow permissions#{1}":[69,72],"#Domain separation and Workflow#Related":[73,78],"#Domain separation and Workflow#Related#{1}":[75,75],"#Domain separation and Workflow#Related#{2}":[76,76],"#Domain separation and Workflow#Related#{3}":[77,78]},"outlinks":[{"title":"Domain separation","target":"domain-separation-relationship-formatter-editor","line":23},{"title":"workflow activities","target":"c_WorkflowActivities","line":35},{"title":"Process administration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_DelegatedAdministration.md","line":41},{"title":"Understanding domain separation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_DomainSeparation.md","line":42},{"title":"Workflow Editor","target":"workflow-editor","line":46},{"title":"Workflow concepts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/legacy-workflow/c_WorkflowConcepts.md","line":50},{"title":"Domain separation for service providers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-sep-landing-page.md","line":55},{"title":"Domain separation","target":"domain-separation-relationship-formatter-editor","line":75},{"title":"Workflow activities","target":"c_WorkflowActivities","line":76},{"title":"Workflow editor","target":"workflow-editor","line":77}],"metadata":{"title":"Domain separation and Workflow","description":"Domain separation is supported in the Workflow application. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.Delegated administration allows child domains to inherit workflows from higher up the domain hierarchy and to override them with domain-specific versions if necessary.When a user starts a new workflow, the workflow runs with that user's domain and credentials.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/legacy-workflow/c\\_WorkflowsAndDomainSeparation.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Workflow concepts","Classic Workflow","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#legacy-workflow","#classic","#deprecated","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/legacy-workflow/c_WorkflowsAndDomainSeparation.md"},
