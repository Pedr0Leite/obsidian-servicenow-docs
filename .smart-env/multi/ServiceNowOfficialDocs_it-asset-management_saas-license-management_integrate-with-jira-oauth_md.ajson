ustralia/markdown/it-asset-management/software-asset-management/run-recon-workspace.md","line":425},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":429},{"title":"SaaS License Management","target":"sam-subscription-management","line":430},{"title":"Using Software Asset Workspace","target":"using-sam-workspace","line":431},{"title":"Software Asset Workspace","target":"sam-workspace","line":432},{"title":"Software reclamation rules","target":"sw-reclamation-rules","line":433},{"title":"Software models","target":"c_CreatingSoftwareModels","line":434}],"metadata":{"title":"Integrate with Jira Software Cloud using OAuth 2.0","description":"Integrate the Software Asset Management application with your Jira account using OAuth to authenticate ServiceNow requests.Create an OAuth 2.0 integration in the Atlassian Developer console to authenticate the requests.Obtain the value of the Cloud ID of the Jira cloud instance. This value is required during the configuration of the connection record in your ServiceNow instance.Create an integration profile to track software subscriptions and optimize licensing for Atlassian Jira Software Cloud.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/saas-license-management/integrate-with-jira-oauth.html","release":"australia","product":"SaaS License Management","classification":"saas-license-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["Integrating with Jira Software Cloud","Integrate with SaaS applications","SaaS License Management","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#saas","#license-management","#discovery","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/saas-license-management/integrate-with-jira-oauth.md"},
