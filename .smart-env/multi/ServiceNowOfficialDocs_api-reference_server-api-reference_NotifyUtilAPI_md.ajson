alidateOutboundNotifyPhoneNumber\\(String number\\)#{1}":[556,559],"#NotifyUtil- Global#NotifyUtil - validateOutboundNotifyPhoneNumber\\(String number\\)#{2}":[560,560],"#NotifyUtil- Global#NotifyUtil - validateOutboundNotifyPhoneNumber\\(String number\\)#{3}":[561,561],"#NotifyUtil- Global#NotifyUtil - validateOutboundNotifyPhoneNumber\\(String number\\)#{4}":[562,563],"#NotifyUtil- Global#NotifyUtil - validateOutboundNotifyPhoneNumber\\(String number\\)#{5}":[564,609],"#NotifyUtil- Global#NotifyUtil - validatePhoneNumber\\(String number\\)":[610,674],"#NotifyUtil- Global#NotifyUtil - validatePhoneNumber\\(String number\\)#{1}":[612,633],"#NotifyUtil- Global#NotifyUtil - validatePhoneNumber\\(String number\\)#{2}":[634,634],"#NotifyUtil- Global#NotifyUtil - validatePhoneNumber\\(String number\\)#{3}":[635,636],"#NotifyUtil- Global#NotifyUtil - validatePhoneNumber\\(String number\\)#{4}":[637,674]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":36},{"title":"Notify","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/notify-landing-page.md","line":57},{"title":"GlideRecord - Global","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_GlideRecordAPI.md","line":253}],"metadata":{"title":"NotifyUtil - Global","description":"The NotifyUtil script include provides utility methods to use when interacting with Notify calls and SMS messages using server-side scripts.Instantiates a NotifyUtil class object.Returns all of the Notify telephone numbers and related Notify information from a specified source record, such as an incident.Returns the SMS-capable number associated with the specified Notify user.Returns a list of unique Notify telephone numbers.Determines whether there are any active conference calls for the specified source record.Validates a specified Notify telephone number.Verifies that the specified number is a valid E.164 telephone number.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/NotifyUtilAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[48,51],[149,157],[212,229],[266,298],[417,424],[468,513],[545,552],[576,608],[640,672]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/NotifyUtilAPI.md"},
