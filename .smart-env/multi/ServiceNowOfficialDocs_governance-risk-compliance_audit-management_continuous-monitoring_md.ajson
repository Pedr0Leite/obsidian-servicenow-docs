ance-risk-compliance/audit-management/c_AuditEngagementOverview.md","line":32},{"title":"Engagement Overview","target":"c_AuditEngagementOverview","line":33},{"title":"Audit Management","target":"c_GRCAudits","line":33},{"title":"Create a GRC indicator","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/audit-management/t_CreateAnIndicator.md","line":34},{"title":"Create a GRC indicator template","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/audit-management/t_CreateIndicatorTemplate.md","line":36},{"title":"Using Audit Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/governance-risk-compliance/audit-management/using-audit-management.md","line":39},{"title":"Engagement Overview","target":"c_AuditEngagementOverview","line":43},{"title":"Audit Management","target":"c_GRCAudits","line":44}],"metadata":{"title":"Manage GRC key risk and control indicators","description":"Continuous monitoring involves activities related to identifying and creating key risk and controls indicators. Supporting information can be collected for those indicators through automatic data collection or manual tasks. Indicator results are then used to create issues for controls, update risk scores, and provide supporting information for audit activities and control testing.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/audit-management/continuous-monitoring.html","release":"australia","product":"Audit Management","classification":"audit-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Audit Management Overview","Audit Management","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#audit","#findings","#grc","#compliance","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],