-security/access-control-rules.md","line":29},{"title":"Query ACLs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/query-acl-rule.md","line":33},{"title":"ACL rule types","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/acl-rule-types.md","line":41},{"title":"Access Analyzer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/access-analyzer.md","line":46},{"title":"ServiceNow Store","target":"https://store.servicenow.com/store","line":50},{"title":"ServiceNow AI Platform security release notes","target":"now-platform-security-rn-landing","line":57},{"title":"ServiceNow AI Platform security release notes","target":"now-platform-security-rn-landing","line":61}],"metadata":{"title":"Access Management release notes","description":"The ServiceNow Access Management application provides robust tools to manage security data on the ServiceNow AI Platform. Access Management includes many controls, such as access control lists \\(ACLs\\), Security Attributes, Security Data Filters, and Machine Identity Access Control. These controls provide granular control and help improve security for managing data access. Access Management was enhanced and updated in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":1,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/release-notes/release-notes/access-management-rn.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"d4goab","at":1784561346803},"key":"ServiceNowOfficialDocs/release-notes/release-notes/access-management-rn.md#---frontmatter---","lines":[1,15],"size":692,"outlinks":[],"class_name":"