/ServiceNowDocs/australia/markdown/release-notes/hr-service-delivery-landing.md","line":53},{"title":"Employee Service Management","target":"https://mynow.servicenow.com/now/best-practices/collections/employee-service-management-best-practices","line":54},{"title":"ServiceNow University","target":"https://learning.servicenow.com/lxp/en/pages/servicenow","line":55},{"title":"Customer Success Center","target":"https://www.servicenow.com/success.html","line":56},{"title":"Now Community","target":"https://www.servicenow.com/community/","line":57},{"title":"Employee Center","target":"employee-center-landing-page","line":61}],"metadata":{"title":"Journey Accelerator","description":"Administrators can use the ServiceNow Journey Accelerator application to create templates for plans and to-do tasks. Managers then use the templates to create and publish customized plans for key employee transitions. Managers, employees, and mentors can access the plans from the Employee Center \\(EC\\).","locale":"en-US","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"tags":["#employee-service-management","#esm","#hr","#service-delivery","#platform","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/employee-service-management/employee-service-management/journey-accelerator-1.md"},
