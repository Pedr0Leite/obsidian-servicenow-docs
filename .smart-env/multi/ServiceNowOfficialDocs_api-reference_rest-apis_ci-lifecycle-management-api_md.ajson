rget":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":2506},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":2506},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2537},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2570},{"title":"Scripted REST Service form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_CustomWebServices.md","line":2739},{"title":"REST API Explorer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":2739},{"title":"CI Lifecycle Management - POST /now/cilifecyclemgmt/operators","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/ci-lifecycle-management-api.md","line":2790},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2809},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":2842},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":2998},{"title":"REST APIs","target":"c_RESTAPI","line":2999}],"metadata":{"title":"CI Lifecycle Management API","description":"The CI Lifecycle Management API provides endpoints to manipulate configuration item \\(CI\\) operational states and apply CI actions.Removes a configuration item \\(CI\\) action for a list of CIs.Unregisters an operator for non-workflow users.Returns a list of active configuration item \\(CI\\) actions for the specified CI.Determines whether two specified configuration item \\(CI\\) actions are compatible.Determines whether the lease has expired for the requestor of a configuration item \\(CI\\) action applied to the specified CI.Determines whether a specified configuration item \\(CI\\) action is not allowed for a CI of a specified class when in a specified operational state.Determines whether a configuration item \\(CI\\) from a specified class can transition from a specified operational state to a second specified operational state.Determines whether the specified active workflow user or registered user is a valid requestor.Returns the current operational state for the specified configuration item \\(CI\\).Extends the specified configuration item \\(CI\\) action's lease expiration time for the specified user.Adds a specified configuration item \\(CI\\) action to a specified list of CIs.Registers an operator for a non-workflow user.Sets the operational state for a specified list of configuration items \\(CIs\\).","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/ci-lifecycle-management-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":37,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[182,187],[197,204],[263,268],[272,278],[411,416],[426,433],[492,497],[501,507],[638,643],[661,668],[725,730],[734,743],[897,902],[906,910],[1064,1069],[1079,1086],[1143,1148],[1152,1158],[1320,1325],[1329,1333],[1495,1500],[1504,1508],[1641,1646],[1656,1663],[1720,1725],[1727,1733],[1864,1869],[1879,1886],[1938,1942],[1944,1951],[2125,2130],[2140,2147],[2206,2211],[2213,2219],[2399,2404],[2414,2421],[2480,2486],[2488,2494],[2625,2630],[2640,2647],[2712,2718],[2720,2727],[2897,2902],[2912,2919],[2978,2984],[2988,2994]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/ci-lifecycle-management-api.md"},
