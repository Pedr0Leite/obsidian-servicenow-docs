y - getRoot\\(\\)#{1}":[144,164],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - getTables\\(\\)":[165,187],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - getTables\\(\\)#{1}":[167,187],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - getTableExtensions\\(\\)":[188,212],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - getTableExtensions\\(\\)#{1}":[190,212],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - isBaseClass\\(\\)":[213,235],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - isBaseClass\\(\\)#{1}":[215,235],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - isSoloClass\\(\\)":[236,258],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - isSoloClass\\(\\)#{1}":[238,258],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - hasExtensions\\(\\)":[259,282],"#GlideTableHierarchy- Scoped#GlideTableHierarchy - hasExtensions\\(\\)#{1}":[261,282]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":26}],"metadata":{"title":"GlideTableHierarchy - Scoped","description":"The GlideTableHierarchy API provides methods for handling information about table relationships.Instantiates a GlideTableHierarchy object.Returns an array of strings containing all tables that extend the current table and includes the current table.Returns the parent class.Returns an array of strings containing all classes in the hierarchy of the current table.Returns the table's name.Returns the top level class in the hierarchy.Returns an array of strings of the table names in the hierarchy.Returns an array of strings containing all tables that extend the current table.Returns true if this is a base class.Returns true if this table is not in a hierarchy.Returns true of this class has been extended.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_GlideTableHierarchyScopedAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[36,39],[43,45],[59,62],[66,71],[85,88],[92,94],[108,111],[115,117],[131,134],[138,140],[154,157],[161,163],[177,180],[184,186],[200,203],[207,211],[225,228],[232,234],[248,251],[255,257],[271,274],[278,280]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_GlideTableHierarchyScopedAPI.md"},
