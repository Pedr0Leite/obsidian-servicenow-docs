lication-development/automated-test-framework-atf/test-steps-email-category.md","line":30},{"title":"Validate Outbound Email Generated by Notification","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/test-steps-email-category.md","line":30},{"title":"Application scope","target":"c_ApplicationScope","line":54},{"title":"Validate Outbound Email Generated by Notification","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/test-steps-email-category.md","line":111},{"title":"Validate Outbound Email","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/automated-test-framework-atf/test-steps-email-category.md","line":111},{"title":"System email log and mailboxes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/r_EmailLogs.md","line":392},{"title":"System email log and mailboxes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/r_EmailLogs.md","line":520},{"title":"Automated Test Framework \\(ATF\\)","target":"atf-landing-page","line":598},{"title":"Notifications","target":"notifications","line":599},{"title":"Application scope","target":"c_ApplicationScope","line":600}],"metadata":{"title":"Email category","description":"Use Automated Test Framework \\(ATF\\) to test email notifications, outbound email flows, and inbound email responses.Verify that a certain outbound email exists by searching for it in the Email \\[sys\\_email\\] table.Verify that a certain outbound email exists by searching for it in the Email \\[sys\\_email\\] table. Use this step to test that a flow is triggered as expected.Verify that a certain outbound email exists by searching for it in the Email \\[sys\\_email\\] table. Use this step to test that an email notification is triggered as expected.Create an incoming email record to test an inbound email flow or an inbound email action.Create a reply email record to test how the system handles a user response to an email notification.Generate a string of random alphanumeric characters that you can use as test data for another step.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/automated-test-framework-atf/test-steps-email-category.html","release":"australia","product":"Automated Test Framework \\(ATF\\)","classification":"automated-test-framework-atf","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Automated Test Framework \\(ATF\\) test step categories","Automated Test Framework \\(ATF\\)","Testing and debugging applications","Building applications"],"tags":["#application-development","#atf","#testing","#automated-tests","#test-suites","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/application-development/automated-test-framework-atf/test-steps-email-category.md"},
