ests through the proxy#Before you begin":[79,86],"#Increase debug logging for the Edge Encryption proxy#Logging timing metrics for requests through the proxy#Before you begin#{1}":[81,86],"#Increase debug logging for the Edge Encryption proxy#Logging timing metrics for requests through the proxy#Procedure":[87,112],"#Increase debug logging for the Edge Encryption proxy#Logging timing metrics for requests through the proxy#Procedure#{1}":[89,109],"#Increase debug logging for the Edge Encryption proxy#Logging timing metrics for requests through the proxy#Procedure#{2}":[91,109],"#Increase debug logging for the Edge Encryption proxy#Logging timing metrics for requests through the proxy#Procedure#{3}":[110,112],"#Increase debug logging for the Edge Encryption proxy#Logging timing metrics for requests through the proxy#Result":[113,151],"#Increase debug logging for the Edge Encryption proxy#Logging timing metrics for requests through the proxy#Result#{1}":[115,151],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance":[152,187],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#{1}":[154,155],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Before you begin":[156,161],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Before you begin#{1}":[158,161],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Procedure":[162,183],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Procedure#{1}":[164,165],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Procedure#{2}":[166,178],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Procedure#{3}":[168,178],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Procedure#{4}":[179,180],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Procedure#{5}":[181,183],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Result":[184,187],"#Increase debug logging for the Edge Encryption proxy#Debug issues with SSL connectivity between the Edge Encryption proxy and the instance#Result#{1}":[186,187],"#Increase debug logging for the Edge Encryption proxy#Related":[188,196],"#Increase debug logging for the Edge Encryption proxy#Related#{1}":[190,190],"#Increase debug logging for the Edge Encryption proxy#Related#{2}":[191,191],"#Increase debug logging for the Edge Encryption proxy#Related#{3}":[192,192],"#Increase debug logging for the Edge Encryption proxy#Related#{4}":[193,193],"#Increase debug logging for the Edge Encryption proxy#Related#{5}":[194,194],"#Increase debug logging for the Edge Encryption proxy#Related#{6}":[195,196]},"outlinks":[{"title":"logs","target":"logs","line":24},{"title":"Edge Encryption","target":"edge-encryption","line":26},{"title":"metrics","target":"ca-metrics","line":31},{"title":"Configuring Edge Encryption","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/edge-encryption/edge-config.md","line":36},{"title":"request","target":"c_requestAPI","line":77},{"title":"encryption","target":"encryption-landing","line":77},{"title":"policies","target":"ca-policies","line":98},{"title":"Logs","target":"logs","line":190},{"title":"Edge Encryption","target":"edge-encryption","line":191},{"title":"Metrics","target":"ca-metrics","line":192},{"title":"request","target":"c_requestAPI","line":193},{"title":"Encryption","target":"encryption-landing","line":194},{"title":"Policies","target":"ca-policies","line":195}],"metadata":{"title":"Increase debug logging for the Edge Encryption proxy","description":"Increase the level of logging to interpret the logs and debug issues with the proxy.Use this method to debug issues with the Edge Encryption application, without stopping and restarting the proxy. These steps increase logging level and help troubleshooting the root cause with more verbose log statements.Enable timing metric logging to add a metric statement for each request handled by the Edge Encryption proxy. Each of these timing metric log statements contains useful information about the request, such as processing times and which encryption rule was used.Use this method to debug issues with SSL connectivity between the Edge Encryption proxy and your instance, such as access to the instance fails via the proxy. These steps increase logging and help find the verbose log statements.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/edge-encryption/edge-debug-logging.html","release":"australia","product":"Edge Encryption","classification":"edge-encryption","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Configuring Edge Encryption","Edge Encryption","Encryption"],"tags":["#platform-security","#edge-encryption","#field-level","#proxy","#security","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[52,54],[58,60],[91,108],[117,120],[124,150],[168,171],[175,177]],"key":"ServiceNowOfficialDocs/platform-security/edge-encryption/edge-debug-logging.md"},
