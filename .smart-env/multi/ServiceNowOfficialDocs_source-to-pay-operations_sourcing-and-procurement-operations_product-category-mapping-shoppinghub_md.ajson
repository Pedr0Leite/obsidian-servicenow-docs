ing#Procedure#{2}":[118,119],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Create third-party category mapping#Procedure#{3}":[120,121],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Create third-party category mapping#Procedure#{4}":[122,164],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Create third-party category mapping#Procedure#{5}":[165,166],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Create third-party category mapping#Procedure#{6}":[167,168],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Related":[169,175],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Related#{1}":[171,171],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Related#{2}":[172,172],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Related#{3}":[173,173],"#Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub#Related#{4}":[174,175]},"outlinks":[{"title":"purchase order lines","target":"purchase-order-lines","line":24},{"title":"purchase requisition","target":"purchase-requisition","line":24},{"title":"Shopping Hub","target":"shopping-hub-overview","line":24},{"title":"Configure punchout for third-party site purchases","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/configure-supplier-punchout.md","line":28},{"title":"supplier","target":"supplier","line":32},{"title":"Shopping Hub","target":"shopping-hub-overview","line":171},{"title":"Purchase order lines","target":"purchase-order-lines","line":172},{"title":"Purchase requisition","target":"purchase-requisition","line":173},{"title":"Supplier","target":"supplier","line":174}],"metadata":{"title":"Mapping Product Categories and Units of Measure for seamless checkout in Shopping Hub","description":"You can map the product categories and units of measure for third-party products to the corresponding model categories. This ensures that during checkout, Shopping Hub accurately considers and displays the product category for the purchase order lines \\(POL\\) and purchase requisition lines \\(PRL\\) based on your predefined mappings.Create a third-party unit mapping to align the punchout supplier's unit of measure with the predefined units of measure.Create a third-party product category mapping to map the punchout supplier's product category to SPO's model category.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/source-to-pay-operations/sourcing-and-procurement-operations/product-category-mapping-shoppinghub.html","release":"australia","product":"Sourcing and Procurement Operations","classification":"sourcing-and-procurement-operations","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Configure punchout third-party site purchases","Configure","Sourcing and Procurement Operations","Finance and Supply Chain"],"tags":["#source-to-pay-operations","#sourcing","#procurement","#rfx","#s2p","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/source-to-pay-operations/sourcing-and-procurement-operations/product-category-mapping-shoppinghub.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"6uzslh","at":1784561348735},"key":"ServiceNowOfficialDocs/source-to-pay-operations/sourcing-and-procurement-operations/product-category-mapping-shoppinghub.md#---frontmatter---","lines":[1,20],"size":1269,"outlinks":[],"class_name":"SmartBlock"},
