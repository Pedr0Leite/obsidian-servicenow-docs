rocedure#{1}":[156,157],"#Managing user sessions#Lock out a user#Procedure#{2}":[158,160],"#Managing user sessions#Mark a user inactive":[161,181],"#Managing user sessions#Mark a user inactive#{1}":[163,164],"#Managing user sessions#Mark a user inactive#Before you begin":[165,168],"#Managing user sessions#Mark a user inactive#Before you begin#{1}":[167,168],"#Managing user sessions#Mark a user inactive#About this task":[169,174],"#Managing user sessions#Mark a user inactive#About this task#{1}":[171,174],"#Managing user sessions#Mark a user inactive#Procedure":[175,181],"#Managing user sessions#Mark a user inactive#Procedure#{1}":[177,178],"#Managing user sessions#Mark a user inactive#Procedure#{2}":[179,181],"#Managing user sessions#Terminate a user session":[182,203],"#Managing user sessions#Terminate a user session#{1}":[184,185],"#Managing user sessions#Terminate a user session#Before you begin":[186,189],"#Managing user sessions#Terminate a user session#Before you begin#{1}":[188,189],"#Managing user sessions#Terminate a user session#Procedure":[190,203],"#Managing user sessions#Terminate a user session#Procedure#{1}":[192,193],"#Managing user sessions#Terminate a user session#Procedure#{2}":[194,195],"#Managing user sessions#Terminate a user session#Procedure#{3}":[196,197],"#Managing user sessions#Terminate a user session#Procedure#{4}":[198,199],"#Managing user sessions#Terminate a user session#Procedure#{5}":[200,203],"#Managing user sessions#Related":[204,210],"#Managing user sessions#Related#{1}":[206,206],"#Managing user sessions#Related#{2}":[207,207],"#Managing user sessions#Related#{3}":[208,208],"#Managing user sessions#Related#{4}":[209,210]},"outlinks":[{"title":"reference","target":"reference-email-admin","line":30},{"title":"Monitoring user activity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/user-administration/user-admin-tools-landing.md","line":32},{"title":"System Properties","target":"r_SetArchiveRuleProcessingBehavior","line":50},{"title":"Configure a maximum active time for integration sessions","target":"managing-integration-sessions","line":64},{"title":"Change the default value of the Remember me check box","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_ChSetRemMeChkbxCookie.md","line":105},{"title":"Log in to an instance","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/t_LoggingIn.md","line":105},{"title":"Modify integration session timeout after inactivity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/managing-integration-sessions.md","line":119},{"title":"User Administration","target":"c_UserAdministration","line":156},{"title":"Managing integration sessions","target":"managing-integration-sessions","line":206},{"title":"Reference","target":"reference-email-admin","line":207},{"title":"System properties","target":"r_SetArchiveRuleProcessingBehavior","line":208},{"title":"User administration","target":"c_UserAdministration","line":209}],"metadata":{"title":"Managing user sessions","description":"The ServiceNow AI Platform provides the ability to view and terminate individual user sessions, lock out users from the system, and make users inactive.Secure your instance by enforcing a maximum time for sessions regardless of user activity.Specify when to time out user sessions after a period of inactivity.Configure how much time users have to extend a session before it times out due to inactivity.Lock out a user when you don’t want the user to access the instance.You can mark a user inactive so the user doesn't show up in any fields that reference active users on the User table.You can terminate a user session, for example, if you’re going to perform system maintenance and users are still logged in.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/user-administration/c\\_ManageUserSessions.html","release":"australia","product":"User Administration","classification":"user-administration","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Monitoring user activity","User administration","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#users","#groups","#roles","#access","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/user-administration/c_ManageUserSessions.md"},
