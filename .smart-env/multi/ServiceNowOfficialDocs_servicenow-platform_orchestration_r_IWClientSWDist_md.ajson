 software distribution#Related#{4}":[327,328]},"outlinks":[{"title":"Client Software Distribution","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_ClientSoftwareDistribution.md","line":26},{"title":"Client Software Distribution","target":"c_ClientSoftwareDistribution","line":30},{"title":"Request client software distribution","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_ActivateClientSWDistribution.md","line":52},{"title":"lease functionality","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateLicsAndCountsForDistSW.md","line":76},{"title":"Service Catalog","target":"service-catalog","line":76},{"title":"Reference","target":"reference","line":165},{"title":"revoked","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/c_SCCMSoftwareRevocation.md","line":241},{"title":"notify","target":"notify-landing-page","line":287},{"title":"SCCM Server Instance record","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_RetrieveSCCMDataClientSWDist.md","line":305},{"title":"Using extension points to extend application functionality","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/extension-points.md","line":314},{"title":"Using scripted extension points in server-side scripts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/scripted-extension-points.md","line":316},{"title":"Using UI extension points in server-side UI macros","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/ui-extension-points.md","line":318},{"title":"Using client extension points in client-side UI scripting","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/web-services/client-extension-points.md","line":320},{"title":"Client Software Distribution","target":"c_ClientSoftwareDistribution","line":324},{"title":"Service Catalog","target":"service-catalog","line":325},{"title":"Reference","target":"reference","line":326},{"title":"Notify","target":"notify-landing-page","line":327}],"metadata":{"title":"Installed with client software distribution","description":"Several types of components are installed with client software distribution \\(CSD\\).These tables are installed with the Orchestration - Client Software Distribution plugin \\(com.snc.orchestration.client\\_sf\\_distribution\\).These plugins are installed with the Orchestration - Client Software Distribution plugin, if they are not already active.These roles are installed with the Orchestration - Client Software Distribution plugin.These script includes are installed with the Orchestration - Client Software Distribution pluginProperties for client software distribution \\(CSD\\) manage the installation status of requested software deployments and configure scheduled Discoveries.These workflows are installed with the Orchestration - Client Software Distribution plugin","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/orchestration/r\\_IWClientSWDist.html","release":"australia","product":"Orchestration","classification":"orchestration","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Client Software Distribution","Orchestration applications","Classic Orchestration","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#orchestration","#itpa","#automation","#runbooks","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"