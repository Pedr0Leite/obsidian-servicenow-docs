lated#{1}":[160,160],"#Sample configuration for integrating external knowledge content#Related#{2}":[161,162]},"outlinks":[{"title":"Knowledge Management","target":"knowledge-management","line":28},{"title":"Integration with external knowledge sources","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/knowledge-external-content-integration.md","line":30},{"title":"connect","target":"c_Connect","line":34},{"title":"Import content from an external knowledge source","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/run-import-job-external-content-integration.md","line":149},{"title":"Open knowledge search results in source system","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/knowledge-management/open-search-results-ext-content.md","line":154},{"title":"Knowledge Management","target":"knowledge-management","line":160},{"title":"Connect","target":"c_Connect","line":161}],"metadata":{"title":"Sample configuration for integrating external knowledge content","description":"You can integrate content from multiple external sources so your users can acquire and search knowledge from a single location. Use this sample configuration to create a connection to your external account, configure external knowledge sources, and import content to enable search results for unified content.Create authentication credentials and a connection alias to connect your external knowledge source to the ServiceNow Knowledge Management application. Define import parameters for your external source to import integrated content.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/knowledge-management/sample-ext-cont-integration.html","release":"australia","product":"Knowledge Management","classification":"knowledge-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Integration with external knowledge sources","Configuring Knowledge Management","Knowledge Management","Manage content capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#knowledge-management","#kb","#articles","#search","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/knowledge-management/sample-ext-cont-integration.md"},
