eplacement list#{4}":[3507,3792],"#Packages Call Removal Tool#Glide object replacement list#{5}":[3793,3793],"#Packages Call Removal Tool#Glide object replacement list#{6}":[3794,3795],"#Packages Call Removal Tool#Glide object replacement list#{7}":[3796,6059],"#Packages Call Removal Tool#Related":[6060,6065],"#Packages Call Removal Tool#Related#{1}":[6062,6062],"#Packages Call Removal Tool#Related#{2}":[6063,6063],"#Packages Call Removal Tool#Related#{3}":[6064,6065]},"outlinks":[{"title":"Get started with update sets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/get-started-update-sets.md","line":36},{"title":"update","target":"r_Update","line":36},{"title":"Scripting","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_Script.md","line":38},{"title":"Find components installed with an application","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/find-components.md","line":60},{"title":"API Reference","target":"api-reference","line":128},{"title":"processors","target":"c_Processors","line":552},{"title":"API reference","target":"api-reference","line":6062},{"title":"Processors","target":"c_Processors","line":6063},{"title":"update","target":"r_Update","line":6064}],"metadata":{"title":"Packages Call Removal Tool","description":"The Packages Call Removal Tool provides modules to identify fields that might contain scripts, find scripts that contain Packages calls to ServiceNow Java classes, and to examine proposed script changes that eliminate those Packages calls.You must activate the Packages Call Removal Tool plugin to access the tool.After you run the Find Packages Fields script to define the list of fields to search for Packages calls, run the Find Packages Calls script to generate the list of fields with Packages calls to ServiceNow Java classes. The script also proposes changes.The names of the new Glide objects that replace Packages calls are derived from the Java package name used in the Packages call.This table lists the Glide classes and the Packages calls they replace.Possible error types generated by the Packages Call Removal Tool.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/scripts/c\\_PackagesCallRemovalTool.html","release":"australia","product":"Scripts","classification":"scripts","topic_type":"concept","last_updated":"2026-06-25","reading_time_minutes":14,"breadcrumb":["Scripting","API implementation","API implementation and reference"],"tags":["#api-reference","#script-includes","#server-side","#glideajax","#library","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/api-reference/scripts/c_PackagesCallRemovalTool.md"},
