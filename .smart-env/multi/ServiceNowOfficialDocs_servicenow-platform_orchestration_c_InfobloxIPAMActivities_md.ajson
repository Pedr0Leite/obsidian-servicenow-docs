-platform/orchestration/t_CreateARESTWebServiceActivity.md","line":127},{"title":"REST web service activity template","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateARESTWebServiceActivity.md","line":209},{"title":"REST web service activity template","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/orchestration/t_CreateARESTWebServiceActivity.md","line":278},{"title":"IPAM Register IP Address activity","target":"r_IPAMRegisterIPAddressActivity-1","line":341},{"title":"IP Address","target":"ip-address","line":342},{"title":"MID Server","target":"mid-server-landing","line":343},{"title":"Workflow editor","target":"workflow-editor","line":344}],"metadata":{"title":"Infoblox IPAM activities","description":"The Infoblox IPAM activities manage IP addresses in your network using an Infoblox DDI Grid Server.The IPAM Register IP Address activity registers an IP address in a network using Infoblox IPAM.The IPAM Reserve IP Address activity reserves an IP address in a network using Infoblox IPAM.The IPAM List IP Reservations activity returns an array of all IP Address within the named InfoBlox Server.The IPAM Delete activity deletes an IP Address within a named InfoBlox server.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/orchestration/c\\_InfobloxIPAMActivities.html","release":"australia","product":"Orchestration","classification":"orchestration","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Infoblox DDI activity pack","Orchestration activity packs","Classic Orchestration","ServiceNow AI Platform Additional Capabilities","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#orchestration","#itpa","#automation","#runbooks","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/orchestration/c_InfobloxIPAMActivities.md"},
