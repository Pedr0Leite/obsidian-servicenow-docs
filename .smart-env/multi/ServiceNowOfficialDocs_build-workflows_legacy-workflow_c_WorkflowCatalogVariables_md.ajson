riables#Display":[137,148],"#Workflow catalog variables#Display#{1}":[139,148],"#Workflow catalog variables#Access and assignment":[149,164],"#Workflow catalog variables#Access and assignment#{1}":[151,164],"#Workflow catalog variables#Related":[165,168],"#Workflow catalog variables#Related#{1}":[167,168]},"outlinks":[{"title":"Workflow management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/managing-workflows.md","line":31},{"title":"Workflow Editor","target":"workflow-editor","line":39},{"title":"Global variable declaration option 2","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowCatalogVariables.md","line":41},{"title":"Global variable declaration option 1","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowCatalogVariables.md","line":78},{"title":"Catalog item specific variable declaration option 2","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowCatalogVariables.md","line":101},{"title":"Catalog item specific variable declaration option 1","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/c_WorkflowCatalogVariables.md","line":134},{"title":"Workflow editor","target":"workflow-editor","line":167}],"metadata":{"title":"Workflow catalog variables","description":"Workflows that are associated with the Requested Item \\[sc\\_req\\_item\\] table have a specific type of workflow input.You can declare requested item catalog variables at the catalog item level or at a global level.You can declare global catalog variables using the Service Catalog.You can declare a catalog item-specific variable.You can declare a catalog item-specific variable directly from a catalog item record.Catalog specific item variables are visible in several places depending on where in the process the variable is viewed.The Catalog Item Variables are available and assigned to a specific Catalog Task activity \\(thereby to a specific task\\) using the slushbucket entry of a catalog task.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/legacy-workflow/c\\_WorkflowCatalogVariables.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":4,"breadcrumb":["Workflow management","Classic Workflow","Build workflows"],"tags":["#build-workflows","#legacy-workflow","#classic","#deprecated","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[157,163]],"key":"ServiceNowOfficialDocs/build-workflows/legacy-workflow/c_WorkflowCatalogVariables.md"},
