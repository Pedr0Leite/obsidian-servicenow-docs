proposed changes#Procedure#{2}":[244,245],"#Managing proposed changes#Verify proposed changes#Procedure#{3}":[246,247],"#Managing proposed changes#Verify proposed changes#Procedure#{4}":[248,249],"#Managing proposed changes#Verify proposed changes#Procedure#{5}":[250,252],"#Managing proposed changes#Verify proposed changes#What to do next":[253,256],"#Managing proposed changes#Verify proposed changes#What to do next#{1}":[255,256],"#Managing proposed changes#Create or edit a planned change validation script":[257,343],"#Managing proposed changes#Create or edit a planned change validation script#{1}":[259,260],"#Managing proposed changes#Create or edit a planned change validation script#Before you begin":[261,264],"#Managing proposed changes#Create or edit a planned change validation script#Before you begin#{1}":[263,264],"#Managing proposed changes#Create or edit a planned change validation script#About this task":[265,284],"#Managing proposed changes#Create or edit a planned change validation script#About this task#{1}":[267,268],"#Managing proposed changes#Create or edit a planned change validation script#About this task#{2}":[269,269],"#Managing proposed changes#Create or edit a planned change validation script#About this task#{3}":[270,271],"#Managing proposed changes#Create or edit a planned change validation script#About this task#{4}":[272,278],"#Managing proposed changes#Create or edit a planned change validation script#About this task#{5}":[279,279],"#Managing proposed changes#Create or edit a planned change validation script#About this task#{6}":[280,280],"#Managing proposed changes#Create or edit a planned change validation script#About this task#{7}":[281,282],"#Managing proposed changes#Create or edit a planned change validation script#About this task#{8}":[283,284],"#Managing proposed changes#Create or edit a planned change validation script#Procedure":[285,343],"#Managing proposed changes#Create or edit a planned change validation script#Procedure#{1}":[287,288],"#Managing proposed changes#Create or edit a planned change validation script#Procedure#{2}":[289,290],"#Managing proposed changes#Create or edit a planned change validation script#Procedure#{3}":[291,292],"#Managing proposed changes#Create or edit a planned change validation script#Procedure#{4}":[293,335],"#Managing proposed changes#Create or edit a planned change validation script#Procedure#{5}":[336,338],"#Managing proposed changes#Create or edit a planned change validation script#Procedure#{6}":[339,343],"#Managing proposed changes#Related":[344,347],"#Managing proposed changes#Related#{1}":[346,347]},"outlinks":[{"title":"Create or edit a CI relationship","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/t_CreateCIRelationship.md","line":98},{"title":"Check box","target":"check-box","line":192},{"title":"Create or edit a proposed change verification rule","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_ProposedChanges.md","line":232},{"title":"Timeline of CI changes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_HistoryTimeline.md","line":342},{"title":"Check box","target":"check-box","line":346}],"metadata":{"title":"Managing proposed changes","description":"The proposed changes feature allows you to pre-configure changes to configuration items and their associated relationships. These pre-configured changes are prepared to be implemented, but do not actually happen until they are applied at a later time.You can view the proposed changes so that you can see what is planned for the CI.Proposed changes to a CI can be made while viewing a change request or any task-related record.When you apply the proposed changes, all the proposed changes for that change request are applied to the configuration item. You can apply proposed changes without verification, or if verification tests of the proposed changes have failed.Ensure that proposed changes meet business requirements and do not introduce invalid data to the CMDB, create a rule that includes a script to verify the proposed changes.Before applying proposed changes to affected CIs, use proposed change verification rules to verify that the changes meet business requirements and do not add invalid data to the CMDB.Create a custom script that checks if a change to a class was valid according to business requirements, and whether the change was planned or not. A planned change validation script is used whenever a CI change is viewed in the CI timeline or change history.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/configuration-management-database-cmdb/c\\_ProposedChanges.html","release":"australia","product":"Configuration Management Database \\(CMDB\\)","classification":"configuration-management-database-cmdb","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Configuration Management Database \\(CMDB\\)","Configuration Management","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#cmdb","#cis","#relationships","#health","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[202,216],[310,334]]},"smart_blocks:ServiceNowOfficialDocs/servicenow-platform/configuration-management-database-cmdb/c_ProposedChanges.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"1jdkmfl","at":1784561352756},"key":"ServiceNowOfficialDocs/servicenow-platform/configuration-management-database-cmdb/c_ProposedChanges.md#---frontmatter---","lines":[1,20],"size":1895,"outlinks":[],"class_name":"SmartBlock"},
