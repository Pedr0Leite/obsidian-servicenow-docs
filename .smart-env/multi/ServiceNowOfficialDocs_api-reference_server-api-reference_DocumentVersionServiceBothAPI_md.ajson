ions \\[ds\\_document\\_version\\] table.Deletes a document version.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/DocumentVersionServiceBothAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[45,47],[77,111],[119,123],[129,158],[184,189],[193,198]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/DocumentVersionServiceBothAPI.md"},
