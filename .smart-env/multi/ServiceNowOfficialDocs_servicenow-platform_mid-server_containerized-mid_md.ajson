ild MID Server Docker Image#{1}":[83,84],"#Containerized MID Server#Containerized MID Server Deployment and Auto-configuration":[85,88],"#Containerized MID Server#Containerized MID Server Deployment and Auto-configuration#{1}":[87,88],"#Containerized MID Server#Related":[89,92],"#Containerized MID Server#Related#{1}":[91,92]},"outlinks":[{"title":"MID Server","target":"mid-server-landing","line":24},{"title":"Setup indicator for configuration phase","target":"../image/ProgressBarConfig.png","line":28,"embedded":true},{"title":"docker inspection command","target":"https://docs.docker.com/engine/reference/commandline/inspect/","line":62},{"title":"Build a MID Server Docker Image","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/mid-build-docker-linux.md","line":83},{"title":"deployment and auto-configuration feature","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/mid-server/containerized-mid-deployment.md","line":87},{"title":"MID Server","target":"mid-server-landing","line":91}],"metadata":{"title":"Containerized MID Server","description":"Containerized MID Server uses a Docker image of the MID Server that allows you to quickly deploy MID Servers at scale. MID Servers are deployed using orchestration tools like OpenShift or Kubernetes. Orchestration tools can automate their deployment and maintenance and add new containers on demand or replace failed containers automatically.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/mid-server/containerized-mid.html","release":"australia","product":"MID Server","classification":"mid-server","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":6,"breadcrumb":["Configuring MID Servers","Configuring MID Server","MID Server","Manage instance data sources","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#mid-se