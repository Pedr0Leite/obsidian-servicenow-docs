rkdown/api-reference/rest-api-explorer/use-REST-API-Explorer.md","line":3016},{"title":"CIs attestation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/attesting-cis.md","line":3063},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":3078},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":3111},{"title":"Scripted REST APIs","target":"c_CustomWebServices","line":3588},{"title":"REST APIs","target":"c_RESTAPI","line":3589},{"title":"insert","target":"r_Insert","line":3590},{"title":"update","target":"r_Update","line":3591}],"metadata":{"title":"CMDB Instance API","description":"The CMDB Instance API provides endpoints to create, read, update, and delete operations on existing Configuration Management Database \\(CMDB\\) tables. You can only insert, update, or delete one record at a time.Deletes the relation for the specified configuration item \\(CI\\).Returns the available configuration items \\(CI\\) for a specified Configuration Management Database \\(CMDB\\) class \\(table\\).Returns attributes and relationship information for a specified configuration item \\(CI\\) record.Creates a single configuration item \\(CI\\) with the specified outbound and inbound relations within the specified Configuration Management Database \\(CMDB\\) table.Updates the specified configuration item \\(CI\\) record with the specified attribute name-value pairs. This endpoint does not create, update, or delete the associated relations.Adds an inbound and/or outbound relation to the specified configuration item \\(CI\\). The specified CI is the parent.Replaces the attributes in the specified configuration item \\(CI\\) record with the specified name-value pairs. This endpoint does not create, update, or delete the associated relations.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/cmdb-instance-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":43,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[118,123],[304,310],[312,323],[444,449],[475,483],[501,507],[541,547],[581,589],[607,613],[647,653],[692,698],[700,918],[926,935],[992,999],[1025,1032],[1131,1136],[1162,1170],[1188,1194],[1228,1234],[1268,1276],[1294,1300],[1334,1340],[1381,1410],[1412,1576],[1582,1604],[1606,1737],[1743,1762],[1764,1772],[1918,1923],[1949,1957],[1975,1981],[2015,2021],[2055,2063],[2081,2087],[2121,2127],[2166,2183],[2185,2357],[2418,2425],[2451,2458],[2557,2562],[2588,2596],[2614,2620],[2654,2660],[2694,2702],[2720,2726],[2760,2766],[2805,2830],[2832,3004],[3148,3153],[3179,3187],[3205,3211],[3245,3251],[3285,3293],[3311,3317],[3351,3357],[3396,3410],[3412,3584]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/cmdb-instance-api.md"},
