 services","target":"workplace-services","line":23},{"title":"Workplace Service Portal","target":"workplace-services-portal-hr","line":23},{"title":"Employee Center","target":"employee-center-landing-page","line":25},{"title":"Workplace services on the Employee Center portal","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/workplace-core/workplace-services-on-employee-center.md","line":25},{"title":"Workplace Core","target":"workplace-safety-mgmt-hr","line":25},{"title":"make a reservation","target":"reservation-portal","line":32},{"title":"Indoor Mapping","target":"Indoor-mapping","line":38},{"title":"Workplace Reservation Management","target":"workplace-rsv-mgmt-feat","line":38},{"title":"Workplace Space Mapping","target":"wsm-mappedin-admin","line":38},{"title":"Explore Workplace Core","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/workplace-core/workplace-service-delivery-overview.md","line":46},{"title":"Workplace Space Mapping","target":"wsm-mappedin-admin","line":57},{"title":"Workplace Service Portal","target":"workplace-services-portal-hr","line":58},{"title":"Workplace Services","target":"workplace-services","line":59},{"title":"Workplace Core","target":"workplace-safety-mgmt-hr","line":60},{"title":"Employee Center","target":"employee-center-landing-page","line":61},{"title":"Make a reservation","target":"reservation-portal","line":62},{"title":"Workplace Reservation Management","target":"workplace-rsv-mgmt-feat","line":63},{"title":"Indoor Mapping","target":"Indoor-mapping","line":64}],"metadata":{"title":"Workplace Service Portal","description":"The Workplace Service Portal is a self-service portal for employees, delivering workplace services from a central location. Employees can make reservations, view knowledge base articles, submit and review requests, and get help using virtual agent chat support.","locale":"en-