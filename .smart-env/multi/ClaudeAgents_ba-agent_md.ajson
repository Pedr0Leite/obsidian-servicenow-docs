onsult knowledge sources":[33,41],"#Business Analyst Agent#Workflow#2. Consult knowledge sources#{1}":[34,41],"#Business Analyst Agent#Workflow#3. Clarify (if needed)":[42,50],"#Business Analyst Agent#Workflow#3. Clarify (if needed)#{1}":[43,43],"#Business Analyst Agent#Workflow#3. Clarify (if needed)#{2}":[44,44],"#Business Analyst Agent#Workflow#3. Clarify (if needed)#{3}":[45,45],"#Business Analyst Agent#Workflow#3. Clarify (if needed)#{4}":[46,46],"#Business Analyst Agent#Workflow#3. Clarify (if needed)#{5}":[47,48],"#Business Analyst Agent#Workflow#3. Clarify (if needed)#{6}":[49,50],"#Business Analyst Agent#Workflow#4. Write rm_story Records":[51,77],"#Business Analyst Agent#Workflow#4. Write rm_story Records#{1}":[53,77],"#Business Analyst Agent#Workflow#5. Refine Loop":[78,83],"#Business Analyst Agent#Workflow#5. Refine Loop#{1}":[79,79],"#Business Analyst Agent#Workflow#5. Refine Loop#{2}":[80,80],"#Business Analyst Agent#Workflow#5. Refine Loop#{3}":[81,81],"#Business Analyst Agent#Workflow#5. Refine Loop#{4}":[82,83],"#Business Analyst Agent#Token Rules":[84,89],"#Business Analyst Agent#Token Rules#{1}":[85,85],"#Business Analyst Agent#Token Rules#{2}":[86,86],"#Business Analyst Agent#Token Rules#{3}":[87,87],"#Business Analyst Agent#Token Rules#{4}":[88,89],"#Business Analyst Agent#Output Format":[90,94],"#Business Analyst Agent#Output Format#{1}":[91,91],"#Business Analyst Agent#Output Format#{2}":[92,92],"#Business Analyst Agent#Output Format#{3}":[93,93],"#Business Analyst Agent#Output Format#{4}":[94,94]},"outlinks":[],"metadata":{"name":"ba-agent","description":"Business Analyst agent that turns raw, unstructured client input (free text, meeting notes, emails, tickets) into structured rm_story records with acceptance criteria, story points, and ServiceNow implementation notes — grounded in the ServiceNowDocs index, not guesswork. Use when requirements exist but stories don't yet: 'write stories for X', 'break this requirement down', 'what are the acceptance criteria for...', 'turn these meeting notes into backlog items'. Not for designing the technical solution (architect) or writing/building anything in ServiceNow (developer, dispatcher)."},"task_lines":[],"tasks":{},"codeblock_ranges":[[34,40],[55,76]],"key":"ClaudeAgents/ba-agent.md"},
