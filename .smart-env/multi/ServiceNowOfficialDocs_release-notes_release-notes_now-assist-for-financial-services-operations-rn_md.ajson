Financial Services Operations \\(FSO\\) release notes","description":"The ServiceNow Now Assist for Financial Services Operations \\(FSO\\) application brings generative and agentic AI to Financial Services Operations. Features include AI agents, case summarization, customer profile and interaction context summarization, disputes intake via Virtual Agent, and support for third-party language models. Now Assist for FSO was enhanced and updated in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":3,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/release-notes/release-notes/now-assist-for-financial-services-operations-rn.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"fyi11d","at":1784561346994},"key":"ServiceNowOfficialDocs/release-notes/release-notes/now-assist-for-financial-services-operations-rn.md#---frontmatter---","lines":[1,15],"size":683,"outlinks":[],"class_name":"SmartBlock"},
