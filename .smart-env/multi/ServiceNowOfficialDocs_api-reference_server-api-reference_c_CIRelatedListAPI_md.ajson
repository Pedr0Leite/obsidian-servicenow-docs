st- Global#CIRelatedList - checkSysM2M\\(\\)#{1}":[233,242],"#CIRelatedList- Global#CIRelatedList - CIRelatedList\\(String table, String refField, String cmdb\\_ci, String debugFlag\\)":[243,253],"#CIRelatedList- Global#CIRelatedList - CIRelatedList\\(String table, String refField, String cmdb\\_ci, String debugFlag\\)#{1}":[245,253],"#CIRelatedList- Global#CIRelatedList - fromXML\\(String element\\)":[254,265],"#CIRelatedList- Global#CIRelatedList - fromXML\\(String element\\)#{1}":[256,265],"#CIRelatedList- Global#CIRelatedList - populate\\(\\)":[266,277],"#CIRelatedList- Global#CIRelatedList - populate\\(\\)#{1}":[268,277],"#CIRelatedList- Global#CIRelatedList - toString\\(Array result\\)":[278,291],"#CIRelatedList- Global#CIRelatedList - toString\\(Array result\\)#{1}":[280,291],"#CIRelatedList- Global#CIRelatedList - toXML\\(String document, String element\\)":[292,304],"#CIRelatedList- Global#CIRelatedList - toXML\\(String document, String element\\)#{1}":[294,304],"#CIRelatedList- Global#CIRelatedList - remove\\(\\)":[305,336],"#CIRelatedList- Global#CIRelatedList - remove\\(\\)#{1}":[307,336],"#CIRelatedList- Global#CIRelatedList - xmlToRecord\\(String records, String element\\)":[337,350],"#CIRelatedList- Global#CIRelatedList - xmlToRecord\\(String records, String element\\)#{1}":[339,350]},"outlinks":[{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":30}],"metadata":{"title":"CIRelatedList - Global","description":"The CIRelatedList script include is a utility class that provides methods for working with configuration item \\(CI\\) related lists.Adds the specified record to the related list.Sets the given records to the related list.Appends an XML child to a field.Appends an XML child to a record.Checks to see if this is a SysCollection table. If it is, sets the target table name and reference field name.Checks to see if this is a Sys many-to-many table. If it is, sets the target table name and reference field name.Creates an instance of the CIRelatedList class. With no arguments, simply constructs an empty instance.Initializes this instance from the specified XML element.Populates the this.records field of this instance.Makes a string representation of this instance, pushing each line onto the end of the given result array.Serializes this instance to XML in the given document and &lt;rl&gt; element.Removes all the related list items.Converts a related list from XML to record format.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_CIRelatedListAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[67,78],[82,106],[143,156],[160,189],[319,335]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_CIRelatedListAPI.md"},
