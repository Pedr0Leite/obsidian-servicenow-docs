ase#{5}":[46,47],"#Access Management release notes#Changed in this release#{6}":[48,52],"#Access Management release notes#Activation information":[53,58],"#Access Management release notes#Activation information#{1}":[55,58],"#Access Management release notes#Related":[59,62],"#Access Management release notes#Related#{1}":[61,62]},"outlinks":[{"title":"Access Control List Rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/access-control-rules.md","line":29},{"title":"Query ACLs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/query-acl-rule.md","line":33},{"title":"ACL rule types","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/acl-rule-types.md","line":41},{"title":"Access Analyzer","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/access-analyzer.md","line":46},{"title":"ServiceNow Store","target":"https://store.servicenow.com/store","line":50},{"title":"ServiceNow AI Platform security release notes","target":"now-platform-security-rn-landing","line":57},{"title":"ServiceNow AI Platform security release notes","target":"now-platform-security-rn-landing","line":61}],"metadata":{"title":"Access Management release notes","description":"The ServiceNow Access Management application provides robust tools to manage security data on the ServiceNow AI Platform. Access Management includes many controls, such as access control lists \\(ACLs\\), Security Attributes, Security Data Filters, and Machine Identity Access Control. These controls provide granular control and help improve security for managing data access. Access Management was enhanced and updated in the Australia release.","locale":"en-US","release":"australia","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":1,"tags":["#release-notes","#changelog","#versions","#updates","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/release-notes/release-notes/access-management-rn.md"},
