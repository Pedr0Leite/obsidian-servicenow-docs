/ServiceNowDocs/australia/markdown/now-intelligence/reporting/t_AccessFieldExtendedTable.md","line":75},{"title":"How to report on extended tables","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/reporting/t_AccessFieldExtendedTable.md","line":107},{"title":"database views","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/performance-analytics-glossary.md","line":112},{"title":"How to report on extended tables","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/reporting/t_AccessFieldExtendedTable.md","line":121},{"title":"Add an additional group by or stack by","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/reporting/add-additional-group-by-stack-by.md","line":127},{"title":"Report on function fields","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/reporting/function-fields-reporting.md","line":135},{"title":"heatmap reports","target":"c_HeatmapCharts","line":150},{"title":"List report style options","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/reporting/list-report-style-options.md","line":162},{"title":"Share a Core UI report","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/reporting/t_ShareASetting.md","line":170},{"title":"Platform Analytics","target":"c_performanceAnalyticsAndReporting","line":176},{"title":"Report sources","target":"c_ReportSources","line":177},{"title":"List reports","target":"list-reports","line":178},{"title":"Heatmap reports","target":"c_HeatmapCharts","line":179}],"metadata":{"title":"Create a list report with question columns","description":"You can create a list report with question columns based on a data source or