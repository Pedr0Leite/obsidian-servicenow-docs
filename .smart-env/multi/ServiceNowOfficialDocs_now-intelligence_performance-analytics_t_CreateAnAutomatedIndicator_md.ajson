omated-indicators","line":408}],"metadata":{"title":"Create an automated indicator","description":"To analyze the performance of a business process that is recorded in a ServiceNow table, use an automated indicator. If a suitable indicator is not provided in a Platform Analytics Solution, create a new one.After you create an automated indicator with the required settings, you can configure optional, advanced settings.Business and fiscal calendars do not have standard periods. Performance Analytics has introduced several innovations to accommodate these custom periods. Your workflow for creating indicators differs accordingly.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/performance-analytics/t\\_CreateAnAutomatedIndicator.html","release":"australia","product":"Performance Analytics","classification":"performance-analytics","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":19,"breadcrumb":["Automated indicators","Indicators","Configure fundamentals","Performance Analytics \\(Indicator data sources\\)","Platform Analytics"],"tags":["#now-intelligence","#pa","#scorecards","#indicators","#analytics","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:ServiceNowOfficialDocs/now-intelligence/performance-analytics/t_CreateAnAutomatedIndicator.md#---frontmatter---": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"ko86pv","at":1784561345726},"key":"ServiceNowOfficialDocs/now-intelligence/performance-analytics/t_CreateAnAutomatedIndicator.md#---frontmatter---","lines":[1,20],"size":1119,"outlinks":[],"class_name":"SmartBlock"},
