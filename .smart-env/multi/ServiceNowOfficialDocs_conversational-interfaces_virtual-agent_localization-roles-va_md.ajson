on roles for Virtual Agent#Localization editor \\[localization\\_editor\\]#Contains Roles":[109,114],"#Localization roles for Virtual Agent#Localization editor \\[localization\\_editor\\]#Contains Roles#{1}":[111,114],"#Localization roles for Virtual Agent#Localization editor \\[localization\\_editor\\]#Groups":[115,120],"#Localization roles for Virtual Agent#Localization editor \\[localization\\_editor\\]#Groups#{1}":[117,120],"#Localization roles for Virtual Agent#Localization editor \\[localization\\_editor\\]#Special considerations":[121,124],"#Localization roles for Virtual Agent#Localization editor \\[localization\\_editor\\]#Special considerations#{1}":[123,124],"#Localization roles for Virtual Agent#Virtual Agent admin \\[virtual\\_agent\\_admin\\]":[125,144],"#Localization roles for Virtual Agent#Virtual Agent admin \\[virtual\\_agent\\_admin\\]#{1}":[127,128],"#Localization roles for Virtual Agent#Virtual Agent admin \\[virtual\\_agent\\_admin\\]#Contains Roles":[129,134],"#Localization roles for Virtual Agent#Virtual Agent admin \\[virtual\\_agent\\_admin\\]#Contains Roles#{1}":[131,134],"#Localization roles for Virtual Agent#Virtual Agent admin \\[virtual\\_agent\\_admin\\]#Groups":[135,140],"#Localization roles for Virtual Agent#Virtual Agent admin \\[virtual\\_agent\\_admin\\]#Groups#{1}":[137,140],"#Localization roles for Virtual Agent#Virtual Agent admin \\[virtual\\_agent\\_admin\\]#Special considerations":[141,144],"#Localization roles for Virtual Agent#Virtual Agent admin \\[virtual\\_agent\\_admin\\]#Special considerations#{1}":[143,144],"#Localization roles for Virtual Agent#Related":[145,148],"#Localization roles for Virtual Agent#Related#{1}":[147,148]},"outlinks":[{"title":"Virtual Agent","target":"virtual-agent-landing-page","line":29},{"title":"Multilingual model management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/intelligent-experiences/multilingual-model-managent.md","line":31},{"title":"Localization Framework roles","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/roles-localization-framework.md","line":35},{"title":"Managing per-user subscriptions in Subscription Management","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/managing-user-subscriptions-v2.md","line":37},{"title":"Localizing Virtual Agent conversations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent/localize-va-topic.md","line":63},{"title":"Virtual Agent","target":"virtual-agent-landing-page","line":147}],"metadata":{"title":"Localization roles for Virtual Agent","description":"Assign localization roles according to a user's scope in the localization process. Users may request translations, fulfill translation requests, and edit translations, based on their role.Requests translations for all the Virtual Agent components into one or more languages. Can also view localization insights. The Virtual Agent admin \\[virtual\\_agent\\_admin\\] role contains this role by default.Provides translations for the requested Virtual Agent topics. Depending on the flow, duties may include editing the translations in the Localization Framework task, interacting with third parties, and loading, verifying, and publishing translations.Edits the translations directly in Virtual Agent Designer. The NLU admin \\[nlu\\_admin\\] and Virtual Agent admin \\[virtual\\_agent\\_admin\\] roles contain this role by default.Contains the localization requestor and localization editor roles by default.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/conversational-interfaces/virtual-agent/localization-roles-va.html","release":"australia","product":"Virtual Agent","classification":"virtual-agent","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Localizing Virtual Agent conversations","Localization options for Virtual Agent","Build and deploy","Virtual Agent","Conversational Interfaces"],"tags":["#conversational-interfaces","#virtual-agent","#chatbot","#nlu","#topics","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/conversational-interfaces/virtual-agent/localization-roles-va.md"},
