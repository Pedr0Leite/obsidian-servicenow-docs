owDocs/australia/markdown/it-operations-management/discovery/discovery-home-page.md","line":53},{"title":"Discovery Schedule form reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/discovery-schedule-form.md","line":66},{"title":"Run options for discovery schedules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/itom-visibility/discovery-schedule-run-options.md","line":74},{"title":"Use Global Excludes List for IP addresses and ranges","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/discovery-ip-address-configuration.md","line":81},{"title":"Define CI field attributes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/define-ci-attributes.md","line":82},{"title":"Discovery behaviors","target":"c_DiscoveryBehaviors","line":83},{"title":"Discovery behaviors","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/c_DiscoveryBehaviors.md","line":83},{"title":"Discovery Quick Start","target":"discovery-quick-start","line":108},{"title":"IP network discovery","target":"r_DataCollDiscoIPNetworks","line":113},{"title":"discovery status","target":"c_DiscoveryStatus","line":127},{"title":"Discovery Home page","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/discovery-home-page.md","line":257},{"title":"remediation","target":"ccg-remediation","line":259},{"title":"Error details","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/discovery/discovery-home-page.md","line":259},{"title":"MID Server pause","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/t_PauseTheMIDServer.md","line":309},{"title":"MID Server cluster configuration","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/t_ConfigureAMIDServerCluster.md","line":311},{"title":"Discovery","target":"r-discovery","line":315},{"title":"Service Mapping","target":"c_ServiceMappingOverview","line":316},{"title":"Discovery behaviors","target":"c_DiscoveryBehaviors","line":317},{"title":"Discovery Quick Start","target":"discovery-quick-start","line":318},{"title":"IP network discovery","target":"r_DataCollDiscoIPNetworks","line":319},{"title":"Discovery status","target":"c_DiscoveryStatus","line":320},{"title":"Remediation","target":"ccg-remediation","line":321}],"metadata":{"title":"Schedule a horizontal discovery","description":"A discovery schedule determines what horizontal discovery searches for, when it runs, and which MID Servers are used. Create a discovery schedule for your local environment or a schedule for discovering the resources in your cloud service account.Quick Discovery, or DiscoverNow, allows an administrator to run a CI Configuration discovery on a single IP address without requiring a schedule.You can run DiscoverNow from a script, such as a background job, a business rule, or web services.Validate the results of your discovery by accessing the ECC queue, analyzing the XML payload, and checking the Discovery log.The Discovery application follows this sequence to find a MID Server.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/discovery/t\\_CreateADiscoverySchedule.html","release":"australia","product":"Discovery","classification":"discovery","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":12,"breadcrumb":["Running discoveries in your network","Using Discovery","Discovery","ITOM Visibility","IT Operations Management"],"tags":["#it-operations-management","#discovery","#cmdb","#patterns","