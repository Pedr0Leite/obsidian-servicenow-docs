":83}],"metadata":{"title":"Teams in Workforce Optimization for Customer Service","description":"Teams lets you organize each of your teams into assignment groups, define a set of key performance indicators \\(KPIs\\) to analyze the performance of all groups within a team, drill into the metrics for a group, an agent, or an incident from a central location, and manage your teams effectively from a single location.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/customer-service-management/explore-teams-configurable-wfo-cs.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Workforce Optimization for Customer Service","Agent management","Use","Customer Service Management"],"tags":["#customer-service-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/customer-service-management/explore-teams-configurable-wfo-cs.md"},
