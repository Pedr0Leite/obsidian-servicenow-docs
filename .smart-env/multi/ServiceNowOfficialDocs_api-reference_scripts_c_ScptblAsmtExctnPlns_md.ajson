able assignment of execution plans#Add a script to a catalog item#Before you begin":[87,90],"#Scriptable assignment of execution plans#Add a script to a catalog item#Before you begin#{1}":[89,90],"#Scriptable assignment of execution plans#Add a script to a catalog item#Procedure":[91,103],"#Scriptable assignment of execution plans#Add a script to a catalog item#Procedure#{1}":[93,94],"#Scriptable assignment of execution plans#Add a script to a catalog item#Procedure#{2}":[95,96],"#Scriptable assignment of execution plans#Add a script to a catalog item#Procedure#{3}":[97,98],"#Scriptable assignment of execution plans#Add a script to a catalog item#Procedure#{4}":[99,100],"#Scriptable assignment of execution plans#Add a script to a catalog item#Procedure#{5}":[101,103],"#Scriptable assignment of execution plans#Add a script to a catalog item#Result":[104,107],"#Scriptable assignment of execution plans#Add a script to a catalog item#Result#{1}":[106,107],"#Scriptable assignment of execution plans#Use a script to approve an execution plan":[108,136],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#{1}":[110,111],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#Before you begin":[112,115],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#Before you begin#{1}":[114,115],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#Procedure":[116,124],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#Procedure#{1}":[118,119],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#Procedure#{2}":[120,121],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#Procedure#{3}":[122,124],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#Script specifying the approver":[125,136],"#Scriptable assignment of execution plans#Use a script to approve an execution plan#Script specifying the approver#{1}":[127,136],"#Scriptable assignment of execution plans#Related":[137,140],"#Scriptable assignment of execution plans#Related#{1}":[139,140]},"outlinks":[{"title":"Server-side scripting","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/scripts/c_ServerScripting.md","line":30},{"title":"Update","target":"r_Update","line":101},{"title":"update","target":"r_Update","line":139}],"metadata":{"title":"Scriptable assignment of execution plans","description":"Each catalog item has an associated execution plan, used whenever an item of that type is ordered; if no plan is specified, the default plan is used. This default is effective for most organizations, but your execution plan may need to vary based on additional criteria.Execution plan scripts have limitations that need to be considered during their implementation.Follow these guidelines when writing execution plan scripts.You can add a script to a catalog item so that the script runs each time a user requests that item.You can use an approval rule script to approve an execution plan.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/scripts/c\\_ScptblAsmtExctnPlns.html","release":"australia","product":"Scripts","classification":"scripts","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Server-side scripting","Scripting","API implementation","API implementation and reference"],"tags":["#api-reference","#script-includes","#server-side","#glideajax","#library","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[55,57],[63,79],[129,135]],"key":"ServiceNowOfficialDocs/api-reference/scripts/c_ScptblAsmtExctnPlns.md"},
