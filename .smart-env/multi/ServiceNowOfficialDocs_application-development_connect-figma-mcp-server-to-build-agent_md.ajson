stralia/markdown/application-development/connect-figma-mcp-server-to-build-agent.md","line":36},{"title":"Configure OAuth provider in ServiceNow Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/connect-figma-mcp-server-to-build-agent.md","line":38},{"title":"Connect Figma MCP server to Build Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/connect-figma-mcp-server-to-build-agent.md","line":40},{"title":"Configure Build Agent","target":"configure-build-agent","line":45},{"title":"Figma Developers Page","target":"https://www.figma.com/login?cont=/developers/apps","line":65},{"title":"Contact ServiceNow Support","target":"https://support.servicenow.com/now?draw=case","line":122},{"title":"Build Agent in ServiceNow Studio","target":"build-agent-in-servicenow-studio","line":131},{"title":"Configure an OAuth app in Figma","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/connect-figma-mcp-server-to-build-agent.md","line":214},{"title":"Configure OAuth provider in ServiceNow Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/connect-figma-mcp-server-to-build-agent.md","line":214},{"title":"Structure your Figma file for better coding","target":"https://developers.figma.com/docs/figma-mcp-server/structure-figma-file/","line":255},{"title":"Write effective prompts to guide the AI","target":"https://developers.figma.com/docs/figma-mcp-server/write-effective-prompts/","line":255},{"title":"MCP connections and Build Agent","target":"accelerate-design-to-development-with-figma-mcp-server","line":291},{"title":"Connect Build Agent to a supported MCP server","target":"ba-connct-mcp-server","line":292},{"title":"Configure Build Agent","target":"configure-build-agent","line":293},{"title":"Build Agent","target":"build-agent","line":294},{"title":"ServiceNow Studio","target":"servicenow-studio-landing","line":295},{"title":"ServiceNow IDE","target":"servicenow-ide-landing","line":296},{"title":"Build Agent in ServiceNow Studio","target":"build-agent-in-servicenow-studio","line":297}],"metadata":{"title":"Connect Build Agent to a Figma MCP server","description":"Connect the Figma Model Context Protocol Server Console \\(MCP\\) server to Build Agent to convert Figma designs into enterprise-grade applications on the ServiceNow AI Platform.Create an OAuth application in Figma to enable the Figma MCP server to authenticate users via OAuth and grant Build Agent access to Figma designs.Set up an OAuth application registry and credentials to enable Build Agent in ServiceNow Studio or the ServiceNow IDE to connect to your Figma MCP server.Connect the Figma Model Context Protocol \\(MCP\\) server to Build Agent in ServiceNow Studio to make Figma designs accessible for application creation.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/connect-figma-mcp-server-to-build-agent.html","release":"australia","topic_type":"task","last_updated":"2026-06-25","reading_time_minutes":8,"keywords":["Now Assist","AI Agents","generative AI","agentic AI","Now Assist","AI Agents","generative AI","agentic AI","Now Assist","AI Agents","generative AI","agentic AI","Now Assist","AI Agents","generative AI","agentic AI"],"breadcrumb":["Configure","Build Agent","Agentic development on the ServiceNow AI Platform","Building applications"],"tags":["#application-development","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/application-development/connect-figma-mcp-server-to-build-agent.md"},
