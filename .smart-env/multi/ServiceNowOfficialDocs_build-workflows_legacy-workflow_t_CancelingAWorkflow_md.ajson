efore you begin#{1}":[72,73],"#Cancel a workflow#Cancel a workflow with the cancelContext\\(context\\) script#About this task":[74,77],"#Cancel a workflow#Cancel a workflow with the cancelContext\\(context\\) script#About this task#{1}":[76,77],"#Cancel a workflow#Define an on-cancel script":[78,118],"#Cancel a workflow#Define an on-cancel script#{1}":[80,81],"#Cancel a workflow#Define an on-cancel script#About this task":[82,87],"#Cancel a workflow#Define an on-cancel script#About this task#{1}":[84,87],"#Cancel a workflow#Define an on-cancel script#Procedure":[88,102],"#Cancel a workflow#Define an on-cancel script#Procedure#{1}":[90,91],"#Cancel a workflow#Define an on-cancel script#Procedure#{2}":[92,93],"#Cancel a workflow#Define an on-cancel script#Procedure#{3}":[94,95],"#Cancel a workflow#Define an on-cancel script#Procedure#{4}":[96,97],"#Cancel a workflow#Define an on-cancel script#Procedure#{5}":[98,99],"#Cancel a workflow#Define an on-cancel script#Procedure#{6}":[100,102],"#Cancel a workflow#Define an on-cancel script#Example":[103,118],"#Cancel a workflow#Define an on-cancel script#Example#{1}":[105,118],"#Cancel a workflow#Related":[119,123],"#Cancel a workflow#Related#{1}":[121,121],"#Cancel a workflow#Related#{2}":[122,123]},"outlinks":[{"title":"workflow activities","target":"c_WorkflowActivities","line":23},{"title":"Administering workflow contexts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/build-workflows/legacy-workflow/r_AdministeringWorkflowContexts.md","line":64},{"title":"Workflow Versions","target":"c_WorkflowVersions","line":90},{"title":"Workflow activities","target":"c_WorkflowActivities","line":121},{"title":"Workflow versions","target":"c_WorkflowVersions","line":122}],"metadata":{"title":"Cancel a workflow","description":"Canceling a workflow stops the workflow from executing and sets the workflow context State to Canceled. To cancel an executing workflow, you can use the cancelContext\\(context\\) script. You can define an onCancel script to clean up unresolved workflow activities.To cancel an executing workflow, you can use the cancelContext\\(context\\) script. This script can be useful in cases where a workflow must be canceled in response to an event or where a user must manually cancel a workflow.Canceling a workflow can leave records or scripts in an unresolved state. For example, canceling a service catalog workflow may leave catalog items in the requesting user's cart. An administrator can specify an On-cancel script that runs when the workflow transitions to the Canceled state. This script can notify users, log information, or resolve the state of any scripts run within a workflow activity. The sys\\_id of the workflow context is available in this script using the context\\_sys\\_id variable.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/build-workflows/legacy-workflow/t\\_CancelingAWorkflow.html","release":"australia","product":"Legacy Workflow","classification":"legacy-workflow","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Administering workflow contexts","Workflow administration","Classic Workflow","Build workflows"],"tags":["#build-workflows","#legacy-workflow","#classic","#deprecated","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[107,117]],"key":"ServiceNowOfficialDocs/build-workflows/legacy-workflow/t_CancelingAWorkflow.md"},
