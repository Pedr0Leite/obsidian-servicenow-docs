achment system properties#Restrict attachment file extensions#Procedure":[95,104],"#Configure attachment system properties#Restrict attachment file extensions#Procedure#{1}":[97,98],"#Configure attachment system properties#Restrict attachment file extensions#Procedure#{2}":[99,100],"#Configure attachment system properties#Restrict attachment file extensions#Procedure#{3}":[101,102],"#Configure attachment system properties#Restrict attachment file extensions#Procedure#{4}":[103,104],"#Configure attachment system properties#Related":[105,109],"#Configure attachment system properties#Related#{1}":[107,107],"#Configure attachment system properties#Related#{2}":[108,109]},"outlinks":[{"title":"System Properties","target":"r_SetArchiveRuleProcessingBehavior","line":28},{"title":"Administering attachments","target":"r_AdministeringAttachments","line":35},{"title":"Administering attachments","target":"r_AdministeringAttachments","line":107},{"title":"System properties","target":"r_SetArchiveRuleProcessingBehavior","line":108}],"metadata":{"title":"Configure attachment system properties","description":"You can disable the drag-and-drop feature. \\(Users can still upload attachments by browsing to the file.\\) You can also limit the attachment file size, restrict who can upload attachments, and restrict what file extensions can be uploaded.You can specify the maximum size allowable for attachments to avoid issues with the user's active session on the instance. The maximum attachment size for email attachments is configured separately.You can restrict who can upload attachments.The glide.attachment.extensions property restricts the file extensions that users can upload as attachments.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-administration/t\\_DisablingTheDragAndDropFeature.html","release":"australia","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Attachments","Administer","Form administration","Forms","fields","and lists","Configure core features","Administer the ServiceNow AI Platform"],"tags":["#platform-administration","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-administration/t_DisablingTheDragAndDropFeature.md"},
