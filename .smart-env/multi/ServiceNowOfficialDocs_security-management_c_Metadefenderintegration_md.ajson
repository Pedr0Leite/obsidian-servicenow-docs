/perform-lookups-on-observables.md","line":66},{"title":"create a new record","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/t_UploadACertificateToAnInstance.md","line":100},{"title":"Identity","target":"identity","line":104},{"title":"KB0691439 Replacing an expiring SAML certificate","target":"https://support.servicenow.com/kb?id=kb_article_view&sysparm_article=KB0691439","line":118},{"title":"Security Operations Integration - Threat Lookup capability","target":"sec-ops-threat-lookups-capability","line":122},{"title":"Perform lookups on observables","target":"perform-lookups-on-observables","line":123},{"title":"Common Security Operations integration flows and orchestration activities","target":"common-wf-activities","line":124},{"title":"Download an application from the ServiceNow Store for the first time","target":"download-app-first-time","line":125},{"title":"Malware","target":"threat-intelligence-malware","line":126},{"title":"Security Operations","target":"security-operations-landing-page","line":127},{"title":"OPSWAT Metadefender Integration","target":"metadefender-landing-page","line":128},{"title":"Threat Lookup","target":"tisc-threat-lookup","line":129},{"title":"Observables","target":"c_Observables","line":130},{"title":"Threat Intelligence","target":"threat-intel-landing-page","line":131},{"title":"Identity","target":"identity","line":132}],"metadata":{"title":"OPSWAT Metadefender integration overview","description":"OPSWAT Metadefender is a security solution that provides access to multiple anti-malware machines and easily integrates with Security Operations.The Threat Lookup - OPSWAT Metadefender flow performs a lookup on selected observables. If the observables are of a type recognized by OPSWAT Metadefender, the observables are scanned for malware, and the results are returned.Before you can use the OPSWAT Metadefender integration, you must download it from the ServiceNow Store.If you require an SSL connection for the integration, there are circumstances when the certificate provided by the third-party vendor is either not yet trusted in ServiceNow or has expired. This task is optional.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/c\\_Metadefenderintegration.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["OPSWAT Metadefender Integration","Threat Intelligence integrations","Threat Intelligence","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/c_Metadefenderintegration.md"},
