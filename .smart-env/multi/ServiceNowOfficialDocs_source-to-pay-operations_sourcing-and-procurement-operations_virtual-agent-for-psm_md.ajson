elated#{2}":[46,46],"#Virtual Agent for Sourcing and Procurement Operations#Related#{3}":[47,48]},"outlinks":[{"title":"Virtual Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/conversational-interfaces/virtual-agent-landing-page.md","line":28},{"title":"Sourcing and Procurement Operations Virtual Agent conversations and topic blocks","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/shoppinghub-virtual-agent-topics-and-topic-blocks.md","line":30},{"title":"Install Virtual Agent for Sourcing and Procurement Operations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/install-virtual-agent-for-shoppinghub.md","line":32},{"title":"Install Virtual Agent for Sourcing and Procurement Operations","target":"install-virtual-agent-for-shoppinghub","line":33},{"title":"Enable Virtual Agent for Sourcing and Procurement Operations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/enable-virtual-agent-for-shoppinghub.md","line":34},{"title":"Enable Virtual Agent for Sourcing and Procurement Operations","target":"enable-virtual-agent-for-shoppinghub","line":35},{"title":"NLU support for Sourcing and Procurement Operations Virtual Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/nlu-support-shoppinghub-va.md","line":36},{"title":"Sourcing and Procurement Operations","target":"psm-overview","line":37},{"title":"Set up NLU for Sourcing and Procurement Operations Virtual Agent","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/set-up-nlu-for-shoppinghub-va.md","line":38},{"title":"Sourcing and Procurement Operations integration with Employee Center","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/source-to-pay-operations/sourcing-and-procurement-operations/employee-center-integration-psm.md","line":41},{"title":"Install Virtual Agent for Sourcing and Procurement Operations","target":"install-virtual-agent-for-shoppinghub","line":45},{"title":"Enable Virtual Agent for Sourcing and Procurement Operations","target":"enable-virtual-agent-for-shoppinghub","line":46},{"title":"Sourcing and Procurement Operations","target":"psm-overview","line":47}],"metadata":{"title":"Virtual Agent for Sourcing and Procurement Operations","description":"ServiceNow Virtual Agent for Sourcing and Procurement Operations enables shoppers to quickly find and purchase products that they're looking for from a vendor on ShoppingHub, by interacting with a virtual agent from Employee Center. It also allows shoppers to view purchases, procurement tasks, procurement cases, and even work on their to-dos. They can also get help from the procurement team using Virtual Agent.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/source-to-pay-operations/sourcing-and-procurement-operations/virtual-agent-for-psm.html","release":"australia","product":"Sourcing and Procurement Operations","classification":"sourcing-and-procurement-operations","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Sourcing Procurement Operations integration Employee","Integrate","Sourcing and Procurement Operations","Finance and Supply Chain"],"tags":["#source-to-pay-operations","#sourcing","#procurement","#rfx","#s2p","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/source-to-pay-operations/sourcing-and-procurement-operations/virtual-agent-for-psm.md"},
