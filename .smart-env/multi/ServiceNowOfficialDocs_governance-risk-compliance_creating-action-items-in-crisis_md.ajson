ng action items in crisis events#Comparison between event tasks and action items#{30}":[199,199],"#Creating action items in crisis events#Comparison between event tasks and action items#{31}":[200,203],"#Creating action items in crisis events#Related":[204,210],"#Creating action items in crisis events#Related#{1}":[206,206],"#Creating action items in crisis events#Related#{2}":[207,207],"#Creating action items in crisis events#Related#{3}":[208,208],"#Creating action items in crisis events#Related#{4}":[209,210]},"outlinks":[{"title":"event assets","target":"event-assets","line":18},{"title":"Create task and assessment-type action items","target":"create-action-items-based-on-smart-assessments","line":199},{"title":"crisis events","target":"crisis-management-uib","line":200},{"title":"Structured workflows for Crisis events","target":"perform-tasks-to-manage-crisis-events","line":202},{"title":"Create task and assessment-type action items","target":"create-action-items-based-on-smart-assessments","line":206},{"title":"Structured workflows for Crisis events","target":"perform-tasks-to-manage-crisis-events","line":207},{"title":"Event assets","target":"event-assets","line":208},{"title":"Crisis events","target":"crisis-management-uib","line":209}],"metadata":{"title":"Creating action items in crisis events","description":"Starting with BCM release 9.0.x, crisis managers can create action tasks for recovery members or teams anytime during a crisis event or exercise, as long as the event remains open. Crisis managers can create these tasks on the fly without mapping them to event assets or recovery plans. These action tasks are also not included in the event recovery timeline.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/creating-action-items-in-crisis.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Structured workflows for Crisis events","Manage","Bu