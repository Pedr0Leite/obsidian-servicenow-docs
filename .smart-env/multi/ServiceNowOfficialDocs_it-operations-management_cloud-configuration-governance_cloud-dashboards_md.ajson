ocedure#{4}":[92,98],"#Cloud Provisioning and Governance dashboards and reports#View tagged resources on the Tag dashboard#Procedure#{5}":[99,100],"#Cloud Provisioning and Governance dashboards and reports#View tagged resources on the Tag dashboard#Procedure#{6}":[101,121],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval":[122,165],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#{1}":[124,127],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#{2}":[128,128],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#{3}":[129,130],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#{4}":[131,140],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets":[141,165],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#{1}":[143,144],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#Before you begin":[145,148],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#Before you begin#{1}":[147,148],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#Procedure":[149,165],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#Procedure#{1}":[151,152],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#Procedure#{2}":[153,154],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#Procedure#{3}":[155,156],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#Procedure#{4}":[157,163],"#Cloud Provisioning and Governance dashboards and reports#Budget-based notification and approval#Configure budgets#Procedure#{5}":[164,165],"#Cloud Provisioning and Governance dashboards and reports#Related":[166,173],"#Cloud Provisioning and Governance dashboards and reports#Related#{1}":[168,168],"#Cloud Provisioning and Governance dashboards and reports#Related#{2}":[169,169],"#Cloud Provisioning and Governance dashboards and reports#Related#{3}":[170,170],"#Cloud Provisioning and Governance dashboards and reports#Related#{4}":[171,171],"#Cloud Provisioning and Governance dashboards and reports#Related#{5}":[172,173]},"outlinks":[{"title":"Dashboards","target":"otto-aiops-dashboards","line":24},{"title":"Cloud Provisioning and Governance","target":"cloud-management-v2-landing-page","line":26},{"title":"Cloud User portal","target":"cloudmgt-cloud-user-portal","line":31},{"title":"Cloud Admin Portal","target":"cloud-admin-portal","line":46},{"title":"Configure budgets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/cloud-configuration-governance/cloud-dashboards.md","line":131},{"title":"discovery","target":"r-discovery","line":135},{"title":"Dashboards","target":"otto-aiops-dashboards","line":168},{"title":"Cloud Provisioning and Governance","target":"cloud-management-v2-landing-page","line":169},{"title":"Cloud User Portal","target":"cloudmgt-cloud-user-portal","line":170},{"title":"Cloud Admin Portal","target":"cloud-admin-portal","line":171},{"title":"Discovery","target":"r-discovery","line":172}],"metadata":{"title":"Cloud Provisioning and Governance dashboards and reports","description":"Dashboards enable cloud admins and cloud users to view reports like cloud billing data and cloud tag usage.The Billing dashboard provides rich summary information on cloud usage, cost trends, and cost aggregates.The Tag dashboard shows all tagged resources. Use the Tag dashboard to see specific tag values for a group of resources such as stacks or virtual machines.Administrators can assign a budget for a group and a user within the group. When the user or group reaches the budget limit threshold, notifications are sent alerting them about it.You can configure budgets for groups and users within that group. You can set up a budget period for the group, allocate a budget limit to a group and to each user within that group.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-operations-management/cloud-configuration-governance/cloud-dashboards.html","release":"australia","product":"Cloud Configuration Governance","classification":"cloud-configuration-governance","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":7,"breadcrumb":["Cloud Admin Portal","Cloud Provisioning and Governance administration guide","Cloud Provisioning and Governance","ITOM Cloud Accelerate","IT Operations Management"],"tags":["#it-operations-management","#cloud-config","#drift","#compliance","#itom","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-operations-management/cloud-configuration-governance/cloud-dashboards.md"},
