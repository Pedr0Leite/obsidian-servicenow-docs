,{"title":"Request an extension for a deferred remediation task","target":"sem-extend-defer-rem","line":58},{"title":"Request a false positive for a vulnerable item or remediate task","target":"sem-falsepst-reqst","line":60},{"title":"Using Unified Security Exposure Management","target":"using-unified-security-exposure-management","line":63},{"title":"Approver roles required for Security Exposure Management Workspace","target":"sem-approve-or-reject-request","line":67},{"title":"Questionnaire support in Exception Management via Smart Assessment","target":"sem-smart-assessment-exp-management","line":68},{"title":"Defer a Remediation task","target":"sem-defer-rem-task","line":69},{"title":"Request an extension for a deferred remediation task","target":"sem-extend-defer-rem","line":70},{"title":"Request a false positive for a vulnerable item or remediate task","target":"sem-falsepst-reqst","line":71},{"title":"Using Unified Security Exposure Management","target":"using-unified-security-exposure-management","line":72},{"title":"Security Exposure Management Workspace","target":"sem-workspace-user-interface","line":73},{"title":"Vulnerability Response","target":"vuln-landing-page","line":74},{"title":"Configuration Compliance","target":"vr-config-compliance-landing","line":75},{"title":"Application Vulnerability Response","target":"avr-landing","line":76},{"title":"Container Vulnerability Response","target":"cvr-landing","line":77}],"metadata":{"title":"Exception Management Overview","description":"When your organization can't comply with a published finding or security policy, standard, or guideline, you can request an exception. Exception management entails requesting, reviewing, approving, or rejecting exceptions to a finding or remediation task \\(RT\\) that can’t be remediated.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/sem-exception-management-overview.html","release":"australia","topic_type":"concept","last_updated":"20