ithubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/hc-linter-check.md","line":28},{"title":"Advanced linter check scripts","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/hs-linter-check-scripts.md","line":28},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":34},{"title":"incrementWithNode\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/FindingsAPI.md","line":48},{"title":"Linter Check form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/hc-linter-check.md","line":48},{"title":"incrementWithNode\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/FindingsAPI.md","line":74},{"title":"Linter Check form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/hc-linter-check.md","line":74},{"title":"incrementWithNode\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/FindingsAPI.md","line":100},{"title":"Linter Check form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/hc-linter-check.md","line":100},{"title":"incrementWithNode\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/FindingsAPI.md","line":126},{"title":"Linter Check form","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-administration/hc-linter-check.md","line":126}],"metadata":{"title":"LinterCheckAstNode - Scoped, Global","description":"The LinterCheckAstNode API provides methods for getting abstract syntax tree \\(AST\\) node details in linter checks.Retrieves the string value of a name node type. A name node represents a simple identifier that is not a keyword, such as a function or variable name.Gets the parent node object of the accessed node.Gets the type of the accessed node.Accesses each node in the subtree starting from this node and executes a given callback function on each node.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/LinterCheckAstNodeAPIBoth.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[50,60],[76,86],[102,112],[128,138]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/LinterCheckAstNodeAPIBoth.md"},
