vidence-request","line":24},{"title":"Evidence request","target":"evidence-request","line":54}],"metadata":{"title":"Approve evidence before evidence review","description":"Approve the evidence being provided before the requester views the evidence. When evidence is provided in response to an evidence request, the evidence may need an approval before the evidence is sent back to the requester. This ability ensures security and confidentiality of the evidence.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/governance-risk-compliance/audit-management/approve-evidence.html","release":"australia","product":"Audit Management","classification":"audit-management","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Evidence request workflow","Audit Evidence Request","Audit Management Overview","Audit Management","Governance","Risk","and Compliance"],"tags":["#governance-risk-compliance","#audit","#findings","#grc","#compliance","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/governance-risk-compliance/audit-management/approve-evidence.md"},
