get":"create-dv-time-series-ac","line":33},{"title":"Time series Performance Analytics widgets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/time-series-widgets.md","line":33},{"title":"Dashboards in Platform Analytics","target":"analytics-center-dashboards","line":34},{"title":"Performance Analytics widgets","target":"c_Widgets","line":34},{"title":"Responsive dashboards","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/dashboards-landing-page.md","line":34},{"title":"Proactive analytics insights cards","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/proactive-analytics/proactive-analytics.md","line":35},{"title":"Performance Analytics targets and thresholds","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/pa-targets-thresholds.md","line":40},{"title":"Create a target in KPI Details","target":"create-kpi-details-targets","line":55},{"title":"Platform Analytics experience","target":"par-workspace","line":55},{"title":"Add a target to multiple breakdown elements in KPI Details","target":"add-multiple-targets","line":57},{"title":"Applying time series aggregations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/applying-time-series-aggregations.md","line":65},{"title":"Date ranges of scores in the Analytics Hub","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/scorecard-overview-tab.md","line":123},{"title":"reporting","target":"reporting-landing-page","line":171},{"title":"Configure which users receive a target notification","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/pa-targets.md","line":180},{"title":"Responsibility for indicator targets","target":"responsibiity-targets-kpi-details","line":182},{"title":"KPI Details","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/kpi-details.md","line":187},{"title":"color schemes","target":"color-schemes-pa-widgets","line":199},{"title":"Define system colors for analytics","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/reporting/t_DefiningSystemColors.md","line":217},{"title":"target","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/now-intelligence/performance-analytics/performance-analytics-glossary.md","line":221},{"title":"Notifications","target":"https://www.servicenow.com/docs/?context=CSHelp:Notifications-Landing","line":293},{"title":"KPI Details","target":"kpi-details","line":297},{"title":"Create time series data visualizations","target":"create-dv-time-series-ac","line":298},{"title":"Create a single score data visualization","target":"create-dv-sing-sc-ac","line":299},{"title":"Dashboards in Platform Analytics","target":"analytics-center-dashboards","line":300},{"title":"Create a target in KPI Details","target":"create-kpi-details-targets","line":301},{"title":"Add a target to multiple breakdown elements in KPI Details","target":"add-multiple-targets","line":302},{"title":"Responsibility for indicator targets","target":"responsibiity-targets-kpi-details","line":303},{"title":"Analytics Hub","target":"c_UsePerformanceAnalyticsScorecards","line":304},{"title":"Platform Analytics","target":"c_performanceAnalyticsAndReporting","line":305},{"title":"Performance Analytics widgets","target":"c_Widgets","line":306},{"title":"Platform Analytics experience","target":"par-workspace","line":307},{"title":"Reporting","target":"reporting-landing-page","line":308},{"title":"Color schemes","target":"color-schemes-pa-widgets","line":309}],"metadata":{"title":"Indicator targets","description":"Targets are goals your organization wants to achieve. Targets show the difference between the desired score at a certain date and the actual score of an indicator.You can set target values for indicators. You can have the targets apply only to specific breakdown elements and time series. The target starts to apply at a selected date and continues to apply until you set the next target. However, you can set a review date on which to reconsider the target.A target color scheme can be used to visualize the position of the indicator score relative to its target.You can specify a target that applies separately to each subset of data for an indicator with a breakdown.You can control which users receive a notification when a target is achieved. Notifications are also sent when it appears that a target will be achieved within the next 14 days.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/now-intelligence/performance-analytics/pa-targets.html","release":"australia","product":"Performance Analytics","classification":"performance-analytics","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":11,"breadcrumb":["Targets and thresholds","Configure fundamentals","Performance Analytics \\(Indicator data sources\\)","Platform Analytics"],"tags":["#now-intelligence","#pa","#scorecards","#indicators","#analytics","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/now-intelligence/performance-analytics/pa-targets.md"},
