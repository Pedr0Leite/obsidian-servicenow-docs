tion keys#Schedule a single key rotation job#Procedure#{3}":[60,147],"#Rotate encryption keys#Schedule a mass key rotation job":[148,241],"#Rotate encryption keys#Schedule a mass key rotation job#{1}":[150,151],"#Rotate encryption keys#Schedule a mass key rotation job#Before you begin":[152,155],"#Rotate encryption keys#Schedule a mass key rotation job#Before you begin#{1}":[154,155],"#Rotate encryption keys#Schedule a mass key rotation job#Procedure":[156,241],"#Rotate encryption keys#Schedule a mass key rotation job#Procedure#{1}":[158,159],"#Rotate encryption keys#Schedule a mass key rotation job#Procedure#{2}":[160,161],"#Rotate encryption keys#Schedule a mass key rotation job#Procedure#{3}":[162,241],"#Rotate encryption keys#Schedule an attachment key rotation job":[242,270],"#Rotate encryption keys#Schedule an attachment key rotation job#{1}":[244,245],"#Rotate encryption keys#Schedule an attachment key rotation job#Before you begin":[246,249],"#Rotate encryption keys#Schedule an attachment key rotation job#Before you begin#{1}":[248,249],"#Rotate encryption keys#Schedule an attachment key rotation job#Procedure":[250,270],"#Rotate encryption keys#Schedule an attachment key rotation job#Procedure#{1}":[252,253],"#Rotate encryption keys#Schedule an attachment key rotation job#Procedure#{2}":[254,255],"#Rotate encryption keys#Schedule an attachment key rotation job#Procedure#{3}":[256,264],"#Rotate encryption keys#Schedule an attachment key rotation job#Procedure#{4}":[265,266],"#Rotate encryption keys#Schedule an attachment key rotation job#Procedure#{5}":[267,268],"#Rotate encryption keys#Schedule an attachment key rotation job#Procedure#{6}":[269,270],"#Rotate encryption keys#Related":[271,277],"#Rotate encryption keys#Related#{1}":[273,273],"#Rotate encryption keys#Related#{2}":[274,274],"#Rotate encryption keys#Related#{3}":[275,275],"#Rotate encryption keys#Related#{4}":[276,277]},"outlinks":[{"title":"encryption","target":"encryption-landing","line":24},{"title":"Configuring Edge Encryption","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/edge-encryption/edge-config.md","line":42},{"title":"Edge Encryption","target":"edge-encryption","line":52},{"title":"Configuration","target":"sc-configuration","line":52},{"title":"Auditing","target":"c_AuditedTables","line":108},{"title":"Auditing","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/c_AuditedTables.md","line":202},{"title":"Auditing","target":"c_AuditedTables","line":273},{"title":"Encryption","target":"encryption-landing","line":274},{"title":"Edge Encryption","target":"edge-encryption","line":275},{"title":"Configuration","target":"sc-configuration","line":276}],"metadata":{"title":"Rotate encryption keys","description":"Perform encryption key rotation from the instance. Add a new key, change the default key assignment, and then schedule a mass key rotation or a single key rotation.Schedule a job to find data encrypted using a specified key alias and then re-encrypt the data with the current default encryption key. The data is decrypted before it is re-encrypted with the default key.Schedule a job to find data encrypted with any previous key, and then re-encrypt the data with the current default encryption keys. The data is decrypted before it is re-encrypted with the current default key.Schedule a job to find attachments encrypted using a specified key alias, and then re-encrypt the attachments with the current default encryption key. The attachment is decrypted before it is re-encrypted with the default key.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/platform-security/edge-encryption/c\\_EncryptionKeyRotation.html","release":"australia","product":"Edge Encryption","classification":"edge-encryption","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":5,"breadcrumb":["Configuring Edge Encryption","Edge Encryption","Encryption"],"tags":["#platform-security","#edge-encryption","#field-level","#proxy","#security","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/platform-security/edge-encryption/c_EncryptionKeyRotation.md"},
