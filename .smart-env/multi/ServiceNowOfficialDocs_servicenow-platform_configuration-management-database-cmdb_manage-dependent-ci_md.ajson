ire#{8}":[174,175],"#Dependent CIs management#Sample scenario: cascade-retire#{9}":[176,194],"#Dependent CIs management#Related":[195,198],"#Dependent CIs management#Related#{1}":[197,198]},"outlinks":[{"title":"CMDB classifications and class dependency","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_CMDBClassifications.md","line":26},{"title":"CMDB Data Manager","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-data-management.md","line":31},{"title":"CMDB Health","target":"c_CMDBHealth","line":33},{"title":"CMDB Health KPIs and metrics","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/r_CMDBHealthMetrics.md","line":33},{"title":"Working with CMDB Data Manager","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-data-management.md","line":45},{"title":"Cascade-cleanup existing orphan dependent CIs","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/manage-dependent-ci.md","line":49},{"title":"CMDB Data Manager","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/cmdb-data-management.md","line":53},{"title":"CMDB dependent relationship rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_ServiceRulesMetadata.md","line":73},{"title":"CMDB Data Manager","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/manage-dependent-ci.md","line":75},{"title":"CMDB Data Manager","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/manage-dependent-ci.md","line":87},{"title":"CMDB Data Manager","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/manage-dependent-ci.md","line":108},{"title":"Activate","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/employee-service-management/activate-sj-mh.md","line":120},{"title":"Use of CMDB Data Manager to perform cascade-cleanup operations","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/manage-dependent-ci.md","line":120},{"title":"CMDB classifications and class dependency","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/c_CMDBClassifications.md","line":176},{"title":"CMDB Health","target":"c_CMDBHealth","line":197}],"metadata":{"title":"Dependent CIs management","description":"A life cycle update for a CI affects its dependent CIs. For example, when the CI that a dependent CI depends on is deleted, the dependent CI becomes orphan with no further use. To maintain the integrity and health of the CMDB, the system applies cascade-cleanup processes to dependent CIs that are affected by a life cycle update.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/configuration-management-database-cmdb/manage-dependent-ci.html","release":"australia","product":"Configuration Management Database \\(CMDB\\)","classification":"configuration-management-database-cmdb","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":14,"breadcrumb":["CMDB classifications and class dependency","Configuration Management Database \\(CMDB\\)","Configuration Management","Extend ServiceNow AI Platform capabilities"],"tags":["#servicenow-platform","#cmdb","#cis","#relationships","#health","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/servicenow-platform/configuration-management-database-cmdb/manage-dependent-ci.md"},
