rviceNowDocs/australia/markdown/servicenow-platform/c_CMDBIdentifyandReconcile.md","line":26},{"title":"Server API reference","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/api-server.md","line":28},{"title":"hasError\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/server-api-reference/c_CMDBTransformUtilAPI.md","line":46},{"title":"INSERT","target":"r_Insert","line":216},{"title":"UPDATE","target":"r_Update","line":218},{"title":"Reconciliation Rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/create-reconciliation-rule.md","line":435},{"title":"Reconciliation Rules","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/create-reconciliation-rule.md","line":1453},{"title":"Apply CI Identification and Reconciliation to Import Sets","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/identification-import-sets.md","line":2000},{"title":"Identification and Reconciliation \\(IRE\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/ire.md","line":2035},{"title":"insert","target":"r_Insert","line":2117},{"title":"update","target":"r_Update","line":2118}],"metadata":{"title":"CMDBTransformUtil - Global","description":"The CMDBTransformUtil script include uses the Identification and Reconciliation \\(IRE\\) framework to minimize the creation of duplicate configuration items \\(CI\\).Creates a CMDBTransformUtil object.Returns any errors generated by the previous identifyAndReconcile\\(\\) or identifyAndReconcileEnhanced\\(\\) method call.Returns the JSON payload from the previous identifyAndReconcile\\(\\) or identifyAndReconcileEnhanced\\(\\) method call.Returns the sys\\_id of the configuration item \\(CI\\) that was inserted or updated.Returns the JSON payload generated from the specified input.Determines if an error occurred in the previous identifyAndReconcile\\(\\) or identifyAndReconcileEnhanced\\(\\) method call.Inserts or updates a configuration item \\(CI\\) in the Configuration Management Database \\(CMDB\\).Inserts or updates a configuration item \\(CI\\) in the Configuration Management Database \\(CMDB\\).Logs the number of configuration items \\(CI\\) inserted, updated, skipped, or that had errors.Sets the data source to use when the identifyAndReconcile\\(\\) or identifyAndReconcileEnhanced\\(\\) method is called.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/server-api-reference/c\\_CMDBTransformUtilAPI.html","release":"australia","product":"Server API Reference","classification":"server-api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":25,"breadcrumb":["Server API reference","API reference","API implementation and reference"],"tags":["#api-reference","#glidesystem","#gliderecord","#server-side","#glide","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[38,40],[56,71],[127,144],[156,165],[183,190],[262,269],[295,305],[332,337],[381,389],[445,456],[474,481],[499,506],[564,574],[640,660],[675,709],[719,729],[742,768],[775,801],[811,838],[843,855],[860,894],[900,910],[912,922],[926,964],[971,997],[1007,1035],[1042,1068],[1072,1082],[1084,1094],[1098,1140],[1161,1171],[1181,1263],[1270,1296],[1306,1333],[1338,1350],[1355,1399],[1407,1489],[1505,1523],[1530,1572],[1579,1656],[1663,1705],[1718,1746],[1753,1835],[1847,1924],[1943,1990],[2016,2022],[2049,2055],[2071,2074],[2094,2109]],"key":"ServiceNowOfficialDocs/api-reference/server-api-reference/c_CMDBTransformUtilAPI.md"},
