b-data-refresh-rule.md","line":44},{"title":"glide.identification\\_engine.enable\\_reconciliation\\_filter\\_before\\_update","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/properties-id-reconciliation.md","line":113},{"title":"CMDB 360","target":"multisource-cmdb","line":141},{"title":"CMDB 360","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/configuration-management-database-cmdb/multisource-cmdb.md","line":145},{"title":"CI Class Manager","target":"ci-class-manager-landing-page","line":155},{"title":"Reconciliation rules","target":"r_ReconciliationRulesPrinciples","line":222},{"title":"Identification and Reconciliation Engine \\(IRE\\)","target":"ire","line":223},{"title":"Reference","target":"reference","line":224},{"title":"CMDB 360","target":"multisource-cmdb","line":225},{"title":"CI Class Manager","target":"ci-class-manager-landing-page","line":226}],"metadata":{"title":"Create a reconciliation rule for a non-CMDB table","description":"Create a static or a dynamic CI reconciliation rule for a non-CMDB table.A static reconciliation rule specifies class attributes that data sources are authorized to update, and prevents unauthorized data sources from overwriting the attributes' values. A static reconciliation rule also specifies the prioritization among multiple data sources. Without static reconciliation rules, data sources can overwrite each other's updates to attribute values.A dynamic reconciliation rule for non-CMDB table uses CMDB 360 data to choose a value such as the largest value that is reported, for updating a record.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/servicenow-platform/configuration-management-database-cmdb/create-reconciliation-rule-non-cmdb.html","release":"australia","product":"Configuration Management Database \\(CMDB\\)","classification":"configura