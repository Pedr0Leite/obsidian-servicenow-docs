ceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-configure-now-assist.md","line":120},{"title":"dynamic behavior","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-glossary.md","line":151},{"title":"Make a form change based on responses in Creator Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-dynamic-behavior.md","line":153},{"title":"Dot-walking to data in related tables","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/c_DotWalking.md","line":183},{"title":"Available question types in Creator Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-form-elements-ref.md","line":192},{"title":"properties","target":"atf-admin-properties","line":210},{"title":"Layout options for forms in Creator Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-form-layout-options.md","line":214},{"title":"Publish a form for your app in Creator Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-publish-form.md","line":249},{"title":"Edit the trigger for a playbook in Creator Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-add-trigger-automation.md","line":274},{"title":"Field","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-glossary.md","line":286},{"title":"Create a condition statement using the condition builder","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-user-interface/create-cond-state-using-cond-build.md","line":291},{"title":"add a decision","target":"add-decision","line":310},{"title":"Add a decision to an app's playbook in Creator Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-add-decision-automation.md","line":310},{"title":"activity","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-glossary.md","line":310},{"title":"Add activities to an app's playbook in Creator Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-add-activities-automation.md","line":390},{"title":"Activate a playbook in Creator Studio","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-activate-automation.md","line":433},{"title":"Version number","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-glossary.md","line":453},{"title":"Release notes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-glossary.md","line":457},{"title":"App versioning and release notes for Creator Studio apps","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/application-development/creator-studio/creator-studio-app-release-versioning.md","line":464},{"title":"Application collaboration","target":"application-collaboration","line":477},{"title":"Creator Studio","target":"creator-studio-landing","line":478},{"title":"Deployment","target":"get-started-deployment","line":479},{"title":"Create your app","target":"create-application","line":480},{"title":"Create an app","target":"app-tutorial-create-an-app","line":481},{"title":"Properties","target":"atf-admin-properties","line":482},{"title":"Add a decision","target":"add-decision","line":483}],"metadata":{"title":"Creator Studio quick start","description":"This quick start guides you through the process of building your first app in Creator Studio and requesting its deployment.Create your app first. Later, we'll continue building it out.Let's add a form so people can make a request. Forms contain questions that people respond to when submitting a service desk request.Add questions to the form and define what they are asking to gather the information that your fulfiller needs to evaluate the request. You can then publish it to make its catalog items available.Add a playbook to create automation for your app, for example, to automatically assign a record to a manager for approval.Add an activity to your playbook to define what the automation does.Now that you've made an app, it's time to submit it for review so admins can approve and deploy it.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/application-development/creator-studio/creator-studio-quick-start.html","release":"australia","product":"Creator Studio","classification":"creator-studio","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":17,"breadcrumb":["Explore","Creator Studio","Building no-code applications","Developing your application","Building applications"],"tags":["#application-development","#creator-studio","#ai-generated","#low-code","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/application-development/creator-studio/creator-studio-quick-start.md"},
