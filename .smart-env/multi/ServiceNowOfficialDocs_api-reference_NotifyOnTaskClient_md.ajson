plate\\(\\)#{27}":[818,819],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{28}":[820,830],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{29}":[831,831],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{30}":[832,832],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{31}":[833,834],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{32}":[835,842],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{33}":[843,844],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{34}":[845,856],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{35}":[857,858],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{36}":[859,870],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{37}":[871,872],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - getNotifyActionTemplate\\(\\)#{38}":[873,928],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - start\\(Object data\\)":[929,1189],"#NotifyOnTaskClient- Client#NotifyOnTaskClient - start\\(Object data\\)#{1}":[931,1189]},"outlinks":[{"title":"Activate Notify","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/servicenow-platform/t_ActivateNotify.md","line":36},{"title":"Client API reference","target":"api-client","line":38},{"title":"doConferenceAction\\(\\)","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/NotifyOnTaskClient.md","line":697},{"title":"Client API reference","target":"api-client","line":1188}],"metadata":{"title":"NotifyOnTaskClient - Client","description":"The NotifyOnTaskClient API provides methods for sending SMS messages or starting/managing a conference call for various telephony service providers, such as Zoom and Webex.Adds the specified participants to a specified conference call.Performs the specified conference call action, such as starting/ending a conference call or joining, removing, muting, or unmuting participants from a conference call.Terminates the specified conference call.Returns a JSON data template to use with the doConferenceAction\\(\\) method. Using this template automatically structures the data object so that you don't have to manually create it.Starts a new conference call.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/NotifyOnTaskClient.html","release":"australia","product":"API Reference","classification":"api-reference","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":17,"breadcrumb":["Client API reference","API reference","API implementation and reference"],"tags":["#api-reference","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[111,254],[282,572],[623,691],[876,927],[1014,1153]],"key":"ServiceNowOfficialDocs/api-reference/NotifyOnTaskClient.md"},
