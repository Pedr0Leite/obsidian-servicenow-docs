/saas-license-management/add-reclamation-rule-sub.md","line":1255},{"title":"Create entitlements in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/track-software-rights.md","line":1259},{"title":"Create entitlements in workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/create-entitlements-workspace.md","line":1260},{"title":"Create entitlements using the guided walk-through","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/guidedwalk-workspace.md","line":1261},{"title":"License Workbench","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-license-workbench.md","line":1263},{"title":"License usage view","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/sam-workspace-workbench.md","line":1263},{"title":"Run software reconciliation in Software Asset Management classic","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/t_RunReconciliation.md","line":1265},{"title":"Run software reconciliation in the workspace","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/run-recon-workspace.md","line":1266},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":1270},{"title":"SaaS License Management","target":"sam-subscription-management","line":1271},{"title":"Using Software Asset Workspace","target":"using-sam-workspace","line":1272},{"title":"Software Asset Workspace","target":"sam-workspace","line":1273},{"title":"Software models","target":"c_CreatingSoftwareModels","line":1274}],"metadata":{"title":"Integrate Salesforce Marketing Cloud using OAuth 2.0","description":"Integrate your ServiceNow instance with Salesforce Marketing Cloud services by using OAuth 2.0.Create Salesforce Marketing Cloud OAuth 2.0 credentials to get access to Salesforce Marketing Cloud APIs.Create a Contacts Counts report to retrieve and display the total number of billable contacts in your Salesforce Marketing Cloud account.Create a data extension to store your Contacts Counts report data on your Salesforce Marketing Cloud instance.Create an automation to automatically import Contacts Counts report data into your data extension after the report is generated.After you create the Contacts Counts report, data extension, and automation, you can retrieve report data between your scheduled report and automation jobs by running these jobs manually.Create a Salesforce Marketing Cloud integration profile by using OAuth 2.0 to track software subscriptions and optimize stale licenses for the Salesforce Marketing Cloud service.Create an integration profile for each additional Salesforce Marketing Cloud that you want to track software subscriptions and optimize licensing for.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/saas-license-management/integrate-sfmc-oauth.html","release":"australia","product":"SaaS License Management","classification":"saas-license-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":33,"breadcrumb":["Integrating with Salesforce Marketing Cloud","Integrate with SaaS applications","SaaS License Management","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#saas","#license-management","#discovery","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[549,554]],"key":"ServiceNowOfficialDocs/it-asset-management/saas-license-management/integrate-sfmc-oauth.md"},
