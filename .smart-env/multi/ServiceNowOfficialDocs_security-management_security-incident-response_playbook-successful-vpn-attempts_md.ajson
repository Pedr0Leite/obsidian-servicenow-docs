a/markdown/security-management/security-incident-response/playbook-setup-successful-vpn-attempts.md","line":26},{"title":"set up the Successful VPN Attempts from the Service Accounts playbook","target":"playbook-setup-successful-vpn-attempts","line":27},{"title":"Use the Successful VPN Attempts from the Service Accounts playbook","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/playbook-using-successful-vpn-attempts.md","line":28},{"title":"Flow-based Playbooks","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/playbook-flow-based.md","line":31},{"title":"Indicators","target":"indicator","line":35},{"title":"Set up the Successful VPN Attempts from the Service Accounts playbook","target":"playbook-setup-successful-vpn-attempts","line":36}],"metadata":{"title":"Playbook for Successful VPN Attempts from the Service Accounts - Corp/Cloud","description":"This playbook provides systematic remediation steps to investigate incidents that track successful login attempts from service accounts through VPN. Service accounts aren’t supposed to have login events from a VPN, and such events could be indicators of either brute force or possible exposure of the account's credentials.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/playbook-successful-vpn-attempts.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":1,"breadcrumb":["Flow-based Playbooks","Security Incident Response playbooks","Playbook Resources","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-concept"]},