viceNow/ServiceNowDocs/australia/markdown/it-asset-management/software-asset-management/ibm-publisher-pack.md","line":92},{"title":"Software Asset Management publisher pack for IBM","target":"ibm-publisher-pack","line":96},{"title":"Software Asset Management","target":"c_SoftwareAssetMgmt","line":97},{"title":"Software discovery","target":"sam-software-discovery","line":98},{"title":"IBM licensing in public cloud environments","target":"ibm-licensing-public-cloud-environments","line":99},{"title":"IBM licensing in VMware vSphere environments","target":"ibm-licensing-vmware-vsphere-environment","line":100}],"metadata":{"title":"Authorized SAM Provider \\(ASP\\) integrations for IBM","description":"You can track and manage IBM licenses in both VMware vSphere environments and IBM LPAR infrastructures by integrating the Software Asset Management publisher pack for IBM with Software Asset Management providers that are authorized to participate in the IBM Client Value Acceleration \\(CVA\\) Program. With these integrations, you can track and manage IBM licensing directly without having to integrate with the IBM License Metric Tool \\(ILMT\\) or BigFix Inventory.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-asset-management/software-asset-management/ibm-asp-integration.html","release":"australia","product":"Software Asset Management","classification":"software-asset-management","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":8,"breadcrumb":["Software Asset Management publisher pack for IBM","Supported software publisher licenses","Software Asset Management","IT Asset Management"],"tags":["#it-asset-management","#sam","#software-licenses","#compliance","#optimization","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-asset-management/software-asset-management/ibm-asp-integration.md"},"smart_blocks:ServiceNowOfficialDocs/it-asset-management/software-asset-management/ibm-asp