operations-management/r_EntryPointsforBizSvcDef.md","line":1167},{"title":"Create entry point types for Service Mapping","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-operations-management/t_CreateEntryPoint.md","line":1167},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1231},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1244},{"title":"SG Services – POST /sg\\_services/app\\_service/update","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-apis/sg_services-api.md","line":1360},{"title":"Supported REST API headers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1479},{"title":"REST API HTTP response codes","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/api-reference/rest-api-explorer/c_RESTAPI.md","line":1492},{"title":"update","target":"r_Update","line":1566}],"metadata":{"title":"Application Service API","description":"The Application Service API provides endpoints that enable you to create, modify, and update application services.Retrieves a list of configuration items \\(CI\\) in a mapped application service and the relationships between them. Only retrieves content for services that were manually created.Returns basic information about a specified application service and its associated business context.Creates an application service or update an existing application service.Creates an application service record stub in the Service Instance \\[cmdb\\_ci\\_service\\_auto\\] table and populates it with the passed in information.Populates the specified application service with a specified set of downstream configuration items \\(CI\\).Updates the specified application service with the passed in basic information.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/api-reference/rest-apis/application-service-api.html","release":"australia","product":"REST APIs","classification":"rest-apis","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":19,"breadcrumb":["REST API reference","API reference","API implementation and reference"],"tags":["#api-reference","#rest","#table-api","#json","#http","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[141,148],[158,165],[183,188],[222,230],[248,255],[284,289],[291,368],[460,465],[491,502],[542,548],[599,605],[607,630],[775,794],[796,804],[844,850],[896,902],[973,978],[1015,1032],[1034,1041],[1098,1103],[1109,1115],[1121,1126],[1138,1143],[1187,1194],[1270,1275],[1298,1310],[1312,1316],[1320,1346],[1348,1352],[1407,1412],[1444,1450],[1517,1522],[1543,1556],[1558,1562]],"key":"ServiceNowOfficialDocs/api-reference/rest-apis/application-service-api.md"},
