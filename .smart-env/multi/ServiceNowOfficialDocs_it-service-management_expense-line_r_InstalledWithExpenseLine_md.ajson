 Line#Support level: No support":[103,114],"#Components installed with Expense Line#Domain separation and Expense Line#Support level: No support#{1}":[105,105],"#Components installed with Expense Line#Domain separation and Expense Line#Support level: No support#{2}":[106,107],"#Components installed with Expense Line#Domain separation and Expense Line#Support level: No support#{3}":[108,114],"#Components installed with Expense Line#Related":[115,118],"#Components installed with Expense Line#Related#{1}":[117,118]},"outlinks":[{"title":"Expense Line","target":"c_ExpenseLine","line":24},{"title":"Expense Line","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/it-service-management/expense-line/c_ExpenseLine.md","line":26},{"title":"Application support for domain separation","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-separated-apps.md","line":108},{"title":"Domain separation for service providers","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/platform-security/domain-sep-landing-page.md","line":113},{"title":"Expense Line","target":"c_ExpenseLine","line":117}],"metadata":{"title":"Components installed with Expense Line","description":"Several types of components are installed with the Expense Line plugin.Tables are added with activation of Expense Line.Roles are added with activation of Expense Line.Script includes are added with activation of Expense Line.Client scripts are added with activation of Expense Line.Business rules are added with activation of Expense Line.Domain separation is unsupported in Expense Line processing. Domain separation enables you to separate data, processes, and administrative tasks into logical groupings called domains. You can control several aspects of this separation, including which users can see and access data.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/it-service-management/expense-line/r\\_InstalledWithExpenseLine.html","release":"australia","product":"Expense Line","classification":"expense-line","topic_type":"reference","last_updated":"2026-03-12","reading_time_minutes":3,"breadcrumb":["Expense Line","IT Service Management"],"tags":["#it-service-management","#expenses","#costs","#itsm","#finance","#type-reference"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/it-service-management/expense-line/r_InstalledWithExpenseLine.md"},
