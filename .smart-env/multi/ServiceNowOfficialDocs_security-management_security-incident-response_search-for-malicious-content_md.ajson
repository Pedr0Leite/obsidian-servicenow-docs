t Flow#AutoFocus Search Session action#Input variables#{1}":[53,62],"#Get AutoFocus Session Info Enrichment Flow#Fetch Search Results action":[63,85],"#Get AutoFocus Session Info Enrichment Flow#Fetch Search Results action#{1}":[65,66],"#Get AutoFocus Session Info Enrichment Flow#Fetch Search Results action#Input variables":[67,74],"#Get AutoFocus Session Info Enrichment Flow#Fetch Search Results action#Input variables#{1}":[69,74],"#Get AutoFocus Session Info Enrichment Flow#Fetch Search Results action#Output variables":[75,85],"#Get AutoFocus Session Info Enrichment Flow#Fetch Search Results action#Output variables#{1}":[77,85],"#Get AutoFocus Session Info Enrichment Flow#Related":[86,91],"#Get AutoFocus Session Info Enrichment Flow#Related#{1}":[88,88],"#Get AutoFocus Session Info Enrichment Flow#Related#{2}":[89,89],"#Get AutoFocus Session Info Enrichment Flow#Related#{3}":[90,91]},"outlinks":[{"title":"Security Operations","target":"security-operations-landing-page","line":24},{"title":"Indicators of Compromise","target":"c_IoCs","line":38},{"title":"Common Security Operations integration flows and orchestration activities","target":"common-wf-activities","line":44},{"title":"AutoFocus Search Session action","target":"https://raw.githubusercontent.com/ServiceNow/ServiceNowDocs/australia/markdown/security-management/security-incident-response/search-for-malicious-content.md","line":73},{"title":"Common Security Operations integration flows and orchestration activities","target":"common-wf-activities","line":88},{"title":"Security Operations","target":"security-operations-landing-page","line":89},{"title":"Indicators of compromise","target":"c_IoCs","line":90}],"metadata":{"title":"Get AutoFocus Session Info Enrichment Flow","description":"When the Security Operations Palo Alto Networks- Get AutoFocus Session Info Enrichment flow is executed, it queues a search query with AutoFocus for gathering information about a specified source IP. If AutoFocus has knowledge about previous sessions originating from that IP address, a JSON-formatted report is returned.The AutoFocus Search Session flow action uploads information from an IP address assigned to a security incident to AutoFocus and queues it for a search query.The Fetch Search Results flow action fetches search results identified by a cookie to the search query initiated by the AutoFocus Search Session action.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/security-management/security-incident-response/search-for-malicious-content.html","release":"australia","product":"Security Incident Response","classification":"security-incident-response","topic_type":"task","last_updated":"2026-03-12","reading_time_minutes":2,"breadcrumb":["Palo Alto Networks - AutoFocus integration","Security Incident Response integrations","Security Incident Response","Enterprise security case management applications","Security Operations"],"tags":["#security-management","#sir","#security-incidents","#investigation","#soar","#type-task"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/security-management/security-incident-response/search-for-malicious-content.md"},
