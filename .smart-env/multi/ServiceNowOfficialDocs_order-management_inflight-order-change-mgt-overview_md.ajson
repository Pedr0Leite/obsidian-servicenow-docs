/markdown/order-management/horizontal-relationships.md","line":65},{"title":"Key inflight order change and cancellation request fields","target":"key-inflight-order-change-cancellation-request-fields","line":112},{"title":"fields","target":"fields","line":113},{"title":"Cancel orders","target":"order-mgt-review-cust-order-detail","line":114},{"title":"Revise orders","target":"revise-orders","line":116},{"title":"Delete orders","target":"delete-orders","line":118},{"title":"Review and approve order revisions or cancellation requests","target":"review-and-approve-or-decline-order-cancellation-requests","line":120},{"title":"Using Order Management","target":"using-order-management","line":123},{"title":"Configuring Order Management","target":"order-mgt-configuring","line":128},{"title":"Order management","target":"explore-order-management","line":130},{"title":"Horizontal relationships between products","target":"horizontal-relationships","line":134},{"title":"Key inflight order change and cancellation request fields","target":"key-inflight-order-change-cancellation-request-fields","line":135},{"title":"Cancel orders","target":"order-mgt-review-cust-order-detail","line":136},{"title":"Revise orders","target":"revise-orders","line":137},{"title":"Delete orders","target":"delete-orders","line":138},{"title":"Review and approve order revisions or cancellation requests","target":"review-and-approve-or-decline-order-cancellation-requests","line":139},{"title":"Using Order Management","target":"using-order-management","line":140},{"title":"Configuring Order Management","target":"order-mgt-configuring","line":141},{"title":"Order management","target":"explore-order-management","line":142},{"title":"Order fulfillment","target":"reviewing-orchestration-plans-order-fulfillment","line":143},{"title":"Modify","target":"Modify","line":144},{"title":"Cancel","target":"cancel","line":145},{"title":"Fields","target":"fields","line":146}],"metadata":{"title":"Managing inflight order changes and cancellation requests","description":"Manage how your organization receives changes for customer orders, service orders or individual line items that are still being orchestrated and fulfilled. By using inflight change order management, you can designate when you permit such changes. You can also assess the impact of the requested changes for an order or order line item, and automatically generate a plan to compensate for them when you approve the revision or cancellation request.","locale":"en-US","canonical_url":"https://www.servicenow.com/docs/r/order-management/inflight-order-change-mgt-overview.html","release":"australia","topic_type":"concept","last_updated":"2026-03-12","reading_time_minutes":10,"breadcrumb":["Order Management","Use","Sales Customer Relationship Management"],"tags":["#order-management","#fulfillment","#catalog","#orchestration","#type-concept"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"ServiceNowOfficialDocs/order-management/inflight-order-change-mgt-overview.md"},
